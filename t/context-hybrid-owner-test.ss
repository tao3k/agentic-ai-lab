;;; Production owner saturation with actual ASCENT/Session/journal effects.
(import (only-in :clan/poo/object .o .ref .call)
        (only-in :std/sync/channel make-channel channel-put channel-get)
        :agentic-ai-lab/t/temporal-evaluator-test
        (prefix-in :agentic-ai-lab/t/context-durable-owner originals.)
        :agentic-ai-lab/modules/ai-agentic-context/durable-owner
        :agentic-ai-lab/modules/ai-agentic-context/session-host
        :agentic-ai-lab/modules/ai-agentic-context/use-host
        :agentic-ai-lab/modules/temporal-causality/runtime/scheduling
        :agentic-ai-lab/modules/temporal-causality/runtime/policy-clock
        :agentic-ai-lab/modules/temporal-causality/runtime/monotonic-clock
        :agentic-ai-lab/modules/temporal-causality/runtime/durable-journal
        :agentic-ai-lab/modules/temporal-causality/truth-maintenance/support/policy-host)
(export hybrid-owner-probe)
(def (ensure value message) (unless value (error message)))
(def (rejected? operation) (with-catch (lambda (_) #t) (lambda () (operation) #f)))
(def (until predicate)
  (let (end (+ (native-monotonic-seconds) 3.))
    (let loop ()
      (unless (predicate)
        (when (> (native-monotonic-seconds) end) (error "Native admission rendezvous timed out"))
        (thread-sleep! 0.001) (loop)))))
(def (spawn operation)
  (thread-start! (make-thread (lambda () (operation) 'producer-joined))))
(def (join producer)
  (ensure (eq? (thread-join! producer 10 'join-timeout) 'producer-joined) "Producer did not join"))

(def (one-probe path timer?)
  (let* ((journal #f) (adapter #f)
         (clock (policy-clock-owner/scheduled (context-scheduling-contract 2 1 2)
           (lambda ()
             (set! journal (journal-open path))
             (originals.originals! journal path)
             (let* ((ctx (clock-original-context))
                    (fixture (authority-fixture #t ctx 1000000 #t)))
               (journal-evidence! journal "original-ascent" (originals.proof-evidence ctx))
               (journal-evidence! journal "original-org" context-source)
               (set! adapter (context-durable-adapter journal (.ref fixture 'host)
                              (.ref fixture 'grants) (.ref fixture 'policies)
                              (lambda (_) (.ref fixture 'proof))))
               (values fixture (.ref fixture 'policies) adapter)))
           "txn" 1 (if timer? 0.1 3600.) 0. 2 #f timer?))
         (entered (make-channel 1)) (release (make-channel 1))
         (observation (policy-clock-call! clock (lambda (f) (push-join! f "session"))))
         (revocation (policy-clock-call! clock (lambda (f)
           (context-durable-revoke-command "revoke"
             (agentic-ai-lab-context-use-host-current (.ref f 'grants) "grant")))))
         (refused-old? #f) (sequence '()))
    (def (read! operation) (policy-clock-call! clock operation))
    (def (command! id op body-value operation)
      (policy-clock-command! clock
        (.o kind: 'context.durable-command.v1 identity: id operation: op body: body-value) operation))
    (let* ((blocker (spawn (lambda ()
                      (read! (lambda (_)
                        (channel-put entered #t)
                        (ensure (eq? (channel-get release 5 'release-timeout) 'release)
                                "Blocked owner was not released"))))))
           (ready (channel-get entered 5 'enter-timeout)))
      (ensure (eq? ready #t) "Owner did not enter the active data handler")
      (let (result (spawn (lambda ()
                    (command! "old-result" 'result "session" (lambda (f)
                      (set! sequence (cons 'result sequence))
                      (set! refused-old?
                        (not (.ref (agentic-ai-lab-ai-agentic-context-session-host-commit-result!
                          (.ref f 'host) "session" 2 0 observation) 'accepted?))))))))
        (until (lambda () (= (.ref (policy-clock-admission-state clock) 'queued-data) 1)))
        (ensure (rejected? (lambda () (read! (lambda (_) #t))))
                "In-flight work did not retain its admission credit")
        (if timer?
          ;; Real background time, without any proof/query call to catch up.
          (begin
            (until (lambda () (= (.ref (policy-clock-admission-state clock) 'queued-controls) 1)))
            (channel-put release 'release))
          (let (revoker (spawn (lambda ()
                         (policy-clock-command! clock revocation (lambda (_)
                           (set! sequence (cons 'revoke sequence))
                           (.call adapter .revoke-grant! adapter revocation))))))
            (until (lambda () (= (.ref (policy-clock-admission-state clock) 'queued-controls) 1)))
            (ensure (rejected? (lambda () (policy-clock-pause! clock)))
                    "Saturated control capacity was silently bypassed")
            (channel-put release 'release)
            (join revoker)))
        (join blocker) (join result)
        (unless timer? (ensure (equal? (reverse sequence) '(revoke result)) "Control did not precede queued result"))
        (read! (lambda (f)
          (ensure refused-old? "Old result became current under saturated scheduling")
          (for-each (lambda (id)
            (ensure (eq? (.ref (push-row f id) 'context-state) 'invalidated)
                    "Affected cross-Session Context was not invalidated")) '("session" "session-b"))
          (ensure (eq? (.ref (push-row f "session-c") 'context-state) 'admitted)
                  "Independent Session was invalidated")
          (ensure (<= (length (agentic-ai-lab-ai-agentic-context-session-host-outcomes
                                (.ref f 'host) "session")) 1) "Attempt has multiple terminals")
          (ensure (.ref (agentic-ai-lab-ai-agentic-context-session-host-commit-result!
                          (.ref f 'host) "session-c" 2 0 (push-join! f "session-c"))
                       'native-result-published?) "Independent consumer could not publish")
          (push-join! f "session-b")
          (clock-check-originals! f)))
        (command! "cancel" 'cancel "session" (lambda (f)
          (agentic-ai-lab-ai-agentic-context-session-host-cancel!
            (.ref f 'host) "session" (push-revision f "session") 0)))
        (command! "recover" 'recover "session" (lambda (f)
          (agentic-ai-lab-ai-agentic-context-session-host-recover!
            (.ref f 'host) "session" (push-revision f "session") 0)))
        (command! "late-result" 'result "session" (lambda (f)
          (ensure (not (.ref (agentic-ai-lab-ai-agentic-context-session-host-commit-result!
                              (.ref f 'host) "session" 2 0 observation) 'accepted?))
                  "Recovery revived an obsolete result")))
        (policy-clock-stop! clock)
        (ensure (eq? (.ref (policy-clock-admission-state clock) 'phase) 'closed)
                "Production ingress did not drain and close")
        (ensure (and (journal-closed? journal) (.ref (policy-clock-stop-receipt clock) 'owner-joined?))
                "Native owner or journal retained")
        (displayln "HYBRID-OWNER timer=" timer? " saturation=refused old-result=refused unaffected=published recovery=no-revival closed=joined")))))

(def (stop-under-pressure)
  (let* ((entered (make-channel 1)) (release (make-channel 1))
         (clock (policy-clock-owner/scheduled (context-scheduling-contract 1 1 2)
                  (lambda ()
                    (let (policies (agentic-ai-lab-temporal-support-policy-host))
                      (agentic-ai-lab-temporal-support-policy-host-refresh! policies (policy "stop") 1 (at 1))
                      (values #t policies))) "txn" 1 0.01 0. 2 #f #t))
         (blocker (spawn (lambda ()
                    (policy-clock-call! clock (lambda (_)
                      (channel-put entered #t) (channel-get release 5 'timeout)))))))
    (ensure (eq? (channel-get entered 5 'timeout) #t) "Stop probe did not enter owner")
    (until (lambda () (= (.ref (policy-clock-admission-state clock) 'queued-controls) 1)))
    (let (stopper (spawn (lambda () (policy-clock-stop! clock))))
      (until (lambda () (eq? (.ref (policy-clock-admission-state clock) 'phase) 'draining)))
      (channel-put release 'release)
      (join blocker) (join stopper))
    (let ((receipt (policy-clock-stop-receipt clock))
          (state (policy-clock-admission-state clock)))
      (ensure (and (.ref receipt 'timer-joined?) (.ref receipt 'owner-joined?)
                   (eq? (.ref state 'phase) 'closed)
                   (= (.ref state 'queued-data) 0) (= (.ref state 'queued-controls) 0))
              "Saturated timer or admitted work blocked normal stop"))
    (displayln "HYBRID-STOP saturated-control=retained timer-retry=interruptible owner=joined")))

(def (hybrid-owner-probe path)
  (stop-under-pressure)
  (one-probe (string-append path ".revoke") #f)
  (one-probe (string-append path ".timer") #t)
  (displayln "MODULE-OK t/context-hybrid-owner-test.ss")
  (displayln "HARNESS-OK context-hybrid-owner")
  (displayln "OK"))
