(import :clan/poo/object)
(export TeachingItems TeachingMechanism RecoveryNeeds)
(def TeachingItems (list
(.o identity: 'clue question: 'why-still-unknown target: "ContextRepeatedRecovery::interruptedWriteDesign" facet: 'evidence-change referent: 'temporal-lineage glyph: "dev/d2/examples/recovery-evidence/assets/clue.svg" title: "Temporal / what changed?" explanation: "Keep history. A clue is not yet proof." representation: (.o family: 'evidence-versions state: 'revised intent: 'input action: "Observed bytes and a conditionally verified receipt remain distinct uses. The correction mark reopens the claim without deleting history.") rationale: "Observed bytes and a conditionally verified receipt remain distinct uses. The correction mark reopens the claim without deleting history." source: "docs/10-19-design/10.06-poo-module-system/agentic-ai-context/workspace-recovery.org" excerpt: "A late receipt can change today's assessment of the old\nAttempt without rewriting what was known on the first recovery observation.")
(.o identity: 'judge question: 'why-still-unknown target: "ContextRepeatedRecovery::interruptedWriteDesign" facet: 'question-responsibility referent: 'original-question glyph: "dev/d2/examples/recovery-evidence/assets/judge.svg" title: "Context + ASCENT / why check?" explanation: "Same Attempt. Task owner keeps the question." representation: (.o family: 'attempt-dossier state: 'unknown intent: 'check action: "One dossier retains the missing result, unknown writer and assigned reconciliation duty; the question is not a new execution.") rationale: "One dossier retains the missing result, unknown writer and assigned reconciliation duty; the question is not a new execution." source: "docs/10-19-design/10.06-poo-module-system/agentic-ai-context/workspace-recovery.org" excerpt: "An obligation identity binds the\nAttempt, question and scope; repeated recovery retains it rather than adding\nanother copy.")
(.o identity: 'explore question: 'why-still-unknown target: "ContextRepeatedRecovery::interruptedWriteDesign" facet: 'open-exploration referent: 'model glyph: "dev/d2/examples/recovery-evidence/assets/explore.svg" title: "Model / which clue next?" explanation: "Find a record, compare writers, or wait." representation: (.o family: 'competing-writers state: 'proposed intent: 'object action: "Two differently colored pencil traces reach the same text. A record under a lens is a possible discriminator, not an automatic next step.") rationale: "Two differently colored pencil traces reach the same text. A record under a lens is a possible discriminator, not an automatic next step." source: "docs/10-19-design/10.06-poo-module-system/agentic-ai-context/workspace-recovery.org" excerpt: "Each proposal explains which uncertainty it addresses and how different possible\nfindings would affect the hypotheses.")
))
(def RecoveryNeeds (map (lambda (p) (.o question: 'why-still-unknown target: "ContextRepeatedRecovery::interruptedWriteDesign" facet: (.ref p 'facet))) TeachingItems))
(def TeachingMechanism (.o links: (list
(.o identity: 'evidence-use from: 'clue to: 'judge role: 'basis label: "assessed evidence" meaning: (.o input?: #t) style: "support" propagates?: #t source: "docs/10-19-design/10.06-poo-module-system/agentic-ai-context/workspace-recovery.org" excerpt: "A late receipt can change today's assessment of the old\nAttempt without rewriting what was known on the first recovery observation.")
(.o identity: 'open-question from: 'judge to: 'explore role: 'qualification label: "what could settle it?" meaning: (.o) style: "support" propagates?: #t source: "docs/10-19-design/10.06-poo-module-system/agentic-ai-context/workspace-recovery.org" excerpt: "An obligation identity binds the\nAttempt, question and scope; repeated recovery retains it rather than adding\nanother copy.")
(.o identity: 'new-findings from: 'explore to: 'clue role: 'proposal label: "findings need checking" meaning: (.o) style: "support" propagates?: #t source: "docs/10-19-design/10.06-poo-module-system/agentic-ai-context/workspace-recovery.org" excerpt: "Actual findings re-enter Temporal as source-bound observations and assessed\nuses.")
(.o identity: 'alternatives from: 'explore to: 'judge role: 'uncertainty label: "competing explanations" meaning: (.o) style: "support" propagates?: #t source: "docs/10-19-design/10.06-poo-module-system/agentic-ai-context/workspace-recovery.org" excerpt: "Each proposal explains which uncertainty it addresses and how different possible\nfindings would affect the hypotheses.")
) requirements: (list (.o question: 'why-still-unknown from: 'explore to: 'clue role: 'proposal) (.o question: 'why-still-unknown from: 'clue to: 'judge role: 'basis)) traces: (list (.o question: 'why-still-unknown from: 'explore to: 'judge))))
