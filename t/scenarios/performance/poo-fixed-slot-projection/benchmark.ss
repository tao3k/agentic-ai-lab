((benchmarkKind . scenario-e2e)
 (max_total . 25ms)
 (target_total . 15ms)
 (regression_budget . 10ms)
 (expected_over_input_budget . 0ms)
 (sampleCount . 20)
 (targetRationale . "Pinned to a package-local fixed-slot projection loop: POO reads happen once at the boundary and the measured loop consumes scalar state.")
 (maxRssMb . 512)
 (memoryMetric . resident-set-size)
 (memoryUnit . "MB")
 (iterations . 3)
 (unit . "ms")
 (sourcePath . "t/scenarios/performance/poo-fixed-slot-projection/benchmark.ss")
 (rule . GERBIL-SCHEME-AGENT-R043)
 (feature . poo-fixed-slot-projection)
 (optimizationFocus . "fixed POO slot projection before scalar loops")
 (inputShape . "stable POO profile with fixed slot identifiers")
 (expectedOutcome . "the poo-fixed-slot-projection scenario preserves its declared semantic result under the ASP P95 gate")
 (expectedRepair . "read fixed slots once through POO accessors and keep loop state scalar")
 (pooFormEvidence . (.o .def defpoo))
 (pooUsageCallEvidence . (.ref .get .mix .o .def .putdefault! .setslot! setslots! .all-slots))
 (measurementPhases collect-before policy-before collect-after policy-after assert-time-gate observe-runtime-memory)
 (tags poo module-system performance projection fixed-slot))
