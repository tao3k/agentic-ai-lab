;;; Complete prior/current inputs; ASCENT derives insertion, withdrawal and retention.
(define-program (make-history)
  (sources current_row previous_row current_input previous_input
           proposal expected_parent observed_parent completed source_checked backend_checked)
  (outputs added removed retained changed_input added_input removed_input publishable publication_gap)
  (relation proposal ((attempt symbol?) (observation symbol?)))
  (relation expected_parent ((attempt symbol?) (parent symbol?)))
  (relation observed_parent ((parent symbol?)))
  (relation completed ((attempt symbol?)))
  (relation source_checked ((attempt symbol?)))
  (relation backend_checked ((attempt symbol?)))
  (relation publication_gap ((attempt symbol?) (reason symbol?)))
  (relation publishable ((attempt symbol?) (observation symbol?)))
  (relation blocked ((attempt symbol?)))
  ((publication_gap A 'comparison-incomplete) <-- (proposal A O) (not (completed A)))
  ((publication_gap A 'source-unchecked) <-- (proposal A O) (not (source_checked A)))
  ((publication_gap A 'backend-unchecked) <-- (proposal A O) (not (backend_checked A)))
  ((publication_gap A 'parent-changed) <-- (expected_parent A P) (not (observed_parent P)))
  ((blocked A) <-- (publication_gap A R))
  ((publishable A O) <-- (proposal A O) (expected_parent A P)
                        (observed_parent P) (completed A) (source_checked A)
                        (backend_checked A) (not (blocked A)))
  (relation current_row ((query symbol?) (row symbol?)))
  (relation previous_row ((query symbol?) (row symbol?)))
  (relation current_input ((path symbol?) (hash symbol?)))
  (relation previous_input ((path symbol?) (hash symbol?)))
  (relation current_name ((path symbol?)))
  (relation previous_name ((path symbol?)))
  (relation added ((query symbol?) (row symbol?)))
  (relation removed ((query symbol?) (row symbol?)))
  (relation retained ((query symbol?) (row symbol?)))
  (relation changed_input ((path symbol?)))
  (relation added_input ((path symbol?)))
  (relation removed_input ((path symbol?)))
  ((added Q R) <-- (current_row Q R) (not (previous_row Q R)))
  ((removed Q R) <-- (previous_row Q R) (not (current_row Q R)))
  ((retained Q R) <-- (current_row Q R) (previous_row Q R))
  ((changed_input P) <-- (current_input P H) (previous_input P K) (not (previous_input P H)))
  ((added_input P) <-- (current_input P H) (not (previous_name P)))
  ((removed_input P) <-- (previous_input P H) (not (current_name P)))
  ((previous_name P) <-- (previous_input P H))
  ((current_name P) <-- (current_input P H)))
