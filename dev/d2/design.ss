;;; SDK capture consumer: all graph and authoring inference belongs to D2.
(import :clan/poo/object
        (only-in :std/crypto/digest sha256)
        (only-in :std/encoding/hex hex-encode)
        (only-in :std/misc/ports read-all-as-u8vector)
        (only-in "./init.ss" agentic-ai-lab/dev/d2.init.exports)
        (only-in "./examples/window-evolution/readings.ss" WindowReadings)
        (only-in "./output/window-source.ss" DesignCapture))
(export main)
(def Scope (.get agentic-ai-lab/dev/d2.init.exports modules d2))
(def Context. (.get Scope prototypes AuthoringContext))
(def (main)
  ((.get agentic-ai-lab/dev/d2.init.exports std-make-spec) '())
  (def view-value (.ref DesignCapture 'view))
  (def graph-view ((.get Scope infer) (.ref DesignCapture 'diagram)))
  (for-each (lambda (render-value)
    (unless (equal? (.ref render-value 'image-sha)
      (hex-encode (sha256 (call-with-input-file (.ref render-value 'image-ref) read-all-as-u8vector))))
      (error "image reading has stale PNG bytes" (.ref render-value 'image-ref))))
    (.ref DesignCapture 'renders))
  (def plan-value
    (.o views: (list view-value) object-states: '() goals: '() prerequisites: '()
        audience-gaps: '() distinctions: '() candidates: '() makes-visible: '()
        meaning-reviews: '() critiques: '() goal-inventories: '()))
  (def authoring-result
    ((.get Scope author)
      (.o (:: @ Context.) views: (list view-value) explanation-plan: plan-value
          questions: (.ref DesignCapture 'questions)
          inspections: (.ref WindowReadings 'inspections)
          facet-needs: (.ref WindowReadings 'facet-needs)
          image-evidence: (.ref WindowReadings 'image-evidence)
          representation-gaps: (.ref WindowReadings 'representation-gaps)
          layout-concerns: (.ref WindowReadings 'layout-concerns)
          image-anchors: (.ref DesignCapture 'image-anchors)
          proposals: (.ref DesignCapture 'proposals) renders: (.ref DesignCapture 'renders))))
  ((.get agentic-ai-lab/dev/d2.init.exports admit-current))
  (call-with-output-file (list path: "dev/d2/output/window-evolution.d2" truncate: #t)
    (lambda (port) (display ((.get Scope source) graph-view) port)))
  (call-with-output-file (list path: "dev/d2/output/window-requests.org" truncate: #t)
    (lambda (port)
      (display "#+TITLE: Current model environment: design interpretation\n\n" port)
      (display "Source: 32-time-window-context-evolution.org and its SysML companion.\n" port)
      (display "The surrounding model reads and illustrates this design; no external model provider is required.\n" port)
      (display "No positive review verdict is synthesized from a successful render.\n\n* Outstanding ASCENT requests\n\n" port)
      (for-each (lambda (request)
        (write (map (lambda (slot) (.ref request slot)) '(kind view revision source-cut subject basis)) port)
        (newline port)) (.ref authoring-result 'requests))
      (display "\n* Questions from the native SysML reader perspective\n\n" port)
      (for-each (lambda (question-value)
        (display (.ref question-value 'text) port) (newline port)) (.ref DesignCapture 'questions))))
  (call-with-output-file (list path: "dev/d2/output/window-findings.org" truncate: #t)
    (lambda (port)
      (display "#+TITLE: Current image reading: evidence and inferred changes\n\n* Inspections retained in Context\n\n" port)
      (for-each (lambda (reading-value)
        (write (.ref reading-value 'identity) port) (display ": " port)
        (display (.ref reading-value 'response) port) (newline port)) (.ref WindowReadings 'inspections))
      (display "\n* Grounded facets (view/revision/proposal/image/question/facet/anchor)\n\n" port)
      (write ((.get authoring-result inspection rows-of) 'GroundedFacet) port)
      (display "\n\n* Model answer basis for supplied facets (not learner understanding)\n\n" port)
      (write (.ref authoring-result 'answers) port)
      (display "\n\n* Derived representation changes\n\n" port)
      (write ((.get authoring-result inspection rows-of) 'ChangeRepresentation) port)
      (display "\n\n* Derived layout changes\n\n" port)
      (write ((.get authoring-result inspection rows-of) 'ChangeLayout) port) (newline port)))
  (displayln "Design: " (length (.ref graph-view 'nodes)) " objects, "
    (length (.ref graph-view 'relations)) " relations; "
    (length (.ref authoring-result 'requests)) " open model requests"))
