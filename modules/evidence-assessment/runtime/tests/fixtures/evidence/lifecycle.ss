;;; Runtime lifecycle review, not execution authorization or a repair certificate.
(define-program (make-lifecycle-review)
  (sources candidate flag expected_flag requirement depends design source mechanism
           model_binding control satisfies measurement metric_requirement)
  (outputs configured missing_flag need missing dependency_path comparison model_context counterexample
           missing_metric source_rows actions)
  (explain
    (lambda (program result query scope)
      (hash ("status" "recorded-only") ("query" query) ("scope" scope)
            ("dependencies" (.ref program 'rules))
            ("gap" "Model context and reference design do not establish same-candidate source refinement, native acceptance, causal retry, performance or host authorization"))))
  (relation candidate ((id string?) (identity string?)))
  (relation flag ((candidate_id string?) (name string?)))
  (relation expected_flag ((name string?)))
  (relation requirement ((id string?) (phase string?) (description string?)))
  (relation depends ((requirement_id string?) (premise string?)))
  (relation design ((implementation string?) (axis string?) (choice string?) (source_id string?)))
  (relation source ((id string?) (path string?) (sha string?) (scope string?)))
  (relation mechanism ((axis string?) (reference string?)))
  (relation model_binding ((requirement_id string?) (model string?) (path string?) (sha string?)))
  (relation control ((id string?) (requirement_id string?) (outcome string?) (receipt string?)))
  ;; Admitted same-candidate evidence is external; finite controls never create it.
  (relation satisfies ((candidate_id string?) (requirement_id string?) (receipt string?)))
  (relation measurement ((candidate_id string?) (metric string?) (value number?) (receipt string?)))
  (relation metric_requirement ((metric string?)))
  (relation missing_flag (candidate_id name))
  (relation configured (candidate_id identity))
  (relation need (candidate_id requirement_id))
  (relation dependency_path (requirement_id premise))
  (relation missing (candidate_id requirement_id phase description))
  (relation comparison (axis gambit_choice reference reference_choice gambit_source reference_source))
  (relation model_context (requirement_id model path sha))
  (relation counterexample (requirement_id id receipt))
  (relation missing_metric (candidate_id metric))
  (relation source_rows (id path sha scope))
  (relation actions (id query reason))
  ((missing_flag C F) <-- (candidate C I) (expected_flag F) (not (flag C F)))
  ((configured C I) <-- (candidate C I) (not (missing_flag C _)))
  ((need C R) <-- (candidate C I) (requirement R P D))
  ((need C D) <-- (need C R) (depends R D))
  ((dependency_path R D) <-- (depends R D))
  ((dependency_path R D) <-- (depends R X) (dependency_path X D))
  ((missing C R P D) <-- (need C R) (requirement R P D) (not (satisfies C R _)))
  ((comparison A G Ref Choice GS RS) <--
    (design (lit "gambit-baseline") A G GS) (mechanism A Ref)
    (design Ref A Choice RS) (source GS _ _ _) (source RS _ _ _))
  ((model_context R M Path H) <-- (requirement R _ _) (model_binding R M Path H))
  ((counterexample R Id Receipt) <-- (requirement R _ _)
    (control Id R (lit "decoded-counterexample") Receipt))
  ((missing_metric C M) <-- (candidate C I) (metric_requirement M) (not (measurement C M _ _)))
  ((source_rows Id Path H Scope) <-- (source Id Path H Scope))
  ((actions (expr (R) (string-append "inspect:" R)) (lit "missing") D) <-- (missing C R P D))
  ((actions (lit "compare-designs") (lit "comparison")
    (lit "Inspect source-bound design differences; not an architecture ranking")) <-- (comparison _ _ _ _ _ _))
  ((actions (lit "inspect-flags") (lit "missing_flag")
    (lit "Check all three concurrency flags against the recorded configure command")) <-- (candidate C I))
  ((actions (lit "inspect-models") (lit "model_context")
    (lit "Inspect finite model context without native or source-refinement admission")) <-- (model_context _ _ _ _))
  ((actions (lit "inspect-performance-gaps") (lit "missing_metric")
    (lit "Require same-input paired pause/throughput/CPU/memory measurements")) <-- (missing_metric C M)))
