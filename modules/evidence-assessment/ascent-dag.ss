(import :std/encoding/json
        (only-in :std/list/list delete-duplicates/hash)
        (only-in :std/hash/misc hash-key?)
        (only-in :std/crypto/digest sha256)
        (only-in :std/encoding/hex hex-encode))
(export ascent-evidence-dag)

(def (copy-wire value)
  (string->json (json->string value) (JSONReadOptions object-as-hash: #t)))
(def (sorted values predicate) (list-sort predicate values))
(def (unique values) (delete-duplicates/hash values from-end?: #t))
(def (names values) (sorted (unique values) string<?))
(def (dependencies atoms)
  (names (filter-map (lambda (atom) (hash-get atom "relation")) atoms)))
(def (heads rule) (dependencies (hash-ref rule "head")))
(def (index-relations relations)
  (let (index (make-hash-table))
    (for-each (lambda (relation)
      (let (name (hash-ref relation "name"))
        (unless (and (string? name) (not (hash-key? index name)))
          (error "duplicate or invalid relation declaration" name))
        (hash-put! index name relation))) relations)
    index))

;; Stable wire identity belongs to the Library, not a host rule normalizer.
(def (canonical-json value)
  (call-with-output-string ""
    (lambda (port)
      (def (emit value)
        (cond
         ((hash-table? value)
          (display "{" port)
          (let (first #t)
            (for-each (lambda (key)
              (unless first (display "," port)) (set! first #f)
              (write-json port key) (display ":" port) (emit (hash-ref value key)))
              (sorted (hash-keys value) string<?)))
          (display "}" port))
         ((list? value)
          (display "[" port)
          (let (first #t)
            (for-each (lambda (item)
              (unless first (display "," port)) (set! first #f) (emit item)) value))
          (display "]" port))
         (else (write-json port value))))
      (emit value))))
(def (wire-identity value) (hex-encode (sha256 (string->utf8 (canonical-json value)))))

(def (canonical-rule rule)
  (let ((rule (copy-wire rule)) (variables (make-hash-table)))
    (def (rename name)
      (or (hash-get variables name)
          (let (fresh (number->string (hash-length variables)))
            (hash-put! variables name fresh) fresh)))
    (for-each (lambda (atom)
      (unless (hash-key? atom "mode")
        (unless (hash-key? atom "not") (hash-put! atom "not" #f)))
      (for-each (lambda (term)
        (when (hash-key? term "var") (hash-put! term "var" (rename (hash-ref term "var")))))
        (hash-ref atom "terms"))
      (when (hash-key? atom "output") (hash-put! atom "output" (rename (hash-ref atom "output"))))
      (when (hash-key? atom "inputs")
        (hash-put! atom "inputs" (map rename (hash-ref atom "inputs")))))
      (append (hash-ref rule "head") (hash-ref rule "body")))
    rule))

;; Tarjan follows dependency edges and emits SCCs in dependency-first order.
(def (components program)
  (let ((graph (make-hash-table)) (indices (make-hash-table))
        (low (make-hash-table)) (active (make-hash-table))
        (stack []) (result []) (next 0))
    (for-each (lambda (relation)
      (unless (hash-ref relation "source") (hash-put! graph (hash-ref relation "name") [])))
      (hash-ref program "relations"))
    (for-each (lambda (rule)
      (let (head (heads rule))
        (for-each (lambda (name)
          (unless (hash-key? graph name) (error "rule head must be a declared derived relation" name))
          (hash-put! graph name
            (names (append (hash-ref graph name) (filter (lambda (other) (not (equal? name other))) head)
              (filter (cut hash-key? graph <>) (dependencies (hash-ref rule "body"))))))) head)))
      (hash-ref program "rules"))
    (def (visit name)
      (hash-put! indices name next) (hash-put! low name next) (set! next (+ next 1))
      (set! stack (cons name stack)) (hash-put! active name #t)
      (for-each (lambda (other)
        (cond
         ((not (hash-key? indices other))
          (visit other) (hash-put! low name (min (hash-ref low name) (hash-ref low other))))
         ((hash-get active other)
          (hash-put! low name (min (hash-ref low name) (hash-ref indices other))))))
        (hash-ref graph name))
      (when (= (hash-ref low name) (hash-ref indices name))
        (let (group [])
          (let pop ()
            (let (other (car stack))
              (set! stack (cdr stack)) (hash-remove! active other)
              (set! group (cons other group))
              (unless (equal? other name) (pop))))
          (set! result (cons (names group) result)))))
    (for-each (lambda (name) (unless (hash-key? indices name) (visit name))) (names (hash-keys graph)))
    (reverse result)))

;; A recursive relation graph becomes a DAG only after SCC condensation.
;; This structural view names dependencies; completion and reuse admission are
;; established separately by query certificates bound to the source identity.
(def (evidence-dag program)
  (let* ((index (index-relations (hash-ref program "relations")))
         (groups (components program)) (owners (make-hash-table))
         (nodes []) (edges []))
    (for-each (lambda (name)
      (when (hash-ref (hash-ref index name) "source")
        (let (id (string-append "source:" name))
          (hash-put! owners name id)
          (set! nodes (cons (hash ("id" id) ("kind" "source") ("relations" [name])) nodes)))))
      (names (hash-keys index)))
    (for-each (lambda (group)
      (let (id (string-append "component:" (wire-identity group)))
        (for-each (cut hash-put! owners <> id) group))) groups)
    (for-each (lambda (group)
      (let* ((id (hash-ref owners (car group)))
             (rules (filter (lambda (rule) (ormap (cut member <> group) (heads rule)))
                            (hash-ref program "rules")))
             (used (dependencies (apply append (map (cut hash-ref <> "body") rules))))
             (external (filter (lambda (name) (not (member name group))) used))
             (recursive (or (> (length group) 1)
                            (ormap (lambda (name) (if (member name group) #t #f)) used))))
        (set! nodes (cons (hash ("id" id) ("kind" "component")
                               ("relations" group) ("recursive" recursive)) nodes))
        (for-each (lambda (name)
          (unless (hash-key? owners name) (error "undeclared DAG dependency" name))
          (set! edges (cons [ (hash-ref owners name) id ] edges))) external))) groups)
    (hash ("schema" "ascent.evidence-dag-structure.v1")
          ("nodes" (reverse nodes))
          ("edges" (map (lambda (edge) (hash ("from" (car edge)) ("to" (cadr edge))))
                         (sorted (unique edges)
                           (lambda (a b) (string<? (canonical-json a) (canonical-json b)))))))))

(def (query-dag request)
  (let* ((program (copy-wire (hash-ref request "program")))
         (trusted (hash-ref request "trusted")) (base (hash-ref request "sources"))
         (certificates (hash-ref request "certificates")) (retain (hash-ref request "retain"))
         (index (index-relations (hash-ref program "relations")))
         (declarations (make-hash-table)) (keys (make-hash-table))
         (mapping (make-hash-table)) (groups []) (reused []) (fresh []))
    (for-each (lambda (name)
      (let (relation (hash-ref index name))
        (if (hash-key? trusted name)
          (unless (equal? (canonical-json relation) (canonical-json (hash-ref trusted name)))
            (error "query changed source authority" name))
          (begin
            (when (or (hash-ref relation "source") (pair? (hash-ref relation "rows" [])))
              (error "derived evidence cannot introduce source facts" name))
            (hash-put! declarations name relation))))) (hash-keys index))
    (unless (andmap (cut hash-key? index <>) base) (error "query omitted source authority"))
    (for-each (lambda (rule)
      (when (ormap (cut hash-key? trusted <>) (heads rule)) (error "query defines source heads")))
      (hash-ref program "rules"))
    (for-each (lambda (group)
      (let* ((rules (filter (lambda (rule) (ormap (cut member <> group) (heads rule))) (hash-ref program "rules")))
             (used (dependencies (apply append (map (cut hash-ref <> "body") rules))))
             (external (filter (lambda (name) (not (member name group))) used))
             (recursive (or (> (length group) 1) (ormap (lambda (name) (if (member name group) #t #f)) used)))
             (deps (make-hash-table)))
        (for-each (lambda (name)
          (hash-put! deps name
            (if (hash-key? keys name) (hash-ref keys name)
              (if (hash-key? trusted name) (wire-identity (hash-ref trusted name))
                (error "undeclared component dependency" name))))) external)
        (let* ((canonical (map canonical-rule rules))
               (key (wire-identity (hash ("plannerVersion" "evidence-dag-v1")
                     ("sourceIdentity" (hash-ref request "sourceIdentity"))
                     ("relations" (map (cut hash-ref declarations <>) group))
                     ("rules" (sorted canonical (lambda (a b) (string<? (wire-identity a) (wire-identity b)))))
                     ("dependencies" deps))))
               (descriptor (hash ("relations" group) ("fingerprint" key)
                                 ("recursive" recursive) ("dependencies" external)))
               (aliases (and retain (hash-get certificates key)))
               (hit (and aliases (andmap (lambda (name)
                         (and (hash-key? aliases name)
                              (not (member (hash-ref aliases name) base))
                              (hash-key? trusted (hash-ref aliases name)))) group))))
          (for-each (cut hash-put! keys <> key) group)
          (set! groups (cons descriptor groups))
          (if hit
            (begin (for-each (lambda (name) (hash-put! mapping name (hash-ref aliases name))) (hash-keys aliases))
                   (set! reused (cons descriptor reused)))
            (set! fresh (cons descriptor fresh)))))) (components program))
    (let (lowered (copy-wire program))
      (hash-put! lowered "relations" (filter (lambda (r) (not (hash-key? mapping (hash-ref r "name"))))
                                                (hash-ref lowered "relations")))
      (hash-put! lowered "rules" (filter (lambda (rule) (not (ormap (cut hash-key? mapping <>) (heads rule))))
                                           (hash-ref lowered "rules")))
      (for-each (lambda (rule)
        (for-each (lambda (atom)
          (when (hash-key? atom "relation")
            (let (name (hash-ref atom "relation"))
              (hash-put! atom "relation" (hash-ref mapping name name))))) (hash-ref rule "body")))
        (hash-ref lowered "rules"))
      (hash-put! lowered "queries" (unique
        (map (lambda (name) (hash-ref mapping name name))
             (append (hash-ref program "queries") (hash-keys declarations)))))
      (let* ((request-key (wire-identity program))
             (cached (and retain (hash-get (hash-ref request "requests" (hash)) request-key))))
        (when cached
          (set! lowered (copy-wire (car cached)))
          (set! mapping (copy-wire (cadr cached))))
        (hash ("plannerVersion" "evidence-dag-v1") ("requestKey" request-key)
              ("lowered" lowered) ("mapping" mapping) ("groups" (reverse groups))
              ("keys" keys) ("reused" (reverse reused)) ("fresh" (reverse fresh)))))))

(def (slice-program request)
  (let* ((program (hash-ref request "program")) (facts (hash-ref request "facts"))
         (queries (names (hash-ref request "queries")))
         (index (index-relations (hash-ref program "relations")))
         (definitions (make-hash-table)) (used (make-hash-table)) (selected (make-hash-table-eqv)))
    (unless (pair? queries) (error "queries must name declared ASCENT relations"))
    (for-each (lambda (rule position)
      (unless (and (equal? (names (hash-keys rule)) '("body" "head"))
                   (pair? (hash-ref rule "head")) (pair? (hash-ref rule "body")))
        (error "ASCENT head/body rule required"))
      (for-each (lambda (name)
        (unless (and (hash-key? index name) (not (hash-ref (hash-ref index name) "source")))
          (error "rule head must name a derived relation" name))
        (hash-put! definitions name (cons position (hash-ref definitions name [])))) (heads rule)))
      (hash-ref program "rules") (iota (length (hash-ref program "rules"))))
    (def (visit name)
      (unless (hash-key? used name)
        (unless (hash-key? index name) (error "undeclared ASCENT dependency" name))
        (hash-put! used name #t)
        (unless (or (hash-ref (hash-ref index name) "source") (hash-key? definitions name))
          (error "derived relation has no rule" name))
        (for-each (lambda (position)
          (hash-put! selected position #t)
          (let (rule (list-ref (hash-ref program "rules") position))
            (for-each visit (dependencies (append (hash-ref rule "head") (hash-ref rule "body"))))))
          (hash-ref definitions name []))))
    (for-each visit queries)
    (let (relations (map (lambda (name)
      (let* ((relation (copy-wire (hash-ref index name))) (source (hash-ref relation "source"))
             (rows (hash-ref facts name [])) (columns (hash-ref relation "columns")))
        (when (and source (not (hash-key? facts name))) (error "undeclared source facts" name))
        (when (and (not source) (pair? rows)) (error "derived relation cannot contain source facts" name))
        (for-each (lambda (row)
          (unless (and (= (length row) (length columns))
            (andmap (lambda (value column)
              (case (string->symbol (hash-ref column "kind"))
                ((symbol) (string? value)) ((integer) (exact-integer? value))
                ((boolean) (boolean? value)) (else #f))) row columns))
            (error "source row violates native relation type" name))) rows)
        (hash-put! relation "rows" rows) relation)) (names (hash-keys used))))
      (hash ("relations" relations)
            ("rules" (map (cut list-ref (hash-ref program "rules") <>) (sorted (hash-keys selected) <)))
            ("queries" queries)))))

;; Closed relational continuations: alpha renaming and conjunction order do
;; not change intent. Variable sharing, negation and constants do change it.
(def (same-rule? actual expected)
  (let (steps 0)
    (def (unify a b forward backward)
      (cond
       ((and (hash-table? a) (hash-table? b)
             (= (hash-length a) 1) (= (hash-length b) 1)
             (hash-key? a "var") (hash-key? b "var"))
        (let ((x (hash-ref a "var")) (y (hash-ref b "var")))
          (and (string? x) (string? y)
               (or (not (hash-key? forward x)) (equal? (hash-ref forward x) y))
               (or (not (hash-key? backward y)) (equal? (hash-ref backward y) x))
               (begin (hash-put! forward x y) (hash-put! backward y x) #t))))
       (else (equal? a b))))
    (def (atom? a b forward backward)
      (and (equal? (hash-ref a "relation" #f) (hash-ref b "relation" #f))
           (equal? (hash-ref a "not" #f) (hash-ref b "not" #f))
           (andmap (lambda (key) (member key '("relation" "terms" "not"))) (hash-keys a))
           (= (length (hash-ref a "terms")) (length (hash-ref b "terms")))
           (andmap (lambda (x y) (unify x y forward backward))
                   (hash-ref a "terms") (hash-ref b "terms"))))
    (def (match-body actual expected forward backward)
      (set! steps (+ steps 1))
      (when (> steps 10000) (error "continuation equivalence search bound"))
      (if (null? actual) (null? expected)
        (let loop ((remaining expected) (before []))
          (and (pair? remaining)
            (let ((f (copy-wire forward)) (b (copy-wire backward)))
              (or (and (atom? (car actual) (car remaining) f b)
                       (match-body (cdr actual) (append (reverse before) (cdr remaining)) f b))
                  (loop (cdr remaining) (cons (car remaining) before))))))))
    (let ((f (hash)) (b (hash)) (ah (hash-ref actual "head")) (eh (hash-ref expected "head")))
      (and (= (hash-length actual) 2) (<= (length (hash-ref actual "body")) 16)
           (= (length ah) 1) (= (length eh) 1)
           (atom? (car ah) (car eh) f b)
           (= (length (hash-ref actual "body")) (length (hash-ref expected "body")))
           (match-body (hash-ref actual "body") (hash-ref expected "body") f b)))))

(def (check-continuation request)
  (def (signatures rules)
    (map (lambda (rule)
      (sorted (map (lambda (atom)
        (list (hash-ref atom "relation" #f) (hash-ref atom "not" #f)
              (length (hash-ref atom "terms")))) (hash-ref rule "body"))
        (lambda (a b) (string<? (canonical-json a) (canonical-json b))))) rules))
  (let* ((actual (hash-ref request "program")) (expected (hash-ref request "contract"))
         (ar (hash-ref actual "rules")) (er (hash-ref expected "rules"))
         (accepted (and
           (equal? (canonical-json (hash-ref actual "relations")) (canonical-json (hash-ref expected "relations")))
           (equal? (hash-ref actual "queries") (hash-ref expected "queries"))
           (= (length ar) (length er)) (andmap same-rule? ar er))))
    (hash ("accepted" accepted)
          ("intentIdentity" (wire-identity actual))
          ("contractIdentity" (wire-identity expected))
          ("diagnostic" (if accepted #f
            (hash ("reason" "Preserve query projection, tuple-field bindings, every conjunct, negation and constant. Return the complete relation, not a delta.")
                  ("requiredPredicateSignatures" (signatures er))
                  ("proposedPredicateSignatures" (signatures ar))))))))

(def (ascent-evidence-dag request)
  (case (string->symbol (hash-ref request "action"))
    ((graph) (evidence-dag (hash-ref request "program")))
    ((components) (hash ("components" (components (hash-ref request "program")))))
    ((canonical-rule) (hash ("rule" (canonical-rule (hash-ref request "rule")))))
    ((query) (query-dag request))
    ((check-continuation) (check-continuation request))
    ((slice) (slice-program request))
    (else (error "unknown Evidence DAG action"))))
