load(
    "@gerbil_bazel//gerbil:defs.bzl",
    "gerbil_project_compile",
    "gerbil_project_dev",
)
load("//packages/bazel:gerbil_project_environment.bzl", "gerbil_project_environment")
load("//packages/bazel:gerbil_projection.bzl", "gerbil_project_projection")

package(default_visibility = ["//visibility:public"])

exports_files([
    "gerbil-dependencies.MODULE.bazel",
    "core/t/feature-system-bundle-v1-foreign-arena-fixture.ss",
    "t/module-system-observability-test.ss",
    "t/profile-binding-syntax-test.ss",
    "t/profile-bundle-test.ss",
    "t/profile-composition-test.ss",
])

filegroup(
    name = "runtime_v0_schema",
    srcs = ["modules/workflow/contracts/runtime-v0-abi-schema.ss"],
)

filegroup(
    name = "gerbil_package_sources",
    # This is only the Bazel sandbox projection. gerbil.pkg owns dependency
    # identity and build.ss owns the module graph compiled from these files.
    srcs = ["gerbil.pkg"] + glob([
        "*.ss",
        "bindings/nono-c/**/*.h",
        "modules/**/*.ss",
        "modules/**/*.inc",
        "user-interface/**/*.ss",
    ]),
)

filegroup(
    name = "scheme_source_root_marker",
    srcs = ["gerbil.pkg"],
)

filegroup(
    name = "runtime_load_projection_source",
    srcs = ["modules/funflow/runtime-load-projection.ss"],
)

filegroup(
    name = "json_schema_native_contract_test_support",
    srcs = [
        "schemas/json/github-workflow.json",
        "t/funflow-github-ci-json-schema-contract-test.ss",
        "t/json-schema-contract-bridge-test.ss",
        "t/json-schema-native-contract-test.ss",
    ],
)

filegroup(
    name = "type_contract_performance_test_support",
    srcs = [
        "t/support/performance.ss",
        "t/support/type-contract-performance.ss",
    ],
)

gerbil_project_compile(
    name = "gerbil_poo_package",
    srcs = ["@gerbil_poo_sources//:sources"],
    build_script = "@gerbil_poo_sources//:build_script",
    require_library_output = True,
    source_resolution_receipts = ["@gerbil_poo_sources//:source_resolution_receipt"],
)


gerbil_project_compile(
    name = "orgize_package",
    srcs = ["@orgize_sources//:sources"],
    build_script = "@orgize_sources//:build_script",
    require_library_output = True,
    source_resolution_receipts = ["@orgize_sources//:source_resolution_receipt"],
    deps = [
        ":gerbil_poo_package",
        ":gerbil_parser_package",
    ],
)

# Core is versioned as a submodule and consumed as ordinary checkout files.
filegroup(
    name = "core_module_sources",
    srcs = glob(
        ["core/*.ss", "core/**/*.ss", "core/**/gerbil.pkg"],
        exclude = ["core/t/**", "core/design/**", "core/module-system/design/**", "core/dev/proofs/**"],
    ),
)

gerbil_project_compile(
    name = "yuanxu_package",
    srcs = [":core_module_sources"],
    build_script = "core/build.ss",
    require_library_output = True,
    deps = [":gerbil_poo_package"],
)

gerbil_project_compile(
    name = "gerbil_parser_package",
    srcs = ["@gerbil_parser_sources//:sources"],
    # Compile the native closure of consumed APIs, not every upstream language
    # and optional FFI product. Source revision/receipt admission is unchanged.
    build_script = "//packages/bazel:parser_dependency_build",
    require_library_output = True,
    source_resolution_receipts = ["@gerbil_parser_sources//:source_resolution_receipt"],
    deps = [
        ":yuanxu_package",
    ],
)

gerbil_project_compile(
    name = "gerbil_ascent_package",
    srcs = ["@gerbil_ascent_sources//:sources"],
    build_script = "@gerbil_ascent_sources//:build_script",
    require_library_output = True,
    source_resolution_receipts = ["@gerbil_ascent_sources//:source_resolution_receipt"],
    deps = [
        ":yuanxu_package",
    ],
)

filegroup(
    name = "dependency_packages",
    srcs = [
        ":gerbil_parser_package",
        ":gerbil_ascent_package",
        ":gerbil_poo_package",
        ":orgize_package",
        ":yuanxu_package",
    ],
)

[
    filegroup(name = name, srcs = [project], output_group = "receipt")
    for name, project in [
        ("gerbil_poo_package_receipt", ":gerbil_poo_package"),
        ("orgize_package_receipt", ":orgize_package"),
        ("yuanxu_package_receipt", ":yuanxu_package"),
        ("gerbil_parser_package_receipt", ":gerbil_parser_package"),
        ("gerbil_ascent_package_receipt", ":gerbil_ascent_package"),
    ]
]

[
    filegroup(name = name, srcs = [project], output_group = "project_root")
    for name, project in [
        ("gerbil_poo_package_project_root", ":gerbil_poo_package"),
        ("orgize_package_project_root", ":orgize_package"),
    ]
]

gerbil_project_compile(
    name = "compile",
    srcs = [":gerbil_package_sources"],
    args = ["compile"],
    build_script = ":build.ss",
    env = {"GERBIL_BUILD_VERBOSE": "1"},
    deps = [":gerbil_parser_package", ":orgize_package", ":gerbil_ascent_package"],
)

gerbil_project_environment(
    name = "python_runtime_test_environment",
    project = ":compile",
    working_directory = "packages/python-runtime",
)

gerbil_project_dev(
    name = "dev_compile",
    args = ["compile"],
    build_script = ":build.ss",
    tags = ["local", "manual"],
    deps = [":gerbil_parser_package", ":orgize_package", ":gerbil_ascent_package"],
)

filegroup(name = "project_root", srcs = [":compile"], output_group = "project_root")
filegroup(name = "compile_log", srcs = [":compile"], output_group = "log")

gerbil_project_projection(
    name = "wheel_smoke_projection_artifact",
    output_name = "wheel_smoke.ss.agentic-ai-lab-projection.sexp",
    project = ":compile",
    projection_source = ":runtime_load_projection_source",
    source = "//packages/python-runtime/src/agentic_ai_lab_runtime:wheel_smoke_projection_source",
)
