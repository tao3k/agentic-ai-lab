((benchmarkKind . scenario-e2e)
 (max_total . 100ms)
 (target_total . 25ms)
 (regression_budget . 75ms)
 (expected_over_input_budget . 5ms)
 (sampleCount . 20)
 (targetRationale . "Runtime requests should be projected once into a POO family and read through stable scalar slots.")
 (maxRssMb . 512)
 (memoryMetric . resident-set-size)
 (memoryUnit . "MB")
 (iterations . 1000)
 (unit . "ms")
 (sourcePath . "t/scenarios/performance/poo-runtime-request-family/benchmark.ss")
 (inputPath . "t/scenarios/performance/poo-runtime-request-family/input/src/runtime/request.ss")
