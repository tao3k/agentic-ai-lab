(import (only-in :clan/poo/object .o .ref)
        :std/encoding/json
        (only-in :std/encoding/hex hex-decode hex-encode)
        (only-in :std/crypto/digest sha256)
        :tao3k/agentic-ai-lab/modules/governance/policy/authorized-effect-token
        "objects.ss")
(export agentic-ai-lab-cedar-runtime-port)

(def frame-limit 1048576)

(def (write-frame port value)
  (let* ((bytes (json->u8vector value)) (size (u8vector-length bytes)))
    (unless (<= size frame-limit) (error "Cedar runtime frame exceeds limit"))
    (let (header (make-u8vector 4))
      (for-each (lambda (i)
        (u8vector-set! header i (bitwise-and #xff (arithmetic-shift size (- (* 8 (- 3 i)))))))
        '(0 1 2 3))
      (write-subu8vector header 0 4 port)
      (write-subu8vector bytes 0 size port)
      (force-output port))))

(def (read-frame port)
  (let (header (make-u8vector 4))
    (unless (= 4 (read-subu8vector header 0 4 port))
      (error "Missing Cedar runtime frame header"))
    (let (size (let loop ((i 0) (n 0))
                 (if (= i 4) n (loop (+ i 1) (+ (* 256 n) (u8vector-ref header i))))))
      (unless (<= 1 size frame-limit) (error "Invalid Cedar runtime frame length"))
      (let (bytes (make-u8vector size))
        (unless (= size (read-subu8vector bytes 0 size port))
          (error "Truncated Cedar runtime frame"))
        (parameterize ((current-json-read-options (JSONReadOptions object-as-hash: #t)))
          (u8vector->json bytes))))))

(def (now-ms) (inexact->exact (floor (* 1000 (time->seconds (current-time))))))

(def (grant-token grant proposal request)
  (let* ((value (hash-ref grant "payload"))
         (subject (hash-ref value "subject"))
         (attempt (.ref (.ref (.ref request 'original) 'body) 'attempt))
         (handoff (.ref proposal 'handoff))
         (bytes (hex-decode (.ref handoff 'payload-hex)))
         (sequence (.ref handoff 'sequence))
         (bundle (hash-ref value "runtime_bundle_digest"))
         (policy (hash-ref subject "policy_set_digest"))
         (entities (hash-ref subject "entity_store_digest"))
         (decision (hash-ref value "decision_receipt_digest"))
         (intent (hash-ref value "intent_digest"))
         (id (hash-ref value "grant_id"))
         (issued (hash-ref value "issued_at_unix_ms"))
         (epoch (hash-ref subject "epoch"))
         (binding (agentic-ai-lab-effect-binding
                    bundle epoch policy entities decision intent
                    (.ref attempt 'identity) (hash-ref value "action")
                    (hash-ref value "runtime_context_id") (.ref attempt 'session)
                    sequence sequence 'cedar-handoff 0 0 (u8vector-length bytes)
                    (string-append "sha256:" (hex-encode (sha256 bytes))) id)))
    (agentic-ai-lab-authorized-effect-token id (hash-ref value "nonce")
      (agentic-ai-lab-semantic-root bundle policy entities decision intent)
      binding (agentic-ai-lab-token-validity issued issued (hash-ref value "expires_at_unix_ms")
                (hash-ref value "revocation_epoch"))
      'strict 1 (hash-ref value "authority_id") (hash-ref grant "signature"))))

;; A private, bounded child channel uses the existing Cedar runtime framing.
;; Signed grants remain in the port and never enter the Durable journal.
(def (agentic-ai-lab-cedar-runtime-port executable endpoint artifact snapshot)
  (let ((port (open-process (list path: executable arguments: (list endpoint artifact))))
        (lock (make-mutex 'cedar-runtime-port))
        (grants (make-hash-table-eq weak-keys: #t))
        (closed? #f))
    (def (close!)
      (unless closed? (set! closed? #t) (close-port port)))
    (def (locked thunk)
      (dynamic-wind (lambda () (mutex-lock! lock))
        (lambda () (and (not closed?) (thunk)))
        (lambda () (mutex-unlock! lock))))
    (def (call operation proposal grant)
      (let (input (make-hash-table))
        (hash-put! input "operation" operation)
        (hash-put! input "proposal" (agentic-ai-lab-cedar-authorization-request->runtime proposal))
        (when grant (hash-put! input "grant" grant))
        (with-catch (lambda (exception) (close!) (raise exception))
          (lambda () (write-frame port input) (read-frame port)))))
    (def (grant-for token)
      (let (issued (hash-get grants token))
        (and issued
             (equal? (cdr issued) (agentic-ai-lab-authorized-effect-token-digest token))
             (car issued))))
    (input-port-timeout-set! port 12.)
    (output-port-timeout-set! port 12.)
    (with-catch (lambda (exception) (close!) (raise exception))
      (lambda ()
        (write-frame port (agentic-ai-lab-cedar-authority-snapshot->runtime snapshot))
        (unless (equal? "ready" (hash-ref (read-frame port) "status"))
          (error "Cedar authority port did not start"))))
    (.o .issue!: (lambda (self proposal request)
          (locked (lambda ()
            (let (reply (call "issue" proposal #f))
              (and (equal? "authorized" (hash-ref reply "status"))
                   (let* ((grant (hash-ref reply "grant"))
                          (token (grant-token grant proposal request)))
                     (hash-put! grants token
                       (cons grant (agentic-ai-lab-authorized-effect-token-digest token)))
                     token))))))
        .check: (lambda (self proposal token)
          (locked (lambda ()
            (let (grant (grant-for token))
              (and grant (equal? "current" (hash-ref (call "check" proposal grant) "status"))
                   (agentic-ai-lab-token-validation-context
                     (.ref token 'semantic-root) (.ref token 'binding) (now-ms)
                     (.ref (.ref token 'validity) 'revocation-epoch) '()))))))
        .consume!: (lambda (self proposal token)
          (locked (lambda ()
            (let (grant (grant-for token))
              (and grant
                   (begin
                     (hash-remove! grants token)
                     (let (reply (call "consume" proposal grant))
                       (and (equal? "consumed" (hash-ref reply "status"))
                            (hash-ref reply "handoff")))))))))
        .close!: (lambda (self) (locked close!)))))
