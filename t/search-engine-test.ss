(import :std/test (only-in :clan/poo/object .ref)
        :agentic-ai-lab/modules/search-engine/interface)
(export search-engine-test)
(def (stage name input output)
  (agentic-ai-lab-search-stage name 'search '() input output agentic-ai-lab-search-acquisition-role))
(def a (stage 'a 'source 'candidates))
(def b (stage 'b 'source 'candidates))
(def parallel (agentic-ai-lab-search-parallel 'branches (list a b)))
(def c (stage 'c (agentic-ai-lab-search-node-output-domain parallel) 'candidates))
(def d (stage 'd 'candidates 'results))
(def strategy (agentic-ai-lab-search-strategy 'generic
                (agentic-ai-lab-search-chain 'pipeline
                  (list (agentic-ai-lab-search-merge 'join parallel c) d)) '()))
(def (initial) (agentic-ai-lab-search-engine strategy "generation" "config" "cut"))
(def (rejected? thunk) (with-catch (lambda (_) #t) (lambda () (thunk) #f)))
(def (run-stage engine name)
  (let (issued (agentic-ai-lab-search-engine-issue engine name))
    (agentic-ai-lab-search-engine-complete (.ref issued 'engine) name (.ref issued 'request))))
(def search-engine-test
  (test-suite "Search DAG controller"
    (test-case "composition derives roots fan-in and continuation"
      (let* ((engine (initial)) (after-a (run-stage engine 'a))
             (after-b (run-stage after-a 'b)) (after-c (run-stage after-b 'c)))
        (check (agentic-ai-lab-search-engine-frontier engine) => '(a b))
        (check (.ref (agentic-ai-lab-search-engine-node engine 'c) 'dependencies) => '(a b))
        (check (.ref (agentic-ai-lab-search-engine-node engine 'd) 'dependencies) => '(c))
        (check (agentic-ai-lab-search-engine-frontier after-a) => '(b))
        (check (agentic-ai-lab-search-engine-frontier after-b) => '(c))
        (check (agentic-ai-lab-search-engine-frontier after-c) => '(d))
        (check (agentic-ai-lab-search-engine-frontier (run-stage after-c 'd)) => '())))
    (test-case "active and missing parents cannot be scheduled"
      (let* ((engine (initial)) (issued (agentic-ai-lab-search-engine-issue engine 'a))
             (next (.ref issued 'engine)))
        (check (agentic-ai-lab-search-engine-frontier next) => '(b))
        (check (rejected? (lambda () (agentic-ai-lab-search-engine-issue next 'a))) => #t)
        (check (rejected? (lambda () (agentic-ai-lab-search-engine-issue next 'c))) => #t)
        (check (rejected? (lambda () (agentic-ai-lab-search-engine-issue next 'unknown))) => #t)))
    (test-case "selective invalidation retains independent branch and fences active work"
      (let* ((after-b (run-stage (initial) 'b))
             (a-issued (agentic-ai-lab-search-engine-issue after-b 'a))
             (old (.ref a-issued 'request))
             (revised (agentic-ai-lab-search-engine-revise (.ref a-issued 'engine) '(a) "cut2")))
        (check (eq? (agentic-ai-lab-search-engine-node after-b 'b) (agentic-ai-lab-search-engine-node revised 'b)) => #t)
        (check (agentic-ai-lab-search-engine-frontier revised) => '(a))
        (for-each (lambda (name)
                    (let (node (agentic-ai-lab-search-engine-node revised name))
                      (check (.ref (.ref node 'state) 'revision) => 1)
                      (check (.ref node 'completion) => #f))) '(a c d))
        (check (rejected? (lambda () (agentic-ai-lab-search-engine-complete revised 'a old))) => #t)
        (let* ((fresh (agentic-ai-lab-search-engine-issue revised 'a))
               (request (.ref fresh 'request))
               (done (agentic-ai-lab-search-engine-complete (.ref fresh 'engine) 'a request)))
          (check (.ref request 'attempt) => 1)
          (check (agentic-ai-lab-search-engine-frontier done) => '(c)))))
    (test-case "completed descendants are invalidated and must run again"
      (let* ((done (run-stage (run-stage (run-stage (run-stage (initial) 'a) 'b) 'c) 'd))
             (revised (agentic-ai-lab-search-engine-revise done '(a) "cut2"))
             (rerun (run-stage (run-stage (run-stage revised 'a) 'c) 'd)))
        (check (agentic-ai-lab-search-engine-frontier revised) => '(a))
        (check (agentic-ai-lab-search-engine-frontier rerun) => '())
        (check (.ref (.ref (agentic-ai-lab-search-engine-node rerun 'c) 'request) 'revision) => 1)
        (check (rejected? (lambda () (agentic-ai-lab-search-engine-revise done '(unknown) "cut"))) => #t)))
    (test-case "exact cancellation invalidates descendants and retains independent work"
      (let* ((after-b (run-stage (initial) 'b))
             (issued (agentic-ai-lab-search-engine-issue after-b 'a))
             (next (.ref issued 'engine)) (request (.ref issued 'request))
             (cancelled (agentic-ai-lab-search-engine-cancel next 'a request)))
        (check (agentic-ai-lab-search-engine-frontier cancelled) => '(a))
        (check (eq? (agentic-ai-lab-search-engine-node after-b 'b)
                    (agentic-ai-lab-search-engine-node cancelled 'b)) => #t)
        (for-each (lambda (name)
                    (check (.ref (.ref (agentic-ai-lab-search-engine-node cancelled name) 'state) 'revision) => 1))
                  '(a c d))
        (check (rejected? (lambda () (agentic-ai-lab-search-engine-complete cancelled 'a request))) => #t)))
    (test-case "stale cancellation preserves the fresh active POO request"
      (let* ((issued (agentic-ai-lab-search-engine-issue (initial) 'a))
             (old (.ref issued 'request))
             (cancelled (agentic-ai-lab-search-engine-cancel (.ref issued 'engine) 'a old))
             (fresh (agentic-ai-lab-search-engine-issue cancelled 'a))
             (next (.ref fresh 'engine)) (request (.ref fresh 'request))
             (state (.ref (agentic-ai-lab-search-engine-node next 'a) 'state))
             (returned (agentic-ai-lab-search-attempt-request state
                         (.ref request 'source-cut) (.ref request 'revision) (.ref request 'attempt))))
        (check (eq? (agentic-ai-lab-search-engine-cancel next 'a old) next) => #t)
        (check (agentic-ai-lab-search-attempt-current? state returned) => #t)
        (check (agentic-ai-lab-search-engine-frontier (agentic-ai-lab-search-engine-complete next 'a returned)) => '(b))))
    (test-case "duplicate leaf identities cannot erase a prerequisite"
      (let* ((duplicate (agentic-ai-lab-search-parallel 'bad (list a a)))
             (bad (agentic-ai-lab-search-strategy 'bad duplicate '())))
        (check (rejected? (lambda () (agentic-ai-lab-search-engine bad "generation" "config" "cut"))) => #t)))
    (test-case "nested branches use terminal stages as merge prerequisites"
      (let* ((a2 (stage 'a2 'candidates 'results))
             (b2 (stage 'b2 'candidates 'results))
             (branches (agentic-ai-lab-search-parallel 'nested
                         (list (agentic-ai-lab-search-chain 'left (list a a2))
                               (agentic-ai-lab-search-chain 'right (list b b2)))))
             (join (stage 'join (agentic-ai-lab-search-node-output-domain branches) 'results))
             (engine (agentic-ai-lab-search-engine
                       (agentic-ai-lab-search-strategy 'nested
                         (agentic-ai-lab-search-merge 'merged branches join) '())
                       "generation" "config" "cut"))
             (done (run-stage (run-stage (run-stage (run-stage engine 'a) 'a2) 'b) 'b2)))
        (check (.ref (agentic-ai-lab-search-engine-node engine 'join) 'dependencies) => '(a2 b2))
        (check (agentic-ai-lab-search-engine-frontier done) => '(join))))))
