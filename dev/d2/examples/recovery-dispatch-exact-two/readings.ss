(.o inspection: 'spacing-reading facet: 'identity-scope anchor: "identities/text/1" excerpt: "R43")
(.o inspection: 'spacing-reading facet: 'identity-scope anchor: "identities/text/5" excerpt: "Same Attempt, effect and window.")
(.o inspection: 'spacing-reading facet: 'count-closure anchor: "assessed/text/0" excerpt: "Exactly two")
(.o inspection: 'spacing-reading facet: 'count-closure anchor: "assessed/text/1" excerpt: "ASCENT closes the count.")
(.o inspection: 'spacing-reading facet: 'publication-history anchor: "summary/text/2" excerpt: "Temporal admits v4")
(.o inspection: 'spacing-reading facet: 'publication-history anchor: "summary/text/3" excerpt: "Keep v3 and its basis.")
(.o inspection: 'current-reading facet: 'identity-scope anchor: "identities/text/0" excerpt: "R42")
