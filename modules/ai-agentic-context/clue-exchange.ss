(import :std/encoding/json :std/crypto/digest :std/encoding/hex
        (only-in :clan/poo/object .ref)
        :agentic-ai-lab/modules/ai-agentic-context/clue-query
        (only-in :gerbil-ascent/rules/declaration rule-module-program)
        (only-in :gerbil-ascent/program/session gerbil-ascent-open-session
          gerbil-ascent-session-run gerbil-ascent-session-replace-source!)
        (only-in :agentic-ai-lab/modules/temporal-causality/trajectory/ascent-ledger ascent-trajectory))
(export open-clue-exchange open-trajectory-clue-exchange)

;; Only the trusted host supplies verify. Agent input never contains attested rows.
(def (clone value)
  (call-with-input-string (json->string value)
    (lambda (port) (read-json port object-as-hash: #t))))
(def (open-clue-exchange verify context (retained #f))
  (unless (procedure? verify) (error "trusted receipt verifier required"))
  (unless (procedure? context) (error "trusted context provider required"))
  (let ((session (gerbil-ascent-open-session
                   (rule-module-program (make-clue-query-evidence))))
        (clues []) (generation 0))
    (def (field row key)
      (let (value (hash-ref row key #f))
        (unless (and (string? value) (> (string-length value) 0))
          (error "invalid clue field" key))
        value))
    (def (current-context)
      (let (value (context))
        (unless (hash-table? value) (error "invalid trusted context"))
        (for-each (lambda (key) (field value key))
          '("ownerIdentity" "sourceIdentity" "prefixIdentity" "ruleIdentity"))
        (hash ("ownerIdentity" (hash-ref value "ownerIdentity"))
              ("sourceIdentity" (hash-ref value "sourceIdentity"))
              ("prefixIdentity" (hash-ref value "prefixIdentity"))
              ("ruleIdentity" (hash-ref value "ruleIdentity")))))
    (def (same-context? left right)
      (andmap (lambda (key) (equal? (hash-ref left key) (hash-ref right key)))
        '("ownerIdentity" "sourceIdentity" "prefixIdentity" "ruleIdentity")))
    (def (digest row source-identity)
      (hex-encode (sha256 (string->utf8 (json->string
        [source-identity (field row "id") (field row "claim") (field row "polarity")
         (field row "role") (field row "source")
         (hash-ref row "factors" []) (hash-ref row "links" [])])))))
    (def (accept row source-identity)
      (unless (hash-table? row) (error "clue must be a record"))
      (unless (member (field row "polarity") '("support" "counter"))
        (error "invalid polarity"))
      (unless (member (field row "role") '("observation" "hypothesis"))
        (error "invalid role"))
      (for-each (lambda (pair)
        (unless (and (list? pair) (= (length pair) 2)
                     (andmap string? pair))
          (error "invalid factor"))) (hash-ref row "factors" []))
      (for-each (lambda (edge)
        (unless (and (list? edge) (= (length edge) 2)
                     (andmap string? edge))
          (error "invalid link"))) (hash-ref row "links" []))
      (hash ("id" (field row "id")) ("claim" (field row "claim"))
            ("polarity" (field row "polarity")) ("role" (field row "role"))
            ("source" (field row "source"))
            ("sourceIdentity" source-identity)
            ("factors" (clone (hash-ref row "factors" [])))
            ("links" (clone (hash-ref row "links" [])))
            ("digest" (digest row source-identity))))
    (def (replace-view question observed)
      (unless (or (not observed)
                  (and (hash-table? observed)
                       (equal? (hash-ref observed "schema" #f)
                               "ascent.clue-view.v1")))
        (error "observed clue view required"))
      (let ((bound-context (current-context))
            (clue-rows []) (factor-rows []) (link-rows []) (attested [])
            (unavailable []))
        (for-each (lambda (row)
          (let* ((id (hash-ref row "id")) (d (hash-ref row "digest"))
                 (claim (hash-ref row "claim")) (role (hash-ref row "role"))
                 (receipt (and (equal? role "observation")
                               (equal? (hash-ref row "sourceIdentity")
                                       (hash-ref bound-context "sourceIdentity"))
                   (with-catch (lambda (_) #f)
                     (lambda () (verify id d (hash-ref row "source")
                                        bound-context))))))
            (set! clue-rows (cons [id d claim (hash-ref row "polarity") role
                                   (hash-ref row "source")] clue-rows))
            (when (equal? role "observation")
              (if (and (string? receipt) (> (string-length receipt) 0))
                (set! attested (cons [id d receipt] attested))
                (set! unavailable (cons id unavailable))))
            (for-each (lambda (pair)
              (set! factor-rows (cons [id d (car pair) (cadr pair)] factor-rows)))
              (hash-ref row "factors"))
            (when receipt
              (for-each (lambda (edge)
                (set! link-rows (cons [claim (car edge) (cadr edge) id d]
                                       link-rows))) (hash-ref row "links"))))) clues)
        (gerbil-ascent-session-replace-source! session 'clue clue-rows)
        (gerbil-ascent-session-replace-source! session 'factor factor-rows)
        (gerbil-ascent-session-replace-source! session 'link link-rows)
        (gerbil-ascent-session-replace-source! session 'attested attested)
        (gerbil-ascent-session-replace-source! session 'question [[question]])
        (let* ((view-identity (hex-encode (sha256 (string->utf8
                  (json->string ["clue-query.v1"
                    [(hash-ref bound-context "ownerIdentity")
                     (hash-ref bound-context "sourceIdentity")
                     (hash-ref bound-context "prefixIdentity")
                     (hash-ref bound-context "ruleIdentity")]
                    generation question
                                 clue-rows attested factor-rows link-rows])))))
               (result (gerbil-ascent-session-run session)))
          (unless (.ref result 'finished) (error "incomplete clue query"))
          (unless (same-context? bound-context (current-context))
            (error "trusted context changed during clue query"))
          (hash ("schema" "ascent.clue-view.v1")
                ("generation" generation) ("question" question)
                ("context" bound-context)
                ("viewIdentity" view-identity)
                ("status" (cond ((pair? unavailable) "unavailable")
                  ((not observed) "unread")
                  ((not (and (hash-table? (hash-ref observed "context" #f))
                             (same-context? bound-context
                               (hash-ref observed "context")))) "stale")
                  ((equal? (hash-ref observed "viewIdentity" #f)
                           view-identity) "unchanged")
                  (else "changed")))
                ("executionAuthorized" #f) ("actionSelected" #f)
                ("unavailable" (reverse unavailable))
                ("support" ((.ref result 'rows-of) 'support))
                ("counterevidence" ((.ref result 'rows-of) 'counterevidence))
                ("conditional" ((.ref result 'rows-of) 'conditional))
                ("relevantFactors" ((.ref result 'rows-of) 'relevant_factor))
                ("neighbors" ((.ref result 'rows-of) 'neighbor))
                ("conflict" ((.ref result 'rows-of) 'conflict))
                ("unknown" ((.ref result 'rows-of) 'unknown))))))
    (def (dispatch action . args)
      (case action
        ((submit)
         (let ((rows (car args)) (base (cadr args)))
           (unless (equal? base generation) (error "stale clue generation"))
           (unless (list? rows) (error "clues must be a list"))
           (let* ((bound-context (current-context))
                  (accepted (map (lambda (row)
                    (accept row (hash-ref bound-context "sourceIdentity"))) rows)))
             (unless (same-context? bound-context (current-context))
               (error "trusted context changed during clue submission"))
             (for-each (lambda (row)
               (when (or (ormap (lambda (old)
                 (equal? (hash-ref old "id") (hash-ref row "id"))) clues)
                 (> (length (filter (lambda (other)
                   (equal? (hash-ref other "id") (hash-ref row "id"))) accepted)) 1))
                 (error "duplicate clue id"))) accepted)
             (set! clues (append clues accepted))
             (set! generation (+ generation 1))
             (hash ("generation" generation)
                   ("identities" (map (lambda (row)
                     [ (hash-ref row "id") (hash-ref row "digest") ]) accepted))))))
        ((query) (replace-view (car args) (if (pair? (cdr args)) (cadr args) #f)))
        ((snapshot) (hash ("schema" "ascent.clue-exchange.v1")
                          ("ownerIdentity" (hash-ref (current-context) "ownerIdentity"))
                          ("generation" generation) ("clues" (clone clues))))
        (else (error "unknown clue exchange action" action))))
    (gerbil-ascent-session-run session)
    (when retained
      (unless (and (hash-table? retained)
                   (equal? (hash-ref retained "schema" #f) "ascent.clue-exchange.v1")
                   (equal? (hash-ref retained "ownerIdentity" #f)
                           (hash-ref (current-context) "ownerIdentity"))
                   (exact-integer? (hash-ref retained "generation" #f))
                   (>= (hash-ref retained "generation") 0)
                   (list? (hash-ref retained "clues" #f)))
        (error "invalid retained clue snapshot"))
      (let (restored (map (lambda (row)
              (accept row (field row "sourceIdentity")))
            (hash-ref retained "clues")))
        (unless (or (null? restored)
                    (> (hash-ref retained "generation") 0))
          (error "nonempty snapshot has zero generation"))
        (for-each (lambda (row)
          (when (> (length (filter (lambda (other)
            (equal? (hash-ref other "id") (hash-ref row "id"))) restored)) 1)
            (error "duplicate retained clue id"))) restored)
        (for-each (lambda (row old)
          (unless (equal? (hash-ref row "digest") (hash-ref old "digest" #f))
            (error "retained clue content changed")))
          restored (hash-ref retained "clues"))
        (set! clues restored)
        (set! generation (hash-ref retained "generation"))))
    dispatch))

;; A host owns the trajectory handle and native verifier. The Agent-facing
;; closure offers read-only history plus clue submission/query, never append.
(def (open-trajectory-clue-exchange trajectory verify rule-identity (retained #f))
  (unless (and (string? rule-identity) (> (string-length rule-identity) 0))
    (error "reviewed rule source identity required"))
  (def (trajectory-read action . args)
    (let (request (hash ("action" action) ("trajectory" trajectory)))
      (when (pair? args) (hash-put! request "candidate" (car args)))
      (when (and (pair? args) (pair? (cdr args)))
        (hash-put! request "observed" (cadr args)))
      (ascent-trajectory request)))
  (def (context)
    (let (brief (trajectory-read "brief"))
      (hash ("ownerIdentity" (number->string (hash-ref brief "ownerIdentity")))
            ("sourceIdentity" (hash-ref brief "sourceIdentity"))
            ("prefixIdentity" (hash-ref brief "prefixIdentity"))
            ("ruleIdentity" rule-identity))))
  (let (clues (open-clue-exchange verify context retained))
    (lambda (action . args)
      (case action
        ((brief)
         (let (packet (ascent-trajectory
           (hash ("action" "brief") ("trajectory" trajectory)
                 ("observed" (if (pair? args) (car args) #f)))))
           (hash-put! packet "clueReads" ["submit" "query"])
           packet))
        ((focus) (apply trajectory-read "focus" args))
        ((submit query snapshot) (apply clues action args))
        (else (error "unknown progressive exchange action" action))))))
