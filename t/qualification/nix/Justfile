# Product adapter roots; dependency traversal belongs to Core, not shell lists.
set shell := ["bash", "-euo", "pipefail", "-c"]
root := justfile_directory() + "/../../.."

build:
    cd "{{ root }}" && timeout --signal=TERM --kill-after=5s 240s gerbil -:max-heap=2G,debug=q interactive t/qualification/nix/build.ss compile

# Bazel has built the declared adapter libraries. Consume the root package's
# SAME native build declaration in this command-owned runtime prefix, using
# the official Gerbil frontend and the unchanged pre-import heap/time fence.
prepare-qualification:
    cd "{{ root }}" && GAMBOPT="${GAMBOPT:+$GAMBOPT,}max-heap=2G,debug=q" timeout --signal=TERM --kill-after=5s 120s gerbil -:max-heap=2G,debug=q interactive qualification-build.ss compile

test path: build prepare-qualification
    cd "{{ root }}" && timeout --signal=TERM --kill-after=5s 240s gxi -:max-heap=2G,debug=q t/qualification/nix/run.ss "{{ path }}"

# Core TestingScript owns the per-file 2 GiB / 120-second gate, serially.
test-all: build prepare-qualification
    cd "{{ root }}" && timeout --signal=TERM --kill-after=5s 3600s gxi -:max-heap=2G,debug=q t/qualification/nix/run.ss

# Read the actual Nix-selected head in an independent bounded process.
head-reader profile:
    cd "{{ root }}" && env -u SDKROOT timeout --signal=TERM --kill-after=5s 30s gxi -:max-heap=2G,debug=q t/qualification/build-publication/nix-head-reader.ss "{{ profile }}"
