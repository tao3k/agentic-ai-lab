;;; Scenario definitions loaded through Python/C ABI; no downstream imports or compile.
(def catalog-observation-rules
  (ascent-fragment
    ((local_has_model F) <-- (local_failure_model F M))
    ((observed_model_registered M) <-- (model M D K))
    ((observed_model_registered M) <-- (protocol_model M D))
    ((observed_model_unregistered F M) <-- (observed_model_reference F M D) (not (observed_model_registered M)))
    ((local_has_model F) <-- (observed_model_reference F M D) (observed_model_registered M))
    ((local_failure_record F C S D) <-- (local_native_failure F C S D))
    ((local_failure_record F (lit 'assertion) S D) <-- (observed_failure F (lit 'assertion) S D K) (observed_process F E (lit #f) (lit #f)) (if (E) (> E 0)))
    ((local_failure_record F (lit 'budget) S D) <-- (observed_failure F (lit 'budget) S D K) (observed_process F E (lit #t) (lit #f)))
    ((local_failure_record F (lit 'signal) S D) <-- (observed_failure F (lit 'signal) S D K) (observed_process F E (lit #f) (lit #f)) (observed_signal F N) (if (E N) (= E (- N))))
    ((local_failure_record F (lit 'environment) S D) <-- (observed_failure F (lit 'environment) S D K) (observed_process F E T (lit #f)) (if (E) (not (= E 0))))
    ((observed_matched F) <-- (local_failure_record F C S D))
    ((observed_unmatched F) <-- (observed_failure F C S D K) (not (observed_matched F)))
    ((observed_present F K) <-- (observed_field F K D P V))
    ((observed_required F (lit 'original-budget)) <-- (observed_failure F C S D K))
    ((observed_required F (lit 'runtime-tree)) <-- (observed_failure F C S D K))
    ((observed_required F (lit 'producer)) <-- (observed_failure F C S D K))
    ((observed_required F (lit 'environment)) <-- (observed_failure F C S D K))
    ((observed_required F (lit 'topology)) <-- (observed_failure F C S D K))
    ((observed_required F (lit 'source-lock-sha)) <-- (observed_failure F C S D K))
    ((observed_required F (lit 'teardown)) <-- (observed_failure F C S D K))
    ((observed_required F (lit 'fixture-sha)) <-- (observed_failure F C S D (lit 'fixture)))
    ((observed_required F (lit 'operation)) <-- (observed_failure F C S D (lit 'build)))
    ((observed_required F (lit 'argv)) <-- (observed_failure F C S D (lit 'build)))
    ((observed_gap F K) <-- (observed_required F K) (not (observed_present F K)))
    ((observed_gap F (lit 'teardown)) <-- (observed_field F (lit 'teardown) D P (lit 'false)))
    ((local_needs_model F) <-- (local_failure_record F (lit 'assertion) S D) (not (local_has_model F)))
    ((local_environment F) <-- (local_failure_record F (lit 'environment) S D))
    ((local_budget F) <-- (local_failure_record F (lit 'budget) S D))
    ((local_has_control F) <-- (local_control_pass F K M D))
    ((local_budget_uncontrolled F) <-- (local_budget F) (not (local_has_control F)))
    ((local_signal F) <-- (local_failure_record F (lit 'signal) S D))
  ))
