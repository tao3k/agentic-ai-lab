;;; Model-host handoff only: fixture composition, module invocation and IO.
(import :clan/poo/object
        (only-in :std/crypto/digest sha256)
        (only-in :std/encoding/hex hex-encode)
        (only-in :std/misc/ports read-all-as-u8vector)
        (only-in "./init.ss" agentic-ai-lab/dev/d2.init.exports)
        "./examples/time-window/scenario.ss")
(export main)
(def Scope (.get agentic-ai-lab/dev/d2.init.exports modules d2))
(def (verify-artifact value path-slot digest-slot)
  (def filename (.ref value path-slot))
  (unless (equal? (.ref value digest-slot)
                 (hex-encode (sha256 (call-with-input-file filename read-all-as-u8vector))))
    (error "authoring observation has stale artifact bytes" filename)))
(def (verify-context-artifacts context-value)
  (for-each (lambda (proposal-value) (verify-artifact proposal-value 'asset-ref 'asset-sha))
            (.ref context-value 'proposals))
  (for-each (lambda (render-value) (verify-artifact render-value 'image-ref 'image-sha))
            (.ref context-value 'renders))
  (for-each (lambda (observation-value) (verify-artifact observation-value 'image-ref 'image-sha))
            (.ref context-value 'observations)))
(def (main (revision-name "r1") (output "dev/d2/output/authoring"))
  ((.get agentic-ai-lab/dev/d2.init.exports std-make-spec) '())
  (def revision-id (string->symbol revision-name))
  (def context-input (illustration-context Scope revision-id))
  (verify-context-artifacts context-input)
  (def result-value ((.get Scope author) context-input))
  (verify-context-artifacts context-input)
  ((.get agentic-ai-lab/dev/d2.init.exports admit-current))
  (create-directory* output)
  (call-with-output-file (list path: (path-expand (string-append revision-name "-requests.md") output) truncate: #t)
    (lambda (port)
      (display "# Model-host handoff: Context time-window explanation\n\n" port)
      (display "Audience: beginner. Diagram language: English only.\n" port)
      (display "Explain event-time versus known-time, competing hypotheses, and scoped retention.\n" port)
      (display "Semantic basis: dev/d2/context-evolution-example.ss and output/ascent-{early,later}.d2.\n" port)
      (display "Proposals and observations: dev/d2/examples/time-window/history.ss.\n\n" port)
      (display "## ASCENT requests\n\n" port)
      (for-each (lambda (request)
        (write (map (lambda (slot) (.ref request slot)) '(view revision source-cut kind subject basis)) port)
        (newline port)) (.ref result-value 'requests))
      (display "\n## Current explanation needs\n\n" port)
      (write ((.ref (.ref result-value 'plan) 'rows-of) 'ExplanationNeed) port)
      (display "\n\n## Reader questions\n\n" port)
      (for-each (lambda (question-value)
        (write (.ref question-value 'identity) port) (display ": " port)
        (display (.ref question-value 'text) port) (newline port)) (.ref context-input 'questions))
      (display "\n## Reviewable against the declared model questions\n\n" port)
      (write (.ref result-value 'reviewable) port) (newline port)
      (display "\nThis is model review, not measured pupil comprehension. New questions can reopen this cut.\n" port)))
  (displayln "Authoring " revision-name ": " (length (.ref result-value 'requests)) " requests; "
             (length (.ref result-value 'reviewable)) " reviewable images"))
