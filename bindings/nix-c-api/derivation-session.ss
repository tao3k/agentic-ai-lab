(import :clan/poo/object
        (only-in :yuanxu/ops/process-script ProcessScript.)
        (only-in :yuanxu/ops/progress call-with-execution-watchdog
                 execution-idle-seconds execution-total-seconds execution-progress!))
(export call-with-derivation-session query-derivation-session)

;; Nix's serialise.hh uses little-endian words and zero-padded UTF-8 strings.
(def max-text 1048576)
(def (read-bytes count port)
  (def bytes (make-u8vector count))
  (let loop ((start 0))
    (when (< start count)
      (let (read-count (read-subu8vector bytes start count port))
        (when (zero? read-count) (error "truncated Nix evaluation frame"))
        (loop (+ start read-count)))))
  bytes)
(def (write-word number port)
  (def bytes (make-u8vector 8))
  (let loop ((index 0) (rest number))
    (unless (= index 8)
      (u8vector-set! bytes index (bitwise-and rest #xff))
      (loop (+ index 1) (arithmetic-shift rest -8))))
  (write-subu8vector bytes 0 8 port))
(def (read-word port)
  (def bytes (read-bytes 8 port))
  (let loop ((index 7) (number 0))
    (if (< index 0) number
      (loop (- index 1) (+ (arithmetic-shift number 8) (u8vector-ref bytes index))))))
(def (padding count) (modulo (- count) 8))
(def (write-text bytes port)
  (def count (u8vector-length bytes))
  (write-word count port)
  (write-subu8vector bytes 0 count port)
  (def pad (padding count))
  (unless (zero? pad)
    (write-subu8vector (make-u8vector pad 0) 0 pad port)))
(def (read-text port)
  (def count (read-word port))
  (when (> count max-text) (error "Nix evaluation response exceeds wire limit"))
  (def bytes (read-bytes count port))
  (read-bytes (padding count) port)
  (utf8->string bytes))

(defstruct session (executable port owner environment directory progress-key queries active?) final: #t)
(def active-session (make-parameter #f))
(def (worker-for executable)
  ;; A caller selects the immutable paired tool output through its existing
  ;; instantiate setting. Unpaired commands follow ordinary CLI dispatch.
  (and (string? executable) (string-prefix? "/nix/store/" executable)
       (let (parts (string-split executable #\/))
         (and (= (length parts) 6)
              (equal? (list-tail parts 4) '("bin" "nix-instantiate"))
              (equal? (path-normalize executable) executable)
              (let (worker (path-expand "nix-derivation-worker" (path-directory executable)))
                (and (file-exists? worker) worker))))))

(def (call-with-derivation-session executable watchdog action)
  (let (worker (worker-for executable))
    (if (not worker) (action)
      (let ((environment (get-environment-variables)) (directory (current-directory)))
        (def script (.cc ProcessScript. command: (list worker)
                         timeout: execution-total-seconds timeout-program: watchdog))
        (.call script .with-process
          (lambda (port)
            (unless (= (call-with-execution-watchdog (* 1000 execution-idle-seconds) #f
                         (lambda () (read-word port))) 1)
              (error "unsupported Nix evaluator protocol"))
            (def scope (make-session executable port (current-thread) environment directory
                                     (gensym 'nix-evaluation) 0 #t))
            (begin0
              (dynamic-wind void
                (lambda () (parameterize ((active-session scope)) (action)))
                (lambda () (session-active?-set! scope #f)))
              (write-word 0 port)
              (force-output port))))))))

(def (query-derivation-session executable expression arguments)
  (def scope (active-session))
  (and scope
       (session-active? scope)
       (eq? (session-owner scope) (current-thread))
       (equal? executable (session-executable scope))
       (equal? (get-environment-variables) (session-environment scope))
       (equal? (current-directory) (session-directory scope))
       (not (or (string-empty? expression) (equal? expression "-")))
       (let* ((names (.all-slots arguments))
              (strings (cons expression
                         (foldr (lambda (name rest)
                                  (cons (symbol->string name)
                                    (cons (.ref arguments name) rest))) '() names))))
         (and (<= (length names) 128)
              (not (ormap (lambda (text) (string-index text #\nul)) strings))
              (let (fields (map string->utf8 strings))
                (and (<= (foldl (lambda (field count) (+ (u8vector-length field) count))
                               0 fields) max-text)
                     (call-with-execution-watchdog
                       (* 1000 execution-idle-seconds) (* 1000 execution-total-seconds)
                       (lambda ()
                         (def port (session-port scope))
                         (write-word 1 port)
                         (write-text (car fields) port)
                         (write-word (length names) port)
                         (for-each (lambda (field) (write-text field port)) (cdr fields))
                         (force-output port)
                         (def status (read-word port))
                         (def result (read-text port))
                         (unless (and (zero? status) (string-prefix? "/nix/store/" result))
                           (error "Nix derivation query refused" result))
                         (def count (+ 1 (session-queries scope)))
                         (session-queries-set! scope count)
                         (execution-progress! (session-progress-key scope) count)
                         result))))))))
