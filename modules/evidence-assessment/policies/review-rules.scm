;; Finite snapshot review, distinct from the sealed native retry safety policy.
(ascent-fragment
  (relation Candidate ((candidate symbol?) (scope symbol?) (identity symbol?)))
  (relation Failure ((failure symbol?) (scope symbol?) (identity symbol?) (report symbol?)))
  (relation Passed ((receipt symbol?) (claim symbol?)))
  (relation ReceiptInput ((receipt symbol?) (key symbol?) (identity symbol?)))
  (relation CurrentInput ((key symbol?) (identity symbol?)))
  (relation ReceiptDepends ((receipt symbol?) (dependency symbol?)))
  (relation Requires ((candidate symbol?) (claim symbol?)))
  (relation ClaimDepends ((claim symbol?) (dependency symbol?)))
  (relation Cause ((candidate symbol?) (failure symbol?) (receipt symbol?)))
  (relation PassedId ((receipt symbol?)))
  (relation Bound ((receipt symbol?)))
  (relation Bad ((receipt symbol?)))
  (relation Claim ((claim symbol?)))
  (relation HasRequirement ((candidate symbol?)))
  (relation Relevant ((candidate symbol?) (failure symbol?) (identity symbol?) (report symbol?)))
  (relation HasCause ((candidate symbol?) (failure symbol?)))
  (relation KnownFailure ((candidate symbol?) (failure symbol?) (report symbol?)))
  (relation Established ((claim symbol?) (receipt symbol?)))
  (relation Reusable ((receipt symbol?) (claim symbol?)))
  (relation Missing ((candidate symbol?) (claim symbol?)))
  (relation Unusable ((receipt symbol?) (reason symbol?)))
  (relation Denial ((candidate symbol?) (reason symbol?)))
  (relation Need ((candidate symbol?) (claim symbol?)))
  (relation ReceiptPath ((receipt symbol?) (dependency symbol?)))
  (relation CausalEvidence ((candidate symbol?) (failure symbol?) (receipt symbol?)))
  (relation DeniedCandidate ((candidate symbol?)))
  (relation Decision ((candidate symbol?) (decision symbol?)))
  ((PassedId R) <-- (Passed R P))
  ((Bound R) <-- (ReceiptInput R K V))
  ((ReceiptPath R D) <-- (ReceiptDepends R D))
  ((ReceiptPath R D) <-- (ReceiptPath R X) (ReceiptDepends X D))
  ((Unusable R (lit 'unbound-inputs)) <-- (PassedId R) (not (Bound R)))
  ((Unusable R (lit 'stale-or-missing-input)) <-- (ReceiptInput R K V) (not (CurrentInput K V)))
  ((Unusable R (lit 'missing-dependency)) <-- (ReceiptPath R D) (not (PassedId D)))
  ((Unusable R (lit 'circular-justification)) <-- (ReceiptPath R R))
  ((Unusable R "invalid-dependency") <-- (ReceiptPath R D) (Unusable D Reason))
  ((Bad R) <-- (Unusable R Reason))
  ((Reusable R P) <-- (Passed R P) (not (Bad R)))
  ((Established P R) <-- (Reusable R P))
  ((Claim P) <-- (Established P R))
  ((Need C P) <-- (Requires C P))
  ((Need C Q) <-- (Need C P) (ClaimDepends P Q))
  ((HasRequirement C) <-- (Requires C P))
  ((Missing C P) <-- (Need C P) (not (Claim P)))
  ((Relevant C F I Report) <-- (Candidate C S CI) (Failure F S I Report))
  ((KnownFailure C F Report) <-- (Relevant C F I Report))
  ((CausalEvidence C F R) <-- (Cause C F R) (Reusable R P))
  ((HasCause C F) <-- (CausalEvidence C F R))
  ((Denial C (lit 'unchanged-failed-inputs)) <-- (Candidate C S I) (Failure F S I Report))
  ((Denial C (lit 'missing-causal-evidence)) <-- (Relevant C F I Report) (not (HasCause C F)))
  ((Denial C (lit 'missing-premise)) <-- (Missing C P))
  ((Denial C (lit 'missing-requirement-set)) <-- (Candidate C S I) (not (HasRequirement C)))
  ((DeniedCandidate C) <-- (Denial C Reason))
  ((Decision C (lit 'DENY)) <-- (Candidate C S I) (DeniedCandidate C))
  ((Decision C (lit 'REVIEW_REQUIRED)) <-- (Candidate C S I) (not (DeniedCandidate C))))
