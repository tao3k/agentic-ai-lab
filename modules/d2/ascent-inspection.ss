;;; -*- Gerbil -*-
;;; SPDX-FileCopyrightText: 2026 tao3k team and Contributors
;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Infer explanation/representation/layout changes from image-grounded findings.
;;; No favorable verdict is an input. Semantic correspondence is a model claim;
;;; the host independently measures anchors in the actual rendered document.
(import (only-in :clan/poo/object .o .ref .slot?)
        (only-in :gerbil-ascent/program/syntax ascent)
        (only-in :gerbil-ascent/program/interface gerbil-ascent-evaluate-program))
(export d2-inspection)
(def (inspection-rows values slots)
  (map (lambda (value) (map (lambda (slot) (.ref value slot)) slots)) values))
(def (d2-inspection context-value current-images)
  (gerbil-ascent-evaluate-program
   (ascent
    (relation CurrentImage (v r cut p asset image) current-images)
    (relation View (v r cut audience)
      (inspection-rows (.ref context-value 'views) '(identity revision source-cut audience)))
    (relation Question (q audience subject)
      (inspection-rows (.ref context-value 'questions) '(identity audience subject)))
    (relation Need (q facet target)
      (inspection-rows (.ref context-value 'facet-needs) '(question facet target)))
    (relation Inspection (i v r cut image q producer)
      (inspection-rows (.ref context-value 'inspections)
        '(identity view revision source-cut image-sha question producer)))
    (relation Evidence (i facet anchor excerpt)
      (inspection-rows (.ref context-value 'image-evidence) '(inspection facet anchor excerpt)))
    (relation Anchor (image anchor excerpt left top right bottom)
      (inspection-rows (.ref context-value 'image-anchors)
        '(image-sha identity text left top right bottom)))
    (relation AnchorScope (image anchor owner facet target)
      (inspection-rows (filter (lambda (a)
          (and (.slot? a 'owner) (.slot? a 'facet) (.slot? a 'target)))
        (.ref context-value 'image-anchors)) '(image-sha identity owner facet target)))
    (relation TextSize (image anchor size)
      (inspection-rows (filter (lambda (a) (.slot? a 'font-size)) (.ref context-value 'image-anchors))
        '(image-sha identity font-size)))
    (relation MinimumText (size) (list (list (.ref context-value 'minimum-reader-text))))
    (relation ChangeTextSize (v r p image q anchor))
    (relation Expression (expr owner q facet target kind token role quantity)
      (inspection-rows (map (lambda (e) (.o (:: @ e) owner:
        (let (value (.ref e 'owner)) (if (symbol? value) (symbol->string value) value))))
        (.ref context-value 'visual-expressions))
        '(identity owner question facet target kind token role-label quantity-label)))
    (relation AnchorExpression (image anchor expr)
      (inspection-rows (filter (lambda (a) (.slot? a 'expression)) (.ref context-value 'image-anchors))
        '(image-sha identity expression)))
    (relation NumericAnchor (image anchor)
      (map (lambda (a) (list (.ref a 'image-sha) (.ref a 'identity)))
        (filter (lambda (a) (number? (string->number (.ref a 'text)))) (.ref context-value 'image-anchors))))
    (relation BoundNumber (image anchor))
    (relation ReviewedNumber (v r p image q anchor))
    (relation WantedLabel (expr owner q facet target text))
    (relation SeenLabel (image expr text))
    (relation ChangeMeaning (v r p image q target reason))
    (relation RepresentationGap (i facet target reason)
      (inspection-rows (.ref context-value 'representation-gaps) '(inspection facet target reason)))
    (relation LayoutConcern (i first second)
      (inspection-rows (.ref context-value 'layout-concerns) '(inspection first second)))
    (relation StructureGap (q target reason)
      (inspection-rows (.ref context-value 'structure-gaps) '(question target reason)))
    (relation RouteNeed (q edge from to stretch)
      (inspection-rows (.ref context-value 'route-needs) '(question edge from to maximum-stretch)))
    (relation Route (image edge from to length direct)
      (inspection-rows (.ref context-value 'image-routes) '(image-sha identity from to length direct)))
    (relation BoundInspection (v r p image q i))
    (relation Inspected (v r p image q))
    (relation HasNeed (q))
    (relation GroundedFacet (v r p image q facet anchor))
    (relation ScopedAnchor (image anchor))
    (relation FacetAnchor (image anchor facet target))
    (relation Covered (v r p image q facet))
    (relation MissingFacet (v r p image q target facet))
    (relation MissingInventory (v r p image q))
    (relation ChangeRepresentation (v r p image q target facet reason))
    (relation ChangeLayout (v r p image q first second))
    (relation ChangeStructure (v r p image q target reason))
    (relation ChangeRoute (v r p image q edge))
    (relation MeasuredRoute (image edge from to))
    (relation MissingRoute (v r p image q edge))
    (relation Blocked (v r p image q))
    (relation AnswerBasis (v r p image q))
    ((BoundInspection V R P Image Q I) <-- (CurrentImage V R C P Asset Image)
      (View V R C A) (Question Q A Subject) (Inspection I V R C Image Q Producer))
    ((ChangeTextSize V R P Image Q AnchorId) <-- (CurrentImage V R C P Asset Image)
      (View V R C A) (Question Q A Subject) (Need Q Facet Target)
      (AnchorScope Image AnchorId Owner Facet Target) (TextSize Image AnchorId Size)
      (MinimumText Minimum) (if (Size Minimum) (< Size Minimum)))
    ((WantedLabel E Owner Q Facet Target Token) <-- (Expression E Owner Q Facet Target Kind Token Role Quantity))
    ((WantedLabel E Owner Q Facet Target Role) <-- (Expression E Owner Q Facet Target Kind Token Role Quantity))
    ((WantedLabel E Owner Q Facet Target Quantity) <-- (Expression E Owner Q Facet Target Kind Token Role Quantity))
    ;; Labels may be shared within an object (for example an axis or a field
    ;; heading); no fixed local template or repetition per number is required.
    ((SeenLabel Image E Text) <-- (Expression E Owner Q Facet Target Kind Token Role Quantity)
      (AnchorScope Image A Owner Facet Target)
      (Anchor Image A Text L T R B))
    ((BoundNumber Image A) <-- (Expression E Owner Q Facet Target Kind Token Role Quantity)
      (AnchorExpression Image A E) (AnchorScope Image A Owner Facet Target)
      (Anchor Image A Token L T R B))
    ((ReviewedNumber V R P Image Q A) <-- (BoundInspection V R P Image Q I)
      (Need Q Facet Target) (Evidence I Facet A Token) (BoundNumber Image A)
      (AnchorScope Image A Owner Facet Target) (Anchor Image A Token Left Top Right Bottom))
    ((ChangeMeaning V R P Image Q E Label) <-- (CurrentImage V R C P Asset Image)
      (View V R C Audience) (Question Q Audience Subject) (WantedLabel E Owner Q Facet Target Label)
      (not (SeenLabel Image E Label)))
    ((ChangeMeaning V R P Image Q A (lit 'unbound-number)) <-- (CurrentImage V R C P Asset Image)
      (View V R C Audience) (Question Q Audience Subject) (Need Q Facet Target)
      (AnchorScope Image A Owner Facet Target) (NumericAnchor Image A) (not (BoundNumber Image A)))
    ((ChangeMeaning V R P Image Q A (lit 'read-the-number-with-its-reference)) <-- (CurrentImage V R C P Asset Image)
      (View V R C Audience) (Question Q Audience Subject) (Need Q Facet Target)
      (AnchorScope Image A Owner Facet Target) (NumericAnchor Image A) (BoundNumber Image A)
      (not (ReviewedNumber V R P Image Q A)))
    ((Inspected V R P Image Q) <-- (BoundInspection V R P Image Q I))
    ((ChangeStructure V R P Image Q Target Reason) <-- (CurrentImage V R C P Asset Image)
      (View V R C A) (Question Q A Subject) (StructureGap Q Target Reason))
    ((ChangeRoute V R P Image Q Edge) <-- (CurrentImage V R C P Asset Image)
      (View V R C A) (Question Q A Subject) (RouteNeed Q Edge From To Maximum)
      (Route Image Edge From To Length Direct)
      (if (Length Direct Maximum) (and (> Direct 0) (> Length (* Direct Maximum)))))
    ((MeasuredRoute Image Edge From To) <-- (Route Image Edge From To Length Direct))
    ((MissingRoute V R P Image Q Edge) <-- (CurrentImage V R C P Asset Image)
      (View V R C A) (Question Q A Subject) (RouteNeed Q Edge From To Maximum)
      (not (MeasuredRoute Image Edge From To)))
    ((HasNeed Q) <-- (Need Q Facet Target))
    ((ScopedAnchor Image A) <-- (AnchorScope Image A Owner Facet Target))
    ((FacetAnchor Image A Facet Target) <-- (AnchorScope Image A Owner Facet Target))
    ((FacetAnchor Image A Facet Target) <-- (Need Q Facet Target)
      (Anchor Image A Text L T Right Bottom) (not (ScopedAnchor Image A)))
    ((GroundedFacet V R P Image Q Facet AnchorId) <--
      (BoundInspection V R P Image Q I) (Need Q Facet Target)
      (Evidence I Facet AnchorId Excerpt) (Anchor Image AnchorId Excerpt L T Right Bottom)
      (FacetAnchor Image AnchorId Facet Target))
    ((Covered V R P Image Q Facet) <-- (GroundedFacet V R P Image Q Facet AnchorId))
    ((MissingFacet V R P Image Q Target Facet) <-- (Inspected V R P Image Q)
      (Need Q Facet Target) (not (Covered V R P Image Q Facet)))
    ((MissingInventory V R P Image Q) <-- (Inspected V R P Image Q) (not (HasNeed Q)))
    ((ChangeRepresentation V R P Image Q Target Facet Reason) <--
      (BoundInspection V R P Image Q I) (RepresentationGap I Facet Target Reason))
    ((ChangeLayout V R P Image Q First Second) <-- (BoundInspection V R P Image Q I)
      (LayoutConcern I First Second)
      (Anchor Image First Text1 L1 T1 R1 B1) (Anchor Image Second Text2 L2 T2 R2 B2)
      (if (L1 T1 R1 B1 L2 T2 R2 B2) (and (< L1 R2) (< L2 R1) (< T1 B2) (< T2 B1))))
    ;; When the host captures a teaching scope, the measured geometry itself
    ;; exposes collisions. No model-authored "pass" or enumerated collision
    ;; list is needed. Scope to the question's actual native target and facet.
    ((ChangeLayout V R P Image Q First Second) <-- (Inspected V R P Image Q)
      (Need Q Facet Target)
      (AnchorScope Image First Owner Facet Target) (AnchorScope Image Second Owner OtherFacet OtherTarget)
      (Need Q OtherFacet OtherTarget)
      (if (First Second) (string<? First Second))
      (Anchor Image First Text1 L1 T1 R1 B1) (Anchor Image Second Text2 L2 T2 R2 B2)
      (if (L1 T1 R1 B1 L2 T2 R2 B2) (and (< L1 R2) (< L2 R1) (< T1 B2) (< T2 B1))))
    ((Blocked V R P Image Q) <-- (MissingFacet V R P Image Q Target Facet))
    ((Blocked V R P Image Q) <-- (MissingInventory V R P Image Q))
    ((Blocked V R P Image Q) <-- (ChangeRepresentation V R P Image Q Target Facet Reason))
    ((Blocked V R P Image Q) <-- (ChangeLayout V R P Image Q First Second))
    ((Blocked V R P Image Q) <-- (ChangeStructure V R P Image Q Target Reason))
    ((Blocked V R P Image Q) <-- (ChangeRoute V R P Image Q Edge))
    ((Blocked V R P Image Q) <-- (MissingRoute V R P Image Q Edge))
    ((Blocked V R P Image Q) <-- (ChangeTextSize V R P Image Q AnchorId))
    ((Blocked V R P Image Q) <-- (ChangeMeaning V R P Image Q Target Reason))
    ;; A scoped basis for the model's answer, not "a pupil understood". Both
    ;; contrary observations and missing requirements remain independently open.
    ((AnswerBasis V R P Image Q) <-- (Inspected V R P Image Q) (HasNeed Q)
      (not (Blocked V R P Image Q)))
    (bounds 1024 8192 16384))))
