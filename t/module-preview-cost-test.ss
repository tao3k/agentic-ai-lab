;;; One dataflow cohort. Instrumented timings are diagnostic, not capacity gates.
(import :std/test :clan/poo/object
        (only-in :std/error Error-message)
        (only-in :clan/poo/declarative-metadata failure? failure-phase failure-cause)
        (only-in :clan/poo/type Record String)
        (only-in :clan/poo/object-contract diagnose)
        (only-in :clan/poo/slot-observation %call-with-recorded-slot-reads
                 call-with-slot-read-observer slot-read-dependencies slot-read-receiver slot-read-key)
        (only-in :yuanxu/observability/testing-case yuanxu-test-case)
        (only-in :yuanxu/observability/testing-fixture yuanxu-test-fixture)
        (only-in :yuanxu/observability/memory yuanxu-debug-memory-snapshot)
        (only-in :yuanxu/module-system/source/admission current-module-source-observer module-source-read
                 current-module-source-phase call-with-module-source-operation-measurement)
        (only-in "../core/t/qualification/testing/directory.ss" write-source)
        (only-in "../core/t/qualification/service-publication/fixtures.ss" ServicesFixture refused)
        :agentic-ai-lab/modules/module-authoring/module-interface
        :agentic-ai-lab/modules/module-authoring/module-descriptor
        :agentic-ai-lab/modules/workflow/scenario/configuration/module-runtime-presentation
        (only-in :agentic-ai-lab/modules/workflow/scenario/configuration/doctor-presentation
                 agenticAiLabModuleDoctorPresentation)
        :yuanxu/module-system/catalog/values)
(export module-preview-cost-test)

;; Walk original records, preserving all edge occurrences. Identity sets are
;; measurement scratch, never replay caches; no observer delivery is suppressed.
(def (read-census roots weak)
  (def seen (make-hash-table-eq))
  (def owners (make-hash-table-eq))
  (def edges 0)
  (def (visit read)
    (unless (hash-key? seen read)
      (check-equal? (object-read-issued? read) #t)
      (hash-put! seen read #t)
      (hash-put! weak read #t)
      (hash-put! owners (slot-read-receiver read) #t)
      (let (children (slot-read-dependencies read))
        (set! edges (+ edges (length children)))
        (for-each visit children))))
  (for-each visit roots)
  (list (length roots) (hash-length seen) edges (hash-length owners)))

(def (cohort label root checked after-preview)
  (def productions 0)
  (def closure-access-seconds 0.)
  (def weak (make-hash-table test: eq? weak-keys: #t))
  (def baseline (yuanxu-debug-memory-snapshot 'before-preview collect?: #t))
  (def (count-production modules) (set! productions (+ productions 1)) modules)
  (def (preview)
    (def evaluation (agentic-ai-lab-module-evaluate root))
    (.def (observed @ evaluation) (modules => count-production))
    (.def (workflow @ (agentic-ai-lab-module-workflow root)) evaluation: observed)
    (.def (doctor @ (agenticAiLabModuleDoctorPresentation
                      (yuanxuModuleCatalog root) (agentic-ai-lab-module-name root)))
      evaluation: observed)
    (.o flow: workflow report: doctor))
  (def (consume bundle)
    (def flow (.get bundle flow))
    (def report (.get bundle report))
    (let (started (real-time))
      (.get flow evaluation modules)
      (set! closure-access-seconds (- (real-time) started)))
    (.get flow evaluation module-ids)
    (.get flow evaluation init-module-ids)
    (.get flow evaluation config-module-ids)
    (.get flow evaluation hooks)
    (.get flow evaluation extensions)
    (.get flow evaluation scripts)
    (.get flow evaluation options)
    (.get flow root-validation-receipts)
    (.get flow validation-receipts)
    (.get report doctor-status)
    (.get report diagnostics)
    (.get report import-graph)
    (.get report contributions)
    (.get report validation-receipt-count)
    ;; Cached preview data never replaces independent source admission.
    (after-preview)
    (void))
  (def (phase name bundle)
    (def deliveries 0)
    (def files 0)
    (def replay-visits 0)
    (def replay-seconds 0.)
    (def replay-starts '())
    ;; Attribute the existing production events; these tables are diagnostics,
    ;; not an observation cache or a replacement for any source guard.
    (def stages '())
    (def windows '())
    (def next-window 0)
    (def attribution (make-hash-table))
    (def window-work (make-hash-table))
    (def window-paths (make-hash-table-eqv))
    (def (window-id) (if (null? windows) 0 (car windows)))
    (def (attribute kind amount)
      (hash-update! window-work (cons (window-id) kind) (cut + <> amount) 0)
      (hash-update! attribution
        (list (reverse stages) (current-module-source-phase)
              (window-id) kind)
        (cut + <> amount) 0))
    (def previous (current-module-source-observer))
    (def (source-observer key amount)
      (cond
       ((and (pair? key) (eq? (car key) 'admission-stage-start))
        (set! stages (cons (cadr key) stages)))
       ((and (pair? key) (eq? (car key) 'admission-stage-end))
        (unless (eq? (car stages) (cadr key)) (error "unbalanced publication trace" key))
        (set! stages (cdr stages)))
       ((eq? key 'read-windows)
        (set! next-window (+ next-window 1))
        (set! windows (cons next-window windows))
        (attribute 'window-start 1))
       ((eq? key 'check-seconds)
        (attribute 'window-end 1)
        (set! windows (cdr windows)))
       ((eq? key 'metadata-replay-visits)
        (attribute 'replay-visits amount)
        (set! replay-visits (+ replay-visits amount)))
       ((and (pair? key) (eq? (car key) 'metadata-replay-start))
        (set! replay-starts (cons (real-time) replay-starts)))
       ((and (pair? key) (eq? (car key) 'metadata-replay-end))
        (set! replay-seconds (+ replay-seconds (- (real-time) (car replay-starts))))
        (set! replay-starts (cdr replay-starts)))
       ((and (pair? key) (eq? (car key) 'file-read))
        (let (paths (or (hash-get window-paths (window-id))
                       (let (fresh (make-hash-table))
                         (hash-put! window-paths (window-id) fresh) fresh)))
          (hash-put! paths (caddr key) #t))
        (attribute 'file-reads amount)
        (set! files (+ files amount)))
       ((and (pair? key) (eq? (car key) 'file-request))
        (attribute 'byte-requests amount)))
      (when previous (previous key amount)))
    (def before-productions productions)
    (def before-checks (checked))
    (def observed-reads '())
    (defvalues (stats operations)
      (call-with-module-source-operation-measurement
       (lambda () (##exec-stats
        (lambda ()
          (defvalues (_ reads)
            (call-with-slot-read-observer
              (lambda (_) (set! deliveries (+ deliveries 1)))
              (lambda ()
                (parameterize ((current-module-source-observer source-observer))
                  (%call-with-recorded-slot-reads (lambda () (consume bundle)))))))
          (set! observed-reads reads))))))
    ;; Census traversal is outside workload timing and source observation.
    (def graph (read-census observed-reads weak))
    (check-equal? stages '())
    (check-equal? windows '())
    (hash-for-each
      (lambda (key amount)
        (displayln (object->string (list 'PREVIEW-ATTRIBUTION label name key amount))))
      attribution)
    (do ((window 0 (+ window 1))) ((> window next-window))
      (def reads (or (hash-get window-work (cons window 'file-reads)) 0))
      (def paths (hash-get window-paths window))
      (def unique (if paths (hash-length paths) 0))
      ;; Window zero contains separated, unscoped entry/exit observations;
      ;; it is NOT one pure window and may legitimately read the same path again.
      (when (> window 0) (check-equal? reads unique))
      (displayln (object->string
        (list 'PREVIEW-WINDOW label name window
              (cons 'reads reads) (cons 'unique-paths unique)
              (cons 'requests (or (hash-get window-work (cons window 'byte-requests)) 0))
              (cons 'replay-visits (or (hash-get window-work (cons window 'replay-visits)) 0))))))
    (write (list 'PREVIEW-COST label name
             (cons 'closure-productions (- productions before-productions))
             (cons 'closure-access-wall closure-access-seconds)
             (cons 'record-diagnoses (- (checked) before-checks))
             (cons 'observer-deliveries deliveries) (cons 'source-reads files)
             (cons 'metadata-replay-visits replay-visits)
             (cons 'metadata-replay-wall replay-seconds)
             (cons 'roots-records-edges-receivers graph)
             (cons 'source-operations (hash->list operations))
             (cons 'wall (cdr (assq 'real-time stats)))
             (cons 'cpu (+ (cdr (assq 'user-time stats)) (cdr (assq 'sys-time stats))))
             (cons 'gc-wall (cdr (assq 'gc-real-time stats)))
             (cons 'gc-cpu (+ (cdr (assq 'gc-user-time stats))
                              (cdr (assq 'gc-sys-time stats))))
             (cons 'collections (cdr (assq 'nb-gcs stats)))
             (cons 'minor-faults (cdr (assq 'minflt stats)))
             (cons 'major-faults (cdr (assq 'majflt stats)))
             (cons 'vm-account-not-owned-bytes (cdr (assq 'bytes-allocated stats)))))
    (newline))
  (def first (preview))
  (check-equal? productions 0)
  (phase 'cold first)
  (check-equal? productions 1)
  (def cold-checks (checked))
  (phase 'hot first)
  (check-equal? productions 1)
  (check-equal? (checked) cold-checks)
  (phase 'fresh (preview))
  (check-equal? productions 2)
  (check-equal? (> (checked) cold-checks) #t)
  ;; Sample outside the recording frame. Only weak keys retain the census:
  ;; collectors cannot keep an otherwise dead preview alive through this table.
  (def resident (yuanxu-debug-memory-snapshot 'preview-resident collect?: #t))
  ;; Keep the preview strongly reachable THROUGH the residency sample, rather
  ;; than depending on the compiler's treatment of dead local variables.
  (check-equal? (length (.get first flow evaluation modules))
                (length (.get first report evaluation modules)))
  (write (list 'PREVIEW-RESIDENCY label
           (cons 'weak-live-records (hash-length weak))
           (cons 'process-live-before (.ref baseline 'live-bytes))
           (cons 'process-live-after (.ref resident 'live-bytes))))
  (newline)
  ;; Return weak ownership observations only, not bundles or captured reads.
  weak)

(def (scale-cohort size)
  (def analyses 0)
  (def shape (Record value: [String]))
  (.def (declaration @ shape)
    .diagnose: (lambda (candidate path)
                 (set! analyses (+ analyses 1)) (diagnose shape candidate path)))
  (def interface (yuanxu-module-interface "PreviewScale" declaration '()))
  (def modules
    (let loop ((index 0) (result '()))
      (if (= index size) (reverse result)
        (loop (+ index 1)
          (cons (agentic-ai-lab-modules interface
                  (.o id: (string->symbol (string-append "preview-" (number->string index)))
                      config: (.o value: "configured"))) result)))))
  ;; A shared last leaf exercises identity deduplication without repeating SDK
  ;; charges. These are real product descriptors, not Loader capacity fixtures.
  (.def (root @ (car modules)) imports: (append (cdr modules) (list (car (reverse modules)))))
  (cohort size root (lambda () analyses) void))

(def module-preview-cost-test
  (test-suite "Unified preview cold hot fresh ownership"
    (yuanxu-test-case "16 and 32 product descriptors share one preview dataflow"
      (def preceding #f)
      (for-each
        (lambda (size)
          (def weak (scale-cohort size))
          (yuanxu-debug-memory-snapshot 'completed-cohort collect?: #t)
          (write (list 'PREVIEW-RELEASE size
                   (cons 'weak-live-records (hash-length weak))
                   (cons 'shared-with-preceding
                     (if preceding
                       (length (filter (cut hash-key? preceding <>) (hash-keys weak))) 0))
                   (cons 'remaining-key-heads
                     (map (lambda (read)
                            (let (key (slot-read-key read)) (if (pair? key) (car key) key)))
                          (hash-keys weak)))))
          (newline)
          (set! preceding weak))
        '(16 32)))
    (yuanxu-test-fixture "real service publication remains independent of preview reuse"
      (fixture ServicesFixture)
      (def publication (.get fixture publication))
      (def parent (.get publication value))
      (def cached (.get parent plan))
      (.def (release @ parent)
        config: =>.+ (.o postgresql: =>.+ (.o settings: =>.+ (.o port: 5433))))
      (def analyses 0)
      (def shape (Record application: [(.get publication contract value-contract)]))
      (.def (declaration @ shape)
        .diagnose: (lambda (candidate path)
                     (set! analyses (+ analyses 1)) (diagnose shape candidate path)))
      (def module
        (agentic-ai-lab-modules (yuanxu-module-interface "ServiceCost" declaration '())
          (.o id: 'services config: (.o application: release))))
      (def admissions 0)
      (def (admit)
        (defvalues (receipt next failure) (.call publication .publish parent release))
        (check-equal? failure #f)
        (check-equal? (.get receipt accepted?) #t)
        (check-equal? (.get next plan postgresql port) 5433)
        (check-equal? (.get next plan gitea database-port) 5433)
        (check-equal? (length (.get publication context contributions)) 2)
        (check-equal? (.get cached postgresql port) 5432)
        (check-equal? (eq? cached (.get parent plan)) #t)
        (set! admissions (+ admissions 1)))
      (cohort 'services module (lambda () analyses) admit)
      (check-equal? admissions 3)
      (def path (path-expand "modules/services/postgresql/postgresql.json" (.get fixture source)))
      ;; Real runtime invocation extension: an inner meaning callback checks
      ;; currentness, THEN changes a selected source. The outer return meaning
      ;; must independently reject it rather than reuse the earlier success.
      (def original-invocation (.get publication invocation))
      (def original-meaning (.get original-invocation meaning))
      (def meaning-calls 0)
      (def original-json (module-source-read path))
      (.def (changed-invocation @ original-invocation)
        meaning:
        (lambda (key request evidence)
          (when (eq? key 'context-current) (set! meaning-calls (+ meaning-calls 1)))
          (def result (original-meaning key request evidence))
          (when (and (eq? key 'context-current) (= meaning-calls 1))
            (write-source path (string-append original-json "\n")))
          result))
      (.def (changed-publication @ publication) invocation: changed-invocation)
      (defvalues (evidence retained failure) (.call changed-publication .publish parent release))
      (check-equal? evidence #f)
      (check-equal? (eq? retained parent) #t)
      (check-equal? (failure? failure) #t)
      (check-equal? (failure-phase failure) 'logic)
      (check-equal? (Error-message (failure-cause failure)) "selected configuration asset changed")
      (check-equal? meaning-calls 2)
      (refused publication parent release "selected configuration asset changed"))))
