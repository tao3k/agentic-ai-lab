;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Independent exact grader: direct edges and integer subset DP only.
;;; No ASCENT receipt, closure, proof or cache functions are used here.
(def (budget-oracle direct durations weights)
  (let* ((n (length durations)) (size (arithmetic-shift 1 n))
         (cost (make-vector size #f)) (counts (make-vector size 0))
         (clocks (make-vector size 0)) (previous (make-vector size #f))
         (preds (make-vector n 0)))
    (unless (and (<= 1 n 16) (= n (length weights))
                 (andmap (lambda (x) (and (exact-integer? x) (> x 0))) durations)
                 (andmap (lambda (x) (and (exact-integer? x) (> x 0))) weights))
      (error "unsupported grader task"))
    (for-each (lambda (e)
      (when (and (< (car e) n) (< (cadr e) n))
        (vector-set! preds (cadr e)
          (bitwise-ior (vector-ref preds (cadr e)) (arithmetic-shift 1 (car e)))))) direct)
    (vector-set! cost 0 0) (vector-set! counts 0 1)
    (let masks ((mask 0))
      (when (< mask size)
        ;; Elapsed time depends only on the scheduled subset, not its order.
        (let jobs ((j 0))
          (when (< j n)
            (let* ((bit (arithmetic-shift 1 j)) (next (bitwise-ior mask bit))
                   (required (vector-ref preds j)))
              (when (and (= 0 (bitwise-and mask bit)) (vector-ref cost mask)
                         (= required (bitwise-and mask required)))
                (let* ((clock (+ (vector-ref clocks mask) (list-ref durations j)))
                       (value (+ (vector-ref cost mask) (* clock (list-ref weights j))))
                       (old (vector-ref cost next)))
                  (vector-set! clocks next clock)
                  (vector-set! counts next (+ (vector-ref counts next) (vector-ref counts mask)))
                  (when (or (not old) (< value old))
                    (vector-set! cost next value) (vector-set! previous next (cons mask j))))))
            (jobs (+ j 1))))
        (masks (+ mask 1))))
    (let recover ((mask (- size 1)) (order []))
      (if (= mask 0)
        (hash ("optimum" (vector-ref cost (- size 1)))
              ("optimalOrder" order) ("feasibleOrders" (vector-ref counts (- size 1)))
              ("subsetStates" size))
        (let (p (vector-ref previous mask))
          (if p (recover (car p) (cons (cdr p) order))
            (hash ("optimum" #f) ("optimalOrder" []) ("feasibleOrders" 0) ("subsetStates" size))))))))

;;; Fixed adjacent-pair penalties make local priority rules insufficient.
;;; Clock still depends on the subset; continuation cost also depends on last.
(def (budget-transition-oracle direct durations weights penalties)
  (if (null? penalties) (budget-oracle direct durations weights)
    (let* ((n (length durations)) (size (arithmetic-shift 1 n))
           (cells (* size n)) (cost (make-vector cells #f))
           (previous (make-vector cells #f)) (clocks (make-vector size 0))
           (preds (make-vector n 0)) (best #f) (best-index #f)
           (base (budget-oracle direct durations weights)))
      (unless (and (= (length penalties) n)
                   (andmap (lambda (row)
                     (and (= (length row) n)
                          (andmap (lambda (x) (and (exact-integer? x) (>= x 0))) row))) penalties))
        (error "invalid transition matrix"))
      (for-each (lambda (e)
        (when (and (< (car e) n) (< (cadr e) n))
          (vector-set! preds (cadr e)
            (bitwise-ior (vector-ref preds (cadr e)) (arithmetic-shift 1 (car e)))))) direct)
      (for-each (lambda (j)
        (when (= 0 (vector-ref preds j))
          (let* ((mask (arithmetic-shift 1 j)) (clock (list-ref durations j)))
            (vector-set! clocks mask clock)
            (vector-set! cost (+ (* mask n) j) (* clock (list-ref weights j)))))) (iota n))
      (let masks ((mask 1))
        (when (< mask size)
          (let lasts ((last 0))
            (when (< last n)
              (let* ((index (+ (* mask n) last)) (prior (vector-ref cost index)))
                (when prior
                  (let jobs ((j 0))
                    (when (< j n)
                      (let* ((bit (arithmetic-shift 1 j)) (required (vector-ref preds j)))
                        (when (and (= 0 (bitwise-and mask bit))
                                   (= required (bitwise-and mask required)))
                          (let* ((next (bitwise-ior mask bit))
                                 (next-index (+ (* next n) j))
                                 (clock (+ (vector-ref clocks mask) (list-ref durations j)))
                                 (value (+ prior (* clock (list-ref weights j))
                                           (list-ref (list-ref penalties last) j)))
                                 (old (vector-ref cost next-index)))
                            (vector-set! clocks next clock)
                            (when (or (not old) (< value old))
                              (vector-set! cost next-index value)
                              (vector-set! previous next-index index)))))
                      (jobs (+ j 1))))))
              (lasts (+ last 1))))
          (masks (+ mask 1))))
      (for-each (lambda (j)
        (let* ((index (+ (* (- size 1) n) j)) (value (vector-ref cost index)))
          (when (and value (or (not best) (< value best)))
            (set! best value) (set! best-index index)))) (iota n))
      (let recover ((index best-index) (order []))
        (if index
          (recover (vector-ref previous index) (cons (modulo index n) order))
          (hash ("optimum" best) ("optimalOrder" order)
                ("feasibleOrders" (hash-ref base "feasibleOrders"))
                ("subsetStates" size) ("stateCells" cells)))))))
