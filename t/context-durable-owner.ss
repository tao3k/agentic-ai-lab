(import (only-in :clan/poo/object .o .ref .call)
        (only-in :std/list/list find every)
        (only-in :agentic-ai-lab/t/qualification/context-temporal/evaluator/fixtures
                 authority-fixture clock-original-context push-row push-revision
                 push-join! context-source context-scope at
                 policy clock-check-originals!)
        :agentic-ai-lab/modules/ai-agentic-context/durable-owner
        :agentic-ai-lab/modules/ai-agentic-context/session-host
        :agentic-ai-lab/modules/ai-agentic-context/use-host
        :agentic-ai-lab/modules/ai-agentic-context/funs-features
        :agentic-ai-lab/modules/query/semantic/context-restriction
        :agentic-ai-lab/modules/temporal-causality/runtime/durable-journal
        :agentic-ai-lab/modules/temporal-causality/runtime/policy-clock
        :agentic-ai-lab/modules/temporal-causality/runtime/monotonic-clock
        :agentic-ai-lab/modules/temporal-causality/truth-maintenance/support/policy-host
        :agentic-ai-lab/modules/temporal-causality/truth-maintenance/support/policy
        (only-in :gerbil-ascent/candidate/checked-program reasoning-receipt-proof)
        (only-in :gerbil-ascent/candidate/provenance positive-proof-nodes positive-proof-roots positive-proof-status
          proof-node-id proof-node-kind proof-node-row proof-node-relation proof-node-inputs))
(export durable-driver originals! proof-evidence fresh-session!)
(def (ensure value message) (unless value (error message)))
(def (file-text path) (call-with-input-file path (lambda (p) (read-line p #f))))
(def (write-source path text)
  (when (file-exists? path) (delete-file path))
  (call-with-output-file path (lambda (p) (display text p))))
(def (originals! j db)
  (for-each (lambda (entry)
    (let* ((key (car entry)) (old (journal-get j key #t))
           (bytes (or old (file-text (cadr entry)))) (copy (string-append db "." key ".ss")))
      (journal-evidence! j key bytes) (write-source copy bytes) (setenv (caddr entry) copy)))
    '(("rules" "t/qualification/temporal-library-basic/rule-correspondence-v1/typed-rules.ss" "AGENTIC_AI_LAB_MRR_RULE_ORACLE")
      ("facts" "t/qualification/temporal-library-basic/derivation-authority-v1/typed-derivations.ss" "AGENTIC_AI_LAB_MRR_DERIVATION_ORACLE"))))
(def (proof-evidence ctx)
  (let* ((p (reasoning-receipt-proof (list-ref ctx 5))) (rows (map (lambda (n)
      (list (proof-node-id n) (proof-node-kind n) (proof-node-relation n) (proof-node-row n) (proof-node-inputs n))) (positive-proof-nodes p)))
         (roots-value (positive-proof-roots p)) (status-value (positive-proof-status p)))
    (.o kind: 'context.original-ascent-proof.v1 nodes: rows roots: roots-value status: status-value
        program: (car ctx) journal: (list-ref ctx 9))))
(def (fresh-session! f sid observed)
  (let* ((ph (.ref f 'policies)) (host (.ref f 'host))
         (snapshot (agentic-ai-lab-temporal-support-policy-host-current ph "policy"))
         (p (.ref snapshot 'policy)) (gen (.ref snapshot 'generation)))
    (ensure (equal? (.ref p 'revision-identity) "clock-new")
            "Fresh Session requires the committed replacement policy")
    (unless (with-catch (lambda (e) #f) (lambda () (agentic-ai-lab-context-use-host-current (.ref f 'grants) "clock-new-grant")))
      (agentic-ai-lab-context-use-host-refresh! (.ref f 'grants)
        (agentic-ai-lab-context-use-grant "clock-new-grant" 1 "manifest" "admission"
          (agentic-ai-lab-context-use-contract "actor" "task" "context-policy" '() '() #t)
          "policy" (.ref p 'semantic-digest) '(display) #t)))
    (agentic-ai-lab-ai-agentic-context-session-host-enroll! host 0 context-source
      (.o (:: @ context-scope) session: sid)
      (agentic-ai-lab-context-restriction "domain" '("actor") '("provider") '("org") 0 1000000)
      (agentic-ai-lab-ai-agentic-context-profile #f) 0 '("work") "clock-new-grant" 1)
    (agentic-ai-lab-ai-agentic-context-session-host-require-proof! host sid 0 0 (.ref f 'proof)
      (.ref (.ref f 'registration-a) 'identity) 1 gen (.ref p 'semantic-digest) 128)
    (agentic-ai-lab-ai-agentic-context-session-host-claim! host sid 1 0 (string-append "attempt-" sid) (string-append "request-" sid))
    (let* ((worker (thread-start! (make-thread (lambda () (thread-receive) "native-result-for-request"))))
           (token (agentic-ai-lab-ai-agentic-context-session-host-attach-worker! host sid 2 0 worker)))
      (hash-put! (.ref f 'workers) sid (list worker token)))))
(def (durable-driver db mode order-text stage-text profile)
  (when (equal? mode "claim")
    (let (j (journal-open db))
      (displayln "DURABLE-CLAIM epoch=" (journal-epoch j))
      (journal-close! j) (exit 0)))
  (let ((journal #f) (restored? #f) (tick (if (equal? profile "terminal") 1. 0.002)) (target #f))
    (let (clock (policy-clock-owner
      (lambda ()
        (set! journal (journal-open db))
        (originals! journal db)
        (set! restored? (if (journal-get journal "context") #t #f))
        (let* ((ctx (clock-original-context)) (f (authority-fixture #t ctx 1000000 (not restored?))))
          (journal-evidence! journal "original-ascent" (proof-evidence ctx))
          (journal-evidence! journal "original-org" context-source)
          (let (adapter (context-durable-adapter journal (.ref f 'host) (.ref f 'grants) (.ref f 'policies)
                          (lambda (registration) (.ref f 'proof))))
            (values f (.ref f 'policies) adapter))))
      "txn" 1 tick 0. 2 (equal? mode "pre") (and (not (equal? mode "counter-no-rearm")) (or (if (member mode '("post" "counter-stale")) #t #f) (not (equal? profile "missed"))))))
      (def (read! fun) (policy-clock-call! clock fun))
      (def (command! id name body-value fun)
        (policy-clock-command! clock (.o kind: 'context.durable-command.v1 identity: id operation: name body: body-value) fun))
      (def (checkpoint-check! f)
        (ensure (eq? (.ref (push-row f "session") 'context-state) 'invalidated) "A must be invalidated")
        (ensure (eq? (.ref (push-row f "session-b") 'context-state) 'invalidated) "B must be invalidated")
        (ensure (eq? (.ref (push-row f "session-c") 'context-state) 'admitted) "C Context was overinvalidated")
        (let ((outcomes (agentic-ai-lab-ai-agentic-context-session-host-outcomes (.ref f 'host) "session"))
              (schedule (.ref (push-row f "session") 'schedule)))
          (ensure (<= (length outcomes) 1) "Duplicate native terminal")
          (for-each (lambda (o) (ensure (not (.ref o 'current-use?)) "Old result resurrected")) outcomes)
          (when (null? outcomes)
            (ensure (pair? (.ref schedule 'obligations)) "Owner crash silently released old Attempt"))))
      (cond
        ((equal? mode "pre")
          (if (equal? profile "missed")
            (begin
              (thread-sleep! 0.03)
              (displayln "DURABLE-HELD missed-send") (force-output) (read-line))
            (begin
              (unless (equal? profile "terminal") (policy-clock-await-events! clock 2))
              (read! (lambda (f)
                (set! target (if (equal? profile "terminal") "terminal-original"
                  (.ref (find (lambda (r) (and (equal? (.ref r 'status) "pending")
                    (eq? (.ref (.ref r 'payload) 'kind) 'context.durable-delivery.v1))) (journal-rows journal)) 'id)))
                (journal-cut! journal (lambda (stage id)
                  (when (and (equal? id target) (eq? stage (string->symbol stage-text)))
                    (displayln "DURABLE-HELD " stage-text " id=" id) (force-output) (read-line))))))
              (if (equal? profile "terminal")
                (let (evidence (read! (lambda (f)
                       (context-observation-evidence (.ref f 'host) "session" (push-join! f "session")))))
                  (command! "terminal-original" 'result evidence (lambda (f)
                    (let (r (agentic-ai-lab-ai-agentic-context-session-host-commit-result! (.ref f 'host) "session" 2 0 (push-join! f "session")))
                      (ensure (.ref r 'native-result-published?) "Positive native completion failed")))))
                (for-each (lambda (move)
                  (case move
                    ((1) (policy-clock-resume! clock))
                    ((2)
                      (policy-clock-replace-policy! clock
                        (read! (lambda (f)
                          (context-durable-policy-command "replace"
                            (agentic-ai-lab-temporal-support-policy-host-registered (.ref f 'policies) "policy")
                            (agentic-ai-lab-temporal-support-policy "policy" "clock-new" (at 1) (at 1000000)))))))
                    ((3) (let (evidence (read! (lambda (f)
                          (context-observation-evidence (.ref f 'host) "session" (push-join! f "session")))))
                      (command! "old-result" 'result evidence (lambda (f)
                        (ensure (not (.ref (agentic-ai-lab-ai-agentic-context-session-host-commit-result! (.ref f 'host)
                          "session" (push-revision f "session") 0 (push-join! f "session")) 'accepted?)) "Expired old result accepted")))))
                    ((4) (command! "cancel" 'cancel "session" (lambda (f)
                      (agentic-ai-lab-ai-agentic-context-session-host-cancel! (.ref f 'host) "session" (push-revision f "session") 0))))
                    ((5) (command! "recover" 'recover "session" (lambda (f)
                      (agentic-ai-lab-ai-agentic-context-session-host-recover! (.ref f 'host) "session" (push-revision f "session") 0)))))
                  (displayln "DURABLE-STEP " move) (force-output)) (call-with-input-string order-text read)))))
          ;; Reaching here is used only by the stale-owner control.
          (error "Crash hook did not stop pre owner"))
        ((equal? mode "counter-no-rearm")
          (ensure restored? "Counterexample requires a restart")
          (thread-sleep! 0.03)
          (read! (lambda (f)
            (ensure (eq? (.ref (push-row f "session") 'context-state) 'admitted) "Expected missing-rearm counterexample")
            (displayln "DURABLE-COUNTEREXAMPLE no-rearm-after-restart cached-admitted=#t automatic-invalidation=#f")))
          (policy-clock-stop! clock) (displayln "COUNTEREXAMPLE-OK"))
        ((member mode '("post" "counter-stale"))
          (ensure restored? "Restart did not read a durable checkpoint")
          (policy-clock-await-events! clock 2)
          ;; Snapshot cache inspection happens after autonomous delivery, without
          ;; consumer proof/use queries triggering the catch-up.
          (read! checkpoint-check!)
          (read! (lambda (f)
            (let* ((checkpoint (context-host-checkpoint (.ref f 'host)))
                   (rows (.ref checkpoint 'entries)) (row (car rows))
                   (source-value (string-append (.ref row 'source) "\n#+begin_src scheme\n(define retained-original #t)\n#+end_src\n"))
                   (changed (.o (:: @ row) source: source-value))
                   (bad (.o (:: @ checkpoint) entries: (cons changed (cdr rows))))
                   (fresh (agentic-ai-lab-ai-agentic-context-session-host (.ref f 'grants) (.ref f 'policies) #t #f))
                   (rejected #f))
              (with-catch (lambda (e) (set! rejected #t))
                (lambda () (context-host-restore! fresh bad (lambda (registration) (.ref f 'proof)))))
              (ensure rejected "Same Org ID incorrectly retargeted a source")
              (displayln "DURABLE-ORG same-id-different-source=rejected exact-query-replay=#t"))))
          ;; Pending pre-crash result envelopes remain data; no endpoint seals survive.
          (read! (lambda (f)
            (let ((rejected #f))
              (with-catch (lambda (e) (set! rejected #t))
                (lambda () (agentic-ai-lab-ai-agentic-context-session-host-commit-result! (.ref f 'host)
                  "session" (push-revision f "session") 0 (.o kind: 'agentic-ai-lab.ai-agentic-context.observation-capability.v1))))
              (ensure rejected "Old observation capability was recreated from data"))))
          (let* ((sid (read! (lambda (f) (string-append "recovered-new-" (number->string (journal-epoch journal))))))
                 (now (policy-clock-observed clock)))
            (let (intent (read! (lambda (f)
              (let (snapshot (agentic-ai-lab-temporal-support-policy-host-registered (.ref f 'policies) "policy"))
                (and (not (equal? (.ref (.ref snapshot 'policy) 'revision-identity) "clock-new"))
                     (context-durable-policy-command (string-append "new-policy:" sid) snapshot
                       (agentic-ai-lab-temporal-support-policy "policy" "clock-new" (at 1) (at 1000000))))))))
              (when intent (policy-clock-replace-policy! clock intent)))
            (command! (string-append "new-session:" sid) 'recover sid (lambda (f) (fresh-session! f sid now)))
            (read! (lambda (f)
              (let (calendar (journal-get journal "calendar"))
                (ensure (find (lambda (ticket)
                  (and (equal? (.ref ticket 'policy) "policy")
                       (= (.ref ticket 'generation)
                          (.ref (agentic-ai-lab-temporal-support-policy-host-registered (.ref f 'policies) "policy") 'generation)))) calendar)
                  "Transaction-enrolled replacement ticket missing from durable calendar")
                (displayln "DURABLE-CALENDAR replacement-ticket-retained=#t"))))
            (command! (string-append "complete:" sid) 'result sid (lambda (f)
              (ensure (.ref (agentic-ai-lab-ai-agentic-context-session-host-commit-result! (.ref f 'host) sid 2 0
                (push-join! f sid)) 'native-result-published?) "New policy Attempt cannot complete")))
            (read! (lambda (f)
              (checkpoint-check! f)
              (ensure (eq? (.ref (push-row f sid) 'context-state) 'admitted) "Old ticket damaged new policy")
              (clock-check-originals! f)
              (displayln "DURABLE-RECOVER epoch=" (journal-epoch journal) " old-terminal-count="
                (length (agentic-ai-lab-ai-agentic-context-session-host-outcomes (.ref f 'host) "session"))
                " old-current=#f pending-preserved=#t new-completed=#t source-retained=#t chain=" (journal-verify! journal)))))
          (when (equal? mode "counter-stale")
            (let (now (policy-clock-observed clock))
              ;; Deliberately wrong native handler: rebase an old policy as a
              ;; fresh generation instead of checking the original ticket.
              (let (old-policy-value (policy "v1"))
               (command! "unsafe-old-policy" 'result
                (.o policy: old-policy-value generation: 4)
                (lambda (f) (agentic-ai-lab-temporal-support-policy-host-refresh! (.ref f 'policies) old-policy-value 4 now)))))
            (read! (lambda (f)
              (let (sid (string-append "recovered-new-" (number->string (journal-epoch journal))))
                (ensure (eq? (.ref (push-row f sid) 'context-state) 'invalidated) "Unsafe stale handler failed to expose damage")
                (displayln "DURABLE-COUNTEREXAMPLE stale-handler-rebases-old-policy new-context-invalidated=#t")))))
          (policy-clock-stop! clock)
          (displayln "MODULE-OK t/context-durable-owner.ss")
          (displayln "HARNESS-OK context-durable-owner") (displayln "OK"))
        (else (error "Unknown durable driver mode"))))))
