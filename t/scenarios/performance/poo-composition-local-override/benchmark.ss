 (rule . GERBIL-SCHEME-AGENT-R047)
 (optimizationFocus . "local profile override over POO base objects")
(inputShape . "bulk imported profiles plus one local profile extending a base object")
(expectedOutcome . "local override extends the imported POO object while preserving base object reuse")
(expectedRepair . "make :extends use POO prototype extension instead of quoted markers")
 (pooFormEvidence . (.o .def defpoo))
 (pooUsageCallEvidence . (.ref .get .mix .o .def .putdefault! .setslot! setslots! .all-slots))
