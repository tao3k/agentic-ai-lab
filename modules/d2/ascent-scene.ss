;;; -*- Gerbil -*-
;;; SPDX-FileCopyrightText: 2026 tao3k team and Contributors
;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Select a novice-facing scene from native source occurrences and open model
;;; choices. No geometry, domain names, object-kind/icon mapping or layout code.
(import (only-in :clan/poo/object .o .ref)
        (only-in :std/list/list find delete-duplicates/hash)
        (only-in :gerbil-ascent/program/syntax ascent)
        (only-in :gerbil-ascent/program/interface gerbil-ascent-evaluate-program))
(export d2-scene)
(def (scene-rows values slots)
  (map (lambda (value) (map (lambda (slot) (.ref value slot)) slots)) values))
(def (d2-scene source-value choices needs)
  (def source-nodes (.ref source-value 'nodes))
  (unless (and (<= (length source-nodes) 512) (<= (length choices) 128) (<= (length needs) 128)
               (= (length source-nodes) (length (delete-duplicates/hash (map (lambda (n) (.ref n 'identity)) source-nodes)))))
    (error "invalid or duplicate native scene identities"))
  (unless (= (length choices) (length (delete-duplicates/hash (map (lambda (c) (.ref c 'source-ref)) choices))))
    (error "ambiguous selected scene choices; keep competing candidates outside a concrete selection"))
  (def evaluation
    (gerbil-ascent-evaluate-program
     (ascent
      (relation Source (id ref) (scene-rows source-nodes '(identity source-ref)))
      (relation Parent (child parent) (.ref source-value 'parents))
      (relation Choice (ref caption glyph role reason)
        (scene-rows choices '(source-ref caption glyph role rationale)))
      (relation Need (q facet ref) (scene-rows needs '(question facet target)))
      (relation Chosen (id ref caption glyph role reason))
      (relation Needed (id))
      (relation Relevant (id))
      (relation Selected (id ref caption glyph role reason))
      (relation SelectedId (id))
      (relation ThroughHidden (child ancestor))
      (relation VisibleParent (child parent))
      (relation KnownRef (ref))
      (relation KnownId (id))
      (relation Ancestor (child ancestor))
      (relation InvalidParent (id))
      (relation CyclicOwner (id))
      (relation UnknownChoice (ref))
      (relation UnknownNeed (ref))
      (relation MissingChoice (id))
      ((KnownRef Ref) <-- (Source Id Ref))
      ((KnownId Id) <-- (Source Id Ref))
      ((Ancestor Child ParentId) <-- (Parent Child ParentId))
      ((Ancestor Child AncestorId) <-- (Ancestor Child Middle) (Parent Middle AncestorId))
      ((CyclicOwner Id) <-- (Ancestor Id Id))
      ((InvalidParent Child) <-- (Parent Child ParentId) (not (KnownId Child)))
      ((InvalidParent ParentId) <-- (Parent Child ParentId) (not (KnownId ParentId)))
      ((Chosen Id Ref Caption Glyph Role Reason) <-- (Source Id Ref) (Choice Ref Caption Glyph Role Reason))
      ((Needed Id) <-- (Need Q Facet Ref) (Source Id Ref))
      ((Relevant Id) <-- (Needed Id))
      ((Relevant ParentId) <-- (Relevant Child) (Parent Child ParentId))
      ((Selected Id Ref Caption Glyph Role Reason) <-- (Chosen Id Ref Caption Glyph Role Reason) (Relevant Id))
      ((SelectedId Id) <-- (Selected Id Ref Caption Glyph Role Reason))
      ((ThroughHidden Child Ancestor) <-- (Parent Child Ancestor))
      ((ThroughHidden Child Ancestor) <-- (ThroughHidden Child Middle) (Parent Middle Ancestor)
        (not (SelectedId Middle)))
      ((VisibleParent Child ParentId) <-- (SelectedId Child) (ThroughHidden Child ParentId) (SelectedId ParentId))
      ((UnknownChoice Ref) <-- (Choice Ref Caption Glyph Role Reason) (not (KnownRef Ref)))
      ((UnknownNeed Ref) <-- (Need Q Facet Ref) (not (KnownRef Ref)))
      ((MissingChoice Id) <-- (Needed Id) (not (SelectedId Id)))
      (bounds 1024 8192 16384))))
  (def rows (.ref evaluation 'rows-of))
  (unless (and (null? (rows 'InvalidParent)) (null? (rows 'CyclicOwner)))
    (error "invalid native ownership tree" (rows 'InvalidParent) (rows 'CyclicOwner)))
  (unless (and (null? (rows 'UnknownChoice)) (null? (rows 'UnknownNeed)))
    (error "scene refers to an absent native source occurrence" (rows 'UnknownChoice) (rows 'UnknownNeed)))
  (def selected-rows (rows 'Selected))
  (def parent-rows (rows 'VisibleParent))
  (.o inference: evaluation missing-choices: (rows 'MissingChoice)
      nodes: (map (lambda (row)
        (def name (car row))
        (def native (find (lambda (node) (eq? (.ref node 'identity) name)) source-nodes))
        (def ancestor (find (lambda (parent-row) (eq? (car parent-row) name)) parent-rows))
        (.o identity: name source-ref: (cadr row) label: (caddr row)
            glyph: (list-ref row 3) role: (list-ref row 4) rationale: (list-ref row 5)
            kind: (.ref native 'kind) parent: (and ancestor (cadr ancestor)))) selected-rows)
      parents: parent-rows))
