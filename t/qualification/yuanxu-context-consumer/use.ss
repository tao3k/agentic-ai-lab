(import (only-in :yuanxu-context-consumer/init yuanxu-context-consumer.init.exports)
        (only-in :clan/poo/object .get .slot?)
        (only-in :yuanxu-context-consumer/main selected-context)
        (only-in :agentic-ai-lab/modules/ai-agentic-context/funs-features context-profile-feature-ids)
        (only-in :yuanxu/module-system/source/admission call-with-module-source-operation-measurement)
        (only-in :gerbil/runtime/loader list-modules))
(export main)

(def owner 'agentic-ai-lab/modules/ai-agentic-context/interface)
(def memory 'agentic-ai-lab/modules/ai-agentic-context/interface/memory)

(def (main mode)
  (def entered (real-time))
  (def enabled? (equal? mode "enabled"))
  (def ids (if enabled? '(ai-agentic-context/core ai-agentic-context/memory) '(ai-agentic-context/core)))
  (def exports yuanxu-context-consumer.init.exports)
  (defvalues (scope first)
    (call-with-module-source-operation-measurement selected-context accounting?: #f))
  (def read-returned (real-time))
  (unless (and (= (hash-ref first '(calls scope-factory) 0) 1)
               (= (hash-ref first (list 'calls (list 'scope-factory owner)) 0) 1))
    (error "first Context read constructed an unrelated scope" mode))
  (def graph (.get exports tests selected-graph))
  (def graph-returned (real-time))
  (unless (equal? (.get graph feature-order) (if enabled? (list memory) '()))
    (error "Context Feature selection differs" mode))
  (def (features value) (context-profile-feature-ids (.get value profile)))
  (unless (and (equal? (features scope) ids)
               (eq? scope (.get exports Lab ai-agentic-context))
               (not (.slot? (.get scope config) 'review)))
    (error "Context scope differs from the selected Feature graph" mode))
  (def refined (.get exports Consumer review context))
  (unless (and (not (eq? refined scope)) (.get refined config review)
               (equal? (features refined) ids)
               (not (.slot? (.get scope config) 'review)))
    (error "downstream refinement leaked or lost its Feature" mode))
  (unless (ormap (lambda (row)
                   (and (equal? (car row) "yuanxu-context-consumer/main~0")
                        (string-prefix? (path-normalize (path-expand "lib/" (gerbil-path)))
                                        (path-normalize (cdr row)))))
                 (list-modules))
    (error "Context consumer did not use its own compiled entry"))
  (displayln "LAB-CONTEXT-USE-PHASES mode=" mode
             " startup=" entered " first-read=" (- read-returned entered)
             " graph=" (- graph-returned read-returned)
             " remaining=" (- (real-time) graph-returned))
  (displayln "LAB-CONTEXT-USE-OK mode=" mode))
