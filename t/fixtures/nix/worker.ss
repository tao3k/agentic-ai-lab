;;; Fresh installed Gerbil process. No disk-record discovery or user Evidence.
(import :clan/poo/object
        (only-in :std/error Error? Error-message)
        (only-in :std/misc/ports read-all-as-u8vector)
        (only-in :std/crypto/digest sha256)
        (only-in :std/encoding/hex hex-encode)
        (only-in :std/string/misc string-subst)
        (only-in :tao3k/yuanxu/module-system/source/link yuanxu-load-modules)
        (only-in :tao3k/yuanxu/admission/publication AdmissionPublication.)
        (only-in :tao3k/yuanxu/module-system/building/artifacts
          accept-build-artifact-handoff! call-with-build-artifact-issuance admit-build-artifacts!
          build-artifact-handoff)
        (only-in :tao3k/yuanxu/ops/progress call-with-execution-progress execution-progress!)
        "./projection" "./store")
(export main)
(def (report-result prefix value)
  ;; Nix --raw has no trailing newline; keep protocol rows independent of stderr.
  (newline (current-error-port))
  (force-output (current-error-port))
  (displayln prefix value)
  (force-output))
(def (worker-arguments raw)
  (if (= (length raw) 2)
    (let* ((directory (car raw)) (libdir (path-expand "lib" directory))
           (package-name (cadr (call-with-input-file (path-expand "gerbil.pkg" directory) read)))
           (unit-name (string-append (symbol->string package-name) "/probe"))
           (record (path-expand
             (find (cut string-prefix? ".yuanxu-build-issuance-" <>)
               (directory-files (list path: libdir ignore-hidden: #f))) libdir)))
      (list directory libdir unit-name (cadr raw) record))
    raw))
;; Keep fresh-worker arguments independent of the Gerbil's interpreter/exe launcher.
(def (main . raw-arguments)
  (call-with-execution-progress 60000 600000
    (lambda (_frame)
      ;; Liveness is not a source-observation callback. Preserve any observer
      ;; explicitly installed by a caller; ordinary restart qualification must
      ;; not turn every source guard into an open callback boundary.
      (def completed-publications 0)
        (def args (worker-arguments raw-arguments))
        (def root (car args))
        (def lib (cadr args))
        (def probe-identity (string->symbol (caddr args)))
        (def requested-mode (list-ref args 3))
        (def approved? (string-prefix? "approved-" requested-mode))
        (def mode (if approved? (substring requested-mode 9 (string-length requested-mode)) requested-mode))
        (def selection (yuanxu-load-modules (path-expand "init.ss" root)))
        (execution-progress! 'worker-stages 1)
        (def projection (probe-projection selection root probe-identity))
        (execution-progress! 'worker-stages 2)
        (when (equal? mode "persist")
          (displayln "CORE-STORE-ROOT " (publish-store! projection lib))
          (exit 0))
        (def (restore!)
          (restore-selected-store! projection lib (list-ref args 5) (list-ref args 6)))
        (when (equal? mode "recover-reject")
          (let (failure (with-catch values restore!))
            (unless (Error? failure) (error "invalid durable recovery accepted"))
            (def blocked (with-catch values (cut admit-build-artifacts! (.get selection build-graph))))
            (unless (and (Error? blocked)
                         (equal? (Error-message blocked) "build-required: Core build did not complete"))
              (error "failed durable recovery downgraded to source publication"))
            (displayln "STORE-REFUSED " (Error-message failure))
            (report-result "STORE-RESULT " (not (Error? failure)))
            (exit 0)))
        (when (and approved? (member mode '("cold-source" "cold-joint" "cold-omitted")))
         (let ()
          (def failure (with-catch values
            (cut .call AdmissionPublication. .for-export selection 'applications/gitea-postgresql 'Application)))
          (unless (Error? failure) (error "restarted reader accepted changed publication"))
          (when (equal? mode "cold-omitted")
            (unless (equal? (Error-message failure) "approved publication omits or replaces selected source")
              (error "omission refused at an unexpected boundary" failure)))
          (def blocked (with-catch values (cut admit-build-artifacts! (.get selection build-graph))))
          (unless (and (Error? blocked)
                       (equal? (Error-message blocked) "build-required: Core build did not complete"))
            (error "failed approved recovery fell back to source publication"))
          (displayln "APPROVED-REFUSED " (Error-message failure))
          (report-result "STORE-RESULT " #f)
          (exit 0)))
        (when (equal? mode "mismatch")
         (let ()
          (def refused (with-catch values
            (cut accept-build-artifact-handoff!
              (.cc projection compiler-identities: '(wrong/compiler)) lib)))
          (unless (and (Error? refused)
                       (equal? (Error-message refused) "Core build handoff does not match selected projection"))
            (error "mismatched worker projection was accepted"))
          (def blocked (with-catch values (cut admit-build-artifacts! (.get selection build-graph))))
          (unless (and (Error? blocked)
                       (equal? (Error-message blocked) "build-required: Core build did not complete"))
            (error "refused handoff downgraded to source-only publication"))
          (displayln "HANDOFF-MISMATCH-REFUSED")
          (exit 0)))
        (cond
          (approved? (void))
          ((> (length args) 5) (restore!))
          (else (accept-build-artifact-handoff! projection lib)))
        (def publication
          (.call AdmissionPublication. .for-export selection 'applications/gitea-postgresql 'Application))
        (def Parent (.get publication value))
        (def parent-plan (.get Parent plan))
        (def saved (.get publication .publish))
        (.def (Release @ Parent)
          config: =>.+ (.o postgresql: =>.+ (.o settings: =>.+ (.o port: 5433))))
        (def last-accepted #f)
        (def (publish!)
          (defvalues (receipt next failure) (saved Parent Release))
          (unless (and (not failure) receipt (.get receipt accepted?)
                       (= (.get next plan postgresql port) 5433)
                       (= (.get next plan gitea database-port) 5433)
                       (= (.get parent-plan postgresql port) 5432)
                       (= (length (.get publication context contributions)) 2))
            (error "worker publication lost service invariants"))
          (set! last-accepted (.get receipt accepted?))
          (set! completed-publications (+ completed-publications 1))
          (execution-progress! 'completed-publications completed-publications)
          next)
        (publish!)
        (publish!)
        (def (warm!)
          (when approved?
            (let* ((wire (build-artifact-handoff (.get selection build-graph) lib))
                   (digest (list-ref wire 6)))
              (string-set! digest 0 (if (char=? (string-ref digest 0) #\0) #\1 #\0))
              ;; Mutating an exported wire copy cannot mutate the issuer.
              (admit-build-artifacts! (.get selection build-graph))))
          (def main (probe-build root lib))
          (def port (open-output-string))
          (with-catch
            (lambda (failure) (error "warm build failed" failure (get-output-string port)))
            (lambda ()
              (parameterize ((current-output-port port))
                (call-with-build-artifact-issuance projection lib (cut main "compile")))))
          (when (string-contains (get-output-string port) "... compile probe")
            (error "fresh worker compiled an already issued unit"))
          (publish!)
          (displayln "HANDOFF-WARM-OK"))
        (cond
          ((member mode '("policy-change" "warm-policy-change" "core-source"))
           (when (equal? mode "warm-policy-change") (warm!))
           (let* ((policy? (not (equal? mode "core-source")))
                  (file (if policy?
                          (path-expand "release-name.nix"
                            (path-directory (.get selection modules building release Source expression)))
                          (path-expand "probe.ss" root)))
                  (original (call-with-input-file file read-all-as-u8vector)))
             (dynamic-wind
               (lambda ()
                 (if policy?
                   (call-with-output-file (list path: file truncate: #t)
                     (cut display (string-subst (utf8->string original)
                                    "core-approved-publication" "core-replaced-publication") <>))
                   (call-with-output-file (list path: file append: #t)
                     (cut display "\n; changed source\n" <>))))
               (lambda ()
                 (defvalues (receipt next failure) (saved Parent Release))
                 (unless (and (not receipt) (eq? next Parent) failure)
                   (error "saved publication accepted changed approval/source"))
                 (def refused (with-catch values
                   (cut .call AdmissionPublication. .for-export selection 'applications/gitea-postgresql 'Application)))
                 (unless (Error? refused) (error "hot export accepted changed approval/source"))
                 (set! last-accepted #f)
                 (displayln "APPROVED-REFUSED " (Error-message refused)))
               (lambda ()
                 (call-with-output-file (list path: file truncate: #t)
                   (lambda (port) (write-subu8vector original 0 (u8vector-length original) port)))))))
          ((equal? mode "unanchored")
           ;; Deliberately wrong release selection: demonstrates that Nix content
           ;; integrity alone does not establish publisher authorization.
           (displayln "UNANCHORED-ACCEPTED"))
          ((equal? mode "source-change")
           ;; A successful child is not permission for its parent to skip currentness.
           (call-with-output-file (list path: (path-expand "probe.ss" root) append: #t)
             (lambda (port) (display "\n; changed by worker\n" port)))
           (displayln "HANDOFF-CHILD-RETURNED"))
          ((equal? mode "warm")
           (warm!))
          ((equal? mode "joint")
          (let ()
           (def binary (path-expand (string-append (symbol->string probe-identity) "~0.o1") lib))
           ;; Parent sends its exact record path separately as an argument for mutation
           ;; only; acceptance above uses retained pipe state, never this argument.
                   (def record (if approved?
                                 (list-ref (build-artifact-handoff (.get selection build-graph) lib) 5)
                                 (list-ref args 4)))
           (def (bytes path) (call-with-input-file path read-all-as-u8vector))
           (def original (bytes binary))
           (def old-record (bytes record))
           (def data (call-with-input-file record read))
           (dynamic-wind
             (lambda ()
               (write-artifact-bytes binary #u8(0))
               (call-with-output-file (list path: record truncate: #t)
                 (lambda (port)
                   (write (list (car data) (cadr data)
                     (map (lambda (row)
                       (if (equal? (car row) binary)
                         (cons binary (hex-encode (sha256 #u8(0)))) row)) (caddr data))) port))))
             (lambda ()
               (defvalues (receipt next failure) (saved Parent Release))
               (unless (and (not receipt) (eq? next Parent) failure)
                 (error "joint replacement accepted by saved worker publication"))
               (report-result "STORE-ATTACK-RESULT " (not failure))
               (def refused (with-catch values
                 (cut .call AdmissionPublication. .for-export selection
                      'applications/gitea-postgresql 'Application)))
               (unless (and (Error? refused)
                            (equal? (Error-message refused) "Core build issuance record changed"))
                 (error "joint replacement accepted by worker export")))
             (lambda () (write-artifact-bytes binary original) (write-artifact-bytes record old-record)))
           (publish!)
           (displayln "HANDOFF-JOINT-REFUSED")))
          (else (error "unknown worker control" mode)))
        (report-result "STORE-RESULT " last-accepted)
)))
