(import :std/test :agentic-ai-lab/modules/ai-agentic-context/clue-exchange
        (only-in :agentic-ai-lab/modules/temporal-causality/trajectory/ascent-ledger ascent-trajectory))
(export clue-exchange-test)

(def (clue id claim polarity role source (factors []) (links []))
  (hash ("id" id) ("claim" claim) ("polarity" polarity)
        ("role" role) ("source" source)
        ("factors" factors) ("links" links)))
(def (rejected? thunk)
  (with-catch (lambda (_) #t) (lambda () (thunk) #f)))
(def (context)
  (hash ("ownerIdentity" "owner") ("sourceIdentity" "source")
        ("prefixIdentity" "prefix") ("ruleIdentity" "rules")))
(def clue-exchange-test
  (test-suite "host-bound progressive clue exchange"
    (test-case "untrusted hints cannot create support or attest themselves"
      (let* ((exchange (open-clue-exchange (lambda (_id _digest _source _context) #f) context))
             (hint (clue "h" "header" "support" "hypothesis" "agent"
                         '(("order" "candidate")))))
        (exchange 'submit [hint] 0)
        (let (view (exchange 'query "header"))
          (check-equal? (hash-ref view "support") [])
          (check-equal? (length (hash-ref view "conditional")) 1)
          (check-equal? (length (hash-ref view "relevantFactors")) 1))
        (check (rejected? (lambda () (exchange 'submit
          [(clue "o" "header" "support" "observation" "trace")]
          0))) => #t)))
    (test-case "independently verified conflict and receipt withdrawal"
      (let* ((live #t)
             (exchange (open-clue-exchange (lambda (id _digest _source _context)
               (and live (string-append "receipt-" id))) context)))
        (exchange 'submit [(clue "a" "header" "support" "observation" "trace-a")
                           (clue "b" "header" "counter" "observation" "trace-b")]
                  0)
        (let (view (exchange 'query "header"))
          (check-equal? (length (hash-ref view "support")) 1)
          (check-equal? (length (hash-ref view "counterevidence")) 1)
          (check-equal? (hash-ref view "conflict") '(("header")))
          (check-equal? (hash-ref (exchange 'query "header" view)
            "status") "unchanged"))
        (set! live #f)
        (let (view (exchange 'query "header"))
          (check-equal? (hash-ref view "support") [])
          (check-equal? (hash-ref view "conflict") [])
          (check-equal? (hash-ref view "unknown") '(("header")))
          (check-equal? (hash-ref view "status") "unavailable")
          (check-equal? (length (hash-ref view "unavailable")) 2))))
    (test-case "content-bound receipt and progressive question"
      (let* ((admitted #f)
             (verify (lambda (_id digest _source _context)
               (and (equal? digest admitted) "native-receipt")))
             (exchange (open-clue-exchange verify context))
             (first (clue "a" "header" "support" "observation" "trace-a"
                          [] '(("gc" "depends-on")))))
        (set! admitted (cadr (car (hash-ref
          (exchange 'submit [first] 0) "identities"))))
        (let (view (exchange 'query "header"))
          (check-equal? (length (hash-ref view "neighbors")) 1))
        (check-equal? (hash-ref (exchange 'query "gc") "unknown") '(("gc")))
        (let* ((snapshot (exchange 'snapshot))
               (stored (car (hash-ref snapshot "clues")))
               (original-digest (hash-ref stored "digest")))
          (hash-put! stored "polarity" "counter")
          (check (rejected? (lambda () (open-clue-exchange verify context snapshot))) => #t)
          (hash-put! stored "polarity" "support")
          (hash-put! stored "digest" original-digest)
          (set! admitted #f)
          (let (resumed (open-clue-exchange verify context snapshot))
          (check-equal? (hash-ref (resumed 'query "header") "support") [])
          (check-equal? (hash-ref (resumed 'query "header") "counterevidence") [])
          (check-equal? (hash-ref (exchange 'query "header") "support") [])))))
    (test-case "prefix changes invalidate view identity and foreign owner cannot resume"
      (let* ((prefix "p1")
             (source "source")
             (owner "owner-a")
             (host (lambda () (hash ("ownerIdentity" owner)
               ("sourceIdentity" source) ("prefixIdentity" prefix)
               ("ruleIdentity" "rules"))))
             (exchange (open-clue-exchange
               (lambda (_id _digest _source _context) "receipt") host)))
        (exchange 'submit [(clue "a" "header" "support" "observation" "trace")] 0)
        (let* ((before (exchange 'query "header"))
               (snapshot (exchange 'snapshot)))
          (set! prefix "p2")
          (let (after (exchange 'query "header" before))
            (check-equal? (hash-ref after "status") "stale")
            (check (equal? (hash-ref before "viewIdentity")
                           (hash-ref after "viewIdentity")) => #f))
          (set! source "source2")
          (let (after (exchange 'query "header"))
            (check-equal? (hash-ref after "support") [])
            (check-equal? (hash-ref after "unknown") '(("header"))))
          (set! owner "owner-b")
          (check (rejected? (lambda () (open-clue-exchange
            (lambda (_id _digest _source _context) "receipt") host snapshot)))
            => #t))))
    (test-case "context change during verification rejects the entire read"
      (let* ((prefix "p1")
             (host (lambda () (hash ("ownerIdentity" "owner")
               ("sourceIdentity" "source") ("prefixIdentity" prefix)
               ("ruleIdentity" "rules"))))
             (exchange (open-clue-exchange
               (lambda (_id _digest _source _context)
                 (set! prefix "p2") "receipt") host)))
        (exchange 'submit [(clue "a" "header" "support" "observation" "trace")] 0)
        (check (rejected? (lambda () (exchange 'query "header"))) => #t)))
    (test-case "one entrance combines open clue questions with focused attempt history"
      (let* ((owner (hash-ref (ascent-trajectory
                      (hash ("action" "open") ("task" "investigate")
                            ("sourceIdentity" "source"))) "trajectory"))
             (live #t)
             (exchange (open-trajectory-clue-exchange owner
               (lambda (_id _digest _source _context)
                 (and live "native-receipt")) "reviewed-rules"))
             (candidate (hash ("questionIdentity" "header")
               ("scopeIdentity" "header-scope")
               ("operationIdentity" "inspect") ("inputIdentity" "source")
               ("toolIdentity" "native-trace") ("modelIdentity" "agent"))))
        (check-equal? (hash-ref (exchange 'brief) "clueReads")
          ["submit" "query"])
        (check-equal? (hash-ref (exchange 'focus candidate) "comparisons") [])
        (ascent-trajectory (hash ("action" "append") ("trajectory" owner)
          ("event" (hash ("id" "attempt-a") ("kind" "attempt")
            ("sourceIdentity" "source") ("questionIdentity" "header")
            ("scopeIdentity" "header-scope")
            ("operationIdentity" "inspect") ("inputIdentity" "source")
            ("toolIdentity" "native-trace") ("modelIdentity" "agent")))))
        (let (focus (exchange 'focus candidate))
          (check-equal? (length (hash-ref focus "comparisons")) 1)
          (check-equal? (hash-ref (car (hash-ref focus "comparisons"))
            "relation") "exact-current")
          (check-equal? (hash-ref focus "actionSelected") #f))
        (exchange 'submit [(clue "h" "header" "support" "hypothesis" "agent")]
          0)
        (check-equal? (length (hash-ref (exchange 'query "header")
          "conditional")) 1)
        (exchange 'submit [(clue "o" "header" "support" "observation" "trace")]
          1)
        (let (before (exchange 'query "header"))
          (check-equal? (length (hash-ref before "support")) 1)
          (set! live #f)
          (let (after (exchange 'query "header" before))
            (check-equal? (hash-ref after "status") "unavailable")
            (check-equal? (hash-ref after "support") [])))
        (check (rejected? (lambda () (exchange 'append (hash)))) => #t)
        (ascent-trajectory (hash ("action" "close") ("trajectory" owner)))))))
