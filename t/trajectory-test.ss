(import :std/test :agentic-ai-lab/modules/temporal-causality/trajectory/ascent-ledger)
(export trajectory-test)
(def (open) (hash-ref (ascent-trajectory (hash ("action" "open") ("task" "task") ("sourceIdentity" "s"))) "trajectory"))
(def (event h id kind . fields)
  (let (item (hash ("id" id) ("kind" kind) ("sourceIdentity" "s")))
    (for-each (lambda (pair) (hash-put! item (car pair) (cdr pair))) fields)
    (ascent-trajectory (hash ("action" "append") ("trajectory" h) ("event" item)))))
(def (snapshot h) (ascent-trajectory (hash ("action" "snapshot") ("trajectory" h))))
(def (close h) (ascent-trajectory (hash ("action" "close") ("trajectory" h))))
(def (call h id thinking (repair #f))
  (apply event h id "model-call"
    (append [(cons "round" 1) (cons "usage" (hash ("inputTokens" 100) ("outputTokens" (+ 10 thinking)) ("thinkingTokens" thinking)))]
            (if repair [(cons "repairOf" repair)] []))))
(def (reject thunk) (with-catch (lambda (_) #t) (lambda () (thunk) #f)))
(def trajectory-test
  (test-suite "Native trajectory evidence and first-correct accounting"
    (test-case "checkpoint records uncertainty without admitting correctness"
      (let (h (open))
        (check (reject (cut event h "missing" "checkpoint" '("modelCall" . "absent")
          (cons "branches" [(hash ("id" "b") ("status" "unknown"))]))) => #t)
        (call h "call" 8)
        (event h "evidence" "evidence" '("resultReference" . "r") '("pathIdentity" . "p"))
        (check (reject (cut event h "bad" "checkpoint" '("modelCall" . "call")
          (cons "branches" [(hash ("id" "b") ("status" "contradicted") ("complete" #f) ("resultReference" "r"))]))) => #t)
        (event h "check" "checkpoint" '("modelCall" . "call")
          (cons "branches" [(hash ("id" "b") ("status" "unknown"))]))
        (check (hash-ref (snapshot h) "verified") => #f)
        (check (hash-ref (hash-ref (snapshot h) "totals") "unknownBranches") => 1)
        (close h)))
    (test-case "consumption gate refuses unconsumed and revoked references atomically"
      (let (h (open))
        (event h "prior" "evidence" '("resultReference" . "r") '("pathIdentity" . "p"))
        (check (reject (cut event h "premature" "verification" '("correct" . #t) '("verifier" . "oracle") '("consumptionReference" . "r"))) => #t)
        (check (hash-ref (snapshot h) "eventCount") => 1)
        (event h "consume" "consumption" '("consumedReference" . "r") '("resultReference" . "r") '("intentIdentity" . "intent") '("contractIdentity" . "contract"))
        (event h "correct" "verification" '("correct" . #t) '("verifier" . "oracle") '("consumptionReference" . "r"))
        (check (hash-ref (snapshot h) "verified") => #t)
        (close h)))
    (test-case "exploration reference requires successful bound verification"
      (let* ((h (open))
             (candidate (hash ("questionIdentity" "q") ("operationIdentity" "test")
                              ("inputIdentity" "input") ("scopeIdentity" "scope")
                              ("toolIdentity" "tool") ("modelIdentity" "model")
                              ("contractIdentity" "contract"))))
        (def (reference)
          (hash-ref (car (hash-ref (ascent-trajectory
            (hash ("action" "explore") ("trajectory" h) ("candidate" candidate)))
            "comparisons")) "currentEvidenceReference"))
        (event h "proof" "evidence" '("resultReference" . "r") '("pathIdentity" . "p"))
        (event h "attempt" "attempt" '("questionIdentity" . "q")
          '("operationIdentity" . "test") '("inputIdentity" . "input")
          '("scopeIdentity" . "scope") '("toolIdentity" . "tool")
          '("modelIdentity" . "model") '("resultReference" . "r")
          '("contractIdentity" . "contract"))
        (check (reference) => #f)
        (event h "consume" "consumption" '("consumedReference" . "r")
          '("resultReference" . "r") '("intentIdentity" . "intent")
          '("contractIdentity" . "contract"))
        (check (reference) => #f)
        (event h "verified" "verification" '("correct" . #t)
          '("verifier" . "independent-check") '("consumptionReference" . "r"))
        (check (reference) => "r")
        (let (packet (ascent-trajectory
             (hash ("action" "explore") ("trajectory" h) ("candidate" candidate))))
          (check (ascent-trajectory (hash ("action" "exploration-current")
            ("trajectory" h) ("packet" packet))) => #t)
        (event h "rejected" "verification" '("correct" . #f)
          '("verifier" . "independent-check") '("consumptionReference" . "r"))
        (check (reference) => #f)
          (check (ascent-trajectory (hash ("action" "exploration-current")
            ("trajectory" h) ("packet" packet))) => #f))
        (close h)))
    (test-case "candidate-free context does not select or expose a result"
      (let (h (open))
        (event h "attempt" "attempt" '("questionIdentity" . "q")
          '("operationIdentity" . "test") '("inputIdentity" . "input"))
        (let* ((context (ascent-trajectory (hash ("action" "context") ("trajectory" h))))
               (attempt (car (hash-ref context "attempts"))))
          (check (hash-ref context "actionSelected") => #f)
          (check (string-length (hash-ref context "prefixIdentity")) => 64)
          (check (hash-ref attempt "earlierEvent") => "attempt")
          (check (hash-key? attempt "resultReference") => #f)
          (check (ascent-trajectory (hash ("action" "exploration-current")
            ("trajectory" h) ("packet" context))) => #t)
          (hash-put! context "prefixIdentity" "different-content")
          (check (ascent-trajectory (hash ("action" "exploration-current")
            ("trajectory" h) ("packet" context))) => #f))
        (close h)))
    (test-case "brief is small and reports only changed kinds since a bound prefix"
      (let* ((h (open))
             (first (ascent-trajectory (hash ("action" "brief") ("trajectory" h)))))
        (check (hash-ref first "status") => "unread")
        (check (hash-ref first "readSurfaces") => ["context" "explore" "focus" "exact-prefix" "snapshot"])
        (check (hash-key? first "attempts") => #f)
        (check (hash-ref (ascent-trajectory (hash ("action" "brief")
          ("trajectory" h) ("observed" first))) "status") => "unchanged")
        (event h "attempt" "attempt" '("questionIdentity" . "q")
          '("operationIdentity" . "probe") '("inputIdentity" . "input"))
        (let (changed (ascent-trajectory (hash ("action" "brief")
               ("trajectory" h) ("observed" first))))
          (check (hash-ref changed "status") => "changed")
          (check (hash-ref changed "changeKinds") => ["attempt"])
          (check (hash-key? changed "attempts") => #f)
          (check (ascent-trajectory (hash ("action" "exploration-current")
            ("trajectory" h) ("packet" changed))) => #t)
          (hash-put! changed "prefixIdentity" "different-content")
          (check (reject (lambda () (ascent-trajectory (hash ("action" "brief")
            ("trajectory" h) ("observed" changed))))) => #t))
        (close h)))
    (test-case "focused read returns only relevant new comparisons"
      (let* ((h (open))
             (candidate (hash ("questionIdentity" "q") ("operationIdentity" "probe")
                              ("inputIdentity" "input")))
             (first (ascent-trajectory (hash ("action" "focus") ("trajectory" h)
                                       ("candidate" candidate)))))
        (check (hash-ref first "status") => "unread")
        (event h "other" "attempt" '("questionIdentity" . "other")
          '("operationIdentity" . "probe") '("inputIdentity" . "input"))
        (let (unchanged (ascent-trajectory (hash ("action" "focus") ("trajectory" h)
                         ("candidate" candidate) ("observed" first))))
          (check (hash-ref unchanged "status") => "unchanged")
          (check (hash-ref unchanged "comparisons") => [])
          (event h "matching" "attempt" '("questionIdentity" . "q")
            '("operationIdentity" . "probe") '("inputIdentity" . "input"))
          (let (changed (ascent-trajectory (hash ("action" "focus") ("trajectory" h)
                           ("candidate" candidate) ("observed" unchanged))))
            (check (hash-ref changed "status") => "changed")
            (check (length (hash-ref changed "comparisons")) => 1)
            (check (hash-ref changed "actionSelected") => #f)
            (let (wrong-candidate (hash ("questionIdentity" "other")
                                   ("operationIdentity" "probe") ("inputIdentity" "input")))
              (check (reject (lambda () (ascent-trajectory
                (hash ("action" "focus") ("trajectory" h)
                      ("candidate" wrong-candidate) ("observed" changed))))) => #t))))
        (close h)))
    (test-case "exact prefix requires the retained content identity"
      (let (h (open))
        (event h "first" "attempt" '("questionIdentity" . "q")
          '("operationIdentity" . "probe") '("inputIdentity" . "input"))
        (let* ((brief (ascent-trajectory (hash ("action" "brief") ("trajectory" h))))
               (exact (ascent-trajectory (hash ("action" "exact-prefix")
                        ("trajectory" h) ("through" 1)
                        ("prefixIdentity" (hash-ref brief "prefixIdentity"))))))
          (check (length (hash-ref exact "events")) => 1)
          (check (hash-ref exact "executionAuthorized") => #f)
          (event h "second" "attempt" '("questionIdentity" . "other")
            '("operationIdentity" . "probe") '("inputIdentity" . "input"))
          (check (ascent-trajectory (hash ("action" "exploration-current")
            ("trajectory" h) ("packet" exact))) => #f)
          (check (reject (lambda () (ascent-trajectory (hash ("action" "exact-prefix")
            ("trajectory" h) ("through" 1) ("prefixIdentity" "wrong"))))) => #t)
          (event h "replace" "invalidate" '("nextSourceIdentity" . "s2"))
          (let (historical (ascent-trajectory (hash ("action" "exact-prefix")
                 ("trajectory" h) ("through" 1)
                 ("prefixIdentity" (hash-ref brief "prefixIdentity")))))
            (check (hash-ref historical "sourceIdentity") => "s")
            (check (hash-ref historical "generation") => 0)))
        (close h)))
    (test-case "equal source revisions do not admit another trajectory packet"
      (let* ((first (open)) (other (open))
             (candidate (hash ("questionIdentity" "q") ("operationIdentity" "read")
                              ("inputIdentity" "s")))
             (packet (ascent-trajectory
               (hash ("action" "explore") ("trajectory" first) ("candidate" candidate)))))
        (check (ascent-trajectory (hash ("action" "exploration-current")
          ("trajectory" first) ("packet" packet))) => #t)
        (check (ascent-trajectory (hash ("action" "exploration-current")
          ("trajectory" other) ("packet" packet))) => #f)
        (close first)
        (close other)))
    (test-case "first correct includes failures and repairs but freezes before later work"
      (let (h (open))
        (call h "one" 80)
        (event h "wrong" "verification" '("correct" . #f) '("verifier" . "oracle"))
        (call h "repair" 30 "wrong")
        (event h "correct" "verification" '("correct" . #t) '("verifier" . "oracle"))
        (call h "waste" 50)
        (let (result (close h))
          (check (hash-ref (hash-ref result "throughFirstCorrect") "thinkingTokens") => 110)
          (check (hash-ref (hash-ref result "throughFirstCorrect") "repairThinkingTokens") => 30)
          (check (hash-ref (hash-ref result "postSuccess") "thinkingTokens") => 50)
          (check (hash-ref result "censored") => #f))))
    (test-case "unknown usage remains unknown and unverified close is censored"
      (let (h (open))
        (event h "unknown" "model-call")
        (let (result (close h))
          (check (hash-ref (hash-ref result "totals") "modelCalls") => 1)
          (check (hash-ref (hash-ref result "totals") "thinkingComplete") => #f)
          (check (hash-ref result "censored") => #t))))
    (test-case "subgoal success cannot freeze complete task cost"
      (let (h (open))
        (call h "first" 80)
        (event h "subgoal" "verification" '("correct" . #t) '("verifier" . "oracle") '("scope" . "subgoal"))
        (check (hash-ref (snapshot h) "verified") => #f)
        (call h "second" 30)
        (check (reject (cut event h "bad-scope" "verification" '("correct" . #t) '("verifier" . "oracle") '("scope" . "unknown"))) => #t)
        (event h "task" "verification" '("correct" . #t) '("verifier" . "oracle") '("scope" . "task"))
        (check (hash-ref (hash-ref (close h) "throughFirstCorrect") "thinkingTokens") => 110)))
    (test-case "invalidation revokes old evidence and retains historical epoch"
      (let (h (open))
        (event h "proof" "evidence" '("resultReference" . "r") '("pathIdentity" . "p"))
        (event h "answer" "direct-answer" '("resultReference" . "r"))
        (event h "replace" "invalidate" '("nextSourceIdentity" . "new"))
        (check (hash-ref (snapshot h) "generation") => 1)
        (check (length (hash-ref (snapshot h) "completedEpochs")) => 1)
        (check (reject (cut event h "stale" "direct-answer" '("resultReference" . "r"))) => #t)
        (check (reject (lambda () (ascent-trajectory (hash ("action" "append") ("trajectory" h)
          ("event" (hash ("id" "stale-ref") ("kind" "direct-answer") ("sourceIdentity" "new") ("resultReference" "r"))))))) => #t)
        (check (hash-ref (snapshot h) "eventCount") => 3)
        (close h)))
    (test-case "duplicate, negative usage and invalid repair rejection are atomic"
      (let (h (open))
        (call h "one" 10)
        (check (reject (cut call h "one" 10)) => #t)
        (check (reject (cut call h "two" 10 "unknown")) => #t)
        (check (reject (cut event h "bad" "model-call" (cons "usage" (hash ("thinkingTokens" -1))))) => #t)
        (check (hash-ref (snapshot h) "eventCount") => 1)
        (check (hash-ref (hash-ref (snapshot h) "totals") "thinkingTokens") => 10)
        (close h)))
    (test-case "closed owner rejects further observation"
      (let (h (open)) (close h) (check (reject (cut snapshot h)) => #t)))))
