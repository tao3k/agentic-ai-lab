(import (only-in "./main.ss" selected-governance)
        (only-in "./init.ss" yuanxu-governance-consumer.init.exports)
        (only-in :clan/poo/object .get .all-slots .ref/cached .cc .o)
        (only-in :tao3k/yuanxu/module-system/source/admission call-with-module-source-operation-measurement))
(export verify-governance-use)
(def (verify-governance-use)
  (defvalues (modules namespace-times)
    (call-with-module-source-operation-measurement
      (lambda () (.get yuanxu-governance-consumer.init.exports modules)) accounting?: #f))
  (unless (and (equal? (.all-slots modules) '(governance))
               (zero? (hash-ref namespace-times '(calls candidate-read) 0))
               (zero? (hash-ref namespace-times '(calls scope-factory) 0))
               (not (.ref/cached modules 'governance)))
    (error "Governance was forced before the first business read"))
  (def started (real-time))
  (defvalues (scope first-times)
    (call-with-module-source-operation-measurement selected-governance accounting?: #f))
  (displayln "LAB-GOVERNANCE-FIRST-GET seconds=" (- (real-time) started))
  (defvalues (again repeat-times)
    (call-with-module-source-operation-measurement selected-governance accounting?: #f))
  (unless (and (eq? scope again)
               (= (hash-ref first-times '(calls candidate-read) 0) 1)
               (= (hash-ref first-times '(calls scope-factory) 0) 1)
               (= (hash-ref first-times '(calls (scope-factory governance)) 0) 1)
               (zero? (hash-ref repeat-times '(calls candidate-read) 0))
               (zero? (hash-ref repeat-times '(calls scope-factory) 0))
               (eq? (.get scope library) 'tao3k/agentic-ai-lab/modules/governance/interface))
    (error "Governance demand differed from the selected closure"))
  (unless (equal? (.get yuanxu-governance-consumer.init.exports tests selected-graph module-order)
                  '(governance))
    (error "Governance test projection differs from runtime selection"))
  (def profile
    (.cc (.get scope Profile)
         identity: "lab/downstream-release" revision: "1" owner: "downstream"))
  (def context (.o request: 'release))
  (def assessment ((.get scope evaluate) profile context))
  (unless (and (eq? (.get assessment kind) 'agentic-ai-lab.governance-assessment)
               (equal? (.get assessment profile-identity) "lab/downstream-release")
               (eq? (.get assessment context) context)
               (null? (.get assessment unresolved-threats))
               (.get assessment handoff-ready?)
               (eq? (.get assessment runtime-executed?) #f))
    (error "Governance release assessment was not an inert handoff" assessment))
  (displayln "LAB-GOVERNANCE-USE-OK declarations=1 scopes=1 assessment=release-ready"))

(def (main) (verify-governance-use))
