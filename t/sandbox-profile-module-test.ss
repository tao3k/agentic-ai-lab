;;; Profiles are modules in a renamed window; sandbox profiles remain domain data.
(import :std/test :clan/poo/object
        (only-in :std/source this-source-file)
        (only-in :std/misc/ports read-all-as-string)
        (only-in :std/text/pregexp pregexp-replace)
        (only-in :clan/poo/mop TypeError?)
        (only-in :gerbil/expander core-import-module expander-context-id)
        (only-in :gerbil/runtime/loader list-modules)
        :agentic-ai-lab/modules/agent-sandbox/interface
        (only-in :tao3k/yuanxu/module-system/building/source-closure for-each-build-module)
        (only-in :tao3k/yuanxu/module-system/interface yuanxu-load-modules)
        (only-in :tao3k/yuanxu/observability/testing-fixture yuanxu-test-fixture)
        (only-in "../core/t/qualification/testing/directory.ss" DirectoryFixture write-source))
(export sandbox-profile-module-test)
(def owner (path-expand ".." (path-directory (this-source-file))))
(.def (ProfileModulesFixture @ DirectoryFixture)
  .prepare:
  (lambda (workspace)
    (def root (.get workspace root))
    (def destination (path-expand "profiles/sandbox" root))
    (create-directory* destination)
    (for-each
      (lambda (role)
        (copy-file (path-expand role (path-expand "profiles/sandbox" owner))
                   (path-expand role destination)))
      '("types.ss" "objects.ss" "config.ss" "interface.ss"))
    (write-source (path-expand "gerbil.pkg" root)
      (string-append "(package: " (symbol->string (gensym 'profile-modules-)) ")\n"))
    (write-source (path-expand "init.ss" root)
      "(import :tao3k/yuanxu/module-system/selection/init-syntax)\n(yuanxu! :load-modules \"./profiles\" mode: explicit rename: Profiles (sandbox))\n")
    (write-source (path-expand "profiles/unselected/interface.ss" root)
      "(error \"unselected Profile was loaded\")\n")
    (.o (:: resource [workspace])
        view: (yuanxu-load-modules (path-expand "init.ss" (.get resource root)))
        scope: (.get (.get resource view) modules Profiles sandbox))))
(def (alist-value key entries)
  (if (object? entries)
    (and (.slot? entries key) (.ref entries key))
    (let (entry (assoc key entries)) (and entry (cdr entry)))))
(def sandbox-profile-module-test
  (test-suite "Unified module Profile configuration"
    (yuanxu-test-fixture "rename changes the window, not module identity or protocol"
      (modules ProfileModulesFixture)
      (def view (.get modules view))
      (check-equal? (.all-slots/sort (.get view modules)) '(Profiles))
      (check-equal? (.get view selected-graph module-order) '(sandbox))
      (check-equal? (.slot? (.get view modules Profiles) 'unselected) #f)
      (def profiles (.get (.get modules scope) profiles))
      (check-equal? (map agentic-ai-lab-sandbox-profile-name profiles) '(agent/nono agent/cube))
      (check-equal? (agentic-ai-lab-sandbox-profile-backend-kind (car profiles)) 'nono)
      (check-equal? (agentic-ai-lab-sandbox-profile-network-policy (cadr profiles))
                    '(allowlisted "github.com" "crates.io")))
    (test-case "business module import closure does not include the retired UI or unrelated engines"
      ;; Walk official import contexts, not Make targets or a second loader.
      (def identities '())
      (for-each-build-module
        (core-import-module ':agentic-ai-lab/modules/agent-sandbox/interface)
        (lambda (context) (set! identities (cons (symbol->string (expander-context-id context)) identities))))
      (for-each
        (lambda (prefix)
          (check-equal? (filter (cut string-prefix? prefix <>) identities) '()))
        '("agentic-ai-lab/modules/workflow/scenario/configuration/"
          "agentic-ai-lab/modules/loop-engine/"
          "agentic-ai-lab/modules/ai-agentic-context/features/memory/config")))
    (yuanxu-test-fixture "repeated scope and preview reads use the official loaded-module cache"
      (modules ProfileModulesFixture)
      (def scope (.get modules scope))
      (def preview (.get scope preview))
      (def loaded (map car (list-modules)))
      (check-equal? (eq? (.get modules scope) scope) #t)
      (check-equal? (eq? (.get scope preview) preview) #t)
      (check-equal? (map car (list-modules)) loaded))
    (test-case "native refinement retains defaults and validates final domain values"
      (.def (Base @ SandboxProfile.)
        name: 'agent/base capabilities: '(process-run filesystem-read tmpdir)
        resource-policy: '((cpu . 2) (memory . "4Gi")))
      ;; Demand/cache the parent before constructing a refined object.
      (def parent (normalize-sandbox-profile SandboxProfile. Base))
      (.def (Operator @ Base)
        name: 'agent/operator
        network-policy: '(allowlisted "github.com" "crates.io")
        (capabilities => append '(cache-mount)))
      (def child (normalize-sandbox-profile SandboxProfile. Operator))
      (check-equal? (agentic-ai-lab-sandbox-profile-capabilities parent)
                    '(process-run filesystem-read tmpdir))
      (check-equal? (agentic-ai-lab-sandbox-profile-capabilities child)
                    '(process-run filesystem-read tmpdir cache-mount))
      (check-equal? (agentic-ai-lab-sandbox-profile-resource-policy child)
                    '((cpu . 2) (memory . "4Gi")))
      (check-exception (normalize-sandbox-profile SandboxProfile. (.o name: 'bad capabilities: 42))
                       TypeError?))
    (yuanxu-test-fixture "cached parent preview stays a snapshot; changed source requires fresh admission"
      (modules ProfileModulesFixture)
      (def view (.get modules view))
      (def parent (.get modules scope))
      (def previous (.get parent preview))
      (def first-profile (car (.get parent profiles)))
      (def file (path-expand "profiles/sandbox/config.ss" (.get modules root)))
      (def original (call-with-input-file file read-all-as-string))
      (write-source file (pregexp-replace "cpu [.] 2" original "cpu . 3"))
      (check-exception (.call view admit-current) error?)
      (def next (yuanxu-load-modules (path-expand "init.ss" (.get modules root))))
      (def final (.get next modules Profiles sandbox))
      (check-equal? (alist-value 'cpu (agentic-ai-lab-sandbox-profile-resource-policy first-profile)) 2)
      (check-equal? (alist-value 'cpu (agentic-ai-lab-sandbox-profile-resource-policy
                                     (car (.get final profiles)))) 3)
      (check-equal? (.ref previous 'profile-count) 2)
      (check-equal? (.get final preview profile-count) 2)
      (.call next admit-current))
    (yuanxu-test-fixture "projects module configuration into validated sandbox values"
      (modules ProfileModulesFixture)
      (def user-sandbox-profiles (.get (.get modules scope) profiles))
      (let* ((nono-profile
              (agentic-ai-lab-sandbox-profile-by-name user-sandbox-profiles
                                                'agent/nono))
             (profile
              (agentic-ai-lab-sandbox-profile->profile nono-profile)))
        (check-equal? (alist-value 'schema profile)
                      'agentic-ai-lab.agent-sandbox-profile.v1)
        (check-equal? (alist-value 'backend-kind profile) 'nono)
        (check-equal? (alist-value 'backend-ref profile) 'nono)
        (check-equal? (alist-value 'network-policy profile)
                      '(deny-by-default))
        (check-equal? (alist-value 'capabilities profile)
                      '(process-run filesystem-read filesystem-write tmpdir))
        (check-equal? (alist-value 'resource-policy profile)
                      '((filesystem
                         (scope . project-workspace)
                         (paths
                          ((role . project-workspace)
                           (source . ".")
                           (project-marker . "gerbil.pkg")
                           (mode . read-write)))
                         (access . read-write))
                        (cpu . 2)
                        (memory . "4Gi")
                        (timeout-ms . 300000)))))
    (yuanxu-test-fixture "previews module values as inert runtime handoff data"
      (modules ProfileModulesFixture)
      (def user-sandbox-profiles (.get (.get modules scope) profiles))
      (let* ((presentation
              (agenticAiLabSandboxProfilesPresentation user-sandbox-profiles))
             (runtime-intents (.ref presentation 'runtime-intents))
             (runtime-summaries (.ref presentation 'runtime-summaries))
             (handoff-summaries (.ref presentation 'handoff-summaries))
             (policy-projections (.ref presentation 'policy-projections))
             (nono-intent (car runtime-intents))
             (cube-intent (cadr runtime-intents))
             (nono-summary (car runtime-summaries))
             (nono-filesystem (alist-value 'filesystem nono-summary))
             (cube-handoff (cadr handoff-summaries))
             (cube-handoff-summary
              (alist-value 'runtime-summary cube-handoff))
             (nono-policy (car policy-projections))
             (nono-policy-validation
              (alist-value 'validation nono-policy))
             (nono-intent-policy
              (alist-value 'policy-projection nono-intent))
             (nono-durable-summary
              (alist-value 'durable-policy-summary nono-intent))
             (nono-policy-durable-summary
              (alist-value 'durable-policy-summary nono-policy)))
        (check-equal? (.ref presentation 'kind)
                      agentic-ai-lab-sandbox-profiles-presentation-kind)
        (check-equal? (.ref presentation 'profile-count) 2)
        (check-equal? (.ref presentation 'profile-names)
                      '(agent/nono agent/cube))
        (check-equal? (length runtime-summaries) 2)
        (check-equal? (length handoff-summaries) 2)
        (check-equal? (length policy-projections) 2)
        (check-equal? (.ref presentation 'policy-valid?) #t)
        (check-equal? (.ref presentation 'policy-diagnostics) '())
        (check-equal? (alist-value 'backend-kind nono-intent) 'nono)
        (check-equal? (alist-value 'backend-ref cube-intent) 'cube-local)
        (check-equal? (alist-value 'policy-valid? nono-intent) #t)
        (check-equal? (alist-value 'kind nono-intent-policy)
                      "agentic-ai-lab.sandbox.profile-policy.projection.v1")
        (check-equal? (alist-value 'durable-policy-ref nono-intent)
                      'durable/default)
        (check-equal? (alist-value 'durable-valid? nono-intent) #t)
        (check-equal? (alist-value 'sandbox-handle-class nono-intent)
                      'sandbox/profile-handle)
        (check-equal? (alist-value 'journal-owner nono-durable-summary)
                      'runtime/fact-log)
        (check-equal? (alist-value 'checkpoint-store nono-durable-summary)
                      'runtime/checkpoint-store)
        (check-equal? (alist-value 'runtime-owner nono-intent)
                      "marlin-agent-core")
        (check-equal? (alist-value 'descriptor-realized? cube-intent) #f)
        (check-equal? (alist-value 'runtime-executed cube-intent) #f)
        (check-equal? (alist-value 'schema nono-summary)
                      'agentic-ai-lab.agent-sandbox-profile.runtime-summary.v1)
        (check-equal? (alist-value 'profile-name nono-summary) 'agent/nono)
        (check-equal? (alist-value 'descriptor-realized? nono-summary) #t)
        (check-equal? (alist-value 'valid? nono-summary) #t)
        (check-equal? (alist-value 'path-count nono-filesystem) 1)
        (check-equal? (alist-value 'scope nono-filesystem)
                      'project-workspace)
        (check-equal? (alist-value 'schema cube-handoff)
                      'agentic-ai-lab.agent-sandbox-profile.handoff-summary.v1)
        (check-equal? (alist-value 'handoff-contract cube-handoff)
                      'agentic-ai-lab.agent-sandbox-profile.runtime-handoff.v1)
        (check-equal? (alist-value 'schema cube-handoff-summary)
                      'agentic-ai-lab.agent-sandbox-profile.runtime-summary.v1)
        (check-equal? (alist-value 'kind nono-policy)
                      "agentic-ai-lab.sandbox.profile-policy.projection.v1")
        (check-equal? (alist-value 'valid? nono-policy) #t)
        (check-equal? (alist-value 'durable-policy-ref nono-policy)
                      'durable/default)
        (check-equal? (alist-value 'repair-mode nono-policy-durable-summary)
                      'fail-closed)
        (check-equal? (alist-value 'valid? nono-policy-validation) #t)
        (check-equal? (alist-value 'durable-valid? nono-policy-validation)
                      #t)
        (check-equal? (alist-value 'diagnostic-count nono-policy-validation)
                      0)
        (check-equal? (.ref presentation 'runtime-executed) #f)))))
