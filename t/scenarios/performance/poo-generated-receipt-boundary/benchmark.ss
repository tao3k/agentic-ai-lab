((benchmarkKind . scenario-e2e)
 (max_total . 100ms)
 (target_total . 25ms)
 (regression_budget . 75ms)
 (expected_over_input_budget . 0ms)
 (sampleCount . 20)
 (targetRationale . "Replicates upstream generated receipt boundary with defstruct-owned construction and one ->alist projection boundary.")
 (maxRssMb . 512)
 (memoryMetric . resident-set-size)
 (memoryUnit . "MB")
 (iterations . 1000)
 (unit . "ms")
 (purpose . "Guard generated receipt projection against repeated POO/alist traversal at runtime-language boundaries.")
 (sourcePath . "t/scenarios/performance/poo-generated-receipt-boundary/benchmark.ss")
 (feature . poo-generated-receipt-boundary)
 (rule . GERBIL-SCHEME-AGENT-R044)
 (optimizationFocus . "generated receipt struct plus one explicit ->alist boundary")
 (inputShape . "runtime receipt projected by repeatedly traversing object slots")
 (expectedOutcome . "the poo-generated-receipt-boundary scenario preserves its declared semantic result under the ASP P95 gate")
 (expectedRepair . "generate receipt accessors and project to alist only at the runtime boundary")
 (pooFormEvidence .o .def defpoo)
 (pooUsageCallEvidence .ref .get .mix .o .def .putdefault! .setslot! setslots! .all-slots)
 (runtimePooPrimary . #t)
 (adapterBoundary . "alist projection is a boundary operation, not a control-plane hot path")
 (hotPathExemption . "no repeated object slot traversal for generated receipt projection")
 (hotPathEvidence . "t/scenarios/performance/poo-generated-receipt-boundary/exercise.ss")
 (styleRewriteBoundary . "do not use raw alist as public control-plane representation; generate receipt boundary accessors")
 (measurementPhases receipt-construction receipt-projection scenario-load
                    assert-time-gate observe-runtime-memory)
 (tags module-system poo receipt generated-boundary performance scenario))
