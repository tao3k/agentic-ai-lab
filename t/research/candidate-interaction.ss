;;; Finite Library consumer: no search controller or workflow dependencies.
(import :std/encoding/json :std/error
        :agentic-ai-lab/modules/evidence-assessment/candidate/evidence-store
        :gerbil-ascent/candidate/feedback
        (only-in :gerbil-ascent/candidate/checked-program
                 reasoning-source-snapshot reasoning-attempt
                 reasoning-receipt-status reasoning-receipt-rows
                 reasoning-receipt-diagnostics reasoning-diagnostic-code
                 reasoning-diagnostic-detail))
(export main)
(def edges '((0 1) (0 2) (1 0) (1 2) (2 0) (2 1)))
(def (ordinals n) (let loop ((i 0)) (if (= i n) [] (cons i (loop (+ i 1))))))
(def (graph mask)
  (filter-map (lambda (edge index) (and (not (zero? (bitwise-and mask (arithmetic-shift 1 index)))) edge)) edges (ordinals 6)))
;;; Independent finite walk over (vertex, parity), not an ASCENT evaluator.
;;; Seed with actual outgoing edges, so zero-length walks are never added.
(def (walk pairs origin even?)
  (let loop ((pending (map (lambda (e) (list (cadr e) 1))
                          (filter (lambda (e) (= origin (car e))) pairs))) (seen []))
    (if (null? pending)
      (filter-map (lambda (v) (and (ormap (lambda (s) (and (= v (car s))
                                  (or (not even?) (= 0 (cadr s))))) seen) v)) '(0 1 2))
      (let (s (car pending))
        (if (member s seen) (loop (cdr pending) seen)
          (loop (append (cdr pending)
                  (map (lambda (e) (list (cadr e) (- 1 (cadr s))))
                       (filter (lambda (e) (= (car s) (car e))) pairs))) (cons s seen)))))))
(def (expected case-id pairs)
  (if (= case-id 2)
    (map list (filter (lambda (v) (member v (walk pairs 1 #f))) (walk pairs 0 #f)))
    (apply append (map (lambda (u) (map (lambda (v) (list u v))
                                        (walk pairs u (= case-id 1)))) '(0 1 2)))))
(def (proposal case-id rules (row-budget 64))
  (append '(candidate (relation path 2))
          (if (= case-id 2) '((relation both 1)) [])
          (map (lambda (r) (cons 'rule r)) rules)
          (list (if (= case-id 2) '(query both ?z) '(query path ?x ?y))
                (list 'limits 16 row-budget 128))))
(def (source case-id generation pairs)
  (reasoning-source-snapshot (string-append "library-candidate-" (number->string case-id)) generation
    (append (list (list 'edge 2 pairs))
            (if (= case-id 2) '((left 1 ((0))) (right 1 ((1)))) []))))
(def (wire x)
  (cond ((symbol? x) (symbol->string x)) ((pair? x) (map wire x)) (else x)))
(def (symbols x)
  (cond ((string? x) (string->symbol x)) ((list? x) (map symbols x))
        ((and (integer? x) (exact? x)) x) (else (error "invalid rule datum"))))
(def (observe case-id generation pairs rules)
  (let* ((s (source case-id generation pairs)) (p (proposal case-id rules))
         (r (reasoning-attempt s p #f))
         (wanted (expected case-id pairs)) (f (reasoning-compare-rows s p r wanted)))
    (hash ("generation" generation) ("edges" pairs) ("expected" wanted)
          ("nativeStatus" (wire (reasoning-receipt-status r)))
          ("actual" (reasoning-receipt-rows r))
          ("status" (wire (reasoning-feedback-status f)))
          ("diagnostics" (map (lambda (d)
            (hash ("code" (wire (reasoning-diagnostic-code d)))
                  ("detail" (reasoning-diagnostic-detail d)))) (reasoning-receipt-diagnostics r)))
          ("reason" (wire (reasoning-feedback-reason f)))
          ("missing" (reasoning-feedback-missing f)) ("extra" (reasoning-feedback-extra f)))))
(def correct
  '(((path ?x ?y) (edge ?x ?y))
    ((path ?x ?z) (path ?x ?y) (edge ?y ?z))))
(def even-rules
  '(((path ?x ?z) (edge ?x ?y) (edge ?y ?z))
    ((path ?x ?w) (path ?x ?y) (edge ?y ?z) (edge ?z ?w))))
(def both-rules
  (append correct '(((both ?z) (left ?x) (right ?y) (path ?x ?z) (path ?y ?z)))))
(def (grade case-id rules)
  ;; 0,1,3,9 are visible development masks. All remaining masks are held out.
  (map (lambda (mask) (observe case-id mask (graph mask) rules))
       (filter (lambda (mask) (not (member mask '(0 1 3 9)))) (ordinals 64))))
(def (qualification group)
  (let ((checks 0) (mutants
        (list correct (cdr correct) (list (car correct))
              '(((path ?x ?y) (edge ?x ?y)) ((path ?x ?z) (path ?x ?y) (edge ?x ?z)))
              '(((path ?x ?y) (edge ?y ?x)) ((path ?x ?z) (path ?x ?y) (edge ?y ?z))))))
    (for-each (lambda (rules index)
      (when (= group index)
      (let (mismatches 0)
        (for-each (lambda (mask)
          (let (r (observe 0 mask (graph mask) rules))
            (unless (string=? (hash-ref r "nativeStatus") "complete") (error "incomplete control" r))
            (unless (string=? (hash-ref r "status") "match") (set! mismatches (+ mismatches 1)))
            (set! checks (+ checks 1)))) (ordinals 64))
        (unless (if (= index 0) (= mismatches 0) (> mismatches 0)) (error "mutant control failed")))))
      mutants (ordinals 5))
    (for-each (lambda (id rules)
      (when (= group (+ id 4))
      (for-each (lambda (mask)
        (unless (string=? (hash-ref (observe id mask (graph mask) rules) "status") "match")
          (error "independent walk disagrees")) (set! checks (+ checks 1))) (ordinals 64))))
      '(1 2) (list even-rules both-rules))
    (when (= group 7)
     (let* ((s (source 0 0 (graph 8))) (p (proposal 0 correct)) (r (reasoning-attempt s p #f)))
      (unless (eq? (reasoning-feedback-reason
                    (reasoning-compare-rows (source 0 1 (graph 8)) p r (expected 0 (graph 8)))) 'unbound)
        (error "stale receipt accepted")))
    (let* ((s (source 0 0 (graph 9))) (p (proposal 0 correct 1))
           (r (reasoning-attempt s p #f)) (f (reasoning-compare-rows s p r (expected 0 (graph 9)))))
      (when (eq? (reasoning-feedback-status f) 'match) (error "bounded failure became match"))))
    (hash ("checks" checks) ("staleRejected" (= group 7)) ("boundedNotMatch" (= group 7)))))
(def (dispatch request)
  (let (op (hash-ref request "op"))
    (cond
      ((string=? op "reuse-init") (reuse-init request))
      ((string=? op "reuse-packet") (reuse-packet request))
      ((string=? op "reuse-episode") (reuse-episode request))
      ((string=? op "qualify") (qualification (hash-ref request "group")))
      (else
      (let* ((id (hash-ref request "case")) (rules (symbols (hash-ref request "rules"))))
        (unless (member id '(0 1 2)) (error "invalid case"))
        (cond ((string=? op "grade") (grade id rules))
              ((string=? op "feedback")
               (map (lambda (mask) (observe id mask (graph mask) rules)) '(0 1 3 9)))
              (else (error "invalid operation"))))))))
(def reuse-store #f)
(def reuse-source #f)
(def reuse-handle #f)
(def reuse-needs [])
(def reuse-candidate
  '(candidate (relation path 2) (relation ready 1)
     (rule (path ?x ?y) (edge ?x ?y))
     (rule (path ?x ?z) (path ?x ?y) (edge ?y ?z))
     (rule (ready ?f) (need ?f ?u ?v ?x ?y) (path ?u ?v) (path ?x ?y))
     (query ready ?f) (limits 256 1024 1024)))
(def (field key pairs) (cadr (assq key pairs)))
(def (reuse-init request)
  (set! reuse-store (reasoning-open-program-store))
  (set! reuse-needs (hash-ref request "needs"))
  (set! reuse-source (reasoning-source-snapshot (hash-ref request "identity") 0
    (list (list 'edge 2 (hash-ref request "edges")) (list 'need 5 reuse-needs))))
  (let (answer (reasoning-resolve-evidence reuse-store reuse-source reuse-candidate))
    (unless (eq? (field 'status answer) 'verified) (error "unverified source" answer))
    (set! reuse-handle (field 'handle answer))
    (hash ("rows" (field 'rows answer)) ("scope" (wire (field 'scope answer))))))
(def (reuse-fact atom)
  (reasoning-evidence-fact reuse-store reuse-source reuse-candidate reuse-handle atom))
(def (reuse-packet request)
  (let* ((ids (hash-ref request "fragments"))
         (answer (reasoning-resolve-evidence reuse-store reuse-source reuse-candidate))
         (atoms (let (seen [])
                  (for-each (lambda (id)
                    (let (n (assoc id reuse-needs))
                      (unless n (error "unknown fragment" id))
                      (for-each (lambda (a) (unless (member a seen) (set! seen (cons a seen))))
                        (list (list 'ready id) (list 'path (list-ref n 1) (list-ref n 2))
                              (list 'path (list-ref n 3) (list-ref n 4)))))) ids)
                  (reverse seen)))
         (facts (map reuse-fact atoms))
         (alternatives (map (lambda (id) (list id (list (list 'ready id)))) ids))
         (partition (reasoning-evidence-partition reuse-store reuse-source reuse-candidate reuse-handle alternatives))
         (pieces (map (lambda (id) (reasoning-evidence-fragment reuse-store reuse-source reuse-candidate reuse-handle (list 'ready id))) ids))
         (nodes (let (seen [])
                  (for-each (lambda (piece)
                    (when (eq? (field 'status piece) 'verified)
                      (for-each (lambda (node) (unless (assoc (car node) seen) (set! seen (cons node seen))))
                                (field 'nodes piece)))) pieces)
                  (reverse seen))))
    (hash ("facts" (map (lambda (a) (hash ("atom" (wire (field 'atom a)))
                                           ("present" (field 'present a)))) facts))
          ("fragments" (map (lambda (id piece) (hash ("id" id)
                        ("roots" (if (eq? (field 'status piece) 'verified) (field 'roots piece) [])))) ids pieces))
          ("nodes" (wire nodes)) ("allowed" (field 'allowed partition))
          ("pruned" (field 'pruned partition)) ("reused" (field 'reused answer))
          ("stats" (wire (reasoning-evidence-store-stats reuse-store))))))
(def (reuse-episode request)
  (let* ((atom (symbols (hash-ref request "atom")))
         (premises (symbols (hash-ref request "premises")))
         (present? (lambda (a) (eq? (field 'status (reuse-fact a)) 'verified)))
         (supported
          (and (pair? premises) (andmap present? premises)
               (case (car atom)
                 ((ready) (let (n (assoc (cadr atom) reuse-needs))
                            (and n (equal? premises
                              (list (list 'path (list-ref n 1) (list-ref n 2))
                                    (list 'path (list-ref n 3) (list-ref n 4)))))))
                 ((path) (and (or (pair? (cdr premises)) (eq? (caar premises) 'edge))
                         (let loop ((at (cadr atom)) (rest premises))
                           (if (null? rest) (= at (caddr atom))
                             (and (memq (caar rest) '(edge path)) (= at (cadar rest))
                                  (loop (caddar rest) (cdr rest)))))))
                 (else #f)))))
    (hash ("present" (present? atom)) ("supportQualified" (and supported #t)))))
(def (main . args)
  (when (member "--dynamic-evidence" args)
    (let (before GerbilAscentEvidenceStoreContract)
      (load (path-expand "lib/gerbil-ascent/candidate/evidence-store.o1" (getenv "GERBIL_PATH")))
      (when (eq? before GerbilAscentEvidenceStoreContract) (error "dynamic module did not initialize"))))
  (displayln "{\"ready\":true}") (force-output)
  (let loop ()
    (let (line (read-line))
      (unless (eof-object? line)
        (displayln (json->string
          (try (dispatch (parameterize ((current-json-read-options (JSONReadOptions object-as-hash: #t)))
                           (call-with-input-string line read-json)))
               (catch (e) (hash ("error" (exception->string e)))))))
        (force-output) (loop)))))
