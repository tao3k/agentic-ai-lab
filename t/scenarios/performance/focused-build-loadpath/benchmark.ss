((benchmarkKind . scenario-e2e)
 (max_total . 20ms)
 (target_total . 15ms)
 (regression_budget . 5ms)
 (expected_over_input_budget . 5ms)
 (sampleCount . 20)
 (targetRationale . "Focused build routing is an argv/loadpath gate; full package builds remain owned by gxpkg build -R -O.")
 (maxRssMb . 64)
 (memoryMetric . resident-set-size)
 (memoryUnit . "MB")
 (iterations . 100)
 (unit . "ms")
 (sourcePath . "t/scenarios/performance/focused-build-loadpath/benchmark.ss")
