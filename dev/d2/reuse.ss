;;; Generic SDK/POO process adapter. No model-specific imports or layout policy.
(import :clan/poo/object
        (only-in :std/encoding/json json->string)
        (only-in :std/crypto/digest sha256)
        (only-in :std/encoding/hex hex-encode)
        (only-in :std/misc/ports read-all-as-u8vector)
        (only-in :std/list/list find delete-duplicates/hash)
        (only-in "./init.ss" tao3k/agentic-ai-lab/dev/d2.init.exports)
        (only-in "./output/reuse-input.ss" NativeCapture DesignCase DesignReadings))
(export main)
(def Scope (.get tao3k/agentic-ai-lab/dev/d2.init.exports modules d2))
(def Context. (.get Scope prototypes AuthoringContext))
(def (s value) (if (symbol? value) (symbol->string value) value))
(def (emit value) (display (json->string value)) (newline) (force-output))
(def (wire-object pairs)
  (def table (make-hash-table))
  (for-each (lambda (pair) (hash-put! table (car pair) (cdr pair))) pairs) table)
(def (wire-rows objects slots)
  (map (lambda (value) (map (lambda (slot) (s (.ref value slot))) slots)) objects))
(def (main (mode "describe"))
  (.get tao3k/agentic-ai-lab/dev/d2.init.exports std-make-spec)
  (if (equal? mode "describe")
    (emit (wire-object
      (cons (cons "intro" (if (.slot? DesignCase 'intro) (.ref DesignCase 'intro) ""))
      (cons (cons "inputs" (if (.slot? DesignCase 'inputs) (.ref DesignCase 'inputs) '()))
      (cons (cons "layoutOptions" (if (.slot? DesignCase 'layout-options) (wire-rows (.ref DesignCase 'layout-options) '(name value)) '()))
      (cons (cons "direction" (s (if (.slot? DesignCase 'direction) (.ref DesignCase 'direction) (.get Scope config direction))))
        (map (lambda (slot) (cons (symbol->string slot) (s (.ref DesignCase slot))))
          '(identity org models view audience title primary width))))))))
    (let* ((view-value (.ref NativeCapture 'view))
           (scene-value ((.get Scope scene) NativeCapture (.ref DesignCase 'choices) (.ref DesignCase 'facet-needs)))
           (choices (.ref DesignCase 'choices))
           (needs (.ref DesignCase 'facet-needs))
           (v (.ref view-value 'identity)) (r (.ref view-value 'revision)))
      (unless (null? (.ref scene-value 'missing-choices))
        (error "model must supply an image/explanation choice for a needed source object" (.ref scene-value 'missing-choices)))
      (for-each (lambda (entry)
        (unless (equal? (cadr entry) (hex-encode (sha256 (call-with-input-file (car entry) read-all-as-u8vector))))
          (error "source/candidate changed; recapture before evaluating" (car entry)))) (.ref NativeCapture 'source-hashes))
      (for-each (lambda (render-value)
        (unless (equal? (.ref render-value 'image-sha)
          (hex-encode (sha256 (call-with-input-file (.ref render-value 'image-ref) read-all-as-u8vector))))
          (error "stale rendered image bytes" (.ref render-value 'image-ref)))) (.ref NativeCapture 'renders))
      (def plan-value
        (.o views: (list view-value)
            object-states: (map (lambda (target) (.o view: v revision: r subject: target state: 'captured))
              (delete-duplicates/hash (map (lambda (need) (.ref need 'target)) needs)))
            goals: (map (lambda (need) (.o view: v revision: r subject: (.ref need 'target) concept: (.ref need 'facet))) needs)
            prerequisites: '()
            audience-gaps: (map (lambda (need) (.o audience: (.ref DesignCase 'audience) concept: (.ref need 'facet))) needs)
            distinctions: (map (lambda (need) (.o concept: (.ref need 'facet) facet: (.ref need 'facet))) needs)
            candidates: (map (lambda (choice) (.o identity: (.ref choice 'source-ref)
              subject: (.ref choice 'source-ref) state: 'captured asset-ref: (.ref choice 'glyph))) choices)
            makes-visible: (map (lambda (need) (.o candidate: (.ref need 'target) facet: (.ref need 'facet))) needs)
            meaning-reviews: '() critiques: '() goal-inventories: (list (.o view: v revision: r))))
      (def teaching-value
        (and (.slot? DesignCase 'teaching)
             ((.get Scope teaching) NativeCapture (.ref DesignCase 'teaching) needs
               (.ref DesignCase 'mechanism) (.ref Scope 'config))))
      (def author-result
        ((.get Scope author)
          (.o (:: @ Context.) views: (list view-value) explanation-plan: plan-value
              questions: (.ref DesignCase 'questions) facet-needs: needs
              inspections: (.ref DesignReadings 'inspections) image-evidence: (.ref DesignReadings 'image-evidence)
              representation-gaps: (.ref DesignReadings 'representation-gaps) layout-concerns: (.ref DesignReadings 'layout-concerns)
              structure-gaps: (if teaching-value (.ref teaching-value 'structure-gaps) '())
              route-needs: (append (if teaching-value (.get teaching-value composition route-needs) '())
                (if (.slot? DesignCase 'route-needs) (.ref DesignCase 'route-needs) '()))
              image-routes: (if (.slot? NativeCapture 'image-routes) (.ref NativeCapture 'image-routes) '())
              minimum-reader-text: (if teaching-value (.get teaching-value composition minimum-reader-text) 0)
              visual-expressions: (if teaching-value (.get teaching-value composition expressions) '())
              image-anchors: (.ref NativeCapture 'image-anchors) proposals: (.ref NativeCapture 'proposals)
              renders: (.ref NativeCapture 'renders))))
      (when (and teaching-value
                 (or (pair? (.ref teaching-value 'missing)) (pair? (.ref teaching-value 'unsupported))
                     (pair? (.ref teaching-value 'unsupported-links))))
        (error "teaching proposal lacks a native target or located source quotation"
          (.ref teaching-value 'missing) (.ref teaching-value 'unsupported)))
      (when (and teaching-value (or (pair? (.ref teaching-value 'invalid-attachments))
                                    (pair? (.ref teaching-value 'cyclic-attachments))
                                    (pair? (.ref teaching-value 'invalid-negations))
                                    (pair? (.ref teaching-value 'invalid-regions))))
        (error "invalid explanatory attachment" (.ref teaching-value 'invalid-attachments)
          (.ref teaching-value 'cyclic-attachments) (.ref teaching-value 'invalid-negations)
          (.ref teaching-value 'invalid-regions)))
      ((.get tao3k/agentic-ai-lab/dev/d2.init.exports admit-current))
      ;; Final process handoff only; the editable source remains POO/SysML.
      (emit (wire-object
        (list (cons "nodes" (wire-rows (.ref scene-value 'nodes) '(identity source-ref label glyph role rationale kind parent)))
              (cons "teaching" (if teaching-value
                (wire-rows (.ref teaching-value 'items)
                  '(identity question facet target glyph title explanation rationale source excerpt)) '()))
              (cons "composition" (if teaching-value
                (let (c (.ref teaching-value 'composition))
                  (wire-object (list (cons "direction" (s (.ref c 'direction)))
                    (cons "expressions" (wire-rows (.ref c 'expressions)
                      '(identity owner question facet target kind token role-label quantity-label meaning use scale)))
                    (cons "reflections" (map (lambda (r) (map s r)) (.ref c 'reflections)))
                    (cons "divergences" (map (lambda (r) (map s r)) (.ref c 'divergences)))
                    (cons "explorations" (map (lambda (r) (map s r)) (.ref c 'explorations)))
                    (cons "options" (wire-rows (.ref c 'layout-options) '(name value)))
                    (cons "near" (map (lambda (r) (map s r)) (.ref c 'near)))
                    (cons "comparisons" (map (lambda (r) (map s r)) (.ref c 'comparisons)))
                    (cons "checks" (map (lambda (r) (map s r)) (.ref c 'checks)))
                    (cons "nonSequential" (map (lambda (r) (map s r)) (.ref c 'non-sequential)))
                    (cons "edges" (map (lambda (e) (wire-object (list
                      (cons "id" (s (.ref e 'identity)))
                      (cons "options" (wire-rows (.ref e 'options) '(name value)))))) (.ref c 'edge-options)))))) #f))
              (cons "links" (if teaching-value (wire-rows (.ref teaching-value 'links)
                '(identity from to role label style source excerpt propagates?)) '()))
              (cons "missingLinks" (if teaching-value (map (lambda (r) (map s r)) (.ref teaching-value 'missing-links)) '()))
              (cons "missingTraces" (if teaching-value (map (lambda (r) (map s r)) (.ref teaching-value 'missing-traces)) '()))
              (cons "attachments" (if teaching-value (map (lambda (r) (map s r)) (.ref teaching-value 'attachments)) '()))
              (cons "regions" (if teaching-value
                (map (lambda (g) (wire-object
                  (list (cons "id" (s (.ref g 'identity))) (cons "label" (.ref g 'label))
                    (cons "visible" (.ref g 'visible?))
                    (cons "members" (map s (.ref g 'members)))
                    (cons "options" (wire-rows (.ref g 'layout-options) '(name value))))))
                  (.ref teaching-value 'regions)) '()))
              (cons "questions" (wire-rows (.ref DesignCase 'questions) '(identity text)))
              (cons "needs" (wire-rows needs '(question facet target)))
              (cons "requests" (wire-rows (.ref author-result 'requests) '(kind view revision source-cut subject basis)))
              (cons "answers" (map (lambda (row) (map s row)) (.ref author-result 'answers)))
              (cons "grounded" (map (lambda (row) (map s row)) ((.get author-result inspection rows-of) 'GroundedFacet)))
              (cons "representations" (map (lambda (row) (map s row)) ((.get author-result inspection rows-of) 'ChangeRepresentation)))
              (cons "layout" (map (lambda (row) (map s row)) ((.get author-result inspection rows-of) 'ChangeLayout)))))))))
