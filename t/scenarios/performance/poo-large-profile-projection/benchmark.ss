((benchmarkKind . scenario-e2e)
 (max_total . 100ms)
 (target_total . 25ms)
 (regression_budget . 75ms)
 (expected_over_input_budget . 0ms)
 (sampleCount . 20)
 (targetRationale . "Replicates upstream large POO profile projection with .o, static projection specs, and a single descriptor boundary.")
 (maxRssMb . 512)
 (memoryMetric . resident-set-size)
 (memoryUnit . "MB")
 (iterations . 1000)
 (unit . "ms")
 (purpose . "Guard large POO profile projection against adapter-heavy hot paths.")
 (sourcePath . "t/scenarios/performance/poo-large-profile-projection/benchmark.ss")
 (feature . poo-large-profile-projection)
 (rule . GERBIL-SCHEME-AGENT-R043)
 (optimizationFocus . "POO object plus static projection specs and boundary-only vector projection")
 (inputShape . "profile metadata adapted from alist and projected repeatedly")
 (expectedOutcome . "the poo-large-profile-projection scenario preserves its declared semantic result under the ASP P95 gate")
 (expectedRepair . "make .o primary, make projection specs static, and project descriptors at one boundary")
 (pooFormEvidence .o .def defpoo)
 (pooUsageCallEvidence .ref .get .mix .o .def .putdefault! .setslot! setslots! .all-slots)
 (runtimePooPrimary . #t)
 (adapterBoundary . "alist adapters are not used in the hot projection path")
 (hotPathExemption . "no object<-alist in projection loop")
 (hotPathEvidence . "t/scenarios/performance/poo-large-profile-projection/exercise.ss")
 (styleRewriteBoundary . "do not replace POO object; move adapter and projection work to a single boundary")
 (measurementPhases projection-specs descriptor-boundary scenario-load
                    assert-time-gate observe-runtime-memory)
 (tags module-system poo profile projection poo-object performance scenario))
