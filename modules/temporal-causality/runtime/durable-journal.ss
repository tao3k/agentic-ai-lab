;;; SQLite commit is the publication boundary. Inert POO data, never code replay.
(import (only-in :clan/poo/object .o .ref object? .alist/sort object<-alist)
        (only-in :std/db/sqlite sqlite-open) (only-in :std/db/db new-db)
        :std/db/interface
        (only-in :std/crypto/digest sha256) (only-in :std/encoding/hex hex-encode)
        (only-in :agentic-ai-lab/modules/workflow/runtime/scheme-wire scheme-wire-read))
(export journal-open journal-close! journal-closed? journal-input journal-get journal-put! journal-evidence!
        journal-receive! journal-begin! journal-commit! journal-abort! journal-rows
        journal-terminal! journal-verify! journal-epoch journal-active? journal-pack journal-unpack journal-hash journal-cut!)
(def (journal-hash value) (string-append "sha256:" (hex-encode (sha256 (string->utf8 value)))))
;;; Emit the existing v1 wire bytes directly instead of allocating an encoded
;;; tree and traversing it again. All values use ONE output port: no fragment
;;; ports, retained object caches, or repeated copies through ancestor strings.
;;; The original depth bound applies independently to every visited occurrence.
(def (journal-pack value)
  (def (emit x depth port)
    (when (> depth 40) (error "Journal value depth"))
    (def (next v) (emit v (+ depth 1) port))
    (def (sequence values)
      (for-each (lambda (v) (display " " port) (next v)) values))
    (cond
     ((object? x)
      (display "(list \"poo\" (list" port)
      (for-each
       (lambda (entry)
         (display " (list " port)
         (write (symbol->string (car entry)) port)
         (display " " port)
         (next (cdr entry))
         (display ")" port))
       (.alist/sort x))
      (display "))" port))
     ((symbol? x)
      (display "(list \"symbol\" " port)
      (write (symbol->string x) port) (display ")" port))
     ((list? x)
      (display "(list \"list\" (list" port)
      (sequence x) (display "))" port))
     ((pair? x)
      (display "(list \"pair\" " port)
      (next (car x)) (display " " port) (next (cdr x)) (display ")" port))
     ((vector? x)
      (display "(list \"vector\" (list" port)
      (sequence (vector->list x)) (display "))" port))
     ((and (real? x) (or (inexact? x) (not (integer? x))))
      (display "(list \"number\" " port)
      (write (number->string x) port) (display ")" port))
     ((or (boolean? x) (string? x) (exact-integer? x))
      (display "(list \"scalar\" " port)
      (write x port) (display ")" port))
     (else (error "Nonportable native capability in journal"))))
  (call-with-output-string (lambda (port) (emit value 0 port))))
(def (decode x)
  (unless (and (list? x) (pair? x)) (error "Invalid journal encoding"))
  (case (string->symbol (car x))
    ((poo) (object<-alist (map (lambda (p) (cons (string->symbol (car p)) (decode (cadr p)))) (cadr x))))
    ((symbol) (string->symbol (cadr x))) ((scalar) (cadr x))
    ((number) (let (n (string->number (cadr x)))
      (unless (and (real? n) (= n n) (not (= (abs n) +inf.0))) (error "Invalid durable number")) n))
    ((list) (map decode (cadr x))) ((vector) (list->vector (map decode (cadr x))))
    ((pair) (cons (decode (cadr x)) (decode (caddr x))))
    (else (error "Unknown inert journal tag"))))
(def (journal-unpack value) (decode (scheme-wire-read value)))
(defstruct journal-state (db owner epoch active key poisoned? cut closed?))
(def (state host (allow-closed? #f))
  (let (s (.ref host 'private-journal))
    (unless (journal-state? s) (error "Invalid durable journal"))
    (when (and (journal-state-closed? s) (not allow-closed?)) (error "Journal is closed"))
    (unless (or (journal-state-closed? s) (eq? (journal-state-owner s) (current-thread)))
      (error "Journal requires serialized owner")) s))
(def (exec s text . args) (DB-exec! (journal-state-db s) text args))
(def (query s text . args)
  (map (lambda (row) (if (vector? row) row (vector row))) (DB-query (journal-state-db s) text args)))
(def (fence! s)
  (unless (= (journal-state-epoch s) (vector-ref (car (query s "SELECT epoch FROM owner WHERE id=1")) 0))
    (error "Durable owner epoch superseded")))
(def (journal-open path)
  (let* ((db (new-db (sqlite-open path))) (s (make-journal-state db (current-thread) 0 #f #f #f #f #f)))
    (exec s "PRAGMA journal_mode=WAL") (exec s "PRAGMA synchronous=FULL")
    (exec s "PRAGMA busy_timeout=5000")
    (exec s "CREATE TABLE IF NOT EXISTS owner(id INTEGER PRIMARY KEY CHECK(id=1), epoch INTEGER NOT NULL)")
    (exec s "CREATE TABLE IF NOT EXISTS state(k TEXT PRIMARY KEY, payload TEXT NOT NULL, digest TEXT NOT NULL)")
    (exec s "CREATE TABLE IF NOT EXISTS evidence(k TEXT PRIMARY KEY, payload TEXT NOT NULL, digest TEXT NOT NULL)")
    (exec s "CREATE TABLE IF NOT EXISTS inbox(id TEXT PRIMARY KEY, payload TEXT NOT NULL, digest TEXT NOT NULL, status TEXT NOT NULL, epoch INTEGER NOT NULL)")
    (exec s "CREATE TABLE IF NOT EXISTS versions(seq INTEGER PRIMARY KEY AUTOINCREMENT, event TEXT NOT NULL, k TEXT NOT NULL, payload TEXT NOT NULL, digest TEXT NOT NULL)")
    (exec s "CREATE TABLE IF NOT EXISTS terminals(session TEXT, attempt TEXT, generation INTEGER, payload TEXT NOT NULL, digest TEXT NOT NULL, PRIMARY KEY(session,attempt,generation))")
    (exec s "CREATE TABLE IF NOT EXISTS log(seq INTEGER PRIMARY KEY AUTOINCREMENT, epoch INTEGER NOT NULL, id TEXT NOT NULL, digest TEXT NOT NULL, previous TEXT NOT NULL, state_digest TEXT NOT NULL, hash TEXT NOT NULL)")
    (exec s "BEGIN IMMEDIATE")
    (exec s "INSERT OR IGNORE INTO owner VALUES(1,0)") (exec s "UPDATE owner SET epoch=epoch+1 WHERE id=1")
    (set! (journal-state-epoch s) (vector-ref (car (query s "SELECT epoch FROM owner WHERE id=1")) 0))
    (exec s "COMMIT")
    (.o kind: 'temporal.durable-journal.v1 private-journal: s)))
(def (journal-closed? host)
  (journal-state-closed? (.ref host 'private-journal)))
(def (journal-close! host)
  (let (s (state host #t))
    (unless (journal-state-closed? s)
      (dynamic-wind void
        (lambda () (when (journal-state-active s) (exec s "ROLLBACK")))
        (lambda ()
          (DB-close (journal-state-db s))
          (set! (journal-state-active s) #f)
          (set! (journal-state-closed? s) #t)
          (set! (journal-state-poisoned? s) #t)
          (set! (journal-state-db s) #f)
          (set! (journal-state-owner s) #f)
          (set! (journal-state-key s) #f)
          (set! (journal-state-cut s) #f))))
    #t))
(def (journal-epoch host) (journal-state-epoch (state host)))
(def (journal-active? host) (journal-state-active (state host)))
(def (journal-cut! host hook) (set! (journal-state-cut (state host)) hook))
(def (cut! s stage (id (journal-state-key s))) (when (journal-state-cut s) ((journal-state-cut s) stage id)))
(def (journal-get host key (evidence? #f))
  (let* ((s (state host)) (rows (query s (if evidence? "SELECT payload,digest FROM evidence WHERE k=?" "SELECT payload,digest FROM state WHERE k=?") key)))
    (and (pair? rows) (let* ((row (car rows)) (bytes (vector-ref row 0)))
      (unless (equal? (journal-hash bytes) (vector-ref row 1)) (error "Journal payload digest mismatch"))
      (journal-unpack bytes)))))
(def (journal-put! host key value)
  (let* ((s (state host)) (bytes (journal-pack value)))
    (unless (journal-state-active s) (error "Durable state requires fenced transaction"))
    (fence! s)
    (exec s "INSERT INTO state VALUES(?,?,?) ON CONFLICT(k) DO UPDATE SET payload=excluded.payload,digest=excluded.digest"
      key bytes (journal-hash bytes))
    (exec s "INSERT INTO versions(event,k,payload,digest) VALUES(?,?,?,?)" (journal-state-key s) key bytes (journal-hash bytes))))
(def (journal-evidence! host key value)
  (let* ((s (state host)) (bytes (journal-pack value)) (old (journal-get host key #t)))
    (when (and old (not (equal? (journal-pack old) bytes))) (error "Original evidence cannot be replaced"))
    (unless old
      (exec s "BEGIN IMMEDIATE")
      ;; Fencing refusal is a transaction failure too. Leaving this short
      ;; transaction open lets a superseded Actor block the current owner,
      ;; even though its obsolete evidence was correctly refused.
      (with-catch
        (lambda (failure) (exec s "ROLLBACK") (raise failure))
        (lambda ()
          (fence! s)
          (exec s "INSERT INTO evidence VALUES(?,?,?)" key bytes (journal-hash bytes))
          (exec s "COMMIT"))))
    value))
(def (journal-receive! host id value)
  (let* ((s (state host)) (bytes (journal-pack value)) (dg (journal-hash bytes)))
    (when (journal-state-active s) (error "Inbox admission must precede decision transaction"))
    (exec s "BEGIN IMMEDIATE")
    (with-catch (lambda (e) (exec s "ROLLBACK") (raise e))
      (lambda () (fence! s)
        (let (old (query s "SELECT digest FROM inbox WHERE id=?" id))
          (when (and (pair? old) (not (equal? dg (vector-ref (car old) 0)))) (error "Inbox identity substitution"))
          (exec s "INSERT OR IGNORE INTO inbox VALUES(?,?,?,'pending',?)" id bytes dg (journal-state-epoch s)))
        (exec s "COMMIT") (cut! s 'after-receive id)))))
(def (journal-begin! host id)
  (let (s (state host))
    (when (or (journal-state-active s) (journal-state-poisoned? s)) (error "Restart poisoned/nested journal owner"))
    (exec s "BEGIN IMMEDIATE")
    (with-catch (lambda (e) (exec s "ROLLBACK") (raise e))
      (lambda () (fence! s) (set! (journal-state-active s) #t) (set! (journal-state-key s) id)))))
(def (journal-commit! host (applied? #t))
  (let* ((s (state host)) (id (journal-state-key s))
         (rows (query s "SELECT digest FROM inbox WHERE id=?" id)))
    (unless (and (journal-state-active s) (pair? rows)) (error "Unknown durable decision input"))
    (fence! s)
    (let* ((previous-rows (query s "SELECT hash FROM log ORDER BY seq DESC LIMIT 1"))
           (previous (if (null? previous-rows) "root" (vector-ref (car previous-rows) 0)))
           (dg (vector-ref (car rows) 0))
           (state-digest (journal-hash (journal-pack (query s "SELECT k,digest FROM state ORDER BY k"))))
           (hash (journal-hash (journal-pack (list (journal-state-epoch s) id dg previous state-digest)))))
      (when applied? (exec s "UPDATE inbox SET status='applied' WHERE id=?" id))
      (exec s "INSERT INTO log(epoch,id,digest,previous,state_digest,hash) VALUES(?,?,?,?,?,?)" (journal-state-epoch s) id dg previous state-digest hash))
    (cut! s 'before-commit)
    (exec s "COMMIT") (set! (journal-state-active s) #f)
    (cut! s 'after-commit)))
(def (journal-abort! host)
  (let (s (state host)) (when (journal-state-active s) (exec s "ROLLBACK"))
    (set! (journal-state-active s) #f) (set! (journal-state-poisoned? s) #t)))
;;; Normal command admission needs one identity, not decoded copies of every
;;; historical input. Verify the selected original bytes before exposing them.
(def (journal-input host id)
  (let* ((s (state host))
         (rows (query s "SELECT id,payload,digest,status,epoch FROM inbox WHERE id=?" id)))
    (and (pair? rows)
      (let* ((row (car rows)) (bytes (vector-ref row 1)))
        (unless (equal? (journal-hash bytes) (vector-ref row 2)) (error "Inbox digest mismatch"))
        (.o id: (vector-ref row 0) payload: (journal-unpack bytes)
            status: (vector-ref row 3) epoch: (vector-ref row 4))))))

(def (journal-rows host)
  (let (s (state host))
    (map (lambda (row)
      (let (payload-bytes (vector-ref row 1))
        (unless (equal? (journal-hash payload-bytes) (vector-ref row 2)) (error "Inbox digest mismatch"))
        (.o id: (vector-ref row 0) payload: (journal-unpack payload-bytes) status: (vector-ref row 3) epoch: (vector-ref row 4))))
      (query s "SELECT id,payload,digest,status,epoch FROM inbox ORDER BY rowid"))))

(def (journal-terminal! host terminal)
  (let* ((s (state host)) (sid (.ref terminal 'session)) (attempt (.ref terminal 'attempt))
         (generation (.ref terminal 'generation)) (bytes (journal-pack terminal)) (dg (journal-hash bytes))
         (old (query s "SELECT digest FROM terminals WHERE session=? AND attempt=? AND generation=?" sid attempt generation)))
    (unless (journal-state-active s) (error "Terminal requires durable transaction"))
    (when (and (pair? old) (not (equal? dg (vector-ref (car old) 0)))) (error "Attempt already has a different durable terminal"))
    (exec s "INSERT OR IGNORE INTO terminals VALUES(?,?,?,?,?)" sid attempt generation bytes dg)))
(def (journal-verify! host)
  (let ((s (state host)) (previous "root") (last-state #f))
    (for-each (lambda (row)
      (let* ((epoch (vector-ref row 0)) (id (vector-ref row 1)) (dg (vector-ref row 2))
             (prev (vector-ref row 3)) (sd (vector-ref row 4)) (hash (vector-ref row 5))
             (input (query s "SELECT digest FROM inbox WHERE id=?" id)))
        (unless (and (equal? previous prev) (pair? input) (equal? dg (vector-ref (car input) 0))
          (equal? hash (journal-hash (journal-pack (list epoch id dg prev sd)))))
          (error "Durable journal chain mismatch"))
        (set! previous hash) (set! last-state sd)))
      (query s "SELECT epoch,id,digest,previous,state_digest,hash FROM log ORDER BY seq"))
    (when last-state
      (unless (equal? last-state (journal-hash (journal-pack (query s "SELECT k,digest FROM state ORDER BY k"))))
        (error "Durable checkpoint/chain mismatch")))
    (for-each (lambda (row) (unless (equal? (journal-hash (vector-ref row 0)) (vector-ref row 1))
      (error "Immutable journal evidence mismatch")))
      (append (query s "SELECT payload,digest FROM evidence") (query s "SELECT payload,digest FROM state")
              (query s "SELECT payload,digest FROM versions") (query s "SELECT payload,digest FROM terminals")))
    previous))
