(import :std/test :agentic-ai-lab/modules/evidence-assessment/ascent-dag)
(export evidence-dag-test)
(def (atom name) (hash ("relation" name) ("terms" [(hash ("var" "x"))])))
(def (relation name source (rows []))
  (hash ("name" name) ("source" source) ("rows" rows) ("columns" [(hash ("kind" "symbol"))])))
(def program
  (hash ("relations" [(relation "input" #t) (relation "blocked" #t)
                       (relation "unrelated" #t) (relation "answer" #f)])
        ("rules" [(hash ("head" [(atom "answer")]) ("body" [(atom "input") (atom "blocked")]))])))
(def (graph-datum graph)
  [(map (lambda (node) [(hash-ref node "id") (hash-ref node "kind")
                        (hash-ref node "relations") (hash-ref node "recursive" #f)])
        (hash-ref graph "nodes"))
   (map (lambda (edge) [(hash-ref edge "from") (hash-ref edge "to")]) (hash-ref graph "edges"))])
(def evidence-dag-test
  (test-suite "Scheme Evidence DAG"
    (test-case "recursive relations condense into an explicit dependency-first DAG"
      (let* ((recursive (hash
               ("relations" [(relation "seed" #t) (relation "left" #f)
                              (relation "right" #f) (relation "answer" #f)])
               ("rules" [(hash ("head" [(atom "left")]) ("body" [(atom "seed") (atom "right")]))
                          (hash ("head" [(atom "right")]) ("body" [(atom "left")]))
                          (hash ("head" [(atom "answer")]) ("body" [(atom "right")]))])))
             (graph (ascent-evidence-dag (hash ("action" "graph") ("program" recursive))))
             (nodes (hash-ref graph "nodes")) (positions (make-hash-table)))
        (check (map (cut hash-ref <> "relations") nodes) => '(("seed") ("left" "right") ("answer")))
        (check (hash-ref (cadr nodes) "recursive") => #t)
        (check (hash-ref (caddr nodes) "recursive") => #f)
        (for-each (lambda (node position) (hash-put! positions (hash-ref node "id") position))
                  nodes (iota (length nodes)))
        (check (length (hash-ref graph "edges")) => 2)
        (check (andmap (lambda (edge) (< (hash-ref positions (hash-ref edge "from"))
                                        (hash-ref positions (hash-ref edge "to"))))
                        (hash-ref graph "edges")) => #t)
        (check (graph-datum (ascent-evidence-dag (hash ("action" "graph")
                 ("program" (hash ("relations" (reverse (hash-ref recursive "relations")))
                                  ("rules" (reverse (hash-ref recursive "rules")))))))) => (graph-datum graph))))
    (test-case "multiple relations sharing a component produce one dependency edge"
      (let (graph (ascent-evidence-dag (hash ("action" "graph")
        ("program" (hash ("relations" [(relation "left" #f) (relation "right" #f) (relation "answer" #f)])
          ("rules" [(hash ("head" [(atom "left") (atom "right")]) ("body" [(atom "left")]))
                     (hash ("head" [(atom "answer")]) ("body" [(atom "left") (atom "right")]))]))))))
        (check (length (hash-ref graph "edges")) => 1)))
    (test-case "structural DAG rejects undeclared dependencies"
      (check (with-catch (lambda (_) #t) (lambda ()
        (ascent-evidence-dag (hash ("action" "graph")
          ("program" (hash ("relations" [(relation "answer" #f)])
                           ("rules" [(hash ("head" [(atom "answer")]) ("body" [(atom "missing")]))]))))) #f)) => #t))
    (test-case "query reuse remains source-bound after DAG operation migration"
      (let* ((source (relation "input" #t [["a"]]))
             (query (hash ("relations" [source (relation "answer" #f)])
                          ("rules" [(hash ("head" [(atom "answer")]) ("body" [(atom "input")]))])
                          ("queries" ["answer"])))
             (trusted (hash ("input" source))) (certificates (hash))
             (request (hash ("action" "query") ("program" query) ("trusted" trusted)
                            ("sources" ["input"]) ("sourceIdentity" "generation-a")
                            ("retain" #t) ("certificates" certificates)))
             (first (ascent-evidence-dag request)))
        (check (length (hash-ref first "fresh")) => 1)
        (hash-put! trusted "completed" (relation "completed" #t [["a"]]))
        (hash-put! certificates (hash-ref (hash-ref first "keys") "answer") (hash ("answer" "completed")))
        (let (reused (ascent-evidence-dag request))
          (check (hash-ref (hash-ref reused "mapping") "answer") => "completed")
          (check (hash-ref (hash-ref reused "lowered") "rules") => []))
        (hash-put! request "sourceIdentity" "generation-b")
        (check (hash-ref (ascent-evidence-dag request) "reused") => [])
        (hash-put! query "relations" [(relation "input" #t []) (relation "answer" #f)])
        (check (with-catch (lambda (_) #t) (lambda () (ascent-evidence-dag request) #f)) => #t)))
    (test-case "dependency slice keeps every referenced source and stable order"
      (let (result (ascent-evidence-dag
          (hash ("action" "slice") ("program" program)
                ("facts" (hash ("input" [["a"]]) ("blocked" []) ("unrelated" [["b"]])))
                ("queries" ["answer"]))))
        (check (map (cut hash-ref <> "name") (hash-ref result "relations"))
          => '("answer" "blocked" "input"))
        (check (hash-ref result "rules") => (hash-ref program "rules"))))
    (test-case "undefined derived relation is not an empty proof"
      (check (with-catch (lambda (_) #t) (lambda ()
        (ascent-evidence-dag (hash ("action" "slice")
          ("program" (hash ("relations" [(relation "answer" #f)]) ("rules" [])))
          ("facts" (hash)) ("queries" ["answer"]))) #f)) => #t))
    (test-case "SCC output is dependency first and multihead atomic"
      (let (result (ascent-evidence-dag (hash ("action" "components")
         ("program" (hash ("relations" [(relation "root" #f) (relation "left" #f) (relation "right" #f)])
          ("rules" [(hash ("head" [(atom "root")]) ("body" [(atom "root")]))
                     (hash ("head" [(atom "left") (atom "right")]) ("body" [(atom "root")]))]))))))
        (check (hash-ref result "components") => '(("root") ("left" "right")))))
    (test-case "source identity precedes retained path selection"
      (let* ((source (relation "input" #t [["a"]]))
             (program (hash ("relations" [source (relation "answer" #f)])
                       ("rules" [(hash ("head" [(atom "answer")]) ("body" [(atom "input")]))])
                       ("queries" ["answer"])))
             (request (hash ("action" "query") ("program" program)
                       ("trusted" (hash ("input" source))) ("sources" ["input"])
                       ("sourceIdentity" "bound-source") ("certificates" (hash))
                       ("retain" #t)))
             (first (ascent-evidence-dag request)))
        (check (hash-ref first "plannerVersion") => "evidence-dag-v1")
        (check (hash-ref first "reused") => [])
        (hash-put! request "certificates"
          (hash ((hash-ref (hash-ref first "keys") "answer") (hash ("answer" "input")))))
        (check (hash-length (hash-ref (ascent-evidence-dag request) "mapping")) => 0)
        (check (hash-ref (ascent-evidence-dag request) "reused") => [])
        (hash-put! request "requests"
          (hash ((hash-ref first "requestKey") [(hash-ref first "lowered") (hash-ref first "mapping")])))
        (check (hash-ref (ascent-evidence-dag request) "requestKey") => (hash-ref first "requestKey"))
        (hash-put! request "trusted" (hash ("input" (relation "input" #t []))))
        (check (with-catch (lambda (_) #t) (lambda () (ascent-evidence-dag request) #f)) => #t)))))
