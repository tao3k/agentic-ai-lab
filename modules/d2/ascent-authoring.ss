;;; -*- Gerbil -*-
;;; SPDX-FileCopyrightText: 2026 tao3k team and Contributors
;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Pure, snapshot-based authoring obligations. No provider or stage counter.
(import (only-in :clan/poo/object .o .ref)
        (only-in :gerbil-ascent/program/syntax ascent)
        (only-in :gerbil-ascent/program/api gerbil-ascent-evaluate-program)
        "ascent-explanation.ss" "ascent-review.ss" "ascent-inspection.ss")
(export d2-author)
(def (author-rows values slots)
  (map (lambda (value) (map (lambda (slot) (.ref value slot)) slots)) values))
(def (d2-author context-value)
  (def plan-result (d2-plan-explanation (.ref context-value 'explanation-plan)))
  (def plan-rows (.ref plan-result 'rows-of))
  (def context-views (.ref context-value 'views))
  (def proposals (.ref context-value 'proposals))
  (def renders (.ref context-value 'renders))
  (def findings (.ref context-value 'feedback))
  ;; Only image-bound observations enter semantic review. The host verifies
  ;; bytes/digests and records actual model image inspection; rules do not
  ;; authenticate a caller's assertion of having seen an image.
  (def binding
    (gerbil-ascent-evaluate-program
     (ascent
      (relation View (v r cut audience)
        (author-rows context-views '(identity revision source-cut audience)))
      (relation Proposal (p v r cut asset sha)
        (author-rows proposals '(identity view revision source-cut asset-ref asset-sha)))
      (relation Render (p asset-sha image-sha)
        (author-rows renders '(proposal asset-sha image-sha)))
      (relation Finding (f v r cut q verdict producer image-sha)
        (author-rows findings '(identity view revision source-cut question verdict producer image-sha)))
      (relation Observed (f image-sha producer)
        (author-rows (.ref context-value 'observations) '(finding image-sha producer)))
      (relation CurrentProposal (v r cut p asset sha))
      (relation CurrentImage (v r cut p asset image-sha))
      (relation BoundFinding (v r cut p image-sha f q verdict producer))
      ((CurrentProposal V R C P Asset Sha) <-- (View V R C A)
        (Proposal P V R C Asset Sha))
      ((CurrentImage V R C P Asset Image) <-- (CurrentProposal V R C P Asset Sha)
        (Render P Sha Image))
      ((BoundFinding V R C P Image F Q Verdict Producer) <--
        (CurrentImage V R C P Asset Image)
        (Finding F V R C Q Verdict Producer Image) (Observed F Image Producer))
      (bounds 512 4096 8192))))
  (def bound-rows (.ref binding 'rows-of))
  (def inspection-result (d2-inspection context-value (bound-rows 'CurrentImage)))
  (def inspection-rows (.ref inspection-result 'rows-of))
  (def image-reviews
    (map (lambda (image)
      (let* ((v (car image)) (r (cadr image)) (p (list-ref image 3))
             (digest (list-ref image 5))
             (matching (filter (lambda (row)
               (and (eq? (car row) v) (eq? (cadr row) r)
                    (eq? (caddr row) (caddr image)) (eq? (cadddr row) p)
                    (equal? (list-ref row 4) digest))) (bound-rows 'BoundFinding)))
             (review-result (d2-review
               (.o views: (filter (lambda (view-value)
                     (and (eq? (.ref view-value 'identity) v)
                          (eq? (.ref view-value 'revision) r))) context-views)
                   questions: (.ref context-value 'questions)
                   needs: (.ref context-value 'needs)
                   prerequisites: (.ref context-value 'prerequisites)
                   explanations: (.ref context-value 'explanations)
                   feedback: (map (lambda (row)
                     (.o identity: (list-ref row 5) view: v revision: r
                         question: (list-ref row 6) verdict: (list-ref row 7)
                         producer: (list-ref row 8))) matching)
                   learner-checks: (.ref context-value 'learner-checks)))))
        (.o proposal: p image-sha: digest result: review-result)))
      (bound-rows 'CurrentImage)))
  (def (review-rows relation)
    (apply append (map (lambda (review-value)
      (map (lambda (row)
        (append (list (car row) (cadr row) (.ref review-value 'proposal) (.ref review-value 'image-sha))
                (cddr row))) ((.ref (.ref review-value 'result) 'rows-of) relation))) image-reviews)))
  (def work
    (gerbil-ascent-evaluate-program
     (ascent
      (relation View (v r cut audience) (author-rows context-views '(identity revision source-cut audience)))
      (relation CurrentProposal (v r cut p asset sha) (bound-rows 'CurrentProposal))
      (relation CurrentImage (v r cut p asset digest) (bound-rows 'CurrentImage))
      (relation Open (v r p image q) (review-rows 'OpenQuestion))
      (relation Awaiting (v r p image q) (review-rows 'AwaitingReview))
      (relation Gap (v r p image q concept) (review-rows 'ExplanationGap))
      (relation Critique (v r p image q finding) (review-rows 'Critique))
      (relation Unsettled (v r p image q finding) (review-rows 'UnsettledFeedback))
      (relation Inspected (v r p image q) (inspection-rows 'Inspected))
      (relation AnswerBasis (v r p image q) (inspection-rows 'AnswerBasis))
      (relation MissingVisualFacet (v r p image q target facet) (inspection-rows 'MissingFacet))
      (relation MissingInventory (v r p image q) (inspection-rows 'MissingInventory))
      (relation RepresentationChange (v r p image q target facet reason) (inspection-rows 'ChangeRepresentation))
      (relation LayoutChange (v r p image q first second) (inspection-rows 'ChangeLayout))
      (relation StructureChange (v r p image q target reason) (inspection-rows 'ChangeStructure))
      (relation RouteChange (v r p image q edge) (inspection-rows 'ChangeRoute))
      (relation UnmeasuredRoute (v r p image q edge) (inspection-rows 'MissingRoute))
      (relation SmallText (v r p image q anchor) (inspection-rows 'ChangeTextSize))
      (relation UnexplainedMark (v r p image q target reason) (inspection-rows 'ChangeMeaning))
      (relation PlanNeed (v r subject facet) (plan-rows 'ExplanationNeed))
      (relation PlanCandidate (v r subject candidate asset) (plan-rows 'CandidateForReview))
      (relation NaturalFacet (v r p image q facet anchor) (inspection-rows 'GroundedFacet))
      (relation FacetTarget (q facet target)
        (author-rows (.ref context-value 'facet-needs) '(question facet target)))
      (relation Question (q audience subject)
        (author-rows (.ref context-value 'questions) '(identity audience subject)))
      ;; Explicit coverage of the questions currently proposed for this cut.
      (relation QuestionInventory (v r cut)
        (author-rows (.ref context-value 'question-inventories) '(view revision source-cut)))
      (relation HasProposal (v r cut))
      (relation HasImage (v r p))
      (relation HasQuestion (v r))
      (relation HasOpen (v r p image))
      (relation PlanCoverage (v r p subject facet))
      (relation PlanGap (v r p subject facet))
      (relation HasPlanGap (v r p))
      (relation Request (v r cut kind subject basis))
      (relation Reviewable (v r cut p image))
      ((HasProposal V R C) <-- (CurrentProposal V R C P Asset Sha))
      ((HasImage V R P) <-- (CurrentImage V R C P Asset Image))
      ((HasQuestion V R) <-- (View V R C A) (Question Q A Subject))
      ((HasOpen V R P Image) <-- (Awaiting V R P Image Q) (not (AnswerBasis V R P Image Q)))
      ((HasOpen V R P Image) <-- (Gap V R P Image Q Concept))
      ((HasOpen V R P Image) <-- (Critique V R P Image Q F))
      ((HasOpen V R P Image) <-- (Unsettled V R P Image Q F))
      ((HasOpen V R P Image) <-- (MissingVisualFacet V R P Image Q Target Facet))
      ((HasOpen V R P Image) <-- (MissingInventory V R P Image Q))
      ((HasOpen V R P Image) <-- (RepresentationChange V R P Image Q Target Facet Reason))
      ((HasOpen V R P Image) <-- (LayoutChange V R P Image Q First Second))
      ((HasOpen V R P Image) <-- (StructureChange V R P Image Q Target Reason))
      ((HasOpen V R P Image) <-- (RouteChange V R P Image Q Edge))
      ((HasOpen V R P Image) <-- (UnmeasuredRoute V R P Image Q Edge))
      ((HasOpen V R P Image) <-- (SmallText V R P Image Q AnchorId))
      ((HasOpen V R P Image) <-- (UnexplainedMark V R P Image Q Target Reason))
      ((PlanCoverage V R P O Facet) <-- (CurrentProposal V R C P Asset Sha)
        (PlanCandidate V R O Candidate Asset) (PlanNeed V R O Facet))
      ((PlanCoverage V R P O Facet) <-- (CurrentImage V R C P Asset Image)
        (NaturalFacet V R P Image Q Facet AnchorId) (FacetTarget Q Facet O))
      ((PlanGap V R P O Facet) <-- (CurrentProposal V R C P Asset Sha)
        (PlanNeed V R O Facet) (not (PlanCoverage V R P O Facet)))
      ((HasPlanGap V R P) <-- (PlanGap V R P O Facet))
      ((Request V R C (lit 'propose) V C) <-- (View V R C A) (not (HasProposal V R C)))
      ((Request V R C (lit 'render) P Asset) <-- (CurrentProposal V R C P Asset Sha)
        (not (HasImage V R P)))
      ((Request V R C (lit 'inspect) Q Image) <-- (CurrentImage V R C P Asset Image)
        (Awaiting V R P Image Q) (not (Inspected V R P Image Q)))
      ((Request V R C (lit 'explain) Target Facet) <-- (CurrentImage V R C P Asset Image)
        (MissingVisualFacet V R P Image Q Target Facet))
      ((Request V R C (lit 'explain) Q (lit 'missing-explanation-needs)) <--
        (CurrentImage V R C P Asset Image) (MissingInventory V R P Image Q))
      ((Request V R C (lit 'illustrate) Target Facet) <-- (CurrentImage V R C P Asset Image)
        (RepresentationChange V R P Image Q Target Facet Reason))
      ((Request V R C (lit 'relayout) First Second) <-- (CurrentImage V R C P Asset Image)
        (LayoutChange V R P Image Q First Second))
      ((Request V R C (lit 'relayout) Edge (lit 'excessive-route-detour)) <-- (CurrentImage V R C P Asset Image)
        (RouteChange V R P Image Q Edge))
      ((Request V R C (lit 'measure) Edge (lit 'route-length-needed)) <-- (CurrentImage V R C P Asset Image)
        (UnmeasuredRoute V R P Image Q Edge))
      ((Request V R C (lit 'relayout) AnchorId (lit 'reader-text-too-small)) <-- (CurrentImage V R C P Asset Image)
        (SmallText V R P Image Q AnchorId))
      ((Request V R C (lit 'illustrate) Target Reason) <-- (CurrentImage V R C P Asset Image)
        (UnexplainedMark V R P Image Q Target Reason))
      ((Request V R C (lit 'relate) Target Reason) <-- (CurrentImage V R C P Asset Image)
        (StructureChange V R P Image Q Target Reason))
      ((Request V R C (lit 'explain) Q Concept) <-- (CurrentImage V R C P Asset Image)
        (Gap V R P Image Q Concept))
      ((Request V R C (lit 'explain) O Facet) <-- (CurrentImage V R C P Asset Image)
        (PlanGap V R P O Facet))
      ((Request V R C (lit 'reconsider) Q Image) <-- (CurrentImage V R C P Asset Image)
        (Critique V R P Image Q F))
      ((Request V R C (lit 'investigate) Q Image) <-- (CurrentImage V R C P Asset Image)
        (Unsettled V R P Image Q F))
      ((Request V R C (lit 'ask) V C) <-- (View V R C A) (not (HasQuestion V R)))
      ((Reviewable V R C P Image) <-- (CurrentImage V R C P Asset Image)
        (QuestionInventory V R C) (HasQuestion V R) (not (HasOpen V R P Image))
        (not (HasPlanGap V R P)))
      (bounds 512 4096 8192))))
  (.o context: context-value plan: plan-result
      inspection: inspection-result answers: (inspection-rows 'AnswerBasis)
      (binding) reviews: image-reviews inference: work
      requests: (map (lambda (row)
        (.o view: (car row) revision: (cadr row) source-cut: (caddr row)
            kind: (list-ref row 3) subject: (list-ref row 4) basis: (list-ref row 5)))
        ((.ref work 'rows-of) 'Request))
      reviewable: ((.ref work 'rows-of) 'Reviewable)))
