;;; Consumer fixture only; not a Library Search or Fact-lifecycle API.
(import :std/encoding/json :std/error
        (only-in :clan/poo/object .ref)
        (only-in :gerbil-ascent/program/scheme-language relational-program)
        (only-in :gerbil-ascent/program/session gerbil-ascent-open-session
                 gerbil-ascent-session-run gerbil-ascent-session-replace-source!)
        (only-in :agentic-ai-lab/modules/temporal-causality/time/objects agentic-ai-lab-temporal-instant agentic-ai-lab-temporal-interval)
        (only-in :agentic-ai-lab/modules/temporal-causality/revisions/objects agentic-ai-lab-temporal-evidence-revision)
        (only-in :agentic-ai-lab/modules/temporal-causality/revisions/funs agentic-ai-lab-temporal-evidence-journal agentic-ai-lab-temporal-evidence-as-of)
        (only-in :agentic-ai-lab/modules/temporal-causality/truth-maintenance/objects agentic-ai-lab-temporal-derivation)
        (only-in :agentic-ai-lab/modules/temporal-causality/truth-maintenance/funs
                 agentic-ai-lab-temporal-dependency-index agentic-ai-lab-temporal-reverse-dependency-plan-from-cuts)
        :agentic-ai-lab/modules/evidence-assessment/candidate/evidence-store
        (only-in :gerbil-ascent/candidate/checked-program reasoning-source-snapshot))
(export main)
(def (field key rows) (cadr (assq key rows)))
(def (flat-map f rows) (apply append (map f rows)))
(def (ordinals n (start 0))
  (if (= n 0) [] (cons start (ordinals (- n 1) (+ start 1)))))
(def (wire value)
  (cond ((symbol? value) (symbol->string value)) ((pair? value) (map wire value)) (else value)))
(def base-edges '((0 2) (1 2) (2 4) (2 5) (4 7) (5 7) (3 6) (6 8) (7 9) (8 9) (9 11) (10 11)))
(def needs '((0 0 7 1 9) (1 2 9 3 11) (2 4 11 5 9) (3 0 11 3 9)
             (4 1 7 6 11) (5 2 7 8 11) (6 3 8 9 11) (7 0 9 10 11)
             (8 0 8 1 7) (9 3 7 2 9) (10 4 8 5 11) (11 10 9 0 7)))
(def proposal
  '(candidate (relation path 2) (relation ready 1)
     (rule (path ?x ?y) (edge ?x ?y))
     (rule (path ?x ?z) (path ?x ?y) (edge ?y ?z))
     (rule (ready ?f) (need ?f ?u ?v ?x ?y) (path ?u ?v) (path ?x ?y))
     (query ready ?f) (limits 128 4096 2048)))
(def (make-task number)
  (unless (member number '(0 1 2)) (error "unknown frozen task"))
  (let* ((stages 7) (index (modulo number 2))
         (edges (case number ((1) (append base-edges '((4 8))))
                               ((2) (append base-edges '((5 8)))) (else base-edges)))
         (options
          (flat-map (lambda (s)
            (map (lambda (j)
              (hash ("id" (+ (* s 5) j)) ("stage" s)
                    ("fragment" (if (= j 3) (+ 8 (modulo s 4)) (modulo (+ s (* 2 j)) 8)))
                    ("cost" (if (= j 0) 2 (+ 3 (modulo (+ (* s 3) (* j 5) number) 10))))
                    ("risk" (if (= j 0) 1 (+ 1 (modulo (+ (* s 2) (* j 3) number) 7))))
                    ("values" (if (= j 0) (list 10 11)
                               (list (+ 13 (modulo (+ (* s 7) (* j 11) (* number 5)) 35))
                                     (+ 14 (modulo (+ (* s 11) (* j 7) (* number 3)) 35)))))))
              (ordinals 5))) (ordinals stages)))
         (bonuses
          (flat-map (lambda (s)
            (map (lambda (t)
              (list (+ (* s 5) (modulo (+ s t number) 3))
                    (+ (* t 5) (modulo (+ (* 2 s) t number 1) 3))
                    (+ 8 (modulo (+ (* s 3) (* t 7) number) 17))))
              (ordinals (- stages s 1) (+ s 1)))) (ordinals stages)))
         (goal (hash ("index" index) ("stages" stages) ("costLimit" 45) ("riskLimit" 26) ("bonuses" bonuses))))
    (hash ("id" (string-append "evidence-search-" (number->string number))) ("edges" edges)
          ("needs" needs) ("options" options) ("goal" goal)
          ("seed" (map (lambda (s) (* s 5)) (ordinals stages))))))
(def task #f) (def source #f) (def store #f) (def resolved #f) (def certificate #f)
(def arm #f) (def frontier []) (def tried #f) (def pending #f) (def incumbent #f)
(def prunings []) (def expansions [])
(def lifecycle #f)
;;; Upper-layer objects are consumed in this test fixture. Nothing here is
;;; registered in the Library build or implements temporal admission itself.
(def (instant at (domain "txn"))
  (agentic-ai-lab-temporal-instant (string-append domain "/" (number->string at)) domain at "fixture-owner" 'observed))
(def (edge-id row) (string-append "edge/" (number->string (car row)) "/" (number->string (cadr row))))
(def (atom-id relation row) (object->string (cons relation row)))
(def (fixture-journal)
  (let* ((valid (agentic-ai-lab-temporal-interval "valid" (instant 0 "valid") (instant 100 "valid") #t #f))
         (initial (map (lambda (row)
                   (agentic-ai-lab-temporal-evidence-revision (string-append (edge-id row) "/assert")
                     (edge-id row) 'assert #f (instant 10) valid (edge-id row))) base-edges))
         (bridge (agentic-ai-lab-temporal-evidence-revision "bridge/assert" "bridge" 'assert #f (instant 10) valid "edge/4/8"))
         (fixed (agentic-ai-lab-temporal-evidence-revision "bridge/correct" "bridge" 'correct "bridge/assert" (instant 20) valid "edge/5/8"))
         (withdrawn (agentic-ai-lab-temporal-evidence-revision "bridge/retract" "bridge" 'retract "bridge/correct" (instant 30) #f #f)))
    (agentic-ai-lab-temporal-evidence-journal "fixture-history" "txn" (append initial (list bridge fixed withdrawn)))))
(def (project-edges journal at)
  (let* ((cut (agentic-ai-lab-temporal-evidence-as-of journal (instant at) #f))
         (ids (.ref cut 'active-revision-identities)))
    (values cut
      (append (filter (lambda (row) (member (string-append (edge-id row) "/assert") ids)) base-edges)
              (cond ((member "bridge/assert" ids) '((4 8)))
                    ((member "bridge/correct" ids) '((5 8))) (else []))))))
(def (library-program edges)
  (relational-program
    (relation edge (from to) edges) (relation need (f u v x y) needs)
    (relation path (from to) '()) (relation ready (f) '())
    (rule (path ?x ?y) (edge ?x ?y))
    (rule (path ?x ?z) (path ?x ?y) (edge ?y ?z))
    (rule (ready ?f) (need ?f ?u ?v ?x ?y) (path ?u ?v) (path ?x ?y))
    (limits 128 4096 2048)))
(def (same-rows! a b)
  (unless (and (= (length a) (length b)) (andmap (lambda (row) (member row b)) a))
    (error "retained Session and independently verified closure disagree")))
(def (dependency-index cut cert)
  (let (nodes (field 'nodes cert))
    (agentic-ai-lab-temporal-dependency-index "consumer-index" (.ref cut 'cut-digest) (.ref cut 'projection-digest) #t
      (map (lambda (node)
        (let* ((relation (list-ref node 2)) (row (list-ref node 3))
               (parents (map (lambda (id) (assoc id nodes)) (list-ref node 5))))
          (agentic-ai-lab-temporal-derivation (atom-id relation row)
            (.ref cut 'cut-digest) (.ref cut 'projection-digest) "fixture-positive-support"
            (if (eq? (list-ref node 1) 'source)
              (list (if (and (eq? relation 'edge) (member row '((4 8) (5 8)))) "bridge"
                        (if (eq? relation 'edge) (edge-id row) (atom-id relation row)))) [])
            (map (lambda (n) (atom-id (list-ref n 2) (list-ref n 3))) parents)))) nodes))))
(def (prepare-library! number)
  (let* ((journal (fixture-journal)) (at (case number ((0) 35) ((1) 15) (else 25)))
         (session #f) (previous-cut #f) (previous-cert #f) (records []) (old-source #f) (old-handle #f))
    (set! store (reasoning-open-program-store))
    (for-each (lambda (position)
      (let-values (((cut edges) (project-edges journal position)))
        (let* ((result (if session (begin (gerbil-ascent-session-replace-source! session 'edge edges)
                                        (gerbil-ascent-session-run session))
                         (begin (set! session (gerbil-ascent-open-session (library-program edges)))
                                (gerbil-ascent-session-run session))))
               (plan (and previous-cut (agentic-ai-lab-temporal-reverse-dependency-plan-from-cuts
                         (dependency-index previous-cut previous-cert) journal
                         (instant (- position 10)) (instant position) #f))))
          (unless (.ref result 'finished) (error "incomplete retained Session"))
          (set! source (reasoning-source-snapshot
             (string-append (hash-ref task "id") "/" (.ref cut 'projection-digest)) position
             (list (list 'edge 2 edges) (list 'need 5 needs))))
          (set! resolved (reasoning-resolve-evidence store source proposal))
          (unless (eq? (field 'status resolved) 'verified) (error "proof not admitted"))
          (set! certificate (reasoning-evidence-certificate store source proposal (field 'handle resolved)))
          (same-rows! ((.ref result 'rows-of) 'ready) (field 'rows resolved))
          (for-each (lambda (row)
            (unless (eq? (field 'status (reasoning-evidence-fact store source proposal (field 'handle resolved) (cons 'path row))) 'verified)
              (error "Session path lacks finite verification"))) ((.ref result 'rows-of) 'path))
          (when old-source
            (unless (eq? (field 'status (reasoning-evidence-fact store source proposal old-handle '(path 0 8))) 'unknown)
              (error "old proof handle accepted for revised scope"))
            (unless (eq? (field 'status (reasoning-evidence-fact store old-source proposal old-handle '(path 0 8))) 'verified)
              (error "historical evidence lost")))
          (when plan
            (unless (member (atom-id 'path '(0 8)) (.ref plan 'affected-conclusion-identities))
              (error "POO plan omitted revised derivation"))
            (when (member (atom-id 'path '(3 11)) (.ref plan 'affected-conclusion-identities))
              (error "unrelated derivation incorrectly affected")))
          (set! records (cons (hash ("knowledgeAt" position) ("cutDigest" (.ref cut 'cut-digest))
            ("projectionDigest" (.ref cut 'projection-digest)) ("edges" edges)
            ("sessionReady" ((.ref result 'rows-of) 'ready)) ("sessionPaths" ((.ref result 'rows-of) 'path))
            ("activeRules" (.ref result 'active-rule-count))
            ("changedSubjects" (if plan (.ref plan 'changed-subject-identities) []))
            ("affectedDerivations" (if plan (.ref plan 'affected-conclusion-identities) []))
            ("certificate" (wire certificate)) ("staleHandleRejected" (and old-source #t))) records))
          (set! previous-cut cut) (set! previous-cert certificate)
          (set! old-source source) (set! old-handle (field 'handle resolved)))))
      (filter (lambda (p) (<= p at)) '(15 25 35)))
    (set! lifecycle (hash ("records" (reverse records)) ("currentKnowledgeAt" at)
      ("ownership" "Synthetic consumer fixture. Agentic AI Lab selects revisions and schedules reevaluation; ASCENT retained Session computes relations; proof store independently verifies current finite results.")))))
(def (fact atom) (reasoning-evidence-fact store source proposal (field 'handle resolved) atom))
(def (check selection full?)
  (let* ((options (hash-ref task "options")) (goal (hash-ref task "goal"))
         (stages (hash-ref goal "stages")) (cost 0) (risk 0) (value 0) (valid #t) (stage 0))
    (unless (and (list? selection) (<= (length selection) stages)
                 (or (not full?) (= (length selection) stages))
                 (andmap (lambda (id) (and (exact-integer? id) (<= 0 id) (< id (length options)))) selection))
      (error "invalid selection shape"))
    (for-each (lambda (id)
      (let (o (list-ref options id))
        (unless (and (= stage (hash-ref o "stage"))
                     (eq? (field 'status (fact (list 'ready (hash-ref o "fragment")))) 'verified))
          (set! valid #f))
        (set! cost (+ cost (hash-ref o "cost"))) (set! risk (+ risk (hash-ref o "risk")))
        (set! value (+ value (list-ref (hash-ref o "values") (hash-ref goal "index"))))
        (set! stage (+ stage 1)))) selection)
    (for-each (lambda (b) (when (and (member (car b) selection) (member (cadr b) selection))
                           (set! value (+ value (caddr b))))) (hash-ref goal "bonuses"))
    (hash ("valid" (and valid (<= cost (hash-ref goal "costLimit")) (<= risk (hash-ref goal "riskLimit"))))
          ("depth" (length selection)) ("cost" cost) ("risk" risk) ("value" value))))
(def (totals checked)
  (hash ("depth" (hash-ref checked "depth")) ("cost" (hash-ref checked "cost"))
        ("risk" (hash-ref checked "risk")) ("value" (hash-ref checked "value"))))
(def (complete prefix) (append prefix (list-tail (hash-ref task "seed") (length prefix))))
(def (mark! parent ids) (hash-put! tried parent (append (hash-ref tried parent []) ids)))
(def (fact-packet ids)
  (let ((seen []) (facts []) (roots []) (nodes (field 'nodes certificate)))
    (def (add-node! id)
      (unless (member id roots)
        (let (node (assoc id nodes))
          (unless node (error "missing admitted support node" id))
          (set! roots (cons id roots)) (for-each add-node! (list-ref node 5)))))
    (for-each (lambda (id)
      (let (f (hash-ref (list-ref (hash-ref task "options") id) "fragment"))
        (unless (member f seen)
          (set! seen (cons f seen))
          (let* ((ready (fact (list 'ready f))) (n (assoc f needs))
                 (requirements
                   (map (lambda (atom)
                          (let (answer (fact atom))
                            (for-each add-node! (field 'support-nodes answer))
                            (hash ("atom" (wire atom)) ("status" (wire (field 'status answer)))
                                  ("supportNodes" (field 'support-nodes answer)))))
                        (list (list 'path (list-ref n 1) (list-ref n 2))
                              (list 'path (list-ref n 3) (list-ref n 4))))))
            (for-each add-node! (field 'support-nodes ready))
            (set! facts (cons (hash ("fragmentId" f) ("status" (wire (field 'status ready)))
                                    ("requirements" requirements) ("supportNodes" (field 'support-nodes ready))) facts)))))) ids)
    (hash ("handle" (field 'handle resolved)) ("scope" (wire (field 'scope resolved)))
          ("facts" (reverse facts)) ("proofNodes" (wire (filter (lambda (n) (member (car n) roots)) nodes))))))
(def (next-context)
  (set! resolved (reasoning-resolve-evidence store source proposal))
  (unless (eq? (field 'status resolved) 'verified) (error "unverified scenario source"))
  (let loop ()
    (if (null? frontier) (hash ("done" #t))
      (let* ((parent (car frontier))
             (ids (map (lambda (o) (hash-ref o "id"))
                   (filter (lambda (o) (and (= (hash-ref o "stage") (length parent))
                                            (not (member (hash-ref o "id") (hash-ref tried parent [])))))
                           (hash-ref task "options"))))
             (partition (and (string=? arm "prune")
                         (reasoning-evidence-partition store source proposal (field 'handle resolved)
                           (map (lambda (id) (list id (list (list 'ready
                             (hash-ref (list-ref (hash-ref task "options") id) "fragment"))))) ids))))
             (allowed (if partition (field 'allowed partition) ids))
             (removed (if partition (field 'pruned partition) [])))
        (when (pair? removed)
          (mark! parent removed) (set! prunings (cons (list parent (wire partition)) prunings)))
        (if (null? allowed) (begin (set! frontier (cdr frontier)) (loop))
          (let* ((children (map (lambda (id)
                            (let (prefix (append parent (list id)))
                              (hash ("option" (list-ref (hash-ref task "options") id))
                                    ("prefixTotals" (totals (check prefix #f)))
                                    ("seedSuffixTotals" (totals (check (complete prefix) #t)))))) allowed))
                 (context (hash
                   ("task" (hash ("objective" "Maximize the value of a feasible complete selection.")
                     ("selectionContract" "One option per stage, in stage order. Each option requires both directed paths in its fragment; paths have at least one edge. Costs and risks add. Value is the current goal's option values plus bonuses for selected pairs.")
                     ("source" (hash ("edges" (hash-ref task "edges")) ("needs" needs)
                                    ("needsColumns" '("fragmentId" "firstFrom" "firstTo" "secondFrom" "secondTo"))))
                     ("goal" (hash-ref task "goal")) ("options" (hash-ref task "options"))))
                   ("parent" parent) ("unvisitedChildren" children) ("commonSeed" (hash-ref task "seed"))
                   ("incumbent" (hash ("selection" (hash-ref incumbent "selection"))
                                       ("totals" (totals (hash-ref incumbent "evaluation"))))))))
            (unless (string=? arm "baseline") (hash-put! context "evidence" (fact-packet ids)))
            (set! pending (list parent allowed))
            (hash ("done" #f) ("context" context))))))))
(def (read-atom row)
  (unless (and (list? row) (pair? row) (member (car row) '("edge" "path" "ready"))
               (= (length row) (if (string=? (car row) "ready") 2 3))
               (andmap exact-integer? (cdr row))) (error "invalid ground annotation atom"))
  (cons (string->symbol (car row)) (cdr row)))
(def (episode-check request)
  (let* ((atom (read-atom (hash-ref request "atom")))
         (premises (map read-atom (hash-ref request "premises")))
         (answer (fact atom))
         (grounded (andmap (lambda (p) (eq? (field 'status (fact p)) 'verified)) premises))
         (support
          (and grounded (pair? premises)
            (case (car atom)
              ((ready)
               (let (n (assoc (cadr atom) needs))
                 (and n (equal? premises
                   (list (list 'path (list-ref n 1) (list-ref n 2))
                         (list 'path (list-ref n 3) (list-ref n 4)))))))
              ((path)
               (let loop ((at (cadr atom)) (rest premises))
                 (if (null? rest) (= at (caddr atom))
                   (and (eq? (caar rest) 'edge) (= at (cadar rest))
                        (loop (caddar rest) (cdr rest))))))
              (else #f)))))
    (hash ("truthStatus" (wire (field 'status answer)))
          ("present" (and (eq? (field 'status answer) 'verified) #t))
          ("supportQualified" (and support #t)))))
(def (dispatch request)
  (case (string->symbol (hash-ref request "op"))
    ((task) (make-task (hash-ref request "case")))
    ((init)
      (set! task (make-task (hash-ref request "case"))) (set! arm (hash-ref request "arm"))
      (unless (member arm '("baseline" "facts" "prune")) (error "invalid treatment"))
      (prepare-library! (hash-ref request "case"))
      (set! frontier (list [])) (set! tried (make-hash-table)) (set! pending #f)
      (set! prunings []) (set! expansions [])
      (let* ((seed (hash-ref task "seed")) (checked (check seed #t)))
        (unless (hash-ref checked "valid") (error "infeasible common seed"))
        (set! incumbent (hash ("selection" seed) ("evaluation" checked))))
      (hash ("task" task) ("certificate" (wire certificate)) ("libraryLifecycle" lifecycle)))
    ((next) (next-context))
    ((episode) (episode-check request))
    ((expand)
      (let ((id (hash-ref request "optionId")))
        (unless (and pending (exact-integer? id) (member id (cadr pending))) (error "invalid scheduled child"))
        (let* ((parent (car pending)) (child (append parent (list id))) (prefix (check child #f))
               (selection (complete child)) (evaluation (check selection #t))
               (event (hash ("parent" parent) ("child" child) ("prefix" prefix)
                            ("completion" selection) ("evaluation" evaluation))))
          (mark! parent (list id))
          (when (and (hash-ref prefix "valid") (< (length child) (hash-ref (hash-ref task "goal") "stages")))
            (set! frontier (cons child frontier)))
          (when (and (hash-ref evaluation "valid") (> (hash-ref evaluation "value")
                       (hash-ref (hash-ref incumbent "evaluation") "value")))
            (set! incumbent (hash ("selection" selection) ("evaluation" evaluation))))
          (set! expansions (cons event expansions)) (set! pending #f) event)))
    ((summary) (hash ("incumbent" incumbent) ("expansions" (reverse expansions))
                    ("prunings" (reverse prunings)) ("nativeStats" (wire (reasoning-evidence-store-stats store)))))
    (else (error "unsupported scenario operation"))))
(def (main . args)
  (displayln "{\"ready\":true}") (force-output)
  (let loop ()
    (let (line (read-line))
      (unless (eof-object? line)
        (let (answer (try (dispatch (parameterize ((current-json-read-options (JSONReadOptions object-as-hash: #t)))
                                       (call-with-input-string line read-json)))
                         (catch (e) (hash ("error" (exception->string e))))))
          (display (json->string answer)) (newline) (force-output))
        (loop)))))
