;;; Native teardown boundaries: exact leases, closed handles and durable rollback.
(import (only-in :clan/poo/object .o .ref .call object? .alist/sort)
        (only-in :agentic-ai-lab/modules/workflow/runtime/scheme-wire scheme-wire-write)
        :agentic-ai-lab/t/temporal-evaluator-test
        (prefix-in :agentic-ai-lab/t/context-durable-owner old.)
        :agentic-ai-lab/modules/ai-agentic-context/durable-owner
        :agentic-ai-lab/modules/ai-agentic-context/session-host
        :agentic-ai-lab/modules/temporal-causality/evaluator/derivation
        :agentic-ai-lab/modules/ai-agentic-context/use-host
        (only-in :agentic-ai-lab/modules/temporal-causality/evaluator/proof-host agentic-ai-lab-temporal-proof-host-retained-digest agentic-ai-lab-temporal-proof-host-current)
        :agentic-ai-lab/modules/temporal-causality/runtime/policy-clock
        :agentic-ai-lab/modules/temporal-causality/runtime/change-feed
        :agentic-ai-lab/modules/temporal-causality/runtime/durable-journal
        :agentic-ai-lab/modules/temporal-causality/truth-maintenance/support/policy-host)
(export owner-lifecycle-unit)
(def (ensure value message) (unless value (error message)))
(def (rejected? fun) (with-catch (lambda (e) #t) (lambda () (fun) #f)))

(def (feed-probe!)
  (let* ((feed (make-change-feed)) (delivered 0)
         (observer (.o kind: 'temporal.source-observer.v1
                     .prepare: (lambda (self event)
                       (.o kind: 'temporal.source-propagation-batch.v1
                           .publish!: (lambda (self) (set! delivered (+ delivered 1))))))))
    (change-feed-watch! feed observer)
    (change-feed-watch! feed observer)
    (ensure (= (change-feed-observer-count feed) 1) "Duplicate lease")
    (change-feed-stage! feed (.o kind: 'fixture-event))
    (ensure (rejected? (lambda () (change-feed-unwatch! feed observer))) "Pending batch was discarded")
    (change-feed-drain! feed)
    (ensure (= delivered 1) "Pending delivery disappeared")
    (ensure (change-feed-unwatch! feed observer) "Owned observer did not detach")
    (ensure (not (change-feed-unwatch! feed observer)) "Repeated detach invented a lease")
    (ensure (= (change-feed-observer-count feed) 0) "Feed retained its observer")))

(def (context-probe!)
  (let* ((f (authority-fixture #t (clock-original-context) 1000000 #f))
         (host (.ref f 'host)) (grants (.ref f 'grants)) (ph (.ref f 'policies))
         (before (.ref (.ref f 'registration-a) 'proof-digest))
         (foreign-events 0)
         (foreign (.o kind: 'temporal.source-observer.v1
                    .prepare: (lambda (self event)
                      (.o kind: 'temporal.source-propagation-batch.v1
                          .publish!: (lambda (self) (set! foreign-events (+ foreign-events 1))))))))
    (ensure (= (context-host-subscription-count host) 3) "Expected proof/grant/policy leases")
    (check-wire (context-host-checkpoint host))
    (agentic-ai-lab-context-use-host-watch! grants foreign)
    (context-host-dispose! host)
    (ensure (and (context-host-disposed? host) (= (context-host-subscription-count host) 0)) "Context leases retained")
    (ensure (context-host-dispose! host) "Context dispose was not idempotent")
    (ensure (rejected? (lambda () (context-host-checkpoint host))) "Closed Context supplied an admission checkpoint")
    ;; Other subscribers and original proof history belong to their publishers.
    (agentic-ai-lab-context-use-host-refresh! grants
      (agentic-ai-lab-context-use-grant-revoke (agentic-ai-lab-context-use-host-current grants "grant")))
    (ensure (= foreign-events 1) "Context disposal removed another consumer's lease")
    (agentic-ai-lab-temporal-support-policy-host-refresh! ph (policy "v2") 2 (at 1))
    (ensure (equal? before (agentic-ai-lab-temporal-proof-host-retained-digest
                           (.ref f 'proof) (.ref (.ref f 'registration-a) 'identity)))
            "Disposal erased retained proof evidence")))

(def (clock-probe!)
  (let* ((host (agentic-ai-lab-temporal-support-policy-host))
         (cap (.o kind: 'temporal.native-clock.v1 .observe: (lambda (self id) (at 1))))
         (foreign (.o kind: 'temporal.native-clock.v1 .observe: (lambda (self id) (at 1)))))
    (agentic-ai-lab-temporal-support-policy-host-refresh! host (policy "v1") 1 (at 1))
    (agentic-ai-lab-temporal-support-policy-host-enroll-clock! host cap)
    (ensure (rejected? (lambda () (agentic-ai-lab-temporal-support-policy-host-release-clock! host foreign)))
            "Foreign owner detached the live clock")
    (agentic-ai-lab-temporal-support-policy-host-current host "policy")
    (agentic-ai-lab-temporal-support-policy-host-release-clock! host cap)
    (ensure (rejected? (lambda () (agentic-ai-lab-temporal-support-policy-host-current host "policy")))
            "Retired clock fell back to frozen registered time")
    (ensure (rejected? (lambda () (agentic-ai-lab-temporal-support-policy-host-enroll-clock! host cap)))
            "Retired clock was re-enabled")))

(def (journal-probe! path)
  (let (journal (journal-open path))
    (journal-evidence! journal "original" "retained-raw-evidence")
    (journal-receive! journal "committed" 'initial)
    (journal-begin! journal "committed")
    (journal-put! journal "value" 'original)
    (journal-commit! journal)
    (ensure (not (journal-input journal "absent")) "Missing identity invented an input")
    (ensure (equal? (.ref (journal-input journal "committed") 'status) "applied") "Point lookup lost status")
    (journal-receive! journal "unfinished" 'must-replay)
    (journal-begin! journal "unfinished")
    (journal-put! journal "value" 'uncommitted)
    (journal-close! journal)
    (ensure (and (journal-closed? journal) (journal-close! journal)) "Journal close is not idempotent")
    (ensure (rejected? (lambda () (journal-input journal "committed"))) "Closed journal accepted reuse"))
  (let (restored (journal-open path))
    (ensure (eq? (journal-get restored "value") 'original) "Close committed an unfinished effect")
    (ensure (equal? (journal-get restored "original" #t) "retained-raw-evidence") "Close discarded evidence")
    (ensure (equal? (.ref (journal-input restored "unfinished") 'status) "pending") "Close discarded replay obligation")
    (ensure (journal-verify! restored) "Close broke the committed journal chain")
    (journal-close! restored)))

(def (waiter-probe!)
  (let* ((clock (policy-clock-owner
                 (lambda () (values (.o kind: 'waiter-fixture)
                                    (agentic-ai-lab-temporal-support-policy-host))) "txn" 1 1.))
         (waiter (thread-start! (make-thread
           (lambda ()
             (with-catch (lambda (e) 'await-rejected)
               (lambda () (policy-clock-await-events! clock 1) 'unexpected-event)))))))
    (let loop ((remaining 100))
      (unless (= (.ref (policy-clock-resource-state clock) 'waiters) 1)
        (ensure (> remaining 0) "Waiter was not registered")
        (thread-sleep! 0.001) (loop (- remaining 1))))
    (policy-clock-stop! clock)
    (ensure (eq? (thread-join! waiter 2 'waiter-timeout) 'await-rejected) "Stop leaked an awaiting client")
    (ensure (= (.ref (policy-clock-stop-receipt clock) 'waiters-rejected) 1) "Missing explicit waiter rejection")
    (ensure (policy-clock-stop! clock) "Repeated stop did not retain its joined receipt")))

;;; Graceful close must preserve already received expiry inputs and active
;;; Attempt obligations. Independent Session endpoints are not owned by the
;;; timer/controller and may finish after the controller scope is gone.
(def (pending-owner-probe! path)
  (let ((journal #f) (held-workers '()) (original-inputs '()))
    (def (setup)
      (set! journal (journal-open path))
      (old.originals! journal path)
      (let* ((restored? (if (journal-get journal "context") #t #f))
             (ctx (clock-original-context))
             (f (authority-fixture #t ctx 1000000 (not restored?))))
        (journal-evidence! journal "original-ascent" (old.proof-evidence ctx))
        (unless restored?
          (set! held-workers (map (lambda (sid) (car (hash-ref (.ref f 'workers) sid)))
                                  '("session" "session-b" "session-c"))))
        (values f (.ref f 'policies)
          (context-durable-adapter journal (.ref f 'host) (.ref f 'grants) (.ref f 'policies)
                                   (lambda (registration) (.ref f 'proof))))))
    (let (first (policy-clock-owner setup "txn" 1 0.002 0. 2 #t #t))
      (policy-clock-await-events! first 2)
      (set! original-inputs
        (policy-clock-call! first (lambda (f)
          (map (lambda (row) (list (.ref row 'id) (journal-hash (journal-pack (.ref row 'payload)))))
            (filter (lambda (row) (and (equal? (.ref row 'status) "pending")
                                      (eq? (.ref (.ref row 'payload) 'kind) 'context.durable-delivery.v1)))
                    (journal-rows journal))))))
      (ensure (= (length original-inputs) 1) "Duplicate copies did not retain one original inbox identity")
      (policy-clock-stop! first)
      (ensure (journal-closed? journal) "First owner retained its journal"))
    (for-each (lambda (worker)
      (ensure (eq? (thread-join! worker 0 'still-running) 'still-running)
              "Controller shutdown terminated a Session endpoint")
      (thread-send worker 'return)
      (ensure (equal? (thread-join! worker 2 'endpoint-timeout) "native-result-for-request")
              "Independent endpoint did not finish")) held-workers)
    (let (second (policy-clock-owner setup "txn" 1 0.002 0. 2 #f #t))
      ;; The duplicate transport copies shared one immutable inbox identity.
      ;; Recover that original receipt plus two real rearmed copies before any
      ;; consumer query; transport multiplicity must not fabricate new inputs.
      (policy-clock-await-events! second (+ (length original-inputs) 2))
      (policy-clock-call! second (lambda (f)
        (ensure (eq? (.ref (push-row f "session") 'context-state) 'invalidated) "Expiry was not rearmed")
        (ensure (eq? (.ref (push-row f "session-b") 'context-state) 'invalidated) "Parent invalidation did not propagate")
        (ensure (eq? (.ref (push-row f "session-c") 'context-state) 'admitted) "Independent Context was invalidated")
        (for-each (lambda (sid)
          (ensure (null? (agentic-ai-lab-ai-agentic-context-session-host-outcomes (.ref f 'host) sid))
                  "Resource cleanup invented endpoint evidence")
          (ensure (= (length (.ref (.ref (push-row f sid) 'schedule) 'obligations)) 1)
                  "Recovery lost or duplicated an active Attempt obligation"))
          '("session" "session-b" "session-c"))
        (for-each (lambda (original)
          (let (row (journal-input journal (car original)))
            (ensure (and (equal? (.ref row 'status) "applied")
                         (equal? (journal-hash (journal-pack (.ref row 'payload))) (cadr original)))
                    "Rearmed delivery substituted original input bytes"))) original-inputs)))
      (policy-clock-stop! second)
      (ensure (journal-closed? journal) "Second owner retained its journal"))
    (displayln "OWNER-PENDING copies=2 pending-identities=1 rearmed=2 original-bytes=retained obligations=exact terminals=0 endpoints=independent")))

;;; Independent v1 projection oracle: kept out of the production pack path.
(def (reference-encode x (depth 0))
  (when (> depth 40) (error "Journal value depth"))
  (def (next v) (reference-encode v (+ depth 1)))
  (cond ((object? x) (list "poo" (map (lambda (p) (list (symbol->string (car p)) (next (cdr p)))) (.alist/sort x))))
        ((symbol? x) (list "symbol" (symbol->string x)))
        ((null? x) (list "list" '()))
        ((list? x) (list "list" (map next x)))
        ((pair? x) (list "pair" (next (car x)) (next (cdr x))))
        ((vector? x) (list "vector" (map next (vector->list x))))
        ((and (real? x) (or (inexact? x) (not (integer? x)))) (list "number" (number->string x)))
        ((or (boolean? x) (string? x) (exact-integer? x)) (list "scalar" x))
        (else (error "Nonportable native capability in journal"))))
(def (check-wire value)
  (ensure (equal? (journal-pack value) (scheme-wire-write (reference-encode value)))
          "Production codec changed original v1 wire bytes"))

(def kernel-candidate
  '(candidate (relation path 2)
     (rule (path ?x ?y) (edge ?x ?y))
     (rule (path ?x ?z) (path ?x ?y) (edge ?y ?z))
     (query path 1 3) (limits 8 16 32)))
(def (kernel-derive ctx bindings)
  (apply (lambda (program correspondence bound admission snapshot receipt ignored output sources journal)
    (agentic-ai-lab-temporal-mrr-derivation-from-ascent "qualified" program correspondence bound
      admission snapshot kernel-candidate receipt 512 32 bindings output sources journal)) ctx))
(def (kernel-replay held ctx bindings)
  (apply (lambda (program correspondence bound admission snapshot receipt ignored output sources journal)
    (agentic-ai-lab-temporal-mrr-derivation-admission-replay held program correspondence bound
      admission snapshot kernel-candidate receipt 512 32 bindings output sources journal)) ctx))

(def (proof-kernel-probe!)
  (let* ((ctx (clock-original-context)) (bindings (list-ref ctx 6))
         (value (kernel-derive ctx bindings))
         (golden "sha256:4e35c0f59fe1973642e4dd2faa0d8a58073886e9fb78a2655e3a6c29a983ab24")
         (support (.ref value 'support)))
    (ensure (equal? (.ref value 'semantic-digest) golden) "Canonical graph changed the original proof digest")
    (ensure (equal? (.ref (kernel-replay value ctx bindings) 'semantic-digest) golden) "Native proof did not replay")
    (ensure (rejected? (lambda () (kernel-derive ctx (cdr bindings)))) "Missing graph binding was accepted")
    (ensure (rejected? (lambda () (kernel-derive ctx (cons (car bindings) bindings)))) "Duplicate graph binding was accepted")
    (ensure (rejected? (lambda () (kernel-replay (.o (:: @ value) action-authorized?: #t) ctx bindings)))
            "Proof graph authorized an effect")
    (ensure (rejected? (lambda () (kernel-replay
              (.o (:: @ value) support: (.o (:: @ support) proof-identity: "forged")) ctx bindings)))
            "Forged support was accepted")
    ;; No successful previous call may mask a later input mutation. Restore the
    ;; caller's fact row afterwards, then verify the identical original proof.
    (let* ((binding (car bindings)) (row (.ref (.ref binding 'fact) 'row)) (old (car row)))
      (dynamic-wind
        (lambda () (set-car! row (+ old 1000)))
        (lambda ()
          (ensure (rejected? (lambda () (kernel-derive ctx bindings)))
                  "Per-invocation canonicalization reused a previous verdict"))
        (lambda () (set-car! row old))))
    (ensure (equal? (.ref (kernel-derive ctx bindings) 'semantic-digest) golden)
            "Restored graph changed original evidence")
    (displayln "OWNER-KERNEL original-digest=exact missing=refused duplicate=refused forged-support=refused next-call-mutation=refused")))

(def (retained-actor-probe!)
  (let ((held-proof #f) (registration-id #f))
    (let (clock
          (policy-clock-owner
           (lambda ()
             (let (fixture (authority-fixture #t (clock-original-context) 1000000 #f))
               (set! held-proof (.ref fixture 'proof))
               (set! registration-id (.ref (.ref fixture 'registration-a) 'identity))
               (values fixture (.ref fixture 'policies))))
           "txn" 1 1000. 0. 1 #f #f))
      ;; Possession of a POO host does not bypass its serialized Actor owner.
      (ensure (rejected? (lambda ()
                (agentic-ai-lab-temporal-proof-host-retained-digest held-proof registration-id)))
              "Foreign thread read Actor-owned proof state")
      (policy-clock-call! clock
        (lambda (fixture)
          (let* ((registration (.ref fixture 'registration-a))
                 (original (string-copy (.ref registration 'proof-digest)))
                 (read-value (agentic-ai-lab-temporal-proof-host-retained-digest held-proof registration-id))
                 (policy-digest (.ref (.ref fixture 'policy) 'semantic-digest))
                 (program (car (.ref fixture 'context)))
                 (catalog-digest (.ref program 'catalog-digest))
                 (first-char (string-ref catalog-digest 0)))
            ;; Neither returned historical strings nor the public registration
            ;; may mutate the private credential or the admitted native proof.
            (string-set! read-value 0 #\X)
            (string-set! (.ref registration 'proof-digest) 0 #\X)
            (ensure (equal? original (agentic-ai-lab-temporal-proof-host-retained-digest held-proof registration-id))
                    "Historical proof credential retained a mutable caller alias")
            (ensure (.ref (agentic-ai-lab-temporal-proof-host-current held-proof registration-id 1 1 policy-digest 128) 'current?)
                    "Public historical string mutation corrupted native proof admission")
            ;; A historical credential must never substitute for current replay.
            ;; Tamper with an actual replay input, then restore it for cleanup.
            (dynamic-wind
              (lambda () (string-set! catalog-digest 0 (if (char=? first-char #\X) #\Y #\X)))
              (lambda ()
                (ensure (equal? original (agentic-ai-lab-temporal-proof-host-retained-digest held-proof registration-id))
                        "Historical read rewrote its original proof credential")
                (ensure (rejected? (lambda ()
                          (agentic-ai-lab-temporal-proof-host-current held-proof registration-id 1 1 policy-digest 128)))
                        "Sealed historical credential bypassed current proof replay"))
              (lambda () (string-set! catalog-digest 0 first-char)))
            (context-host-dispose! (.ref fixture 'host)))))
      (policy-clock-stop! clock)
      (ensure (.ref (policy-clock-stop-receipt clock) 'owner-joined?) "Proof Actor was not joined"))
    (displayln "OWNER-PROOF retained=sealed aliases=detached current-tamper=refused foreign-owner=refused")))

(def (codec-probe!)
  (for-each check-wire (list 'symbol '() #t #f 42 -9 1/3 2.5 "quote\"\nline"
                             (cons 'a 'b) (vector 1 "v") (list 1 'a (.o v: #t))))
  (let* ((shared-value (.o leaf: (.o value: "original")))
         (shared (.o alpha: shared-value beta: shared-value))
         (independent (.o alpha: (.o leaf: (.o value: "original"))
                          beta: (.o leaf: (.o value: "original")))))
    (check-wire shared)
    (ensure (equal? (journal-pack shared) (journal-pack independent)) "Shared projection changed v1 wire bytes")
    (let nest ((remaining 38) (deep-value shared-value))
      (if (= remaining 0)
        (ensure (rejected? (lambda () (journal-pack (.o shallow: shared-value deep: deep-value))))
                "Shallow cached alias bypassed the depth bound")
        (nest (- remaining 1) (.o child: deep-value))))
    (ensure (equal? (journal-pack shared) (journal-pack (journal-unpack (journal-pack shared))))
            "Encoded shared checkpoint did not replay exactly"))
  (let (cycle (make-vector 1 #f))
    (vector-set! cycle 0 cycle)
    (ensure (rejected? (lambda () (journal-pack cycle))) "Cyclic data escaped the depth bound"))
  (ensure (rejected? (lambda () (journal-pack (lambda () #t)))) "Codec admitted a native procedure"))

(def (bootstrap-failure-probe! path)
  (let ((journal #f) (host #f) (owner #f))
    ;; Fail after durable input receipt and an uncommitted write, before the
    ;; clock lease/timer are enrolled. The real adapter owns rollback/close.
    (ensure
      (rejected? (lambda ()
        (policy-clock-owner
          (lambda ()
            (set! owner (current-thread))
            (set! journal (journal-open path))
            (journal-evidence! journal "bootstrap-original" "original-bytes")
            (let* ((f (authority-fixture #t (clock-original-context) 1000000 #f))
                   (adapter (context-durable-adapter journal (.ref f 'host) (.ref f 'grants)
                              (.ref f 'policies) (lambda (registration) (.ref f 'proof)))))
              (set! host (.ref f 'host))
              (values f (.ref f 'policies)
                (.o (:: @ adapter)
                    .anchor!: (lambda (self domain origin tick now boot)
                      (journal-receive! journal "bootstrap-failure" (.o original: "inbox-bytes"))
                      (journal-begin! journal "bootstrap-failure")
                      (journal-put! journal "uncommitted" "must-rollback")
                      (error "Injected anchor failure"))))))
          "txn" 1 1000. 0. 1 #f #f)))
      "Failed anchor incorrectly started an owner")
    (displayln "OWNER-BOOTSTRAP-OBS journal-closed=" (journal-closed? journal)
      " context-disposed=" (and (journal-closed? journal) (context-host-disposed? host)))
    (ensure (journal-closed? journal) "Failed bootstrap retained its actual journal")
    (ensure (and (context-host-disposed? host) (= (context-host-subscription-count host) 0))
            "Failed bootstrap retained Context observers")
    (ensure (not (eq? (thread-join! owner 0 'still-running) 'still-running))
            "Failed bootstrap owner was not joined")
    (let (reopened (journal-open path))
      (ensure (not (journal-get reopened "uncommitted")) "Failed bootstrap committed a partial write")
      (ensure (equal? (journal-get reopened "bootstrap-original" #t) "original-bytes")
              "Failed bootstrap lost original evidence")
      (ensure (equal? (.ref (journal-input reopened "bootstrap-failure") 'status) "pending")
              "Failed bootstrap lost its durable pending input")
      (journal-close! reopened))
    (displayln "OWNER-BOOTSTRAP rollback=exact journal=closed subscriptions=0 owner=joined pending=preserved")))

(def (owner-lifecycle-unit path)
  (proof-kernel-probe!) (retained-actor-probe!) (codec-probe!) (feed-probe!) (context-probe!) (clock-probe!) (journal-probe! path) (waiter-probe!)
  (pending-owner-probe! (string-append path ".pending.sqlite"))
  (bootstrap-failure-probe! (string-append path ".bootstrap.sqlite"))
  (displayln "OWNER-UNIT leases=exact pending=preserved foreign=retained retired-clock=denied rollback=preserved")
  (displayln "MODULE-OK t/context-owner-lifecycle-test.ss")
  (displayln "HARNESS-OK context-owner-lifecycle")
  (displayln "OK"))
