(def (study-action-id study suffix)
  (string->symbol (string-append "study:" (symbol->string study) ":" suffix)))
(define-program (make-actions)
  (sources DeclaredAction DeclaredRequires PremiseDepends DeclaredSatisfied DeclaredCurrent RecordedOutcome Hypothesis Prediction Observation ObservationEvidence PremiseEvidence ActionEvidence EvidenceReference ProcessExit
           DeclaredKind DeclaredStudyMember DeclaredSourcePremise StudySourceBinding StudySourceGap Capability
           StudyDeclaration StudyHypothesis StudyEvidence StudyExit SnapshotIdentity)
  (outputs StudyActionSpec StudyExpected Eligible Blocked OpenPrediction Discriminator Need Missing Supported ReusedEvidence ExistingFailure ExplanationGap FailedEvidence ActionGap)
  (relation DeclaredAction ((action symbol?)))
  (relation DeclaredCurrent ((action symbol?) (identity symbol?)))
  (relation DeclaredKind ((action symbol?) (kind symbol?)))
  (relation DeclaredStudyMember ((study symbol?) (action symbol?)))
  (relation DeclaredSourcePremise ((study symbol?) (premise symbol?)))
  (relation StudyDeclaration ((study symbol?) (path string?)))
  (relation StudyHypothesis ((study symbol?) (hypothesis symbol?)))
  (relation StudyEvidence ((study symbol?) (reference symbol?)))
  (relation StudyExit ((study symbol?) (reference symbol?) (exit exact-integer?)))
  (relation SnapshotIdentity ((identity symbol?)))
  (relation StudyActionSpec ((action symbol?) (operation symbol?) (study symbol?) (path string?)
                           (hypothesis symbol?) (risk symbol?) (admission symbol?)))
  (relation StudyExpected ((action symbol?) (description string?)))
  ((StudyActionSpec (expr (S) (study-action-id S "inspect")) 'inspect-study S Path 'none 'read-only 'recorded-only) <-- (StudyDeclaration S Path))
  ((StudyActionSpec (expr (S) (study-action-id S "trace")) 'trace-source S Path 'none 'local-artifact 'recorded-only) <-- (StudyDeclaration S Path))
  ((StudyActionSpec (expr (S) (study-action-id S "dynamic-origin")) 'dynamic-origin S Path 'none 'execution 'kernel-check-required) <-- (StudyDeclaration S Path))
  ((StudyActionSpec (expr (S H) (study-action-id S (string-append (symbol->string H) ":design"))) 'design-experiment S Path H 'local-artifact 'recorded-only) <-- (StudyDeclaration S Path) (StudyHypothesis S H))
  ((StudyExpected A "exact receipt/pointer correspondence") <-- (StudyActionSpec A 'inspect-study S Path H Risk Admission))
  ((StudyExpected A "competing predictions and missing observations") <-- (StudyActionSpec A 'inspect-study S Path H Risk Admission))
  ((StudyExpected A "exact candidate source anchors; not dynamic object provenance") <-- (StudyActionSpec A 'trace-source S Path H Risk Admission))
  ((StudyExpected A "first-producing-operation allocation/copy/scan/publication trace") <-- (StudyActionSpec A 'dynamic-origin S Path H Risk Admission))
  ((StudyExpected A "reviewable prediction/coverage/falsifier proposal; no execution authorization") <-- (StudyActionSpec A 'design-experiment S Path H Risk Admission))
  ((Action A) <-- (DeclaredAction A))
  ((Action A) <-- (StudyActionSpec A Kind S Path H Risk Admission))
  ((ActionKind A Kind) <-- (DeclaredKind A Kind))
  ((ActionKind A Kind) <-- (StudyActionSpec A Kind S Path H Risk Admission))
  ((StudyMember S A) <-- (DeclaredStudyMember S A))
  ((StudyMember S A) <-- (StudyActionSpec A Kind S Path H Risk Admission))
  ((StudySourcePremise S P) <-- (DeclaredSourcePremise S P))
  ((StudySourcePremise S (expr (S) (study-action-id S "exact-source"))) <-- (StudyDeclaration S Path))
  ((Current A I) <-- (DeclaredCurrent A I))
  ((Current A I) <-- (Action A) (SnapshotIdentity I))
  (relation Action ((action symbol?)))
  (relation Requires ((action symbol?) (premise symbol?)))
  (relation DeclaredRequires ((action symbol?) (premise symbol?)))
  (relation DeclaredSatisfied ((premise symbol?)))
  (relation ActionKind ((action symbol?) (kind symbol?)))
  (relation StudyMember ((study symbol?) (action symbol?)))
  (relation StudySourcePremise ((study symbol?) (premise symbol?)))
  (relation StudySourceBinding ((study symbol?) (reference symbol?)))
  (relation StudySourceGap ((study symbol?) (reason string?)))
  (relation Capability ((name symbol?) (premise symbol?)))
  (relation PremiseSupport ((premise symbol?) (reference symbol?)))
  (relation ActionSupport ((action symbol?) (reference symbol?)))
  (relation ActionExit ((action symbol?) (reference symbol?) (exit exact-integer?)))
  (relation ActionGap ((action symbol?) (premise symbol?) (reason string?)))
  (relation PremiseDepends ((premise symbol?) (dependency symbol?)))
  (relation Need ((action symbol?) (premise symbol?)))
  (relation Satisfied ((premise symbol?)))
  (relation Current ((action symbol?) (identity symbol?)))
  (relation RecordedOutcome ((action symbol?) (identity symbol?) (outcome symbol?)))
  (relation Missing ((action symbol?) (premise symbol?)))
  (relation HasMissing ((action symbol?)))
  (relation Eligible ((action symbol?)))
  (relation Blocked ((action symbol?) (premise symbol?)))
  (relation Hypothesis ((hypothesis symbol?)))
  (relation Prediction ((hypothesis symbol?) (observation symbol?) (expected symbol?)))
  (relation Observation ((observation symbol?)))
  (relation ObservationEvidence ((observation symbol?) (reference symbol?)))
  (relation BoundObservation ((observation symbol?)))
  (relation OpenPrediction ((hypothesis symbol?) (observation symbol?) (expected symbol?)))
  (relation Discriminator ((left symbol?) (right symbol?) (observation symbol?)))
  (relation PremiseEvidence ((premise symbol?) (reference symbol?)))
  (relation ActionEvidence ((action symbol?) (reference symbol?)))
  (relation EvidenceReference ((reference symbol?) (path symbol?) (hash symbol?) (pointer symbol?)))
  (relation Supported ((action symbol?) (premise symbol?) (reference symbol?)))
  (relation ReusedEvidence ((action symbol?) (reference symbol?)))
  (relation ExistingFailure ((action symbol?) (identity symbol?) (outcome symbol?)))
  (relation HasEvidence ((premise symbol?)))
  (relation ExplanationGap ((action symbol?) (premise symbol?)))
  (relation ProcessExit ((action symbol?) (reference symbol?) (exit exact-integer?)))
  (relation FailedEvidence ((action symbol?) (reference symbol?) (exit exact-integer?)))
  ((Requires A P) <-- (DeclaredRequires A P))
  ((Satisfied P) <-- (DeclaredSatisfied P))
  ((Requires A P) <-- (ActionKind A Kind) (StudyMember S A) (StudySourcePremise S P)
                    (if (Kind) (or (eq? Kind 'trace-source) (eq? Kind 'dynamic-origin))))
  ((Requires A (lit 'capability:source.reference-origin)) <-- (ActionKind A 'dynamic-origin))
  ((Satisfied P) <-- (Capability Name P))
  ((Satisfied P) <-- (StudySourcePremise S P) (StudySourceBinding S R) (EvidenceReference R Path Hash Pointer))
  ((PremiseSupport P R) <-- (PremiseEvidence P R))
  ((PremiseSupport P R) <-- (StudySourcePremise S P) (StudySourceBinding S R))
  ((ActionSupport A R) <-- (ActionEvidence A R))
  ((ActionSupport A R) <-- (StudyMember S A) (StudyEvidence S R))
  ((ActionExit A R Code) <-- (ProcessExit A R Code))
  ((ActionExit A R Code) <-- (StudyMember S A) (StudyExit S R Code))
  ((ActionGap A P Reason) <-- (StudyMember S A) (StudySourcePremise S P)
                            (Requires A P) (StudySourceGap S Reason) (not (Satisfied P)))
  ((ActionGap A (lit 'capability:source.reference-origin) "No sealed first-producer tracing capability is implemented; debug CLI is not an execution substitute.") <--
    (ActionKind A 'dynamic-origin) (not (Satisfied 'capability:source.reference-origin)))
  ((BoundObservation O) <-- (Observation O) (ObservationEvidence O R) (EvidenceReference R Path Hash Pointer))
  ((OpenPrediction H O E) <-- (Hypothesis H) (Prediction H O E) (not (BoundObservation O)))
  ((Discriminator L R O) <-- (Prediction L O E) (Prediction R O F) (if (L R E F) (and (not (eq? L R)) (not (eq? E F)))))
  ((Need A P) <-- (Requires A P))
  ((Need A Q) <-- (Need A P) (PremiseDepends P Q))
  ((HasEvidence P) <-- (PremiseSupport P R) (EvidenceReference R Path Hash Pointer))
  ((Supported A P R) <-- (Need A P) (Satisfied P) (PremiseSupport P R) (EvidenceReference R Path Hash Pointer))
  ((ReusedEvidence A R) <-- (Supported A P R))
  ((ReusedEvidence A R) <-- (ActionSupport A R) (EvidenceReference R Path Hash Pointer))
  ((FailedEvidence A R Code) <-- (ActionExit A R Code) (EvidenceReference R Path Hash Pointer) (if (Code) (not (= Code 0))))
  ((ExplanationGap A P) <-- (Need A P) (Satisfied P) (not (HasEvidence P)))
  ((ExistingFailure A I O) <-- (Current A I) (RecordedOutcome A I O) (if (O) (or (eq? O 'DENY) (eq? O 'FAILED) (eq? O 'STALE))))
  ((Missing A P) <-- (Need A P) (not (Satisfied P)))
  ((HasMissing A) <-- (Missing A P))
  ((HasMissing A) <-- (Current A I) (RecordedOutcome A I O) (if (O) (or (eq? O 'DENY) (eq? O 'FAILED) (eq? O 'STALE))))
  ((Blocked A (lit 'unchanged-failed-action)) <-- (Current A I) (RecordedOutcome A I O) (if (O) (or (eq? O 'DENY) (eq? O 'FAILED) (eq? O 'STALE))))
  ((Blocked A P) <-- (Missing A P))
  ((Eligible A) <-- (Action A) (not (HasMissing A))))
