load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_static_library.bzl", "cc_static_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load(":runtime_checks.bzl", "runtime_contract_parity_test", "runtime_gerbil_benchmark_test", "runtime_gerbil_script_test", "runtime_leak_test")
load(":runtime_contract.bzl", "runtime_contract")

package(default_visibility = ["//visibility:public"])

exports_files([
    "pkgconfig/agentic-ai-lab-runtime-v0.pc",
    "include/agentic_ai_lab/scheme_native_v1.h",
    "include/agentic_ai_lab/semantic.h",
    "t/validate-runtime-v0-symbol-surface.ss",
])

cc_library(
    name = "scheme_native_v1_headers",
    hdrs = ["include/agentic_ai_lab/scheme_native_v1.h"],
    strip_include_prefix = "include",
)

runtime_contract(
    name = "runtime_v0_contract",
    clan_poo_root = "@gerbil_poo_sources//:gerbil.pkg",
    clan_poo_sources = "@gerbil_poo_sources//:sources",
    generator = "tools/generate-runtime-v0-contract.ss",
    schema = "//:runtime_v0_schema",
    scheme_sources = "//:gerbil_package_sources",
)

runtime_contract_parity_test(
    name = "runtime_v0_contract_parity_test",
    checked_event_vector = "tests/vectors/runtime_v0_event_1.txt",
    checked_header = "include/agentic_ai_lab/runtime_v0_contract.h",
    checked_vector = "tests/vectors/runtime_v0_contract.txt",
    generated_event_vector = ":runtime_v0_event_vector",
    generated_header = ":runtime_v0_contract_header",
    generated_vector = ":runtime_v0_contract_vector",
)

filegroup(
    name = "runtime_v0_contract_header",
    srcs = [":runtime_v0_contract"],
    output_group = "header",
)

filegroup(
    name = "runtime_v0_contract_vector",
    srcs = [":runtime_v0_contract"],
    output_group = "vector",
)

filegroup(
    name = "runtime_v0_event_vector",
    srcs = [":runtime_v0_contract"],
    output_group = "event_vector",
)

cc_library(
    name = "runtime_v0_contract_headers",
    hdrs = [":runtime_v0_contract_header"],
    strip_include_prefix = "generated/include",
)

cc_library(
    name = "runtime_v0_headers",
    hdrs = ["include/agentic_ai_lab/runtime_v0.h"],
    strip_include_prefix = "include",
    deps = [":runtime_v0_contract_headers"],
)

cc_library(
    name = "proof_case_v1_headers",
    hdrs = [
        "include/agentic_ai_lab/proof_case_v1.h",
        "include/agentic_ai_lab/proof_case_vector_v1.h",
    ],
    strip_include_prefix = "include",
)

cc_library(
    name = "runtime_c_library",
    srcs = [
        "src/proof_case_v1.c",
        "src/runtime_v0.c",
    ],
    copts = [
        "-std=c11",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-pedantic",
    ],
    deps = [
        ":proof_case_v1_headers",
        ":runtime_v0_headers",
    ],
    alwayslink = True,
)

cc_binary(
    name = "runtime_c_shared",
    linkshared = True,
    deps = [":runtime_c_library"],
)

cc_static_library(
    name = "runtime_c_static",
    deps = [":runtime_c_library"],
)

cc_test(
    name = "runtime_v0_harness",
    size = "small",
    srcs = ["tests/runtime_v0_harness.c"],
    deps = [":runtime_c_library"],
)

cc_test(
    name = "scheme_native_v1_header_harness",
    size = "small",
    srcs = ["tests/scheme_native_v1_header_harness.c"],
    deps = [":scheme_native_v1_headers"],
)

runtime_gerbil_benchmark_test(
    name = "runtime_v0_gerbil_ffi_benchmark",
    contract_header = ":runtime_v0_contract_header",
    header = "include/agentic_ai_lab/runtime_v0.h",
    library = ":runtime_c_shared",
    package_file = "//:gerbil.pkg",
    source = "benchmarks/runtime-v0-gerbil-ffi-benchmark.ss",
    tags = ["manual"],
)

cc_test(
    name = "runtime_v0_batch_harness",
    size = "small",
    srcs = ["tests/runtime_v0_batch_harness.c"],
    deps = [":runtime_c_library"],
)

cc_test(
    name = "runtime_v0_vector_harness",
    size = "small",
    srcs = ["tests/runtime_v0_vector_harness.c"],
    args = ["$(location :runtime_v0_event_vector)"],
    data = [":runtime_v0_event_vector"],
    deps = [":runtime_c_library"],
)

cc_test(
    name = "runtime_v0_installed_consumer",
    size = "small",
    srcs = ["tests/runtime_v0_installed_consumer.c"],
    deps = [":runtime_c_library"],
)

runtime_gerbil_script_test(
    name = "runtime_v0_symbol_surface_test",
    size = "small",
    arguments = [
        ":t/validate-runtime-v0-symbol-surface.ss",
        ":runtime_c_shared",
        ":runtime_v0_exported_symbols",
        "@gerbil_poo_sources//:gerbil.pkg",
    ],
    data = [
        "//:gerbil_package_sources",
        "@gerbil_poo_sources//:sources",
    ],
    script = "tests/runtime_v0_symbol_surface_test.sh",
)

filegroup(
    name = "runtime_v0_exported_symbols",
    srcs = ["tests/runtime_v0_exported_symbols.json"],
)

cc_test(
    name = "proof_case_v1_harness",
    size = "small",
    srcs = ["tests/proof_case_v1_harness.c"],
    deps = [":runtime_c_library"],
)

cc_test(
    name = "proof_case_v1_installed_consumer",
    size = "small",
    srcs = ["tests/proof_case_v1_installed_consumer.c"],
    deps = [":runtime_c_library"],
)

cc_test(
    name = "proof_case_v1_harness_ubsan",
    srcs = [
        "src/proof_case_v1.c",
        "tests/proof_case_v1_harness.c",
    ],
    copts = [
        "-fno-omit-frame-pointer",
        "-fsanitize=undefined",
    ],
    linkopts = ["-fsanitize=undefined"],
    deps = [":proof_case_v1_headers"],
)

cc_test(
    name = "proof_case_v1_harness_asan",
    srcs = [
        "src/proof_case_v1.c",
        "tests/proof_case_v1_harness.c",
    ],
    copts = [
        "-fno-omit-frame-pointer",
        "-fsanitize=address",
    ],
    linkopts = ["-fsanitize=address"],
    deps = [":proof_case_v1_headers"],
)

cc_test(
    name = "runtime_v0_harness_ubsan",
    srcs = [
        "src/runtime_v0.c",
        "tests/runtime_v0_harness.c",
    ],
    copts = [
        "-fno-omit-frame-pointer",
        "-fsanitize=undefined",
    ],
    linkopts = ["-fsanitize=undefined"],
    deps = [":runtime_v0_headers"],
)

cc_test(
    name = "runtime_v0_batch_harness_ubsan",
    srcs = [
        "src/runtime_v0.c",
        "tests/runtime_v0_batch_harness.c",
    ],
    copts = [
        "-fno-omit-frame-pointer",
        "-fsanitize=undefined",
    ],
    linkopts = ["-fsanitize=undefined"],
    deps = [":runtime_v0_headers"],
)

cc_test(
    name = "runtime_v0_harness_asan",
    srcs = [
        "src/runtime_v0.c",
        "tests/runtime_v0_harness.c",
    ],
    copts = [
        "-fno-omit-frame-pointer",
        "-fsanitize=address",
    ],
    linkopts = ["-fsanitize=address"],
    deps = [":runtime_v0_headers"],
)

cc_test(
    name = "runtime_v0_batch_harness_asan",
    srcs = [
        "src/runtime_v0.c",
        "tests/runtime_v0_batch_harness.c",
    ],
    copts = [
        "-fno-omit-frame-pointer",
        "-fsanitize=address",
    ],
    linkopts = ["-fsanitize=address"],
    deps = [":runtime_v0_headers"],
)

test_suite(
    name = "runtime_c_sanitizer_tests",
    tests = [
        ":proof_case_v1_harness_asan",
        ":proof_case_v1_harness_ubsan",
        ":runtime_v0_batch_harness_asan",
        ":runtime_v0_batch_harness_ubsan",
        ":runtime_v0_contract_parity_test",
        ":runtime_v0_harness_asan",
        ":runtime_v0_harness_ubsan",
    ],
)

runtime_leak_test(
    name = "runtime_c_leak_test",
    binaries = [
        ":proof_case_v1_harness",
        ":runtime_v0_batch_harness",
        ":runtime_v0_harness",
    ],
    tags = ["manual"],
)

cc_binary(
    name = "runtime_v0_batch_benchmark",
    srcs = ["benchmarks/runtime_v0_batch_benchmark.c"],
    copts = ["-O3"],
    deps = [":runtime_c_library"],
)

cc_binary(
    name = "proof_case_v1_benchmark",
    srcs = ["benchmarks/proof_case_v1_benchmark.c"],
    copts = ["-O3"],
    deps = [":runtime_c_library"],
)

cc_test(
    name = "proof_case_v1_benchmark_smoke",
    size = "small",
    srcs = ["benchmarks/proof_case_v1_benchmark.c"],
    args = ["5"],
    copts = ["-O3"],
    deps = [":runtime_c_library"],
)

cc_test(
    name = "runtime_v0_batch_benchmark_smoke",
    srcs = ["benchmarks/runtime_v0_batch_benchmark.c"],
    args = ["20"],
    copts = ["-O3"],
    deps = [":runtime_c_library"],
)

test_suite(
    name = "runtime_c_tests",
    tests = [
        ":proof_case_v1_benchmark_smoke",
        ":proof_case_v1_harness",
        ":proof_case_v1_installed_consumer",
        ":runtime_v0_batch_harness",
        ":runtime_v0_harness",
        ":runtime_v0_installed_consumer",
        ":runtime_v0_symbol_surface_test",
        ":runtime_v0_vector_harness",
        ":scheme_native_v1_header_harness",
    ],
)

# Temporal local first-root selection; requires the platform SQLite development library.
cc_library(
    name = "temporal_store",
    srcs = ["src/temporal_store.c"],
    hdrs = ["include/agentic_ai_lab/temporal_store.h"],
    strip_include_prefix = "include",
    linkopts = ["-lsqlite3", "-lpthread"],
)
