;;; -*- Gerbil -*-
;;; SPDX-FileCopyrightText: 2026 tao3k team and Contributors
;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Reader-question projection, independent of native containment geometry.
(import (only-in :clan/poo/object .o .ref .slot?)
        (only-in :std/list/list delete-duplicates/hash filter-map)
        (only-in :gerbil-ascent/program/syntax ascent)
        (only-in :gerbil-ascent/program/interface gerbil-ascent-evaluate-program)
        "ascent-composition.ss" "config.ss")
(export d2-teaching)
(def (teaching-rows values slots)
  (map (lambda (value) (map (lambda (slot) (.ref value slot)) slots)) values))
(def (quotation-in? text excerpt)
  (def width (string-length excerpt))
  (let loop ((start 0))
    (and (<= (+ start width) (string-length text))
         (or (string=? excerpt (substring text start (+ start width)))
             (loop (+ start 1))))))
(def (d2-teaching source-value proposals needs mechanism-value (policy D2Config))
  (when (and (.slot? mechanism-value 'artwork) (not (equal? (.ref mechanism-value 'artwork) "")))
    (error "whole-scene artwork cannot replace inferred explanatory composition"))
  (def link-values (.ref mechanism-value 'links))
  (def requirements (.ref mechanism-value 'requirements))
  (def traces (.ref mechanism-value 'traces))
  (def attachment-values (if (.slot? mechanism-value 'attachments) (.ref mechanism-value 'attachments) '()))
  (def region-values (if (.slot? mechanism-value 'regions) (.ref mechanism-value 'regions) '()))
  (def cohesion-values (if (.slot? mechanism-value 'cohesion) (.ref mechanism-value 'cohesion) '()))
  (unless (and (<= (length region-values) 32) (<= (length cohesion-values) 128)
               (= (length region-values) (length (delete-duplicates/hash (map (lambda (g) (.ref g 'identity)) region-values))))
               (= (length (apply append (map (lambda (g) (.ref g 'members)) region-values)))
                  (length (delete-duplicates/hash (apply append (map (lambda (g) (.ref g 'members)) region-values)))))
               (not (ormap (lambda (g) (member (.ref g 'identity) (map (lambda (p) (.ref p 'identity)) proposals))) region-values)))
    (error "invalid explanatory regions or repeated visual membership"))
  (unless (and (<= (length link-values) 256) (<= (length requirements) 256) (<= (length traces) 128)
               (<= (length attachment-values) 128)
               (= (length attachment-values) (length (delete-duplicates/hash
                 (map (lambda (a) (.ref a 'child)) attachment-values))))
               (= (length link-values) (length (delete-duplicates/hash (map (lambda (l) (.ref l 'identity)) link-values)))))
    (error "invalid mechanism link identities or bounds"))
  (unless (and (<= (length proposals) 128) (<= (length needs) 128)
               (= (length proposals) (length (delete-duplicates/hash
                 (map (lambda (p) (.ref p 'identity)) proposals)))))
    (error "invalid teaching proposal identities or bounds"))
  ;; This checks a quotation against captured bytes, not the truth of the
  ;; document or the adequacy of the proposed visual interpretation.
  (def (located-quotes values)
    (apply append (map (lambda (proposal)
      (filter-map (lambda (document)
        (and (equal? (.ref proposal 'source) (.ref document 'identity))
             (> (string-length (.ref proposal 'excerpt)) 0)
             (quotation-in? (.ref document 'text) (.ref proposal 'excerpt))
             (list (.ref proposal 'identity)))) (.ref source-value 'documents))) values)))
  (def quotations (located-quotes proposals))
  (def evaluation
    (gerbil-ascent-evaluate-program
     (ascent
      (relation Native (ref) (map (lambda (n) (list (.ref n 'source-ref))) (.ref source-value 'nodes)))
      (relation Need (q facet ref) (teaching-rows needs '(question facet target)))
      (relation Proposal (id q facet ref glyph)
        (teaching-rows proposals '(identity question facet target glyph)))
      (relation Quoted (id) quotations)
      (relation LinkQuote (id) (located-quotes link-values))
      (relation Link (id from to role)
        (teaching-rows link-values '(identity from to role)))
      (relation Propagates (id)
        (map (lambda (l) (list (.ref l 'identity)))
          (filter (lambda (l) (.ref l 'propagates?)) link-values)))
      (relation Negation (id)
        (map (lambda (l) (list (.ref l 'identity)))
          (filter (lambda (l) (and (.slot? l 'style) (equal? (.ref l 'style) "negation"))) link-values)))
      (relation InvalidNegation (id))
      (relation Region (id) (map (lambda (g) (list (.ref g 'identity))) region-values))
      (relation RegionQuote (id) (located-quotes region-values))
      (relation Member (region id)
        (apply append (map (lambda (g) (map (lambda (id) (list (.ref g 'identity) id)) (.ref g 'members))) region-values)))
      (relation Cohere (q first second) (teaching-rows cohesion-values '(question first second)))
      (relation BadRegion (id))
      (relation HasMember (id))
      (relation ValidRegion (id))
      (relation CoLocated (first second))
      (relation MissingCohesion (q first second))
      (relation RequiredLink (q from to role)
        (teaching-rows requirements '(question from to role)))
      (relation RequiredTrace (q from to) (teaching-rows traces '(question from to)))
      (relation Attached (child parent) (teaching-rows attachment-values '(child parent)))
      ;; A non-propagating explanation of the SAME referent belongs with that
      ;; object. This is a semantic ownership relation, not a canvas placement.
      (relation Referent (id ref)
        (map (lambda (p) (list (.ref p 'identity)
          (if (.slot? p 'referent) (.ref p 'referent) (.ref p 'identity)))) proposals))
      (relation OwnedExplanation (child parent)
        (filter-map (lambda (l)
          (and (not (.ref l 'propagates?)) (.slot? l 'meaning)
            (.slot? (.ref l 'meaning) 'annotation?)
            (.ref (.ref l 'meaning) 'annotation?)
            (list (.ref l 'from) (.ref l 'to)))) link-values))

      (relation Attachment (child parent))
      (relation AttachedAncestor (child ancestor))
      (relation InvalidAttachment (child parent))
      (relation CyclicAttachment (child))
      (relation AttachablePair (from to))
      (relation Located (id q facet ref glyph))
      (relation Selected (id q facet ref glyph))
      (relation Group (q))
      (relation Covered (q facet ref))
      (relation Missing (q facet ref))
      (relation Unsupported (id))
      (relation SelectedId (id))
      (relation SelectedLink (id from to role))
      (relation Linked (from to role))
      (relation UnsupportedLink (id))
      (relation Reach (from to))
      (relation MissingLink (q from to role))
      (relation MissingTrace (q from to))
      ((Located Id Q Facet Ref Glyph) <-- (Proposal Id Q Facet Ref Glyph) (Quoted Id) (Native Ref))
      ((Selected Id Q Facet Ref Glyph) <-- (Located Id Q Facet Ref Glyph) (Need Q Facet Ref))
      ((Group Q) <-- (Selected Id Q Facet Ref Glyph))
      ((Covered Q Facet Ref) <-- (Selected Id Q Facet Ref Glyph))
      ((SelectedId Id) <-- (Selected Id Q Facet Ref Glyph))
      ((HasMember G) <-- (Member G Id))
      ((BadRegion G) <-- (Region G) (not (RegionQuote G)))
      ((BadRegion G) <-- (Region G) (not (HasMember G)))
      ((BadRegion G) <-- (Member G Id) (not (SelectedId Id)))
      ((ValidRegion G) <-- (Region G) (not (BadRegion G)))
      ((CoLocated A B) <-- (ValidRegion G) (Member G A) (Member G B))
      ((MissingCohesion Q A B) <-- (Cohere Q A B) (not (CoLocated A B)))
      ((SelectedLink Id From To Role) <-- (Link Id From To Role) (LinkQuote Id)
        (SelectedId From) (SelectedId To))
      ((Linked From To Role) <-- (SelectedLink Id From To Role))
      ((AttachablePair From To) <-- (SelectedLink Id From To Role) (not (Propagates Id)))
      ((Attachment Child Parent) <-- (Attached Child Parent) (AttachablePair Child Parent))
      ((Attachment Child Parent) <-- (OwnedExplanation Child Parent)
        (AttachablePair Child Parent) (Referent Child Ref) (Referent Parent Ref))
      ((InvalidAttachment Child Parent) <-- (Attached Child Parent) (not (AttachablePair Child Parent)))
      ((AttachedAncestor Child Parent) <-- (Attachment Child Parent))
      ((AttachedAncestor Child Ancestor) <-- (AttachedAncestor Child Middle) (Attachment Middle Ancestor))
      ((CyclicAttachment Child) <-- (AttachedAncestor Child Child))
      ((UnsupportedLink Id) <-- (Link Id From To Role) (not (SelectedLink Id From To Role)))
      ((Reach From To) <-- (SelectedLink Id From To Role) (Propagates Id))
      ((InvalidNegation Id) <-- (Negation Id) (Propagates Id))
      ((Reach From To) <-- (Reach From Middle) (Reach Middle To))
      ((MissingLink Q From To Role) <-- (RequiredLink Q From To Role)
        (not (Linked From To Role)))
      ((MissingTrace Q From To) <-- (RequiredTrace Q From To) (not (Reach From To)))
      ((Missing Q Facet Ref) <-- (Need Q Facet Ref) (not (Covered Q Facet Ref)))
      ((Unsupported Id) <-- (Proposal Id Q Facet Ref Glyph) (not (Located Id Q Facet Ref Glyph)))
      (bounds 1024 8192 16384))))
  (def rows (.ref evaluation 'rows-of))
  (def selected-items (filter (lambda (p) (member (.ref p 'identity) (map car (rows 'Selected)))) proposals))
  (def selected-links (filter (lambda (l) (member (.ref l 'identity) (map car (rows 'SelectedLink)))) link-values))
  (def composition-value (d2-compose selected-items selected-links policy))
  (def supplied-regions (filter (lambda (g) (member (.ref g 'identity) (map car (rows 'ValidRegion)))) region-values))
  ;; Existing explicit source-qualified neighborhoods keep ownership. Inferred
  ;; neighborhoods may only use otherwise ungrouped members.
  (def inferred-regions (filter (lambda (g)
    (not (ormap (lambda (other)
      (ormap (lambda (id) (member id (.ref other 'members))) (.ref g 'members))) supplied-regions)))
    (.ref composition-value 'regions)))
  (.o inference: evaluation missing: (rows 'Missing) unsupported: (rows 'Unsupported)
      composition: composition-value
      ;; Preserve the model's proposed reading order within each question.
      ;; It is a presentation order, never an execution dependency or approval.
      items: selected-items
      groups: (rows 'Group)
      links: selected-links
      unsupported-links: (rows 'UnsupportedLink)
      attachments: (rows 'Attachment)
      invalid-attachments: (rows 'InvalidAttachment) cyclic-attachments: (rows 'CyclicAttachment)
      invalid-negations: (rows 'InvalidNegation)
      regions: (append supplied-regions inferred-regions)
      invalid-regions: (rows 'BadRegion) missing-cohesion: (rows 'MissingCohesion)
      missing-links: (rows 'MissingLink) missing-traces: (rows 'MissingTrace)
      structure-gaps: (append
        (.ref composition-value 'gaps)
        (map (lambda (row) (.o question: (car row) target: (cadr row) reason: 'missing-explanatory-relation)) (rows 'MissingLink))
        (map (lambda (row) (.o question: (car row) target: (cadr row) reason: 'missing-state-change-trace)) (rows 'MissingTrace))
        (map (lambda (row) (.o question: (car row) target: (cadr row) reason: 'separated-causal-neighborhood)) (rows 'MissingCohesion)))))
