(import (only-in :clan/poo/object .ref .slot? object?)
        (only-in :clan/poo/mop Type. define-type))
(export D2ScopeContract d2-diagram?)
(def (has-slots? value slots)
  (and (object? value) (andmap (lambda (slot) (.slot? value slot)) slots)))
(def (node? value)
  (and (has-slots? value '(identity label kind))
       (symbol? (.ref value 'identity)) (string? (.ref value 'label))
       (<= (string-length (.ref value 'label)) 4096)
       (symbol? (.ref value 'kind))))
(def (relation? value)
  (and (has-slots? value '(from to role))
       (symbol? (.ref value 'from)) (symbol? (.ref value 'to))
       (symbol? (.ref value 'role))))
(def (d2-diagram? value)
  (and (has-slots? value '(identity revision nodes relations roots))
       (symbol? (.ref value 'identity)) (symbol? (.ref value 'revision))
       (list? (.ref value 'nodes)) (<= (length (.ref value 'nodes)) 128)
       (andmap node? (.ref value 'nodes))
       (list? (.ref value 'relations)) (<= (length (.ref value 'relations)) 256)
       (andmap relation? (.ref value 'relations))
       (list? (.ref value 'roots)) (<= (length (.ref value 'roots)) 128)
       (andmap symbol? (.ref value 'roots))))
(def (scope? value)
  (and (has-slots? value '(prototypes infer review plan author scene teaching source profiles))
       (object? (.ref value 'prototypes)) (object? (.ref value 'profiles))
       (procedure? (.ref value 'infer)) (procedure? (.ref value 'review)) (procedure? (.ref value 'plan))
       (procedure? (.ref value 'author))
       (procedure? (.ref value 'scene))
       (procedure? (.ref value 'teaching))
       (procedure? (.ref value 'source))))
(define-type (D2ScopeContract @ Type.) identity: 'd2/scope .element?: scope?)
