(import (only-in :clan/poo/object .ref)
        (only-in :gerbil-ascent/program/syntax ascent))
(export d2-graph-program)
(def (project objects slots)
  (map (lambda (value) (map (lambda (slot) (.ref value slot)) slots)) objects))
(def (d2-graph-program diagram)
  (ascent
    (relation Node (id kind label) (project (.ref diagram 'nodes) '(identity kind label)))
    (relation Edge (from to role) (project (.ref diagram 'relations) '(from to role)))
    (relation Root (id) (map list (.ref diagram 'roots)))
    (relation HasRoot ())
    (relation Referenced (id))
    (relation Declared (id))
    (relation MissingNode (id))
    (relation Reach (from to))
    (relation Visible (id))
    (relation VisualNode (id kind label))
    (relation VisualEdge (from to role))
    (relation CycleMember (id))
    ((Declared X) <-- (Node X K L))
    ((Referenced X) <-- (Root X))
    ((Referenced X) <-- (Edge X Y R))
    ((Referenced Y) <-- (Edge X Y R))
    ((MissingNode X) <-- (Referenced X) (not (Declared X)))
    ((HasRoot) <-- (Root X))
    ((Reach X Y) <-- (Edge X Y R))
    ((Reach X Z) <-- (Reach X Y) (Edge Y Z R))
    ((Visible X) <-- (Root X))
    ((Visible Y) <-- (Root X) (Reach X Y))
    ((Visible X) <-- (Node X K L) (not (HasRoot)))
    ((VisualNode X K L) <-- (Visible X) (Node X K L))
    ((VisualEdge X Y R) <-- (Visible X) (Visible Y) (Edge X Y R))
    ((CycleMember X) <-- (Visible X) (Reach X X))
    (bounds 512 32768 32768)))
