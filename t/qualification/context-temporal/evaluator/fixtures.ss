;;; Shared native fixtures. Test verdicts remain in the original Suite.
(import (only-in :agentic-ai-lab/modules/workflow/runtime/scheme-wire scheme-wire-read scheme-wire-write)
        (only-in :agentic-ai-lab/modules/ai-agentic-context/objects AiAgenticContextScope.)
        (only-in :agentic-ai-lab/modules/ai-agentic-context/funs-features agentic-ai-lab-ai-agentic-context-profile)
        :agentic-ai-lab/modules/ai-agentic-context/session-host
        :agentic-ai-lab/modules/ai-agentic-context/use-host
        :agentic-ai-lab/modules/session/funs-attempt
        :agentic-ai-lab/modules/query/semantic/context-restriction
        :agentic-ai-lab/modules/temporal-causality/runtime/policy-clock
        :std/test (only-in :clan/poo/object .o .ref object?)
        (only-in :yuanxu/observability/testing-case yuanxu-test-case yuanxu-test-case/with yuanxu-selected-testing-case-profile)
        (only-in :yuanxu/ops/progress execution-progress!)
        (only-in :gerbil-ascent/candidate/checked-program
                 reasoning-source-snapshot reasoning-attempt reasoning-receipt-status reasoning-receipt-proof
                 reasoning-receipt-rows reasoning-receipt-bound?)
        (only-in :gerbil-ascent/candidate/provenance positive-proof-status positive-proof-nodes positive-proof-roots proof-node-id proof-node-kind proof-node-row proof-node-relation proof-node-inputs)
        :agentic-ai-lab/modules/temporal-causality/evaluator/interface
        :agentic-ai-lab/modules/temporal-causality/time/objects
        :agentic-ai-lab/modules/temporal-causality/revisions/interface
        :agentic-ai-lab/modules/temporal-causality/truth-maintenance/support/interface
        :agentic-ai-lab/modules/temporal-causality/truth-maintenance/support/policy-host)
(export #t)

;;; Keep the assertion outside the catch: std/test check-exception with `true`
;;; can catch its own missing-exception TestError and silently pass.
(def (rejected? thunk) (try (begin (thunk) #f) (catch (e) #t)))
(defrule (check-rejected expr) (check (rejected? (lambda () expr)) => #t))
;;; Original ASCENT owner data is used only at the explicitly named owner adapter.
(def (source generation) (reasoning-source-snapshot 'graph generation '((edge 2 ((1 2) (2 3))))))
(def proposal '(candidate (relation path 2)
                 (rule (path ?x ?y) (edge ?x ?y))
                 (rule (path ?x ?z) (path ?x ?y) (edge ?y ?z))
                 (query path 1 3) (limits 8 16 32)))
(def (admit snapshot datum receipt (steps 512) (nodes 32))
  (agentic-ai-lab-temporal-positive-proof-from-ascent "proof" snapshot datum receipt steps nodes))

(def (at n) (agentic-ai-lab-temporal-instant (number->string n) "txn" n "host-clock" 'observed))
(def (policy rev) (agentic-ai-lab-temporal-support-policy "policy" rev (at 1) (at 4)))
(def program (agentic-ai-lab-temporal-support-program "p" "policy" #t
  (list (agentic-ai-lab-temporal-support "s" "claim" "unadmitted-label"
    (list (agentic-ai-lab-temporal-support-premise "source" "r1")) '()))))
(def journal (agentic-ai-lab-temporal-evidence-journal "j" "txn"
  (list (agentic-ai-lab-temporal-evidence-revision "r1" "source" 'assert #f (at 1) (agentic-ai-lab-temporal-interval "valid" (at 0) (at 10) #t #f) "content"))))
(def (guard host gen p)
  (agentic-ai-lab-temporal-support-policy-host-guard host gen (.ref p 'semantic-digest)
    program journal (at 1) #f 128))


;;; Inert original-owner projection fixture; the normal API is native POO values.
(def (mrr-rule-program-fixture)
  (let* ((data (call-with-input-file (or (getenv "AGENTIC_AI_LAB_MRR_RULE_ORACLE" #f)
                    "t/qualification/temporal-library-basic/rule-correspondence-v1/typed-rules.ss")
                 (lambda (p) (scheme-wire-read (read-line p)))))
         (term (lambda (t) (if (equal? (hash-ref t "kind") "variable")
                 (agentic-ai-lab-temporal-rule-variable (hash-ref t "name"))
                 (agentic-ai-lab-temporal-rule-literal (hash-ref t "value")))))
         (atom (lambda (a) (agentic-ai-lab-temporal-rule-atom (hash-ref a "relationId") (map term (hash-ref a "terms")))))
         (relations (map (lambda (r) (agentic-ai-lab-temporal-rule-relation (hash-ref r "identity") (hash-ref r "predicate")
                       (map string->symbol (hash-ref r "columns")))) (hash-ref data "relations")))
         (rules (map (lambda (r) (agentic-ai-lab-temporal-rule (hash-ref r "identity") (atom (hash-ref r "head"))
                   (map atom (hash-ref r "body")))) (hash-ref data "rules"))))
    (agentic-ai-lab-temporal-rule-program (hash-ref data "identity") (hash-ref data "catalogDigest")
      (hash-ref data "generation") (hash-ref data "ascentGeneration") relations rules)))

(def (selected-native-nodes proof)
  (let ((all (positive-proof-nodes proof)) (seen (make-hash-table)))
    (def (visit id)
      (unless (hash-get seen id)
        (hash-put! seen id #t)
        (for-each visit (proof-node-inputs (list-ref all id)))))
    (visit (car (positive-proof-roots proof)))
    (filter (lambda (node) (hash-get seen (proof-node-id node))) all)))
(def (mrr-derivation-fixture (candidate proposal) (output-row #f) (journal-override #f))
  (let* ((data (call-with-input-file (or (getenv "AGENTIC_AI_LAB_MRR_DERIVATION_ORACLE" #f)
                   "t/qualification/temporal-library-basic/derivation-authority-v1/typed-derivations.ss")
                (lambda (p) (scheme-wire-read (read-line p)))))
         (p (mrr-rule-program-fixture))
         (facts (map (lambda (row) (let (f (hash-ref row "content"))
                  (agentic-ai-lab-temporal-mrr-fact-content (hash-ref f "identity") (hash-ref f "generation")
                    (hash-ref f "relationId") (hash-ref f "evaluatorRelation") (hash-ref f "row")))) (hash-ref data "facts")))
         (get-fact (lambda (id) (car (filter (lambda (f) (equal? (.ref f 'identity) id)) facts))))
         (ds (map (lambda (d) (agentic-ai-lab-temporal-mrr-derivation (hash-ref d "identity") (hash-ref d "rule")
               (hash-ref d "generation") (get-fact (hash-ref d "output")) (hash-ref d "supports"))) (hash-ref data "derivations")))
         (s (source 1)) (r (reasoning-attempt s candidate 512)) (a (admit s candidate r))
         (nodes (selected-native-nodes (reasoning-receipt-proof r)))
         (bindings (map (lambda (f)
                     (let* ((node (car (filter (lambda (n) (and (equal? (proof-node-row n) (.ref f 'row))
                                  (equal? (symbol->string (proof-node-relation n)) (.ref f 'evaluator-relation)))) nodes)))
                            (d (find (lambda (d) (equal? (.ref (.ref d 'output) 'identity) (.ref f 'identity))) ds)))
                       (agentic-ai-lab-temporal-proof-node-fact (proof-node-id node) f d)))
                    (filter (lambda (f) (find (lambda (n) (and (equal? (proof-node-row n) (.ref f 'row))
                      (equal? (symbol->string (proof-node-relation n)) (.ref f 'evaluator-relation)))) nodes)) facts)))
         (leaves (filter (lambda (b) (not (.ref b 'derivation))) bindings))
         (source-bindings (map (lambda (b) (let (f (.ref b 'fact))
                   (agentic-ai-lab-temporal-proof-source-binding (.ref b 'node) f (.ref f 'identity) (.ref f 'identity)))) leaves))
         (j (or journal-override (agentic-ai-lab-temporal-evidence-journal "original-lineage" "txn"
              (map (lambda (b) (let (f (.ref b 'fact)) (agentic-ai-lab-temporal-evidence-revision (.ref f 'identity) (.ref f 'identity)
                'assert #f (at 1) (agentic-ai-lab-temporal-interval "v" (at 0) (at 10) #t #f) (.ref f 'semantic-digest)))) leaves))))
         (out (if output-row (find (lambda (f) (and (equal? (.ref f 'row) output-row)
                         (equal? (.ref f 'evaluator-relation) "path"))) facts)
                   (get-fact (hash-ref data "rootFact"))))
         (root (car (positive-proof-roots (reasoning-receipt-proof r))))
         (root-d (find (lambda (d) (equal? (.ref (.ref d 'output) 'identity) (.ref out 'identity))) ds))
         (bound (agentic-ai-lab-temporal-proof-support (.ref root-d 'identity) a s candidate r 512 32 root out source-bindings j))
         (c (agentic-ai-lab-temporal-rule-correspondence-from-ascent p a s candidate r 512 32)))
    (unless (and (equal? (.ref p 'catalog-digest) (hash-ref (hash-ref data "program") "catalogDigest"))
                 (equal? (.ref p 'generation) (.ref out 'generation))) (error "original fixture program mismatch"))
    (list p c bound a s r bindings out source-bindings j)))
(def (derive-selected ctx bindings (candidate proposal))
  (apply (lambda (p c b a s r original out sources j)
    (agentic-ai-lab-temporal-mrr-derivation-from-ascent "qualified" p c b a s candidate r 512 32 bindings out sources j)) ctx))
(def (replay-selected held ctx bindings)
  (apply (lambda (p c b a s r original out sources j)
    (agentic-ai-lab-temporal-mrr-derivation-admission-replay held p c b a s proposal r 512 32 bindings out sources j)) ctx))

(def (selected-context ctx (candidate proposal))
  (apply (lambda (p c b a s r bindings out sources j)
    (agentic-ai-lab-temporal-derivation-context (derive-selected ctx bindings candidate) p c b a s candidate r 512 32 bindings out sources j)) ctx))
(def (register-selected host snapshot ctx (admitted-context #f))
  (agentic-ai-lab-temporal-proof-host-register! host "source" (.ref snapshot 'semantic-digest)
    (or admitted-context (selected-context ctx)) "policy"))
(def (proof-current host registration state-generation policy-generation p)
  (agentic-ai-lab-temporal-proof-host-current host (.ref registration 'identity) state-generation policy-generation (.ref p 'semantic-digest) 128))
(def (corrected-journal j)
  (let (first (car (.ref j 'revisions)))
    (agentic-ai-lab-temporal-evidence-journal (.ref j 'identity) (.ref j 'admission-domain-identity)
      (append (.ref j 'revisions) (list (agentic-ai-lab-temporal-evidence-revision "late-correction"
        (.ref first 'subject-identity) 'correct (.ref first 'identity) (at 2)
        (agentic-ai-lab-temporal-interval "v2" (at 0) (at 10) #t #f) "changed"))))))

(def (withdrawn-journal j)
  (let (first (car (.ref j 'revisions)))
    (agentic-ai-lab-temporal-evidence-journal (.ref j 'identity) (.ref j 'admission-domain-identity)
      (append (.ref j 'revisions)
        (list (agentic-ai-lab-temporal-evidence-revision "native-withdrawal"
          (.ref first 'subject-identity) 'retract (.ref first 'identity) (at 2) #f #f))))))

;;; Context owner enrollment associates its source-relative Task with the retained
;;; Temporal proof. This fixture does not assert Org-to-Fact source refinement.
(def context-scope (.o (:: @ AiAgenticContextScope.) bundle: "bundle" organization: "org" epoch: 1
  project: "project" worktree: "worktree" source-cut: "cut:0" actor: "actor" task: "task"
  destination: "provider" session: "session" turn: 0))
(def context-source "* TODO Work\n:PROPERTIES:\n:ID: work\n:END:\n")
(def (context-proof-setup (grant-owner #f) (original-context #f) (admitted-context #f) (eager-value #f))
  (let* ((ctx (or original-context (mrr-derivation-fixture))) (ph (agentic-ai-lab-temporal-support-policy-host))
         (proof-host (agentic-ai-lab-temporal-proof-host ph)) (p (policy "v1"))
         (snapshot (agentic-ai-lab-temporal-proof-host-refresh! proof-host "source" 1 (car ctx) (list-ref ctx 9)))
         (registration (register-selected proof-host snapshot ctx admitted-context))
         (grants (or grant-owner (agentic-ai-lab-context-use-host))) (context-host (agentic-ai-lab-ai-agentic-context-session-host grants ph #t eager-value))
         (contract (agentic-ai-lab-context-use-contract "actor" "task" "context-policy" '() '() #t)))
    (agentic-ai-lab-temporal-support-policy-host-refresh! ph p 1 (at 1))
    (agentic-ai-lab-context-use-host-refresh! grants
      (agentic-ai-lab-context-use-grant "grant" 1 "manifest" "admission" contract "policy" (.ref p 'semantic-digest) '(display) #t))
    (agentic-ai-lab-ai-agentic-context-session-host-enroll! context-host 0 context-source context-scope
      (agentic-ai-lab-context-restriction "domain" '("actor") '("provider") '("org") 0 8)
      (agentic-ai-lab-ai-agentic-context-profile #f) 0 '("work") "grant" 1)
    (values context-host proof-host ph registration p ctx)))
(def (context-bind host proof-host registration p revision source-generation state-generation policy-generation)
  (agentic-ai-lab-ai-agentic-context-session-host-require-proof! host "session" revision source-generation
    proof-host (.ref registration 'identity) state-generation policy-generation (.ref p 'semantic-digest) 128))
(def (context-claim host revision source-generation)
  (agentic-ai-lab-ai-agentic-context-session-host-claim! host "session" revision source-generation "attempt" "request"))


;;; Native reducer replay. Ordering is test data; every state change uses a real
;;; Context/Session owner API and actual ASCENT proof/current-support Hosts.
(def (native-cas-setup (original-context #f) (admitted-context #f))
  (let (grants (agentic-ai-lab-context-use-host))
    (let-values (((host proof ph registration p ctx) (context-proof-setup grants original-context admitted-context)))
      (context-bind host proof registration p 0 0 1 1)
      (context-claim host 1 0)
      (let* ((worker (thread-start! (make-thread (lambda () (thread-receive) "native-result-for-request"))))
             (token (agentic-ai-lab-ai-agentic-context-session-host-attach-worker! host "session" 2 0 worker)))
        (values host proof ph registration p ctx worker token grants)))))
(def (native-finish-worker worker)
  (with-catch (lambda (exception) #f) (lambda () (thread-send worker 'result)))
  (check (thread-join! worker 2 'native-worker-timeout) => "native-result-for-request"))
(def (native-revoke-grant! grants p)
  (agentic-ai-lab-context-use-host-refresh! grants
    (agentic-ai-lab-context-use-grant "grant" 2 "manifest" "admission"
      (agentic-ai-lab-context-use-contract "actor" "task" "context-policy" '() '() #t)
      "policy" (.ref p 'semantic-digest) '(display) #f)))
(def (native-cas-orders prefix remaining)
  (if (null? remaining) (list (reverse prefix))
    (apply append
      (map (lambda (move)
        (if (and (or (not (= move 2)) (member 1 prefix))
                 (or (not (= move 3)) (member 2 prefix))
                 (or (not (memq move '(7 8))) (member 6 prefix)))
          (native-cas-orders (cons move prefix) (filter (lambda (x) (not (= x move))) remaining)) '())) remaining))))
(def (native-cas-replay order ctx (admitted-context #f))
  (let-values (((host proof ph registration p original worker worker-token grants) (native-cas-setup ctx admitted-context)))
    (let ((result-revision 2) (cancel-revision 2) (observation #f) (invalidated? #f))
      (def (revision)
        (.ref (.ref (agentic-ai-lab-ai-agentic-context-session-host-current host "session") 'schedule) 'revision))
      (for-each (lambda (move)
        (case move
          ((1) (native-finish-worker worker)
               (set! observation (agentic-ai-lab-ai-agentic-context-session-host-observe-worker! host "session" worker-token)))
          ((2) (set! result-revision (revision))
               (agentic-ai-lab-ai-agentic-context-session-host-observe host "session" result-revision 0))
          ((3) (agentic-ai-lab-ai-agentic-context-session-host-commit-result! host "session" result-revision 0 observation))
          ((4) (agentic-ai-lab-temporal-proof-host-refresh! proof "source" 2 (car ctx) (withdrawn-journal (list-ref ctx 9)))
               (agentic-ai-lab-temporal-support-policy-host-refresh! ph p 2 (at 2))
               (set! invalidated? #t))
          ((5) (native-revoke-grant! grants p) (set! invalidated? #t))
          ((6) (let (r (agentic-ai-lab-ai-agentic-context-session-host-cancel! host "session" (revision) 0))
                 (set! cancel-revision (.ref (.ref r 'schedule) 'revision))))
          ((7) (native-finish-worker worker)
               (set! observation (agentic-ai-lab-ai-agentic-context-session-host-observe-worker! host "session" worker-token))
               (agentic-ai-lab-ai-agentic-context-session-host-reconcile! host "session" cancel-revision 0 observation))
          ((8) (agentic-ai-lab-ai-agentic-context-session-host-recover! host "session" (revision) 0)))
        (let ((outcomes (agentic-ai-lab-ai-agentic-context-session-host-outcomes host "session"))
              (schedule (.ref (agentic-ai-lab-ai-agentic-context-session-host-current host "session") 'schedule)))
          (check (<= (length outcomes) 1) => #t)
          (check (<= (length (.ref schedule 'completed)) 1) => #t)
          (when (and invalidated? (pair? outcomes)) (check (.ref (car outcomes) 'current-use?) => #f)))) order)
      (let* ((outcomes (agentic-ai-lab-ai-agentic-context-session-host-outcomes host "session"))
             (schedule (.ref (agentic-ai-lab-ai-agentic-context-session-host-current host "session") 'schedule)))
        (displayln "NATIVE-CAS-PATH order=" order
          " outcome=" (if (pair? outcomes) (.ref (car outcomes) 'outcome) 'pending)
          " revision=" (.ref schedule 'revision)
          " terminals=" (length outcomes)
          " obligations=" (length (.ref schedule 'obligations))
          " current-use=" (and (pair? outcomes) (.ref (car outcomes) 'current-use?))))
      (native-finish-worker worker))))

;;; Three real consumers: A uses path(1,3), B uses unaffected path(1,2)
;;; but explicitly depends on Context A, C uses only path(1,2).
(def push-candidate '(candidate (relation path 2)
                 (rule (path ?x ?y) (edge ?x ?y))
                 (rule (path ?x ?z) (path ?x ?y) (edge ?y ?z))
                 (query path 1 2) (limits 8 16 32)))
(def (push-fixture (enabled? #t))
  (let-values (((host proof ph registration p ctx) (context-proof-setup #f #f #f enabled?)))
    (let* ((ctx-c (mrr-derivation-fixture push-candidate '(1 2) (list-ref ctx 9)))
           (registered-c (agentic-ai-lab-temporal-proof-host-register! proof "source"
              (.ref (agentic-ai-lab-temporal-proof-host-refresh! proof "source" 1 (car ctx) (list-ref ctx 9)) 'semantic-digest)
              (selected-context ctx-c push-candidate) "policy"))
           (workers (make-hash-table)))
      (agentic-ai-lab-temporal-support-policy-host-refresh! ph p 2 (at 2))
      (when enabled? (agentic-ai-lab-ai-agentic-context-session-host-enable-propagation! host))
      (def (enroll id selected parents)
        (unless (equal? id "session")
          (agentic-ai-lab-ai-agentic-context-session-host-enroll! host 0 context-source
            (.o (:: @ context-scope) session: id)
            (agentic-ai-lab-context-restriction "domain" '("actor") '("provider") '("org") 0 8)
            (agentic-ai-lab-ai-agentic-context-profile #f) 0 '("work") "grant" 1))
        (when (pair? parents)
          (agentic-ai-lab-ai-agentic-context-session-host-depend-on! host id 0 0 parents))
        (agentic-ai-lab-ai-agentic-context-session-host-require-proof! host id 0 0 proof
          (.ref selected 'identity) 1 2 (.ref p 'semantic-digest) 128)
        (agentic-ai-lab-ai-agentic-context-session-host-claim! host id 1 0
          (string-append "attempt-" id) (string-append "request-" id))
        (let* ((worker (thread-start! (make-thread (lambda () (thread-receive) "native-result-for-request"))))
               (token (agentic-ai-lab-ai-agentic-context-session-host-attach-worker! host id 2 0 worker)))
          (hash-put! workers id (list worker token))))
      (enroll "session" registration '())
      (enroll "session-b" registered-c '("session"))
      (enroll "session-c" registered-c '())
      (let ((host-value host) (proof-value proof) (workers-value workers))
        (.o host: host-value proof: proof-value policy: p context: ctx
          registration-a: registration registration-c: registered-c workers: workers-value)))))
(def (push-row f id) (agentic-ai-lab-ai-agentic-context-session-host-current (.ref f 'host) id))
(def (push-revision f id) (.ref (.ref (push-row f id) 'schedule) 'revision))
(def (push-join! f id)
  (let (worker (hash-ref (.ref f 'workers) id))
    (native-finish-worker (car worker))
    (agentic-ai-lab-ai-agentic-context-session-host-observe-worker! (.ref f 'host) id (cadr worker))))
(def (push-withdraw! f)
  (let* ((ctx (.ref f 'context)) (j (list-ref ctx 9))
         (binding (find (lambda (b) (equal? (.ref (.ref b 'fact) 'row) '(2 3))) (list-ref ctx 6)))
         (subject (.ref (.ref binding 'fact) 'identity))
         (prior (find (lambda (r) (equal? (.ref r 'subject-identity) subject)) (.ref j 'revisions)))
         (revised (agentic-ai-lab-temporal-evidence-journal (.ref j 'identity) (.ref j 'admission-domain-identity)
           (append (.ref j 'revisions) (list (agentic-ai-lab-temporal-evidence-revision "push-withdrawal" subject
             'retract (.ref prior 'identity) (at 2) #f #f))))))
    (agentic-ai-lab-temporal-proof-host-refresh! (.ref f 'proof) "source" 2 (car ctx) revised)))
(def (push-check-cached! f)
  (for-each (lambda (id)
    (let (row (push-row f id))
      (check (.ref row 'context-state) => 'invalidated)
      (check (.ref (.ref row 'schedule) 'active) => #f)
      (check (.ref (.ref row 'propagation) 'affected-contexts) => '("session" "session-b")))) '("session" "session-b"))
  (let (row (push-row f "session-c"))
    (check (.ref row 'context-state) => 'admitted)
    (check (.ref (.ref row 'propagation) 'affected?) => #f)))
(def (push-orders prefix remaining)
  (if (null? remaining) (list (reverse prefix))
    (apply append (map (lambda (move)
      (if (and (or (not (= move 2)) (member 1 prefix))
               (or (not (= move 3)) (member 2 prefix))
               (or (not (memq move '(6 7))) (member 5 prefix)))
        (push-orders (cons move prefix) (filter (lambda (x) (not (= x move))) remaining)) '())) remaining))))
(def (push-replay order (fixture #f) (withdraw! push-withdraw!) (label "NATIVE-PUSH-PATH"))
  (let* ((f (or fixture (push-fixture))) (host (.ref f 'host)) (ids '("session" "session-b"))
         (result-revisions (make-hash-table)) (cancel-revisions (make-hash-table))
         (observations (make-hash-table)) (withdrawn? #f))
    (for-each (lambda (move)
      (case move
        ((1) (hash-put! observations "session" (push-join! f "session")))
        ((2) (hash-put! result-revisions "session" (push-revision f "session")))
        ((3) (for-each (lambda (id) (agentic-ai-lab-ai-agentic-context-session-host-commit-result! host id
                  (hash-ref result-revisions id) 0 (hash-ref observations id))) '("session")))
        ((4) (withdraw! f) (set! withdrawn? #t) (push-check-cached! f))
        ((5) (for-each (lambda (id)
               (let (r (agentic-ai-lab-ai-agentic-context-session-host-cancel! host id (push-revision f id) 0))
                 (hash-put! cancel-revisions id (.ref (.ref r 'schedule) 'revision)))) '("session")))
        ((6) (for-each (lambda (id)
               (agentic-ai-lab-ai-agentic-context-session-host-reconcile! host id (hash-ref cancel-revisions id) 0 (push-join! f id))) '("session")))
        ((7) (for-each (lambda (id) (agentic-ai-lab-ai-agentic-context-session-host-recover! host id (push-revision f id) 0)) '("session"))))
      (when withdrawn? (push-check-cached! f))
      (for-each (lambda (id)
        (let ((outcomes (agentic-ai-lab-ai-agentic-context-session-host-outcomes host id))
              (schedule (.ref (push-row f id) 'schedule)))
          (check (<= (length outcomes) 1) => #t)
          (check (<= (length (.ref schedule 'completed)) 1) => #t)
          (when (and withdrawn? (pair? outcomes)) (check (.ref (car outcomes) 'current-use?) => #f)))) ids)
      (check (.ref (push-row f "session-c") 'context-state) => 'admitted)
      (check (push-revision f "session-c") => 2)) order)
    (check (.ref (agentic-ai-lab-ai-agentic-context-session-host-commit-result! host "session-c" 2 0 (push-join! f "session-c")) 'native-result-published?) => #t)
    (push-join! f "session")
    (let (observation (push-join! f "session-b"))
      (check (.ref (agentic-ai-lab-ai-agentic-context-session-host-commit-result! host "session-b"
        (push-revision f "session-b") 0 observation) 'accepted?) => #f)
      (check (.ref (agentic-ai-lab-ai-agentic-context-session-host-reconcile! host "session-b"
        (push-revision f "session-b") 0 observation) 'runtime-published?) => #t))
    (let ((a (agentic-ai-lab-ai-agentic-context-session-host-outcomes host "session"))
          (b (agentic-ai-lab-ai-agentic-context-session-host-outcomes host "session-b"))
          (c (agentic-ai-lab-ai-agentic-context-session-host-outcomes host "session-c")))
      (check (.ref (car c) 'current-use?) => #t)
      (displayln label " order=" order
        " a=" (if (pair? a) (.ref (car a) 'outcome) 'pending)
        " b=" (if (pair? b) (.ref (car b) 'outcome) 'pending)
        " c=completed current-a=#f current-b=#f unaffected=#t"))))

(def (push-print-evidence f)
  (let ((receipt (car (agentic-ai-lab-ai-agentic-context-session-host-propagations (.ref f 'host))))
        (ctx (.ref f 'context)))
    (displayln "NATIVE-PUSH-EVIDENCE event=" (.ref receipt 'event)
      " proof-index=" (.ref receipt 'proof-index) " context-index=" (.ref receipt 'context-index)
      " previous-journal=" (.ref receipt 'previous-cut) " revised-journal=" (.ref receipt 'revised-cut)
      " ascent-a=" (.ref (list-ref ctx 3) 'proof-digest)
      " registered-a=" (.ref (.ref f 'registration-a) 'proof-digest)
      " registered-c=" (.ref (.ref f 'registration-c) 'proof-digest))))

;;; Independent full native query oracle over the journal-selected CURRENT facts.
;;; This does not reuse the incremental reverse plan or cached invalidation flags.
(def (push-current-ascent-oracle f)
  (let* ((ctx (.ref f 'context))
         (updated (push-withdraw! f))
         (visible (agentic-ai-lab-temporal-evidence-as-of (.ref updated 'journal) (at 2) (at 2)))
         (leaf-bindings (filter (lambda (binding) (and (not (.ref binding 'derivation))
              (member (.ref (.ref binding 'fact) 'identity) (.ref visible 'active-revision-identities)))) (list-ref ctx 6)))
         (rows (map (lambda (binding) (.ref (.ref binding 'fact) 'row)) leaf-bindings))
         (current (reasoning-source-snapshot 'journal-selected-current 2 (list (list 'edge 2 rows))))
         (fresh-a (reasoning-attempt current proposal 512))
         (fresh-c (reasoning-attempt current push-candidate 512))
         (original-c (reasoning-attempt (list-ref ctx 4) push-candidate 512)))
    (check (reasoning-receipt-status fresh-a) => 'complete)
    (check (reasoning-receipt-status fresh-c) => 'complete)
    (check (reasoning-receipt-rows fresh-a) => '())
    (check (reasoning-receipt-rows fresh-c) => (reasoning-receipt-rows original-c))
    (check (length rows) => 1)
    (displayln "NATIVE-PUSH-ORACLE withdrawn-a-rows=0 unaffected-c-equal=#t active-facts=1 native-status=complete")))

;;; A has the changed grant/policy. B has independent authority/proof but captures
;;; A's immutable Context version. C shares B's authority without that dependency.
(def (authority-fixture (enabled? #t) (original-context #f) (safe-end 10) (workers? #t))
  (let (grants (agentic-ai-lab-context-use-host))
    (let-values (((host proof ph registration p ctx) (context-proof-setup grants original-context #f enabled?)))
      (let* ((safe (agentic-ai-lab-temporal-support-policy "safe-policy" "safe-v1" (at 1) (at safe-end)))
             (ctx-c (mrr-derivation-fixture push-candidate '(1 2) (list-ref ctx 9)))
             (registered-c (agentic-ai-lab-temporal-proof-host-register! proof "source"
               (.ref (agentic-ai-lab-temporal-proof-host-refresh! proof "source" 1 (car ctx) (list-ref ctx 9)) 'semantic-digest)
               (selected-context ctx-c push-candidate) "safe-policy"))
             (workers (make-hash-table)))
        (agentic-ai-lab-temporal-support-policy-host-refresh! ph safe 1 (at 1))
        (agentic-ai-lab-context-use-host-refresh! grants
          (agentic-ai-lab-context-use-grant "safe-grant" 1 "manifest" "admission"
            (agentic-ai-lab-context-use-contract "actor" "task" "context-policy" '() '() #t)
            "safe-policy" (.ref safe 'semantic-digest) '(display) #t))
        (def (enroll id selected policy-value parents)
          (unless (equal? id "session")
            (agentic-ai-lab-ai-agentic-context-session-host-enroll! host 0 context-source
              (.o (:: @ context-scope) session: id)
              (agentic-ai-lab-context-restriction "domain" '("actor") '("provider") '("org") 0 safe-end)
              (agentic-ai-lab-ai-agentic-context-profile #f) 0 '("work") "safe-grant" 1))
          (when (pair? parents) (agentic-ai-lab-ai-agentic-context-session-host-depend-on! host id 0 0 parents))
          (agentic-ai-lab-ai-agentic-context-session-host-require-proof! host id 0 0 proof
            (.ref selected 'identity) 1 1 (.ref policy-value 'semantic-digest) 128)
          (when workers?
        (agentic-ai-lab-ai-agentic-context-session-host-claim! host id 1 0
            (string-append "attempt-" id) (string-append "request-" id))
          (let* ((worker (thread-start! (make-thread (lambda () (thread-receive) "native-result-for-request"))))
                 (token (agentic-ai-lab-ai-agentic-context-session-host-attach-worker! host id 2 0 worker)))
            (hash-put! workers id (list worker token)))))
        (let (ticket (find (lambda (ticket) (equal? (.ref ticket 'identity) "policy"))
                      (agentic-ai-lab-temporal-support-policy-host-deadlines ph)))
          (check (.ref (.ref ticket 'end) 'coordinate) => 4)
          (check-rejected (agentic-ai-lab-temporal-support-policy-host-fire-deadline! ph "policy" 1 (at 3)))
          (check-rejected (agentic-ai-lab-temporal-support-policy-host-fire-deadline! ph "policy" 0 (at 4))))
        (enroll "session" registration p '())
        (enroll "session-b" registered-c safe '("session"))
        (enroll "session-c" registered-c safe '())
        (let ((host-value host) (proof-value proof) (workers-value workers) (grants-value grants) (policies-value ph))
          (.o host: host-value proof: proof-value workers: workers-value grants: grants-value policies: policies-value
              policy: p context: ctx registration-a: registration registration-c: registered-c))))))
(def (authority-change! f kind)
  (case kind
    ((grant) (native-revoke-grant! (.ref f 'grants) (.ref f 'policy)))
    ((policy) (agentic-ai-lab-temporal-support-policy-host-refresh! (.ref f 'policies) (policy "v2") 2 (at 1)))
    ((expiry) (agentic-ai-lab-temporal-support-policy-host-fire-deadline! (.ref f 'policies) "policy" 1 (at 4)))
    (else (error "Unknown authority change"))))
(def (authority-evidence! f kind)
  (let* ((events (if (eq? kind 'grant) (agentic-ai-lab-context-use-host-history (.ref f 'grants))
                   (agentic-ai-lab-temporal-support-policy-host-history (.ref f 'policies))))
         (event (car (reverse events))) (ctx (.ref f 'context))
         (receipts (agentic-ai-lab-ai-agentic-context-session-host-propagations (.ref f 'host)))
         (receipt (find (lambda (r) (equal? (.ref r 'event) (.ref event 'semantic-digest))) receipts)))
    (check (object? (.ref event 'previous)) => #t)
    (let ((old (.ref event 'previous)) (new (.ref event 'revised)))
      (case kind
        ((grant) (check (.ref old 'enabled?) => #t) (check (.ref new 'enabled?) => #f))
        ((policy) (check (.ref (.ref old 'policy) 'semantic-digest) => (.ref (.ref f 'policy) 'semantic-digest))
                  (check (equal? (.ref (.ref old 'policy) 'semantic-digest) (.ref (.ref new 'policy) 'semantic-digest)) => #f))
        ((expiry) (check (.ref (.ref old 'effective-at) 'coordinate) => 1)
                  (check (.ref (.ref new 'effective-at) 'coordinate) => 4)
                  (check (.ref (.ref old 'policy) 'semantic-digest) => (.ref (.ref new 'policy) 'semantic-digest)))))
    (check (.ref receipt 'affected-contexts) => '("session" "session-b"))
    (check (.ref (.ref f 'registration-a) 'proof-digest) => (.ref (derive-selected ctx (list-ref ctx 6)) 'semantic-digest))
    (displayln "NATIVE-AUTHORITY-EVIDENCE kind=" kind " event=" (.ref event 'semantic-digest)
      " context-index=" (.ref receipt 'context-index) " original-journal=" (.ref (list-ref ctx 9) 'semantic-digest)
      " original-proof=" (.ref (.ref f 'registration-a) 'proof-digest))))

;;; Long-lived original fact validity separates policy expiry from fact expiry.
(def (clock-original-context)
  (let* ((ctx (mrr-derivation-fixture)) (old (list-ref ctx 9))
         (j (agentic-ai-lab-temporal-evidence-journal (.ref old 'identity) (.ref old 'admission-domain-identity)
           (map (lambda (r) (agentic-ai-lab-temporal-evidence-revision (.ref r 'identity) (.ref r 'subject-identity)
             'assert #f (at 1) (agentic-ai-lab-temporal-interval "clock-valid" (at 0) (at 1000000) #t #f)
             (.ref r 'content-identity))) (.ref old 'revisions)))))
    (mrr-derivation-fixture proposal #f j)))
(def (clock-fixture paused? delay copies (enabled? #t) (tick 0.002))
  (policy-clock-owner (lambda ()
    (let (f (authority-fixture #t (clock-original-context) 1000000))
      (values f (.ref f 'policies)))) "txn" 1 tick delay copies paused? enabled?))
(def (clock-phases audit phase)
  (length (filter (lambda (row) (eq? (.ref row 'phase) phase)) audit)))
(def (clock-print-audit label audit)
  (for-each (lambda (row)
    (displayln "NATIVE-CLOCK-EVENT case=" label " phase=" (.ref row 'phase) " cause=" (.ref row 'cause)
      " ticket=" (.ref row 'ticket) " policy=" (.ref row 'policy) " generation=" (.ref row 'generation)
      " policy-digest=" (.ref row 'policy-digest) " end=" (.ref row 'end)
      " observed=" (.ref (.ref row 'observed) 'coordinate)
      " deadline=" (.ref row 'deadline-monotonic) " sample=" (.ref row 'sample-monotonic))) audit))
(def (clock-check-originals! f)
  (let (ctx (.ref f 'context))
    (check (.ref (derive-selected ctx (list-ref ctx 6)) 'semantic-digest) => (.ref (.ref f 'registration-a) 'proof-digest))
    (let (receipt (car (reverse (agentic-ai-lab-ai-agentic-context-session-host-propagations (.ref f 'host)))))
      (displayln "NATIVE-CLOCK-EVIDENCE journal=" (.ref (list-ref ctx 9) 'semantic-digest)
        " proof=" (.ref (.ref f 'registration-a) 'proof-digest) " event=" (.ref receipt 'event)
        " context-index=" (.ref receipt 'context-index)))))
(def (clock-cleanup! f)
  (let (host (.ref f 'host))
    (for-each (lambda (id)
      (let (observation (push-join! f id))
        (when (null? (agentic-ai-lab-ai-agentic-context-session-host-outcomes host id))
          (agentic-ai-lab-ai-agentic-context-session-host-cancel! host id (push-revision f id) 0)
          (check (.ref (agentic-ai-lab-ai-agentic-context-session-host-reconcile! host id
            (push-revision f id) 0 observation) 'runtime-published?) => #t)))) '("session" "session-b"))
    (check (.ref (agentic-ai-lab-ai-agentic-context-session-host-commit-result! host "session-c" 2 0
      (push-join! f "session-c")) 'native-result-published?) => #t)))
(def (clock-replace! f observed)
  (let* ((p (agentic-ai-lab-temporal-support-policy "policy" "clock-new" (at 1) (at 1000000)))
         (host (.ref f 'host)) (grants (.ref f 'grants)) (sid "session-new"))
    (agentic-ai-lab-temporal-support-policy-host-refresh! (.ref f 'policies) p 3 observed)
    (agentic-ai-lab-context-use-host-refresh! grants
      (agentic-ai-lab-context-use-grant "clock-new-grant" 1 "manifest" "admission"
        (agentic-ai-lab-context-use-contract "actor" "task" "context-policy" '() '() #t)
        "policy" (.ref p 'semantic-digest) '(display) #t))
    (agentic-ai-lab-ai-agentic-context-session-host-enroll! host 0 context-source
      (.o (:: @ context-scope) session: sid)
      (agentic-ai-lab-context-restriction "domain" '("actor") '("provider") '("org") 0 1000000)
      (agentic-ai-lab-ai-agentic-context-profile #f) 0 '("work") "clock-new-grant" 1)
    (agentic-ai-lab-ai-agentic-context-session-host-require-proof! host sid 0 0 (.ref f 'proof)
      (.ref (.ref f 'registration-a) 'identity) 1 3 (.ref p 'semantic-digest) 128)
    (agentic-ai-lab-ai-agentic-context-session-host-claim! host sid 1 0 "attempt-new" "request-new")
    (let* ((worker (thread-start! (make-thread (lambda () (thread-receive) "native-result-for-request"))))
           (token (agentic-ai-lab-ai-agentic-context-session-host-attach-worker! host sid 2 0 worker)))
      (hash-put! (.ref f 'workers) sid (list worker token)))))
(def (clock-orders prefix remaining)
  (if (null? remaining) (list (reverse prefix))
    (apply append (map (lambda (move)
      (if (or (not (= move 5)) (member 4 prefix))
        (clock-orders (cons move prefix) (filter (lambda (n) (not (= n move))) remaining)) '())) remaining))))
;;; Both duplicate deliveries are produced by the REAL timer before these
;;; operations. Pausing delays handling, not clock passage or event production.
;;; 1 resume; 2 replace+fresh D; 3 actual old commit; 4 cancel; 5 recover.
(def (clock-replay order)
  (let (clock (clock-fixture #t 0.004 2))
    (dynamic-wind void
      (lambda ()
        (policy-clock-await-events! clock 2)
        (for-each (lambda (move)
          (case move
            ((1) (policy-clock-resume! clock))
            ((2) (let (observed (policy-clock-observed clock))
              (policy-clock-call! clock (lambda (f) (clock-replace! f observed)))))
            ((3) (policy-clock-call! clock (lambda (f)
              (check (.ref (agentic-ai-lab-ai-agentic-context-session-host-commit-result! (.ref f 'host)
                "session" (push-revision f "session") 0 (push-join! f "session")) 'accepted?) => #f))))
            ((4) (policy-clock-call! clock (lambda (f)
              (agentic-ai-lab-ai-agentic-context-session-host-cancel! (.ref f 'host) "session" (push-revision f "session") 0))))
            ((5) (policy-clock-call! clock (lambda (f)
              (agentic-ai-lab-ai-agentic-context-session-host-recover! (.ref f 'host) "session" (push-revision f "session") 0)))))
          (policy-clock-call! clock (lambda (f)
            (let (outcomes (agentic-ai-lab-ai-agentic-context-session-host-outcomes (.ref f 'host) "session"))
              (check (<= (length outcomes) 1) => #t)
              (when (pair? outcomes) (check (.ref (car outcomes) 'current-use?) => #f)))
            (check (.ref (push-row f "session-c") 'context-state) => 'admitted)))) order)
        (policy-clock-call! clock (lambda (f)
          (clock-cleanup! f)
          (check (.ref (push-row f "session-new") 'context-state) => 'admitted)
          (check (push-revision f "session-new") => 2)
          (check (.ref (agentic-ai-lab-ai-agentic-context-session-host-commit-result! (.ref f 'host) "session-new" 2 0
            (push-join! f "session-new")) 'native-result-published?) => #t)
          (clock-check-originals! f)))
        (let (audit (policy-clock-audit clock))
          (check (clock-phases audit 'received) => 2)
          (check (+ (clock-phases audit 'applied) (clock-phases audit 'stale)) => 1)
          (check (clock-phases audit 'duplicate) => 1)
          (clock-print-audit "race" audit)
          (displayln "NATIVE-CLOCK-PATH order=" order " received=2 applied=" (clock-phases audit 'applied)
            " stale=" (clock-phases audit 'stale) " duplicate=1 old-current=#f new-current=#t unaffected=#t")))
      (lambda () (policy-clock-stop! clock)))))
