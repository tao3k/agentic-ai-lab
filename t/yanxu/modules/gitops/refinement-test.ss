;;; Test-only relation between the public POO library and Quint ITF witnesses.
(import :std/test (only-in :clan/poo/object .o .cc .get)
        (only-in :std/source this-source-file)
        (only-in :std/encoding/json read-json)
        (only-in :std/io/tempfile call-with-temporary-directory)
        (only-in :std/misc/process run-process)
        (only-in :std/misc/ports read-all-as-u8vector)
        (only-in :std/crypto/digest sha256)
        (only-in :std/encoding/hex hex-encode)
        (only-in "../../interface.ss" Lab))
(export refinement-test)
(def repo-root (path-normalize (path-expand "../../../.." (path-directory (this-source-file)))))
(def model-directory "docs/10-19-design/10.06-poo-module-system/agentic-ai-context/")
(def scope (.get Lab gitops))
(def bind-policy (.get scope bind-working-copy-policy))
(def receive (.get scope admit-working-copy-receipt))
(def refresh (.get scope refresh-working-copy-evidence))
(def select-provider (.get scope select-working-copy))
(def fresh-state (.get scope working-copy-evidence))
(def predicates (.get scope create-contract predicates))
(def base-source (.o project: "project" worktree: "worktree" path: "policy.org" git-head: "head"
  text: "* Work\n:PROPERTIES:\n:ID: work\n:GITOPS_ALLOWED: git-worktree worktrunk\n:GITOPS_PREFERRED: worktrunk\n:END:\n"))
(def policy-a (bind-policy (.get scope working-copy-policy) base-source "work" "v1"))
(def policy-b (bind-policy (.get scope working-copy-policy) base-source "work" "v1"))
(def policy-c (bind-policy (.cc (.get scope working-copy-policy) allowed: '(git-worktree)) base-source "work" "v1"))
(def (prefer-available-git policy availability)
  ((.get scope working-copy-policy select-provider) (.cc policy preferred: 'git-worktree) availability))
(def changed-source (.cc base-source git-head: "new-head"
  text: "* Work\n:PROPERTIES:\n:ID: work\n:GITOPS_ALLOWED: git-worktree\n:GITOPS_PREFERRED: git-worktree\n:END:\n"))
(def policy-d (bind-policy (.cc policy-a allowed: '(git-worktree) select-provider: prefer-available-git)
                          base-source "work" "v2"))
(def policy-e (bind-policy policy-d changed-source "work" "v3"))
(def default-current (.o source: base-source request: "r1" provider: 'worktrunk
                         policy-revision: "v1" authorized?: #t fence-current?: #t))
(def old-binding (.o path: "/old"))
(def returned-binding (.o path: "/returned"))
(def other-source (.cc base-source git-head: "other"))
(def baseline-receipt (.o witness: -1 source: base-source request: "r1" provider: 'worktrunk
  policy-revision: "v1" anchor: "work" custody-valid?: #t executed?: #t
  outcome: 'applied working-copy: old-binding))
(def seeded (receive policy-a (fresh-state) baseline-receipt default-current))
(def withdrawn (refresh policy-a seeded (.cc default-current fence-current?: #f)))
(def (bit? mask weight) (odd? (quotient mask weight)))
(def (decode-int value) (string->number (hash-ref value "#bigint")))
(def (decode-list values) (map decode-int values))
(def (request-id value)
  (cond ((not value) 0) ((equal? value "r1") 1) ((equal? value "r2") 2)
        ((equal? value "r3") 3) ((equal? value "r4") 4) ((equal? value "r5") 5)
        (else (error "unmapped request" value))))
(def (provider-id value)
  (case value ((#f) 0) ((git-worktree) 1) ((worktrunk) 2) ((unknown) 3) (else (error "unmapped provider" value))))
(def (policy-id value)
  (cond ((not value) 0) ((eq? value policy-a) 1) ((eq? value policy-b) 2) ((eq? value policy-c) 3)
        ((eq? value policy-d) 4) ((eq? value policy-e) 5)
        (else (error "unmapped Policy identity"))))
(def (binding-id value)
  (cond ((not value) 0) ((equal? (.get value path) "/old") 10)
        ((equal? (.get value path) "/returned") 11) (else (error "unmapped binding"))))
;; alpha: every successor field is observed, including historical/current use.
(def (abstract-state value)
  (list (map (lambda (r) (.get r witness)) (.get value receipts))
        (map request-id (.get value accepted-requests))
        (policy-id (.get value active-policy)) (request-id (.get value active-request))
        (provider-id (.get value active-provider)) (binding-id (.get value binding))
        (.get value admitted?) (.get value accepted?)))
(def (model-state value)
  (append (list (decode-list (hash-ref value "receipts")) (decode-list (hash-ref value "spent")))
          (map (lambda (key) (decode-int (hash-ref value key)))
               '("activePolicy" "activeRequest" "activeProvider" "binding"))
          (list (hash-ref value "admitted") (hash-ref value "accepted"))))
(def (same-transition? actual expected) (equal? (abstract-state actual) (model-state expected)))
(def (check-transition family mask before actual expected (r #f))
  (unless (same-transition? actual expected)
    (error "Scheme/Quint transition mismatch" family mask (abstract-state actual) (model-state expected)))
  (def original-receipts (if r (cons r (.get before receipts)) (.get before receipts)))
  (unless (and (= (length (.get actual receipts)) (length original-receipts))
               (andmap eq? (.get actual receipts) original-receipts))
    (error "original receipt lineage replaced" family mask))
  (unless (eq? (.get actual binding)
               (cond ((and r (.get actual admitted?)) (.get r working-copy))
                     ((.get actual accepted?) (.get before binding)) (else #f)))
    (error "original binding replaced" family mask)))
(def (receipt-and-current mask receipt-request current-request)
  (values
    (.cc baseline-receipt witness: mask request: receipt-request
      source: (if (bit? mask 16) base-source other-source)
      policy-revision: (if (bit? mask 32) "v1" "v2") anchor: (if (bit? mask 64) "work" "other")
      custody-valid?: (bit? mask 512) executed?: (bit? mask 1024)
      provider: (if (bit? mask 2048) 'worktrunk 'git-worktree)
      outcome: (if (bit? mask 4096) 'applied 'ambiguous)
      working-copy: (and (bit? mask 8192) returned-binding))
    (.cc default-current authorized?: (bit? mask 1) fence-current?: (bit? mask 2)
      source: (if (bit? mask 4) base-source other-source)
      policy-revision: (if (bit? mask 8) "v1" "v2") request: current-request)))
(def (admission-input mask)
  (defvalues (receipt current) (receipt-and-current mask "r1" (if (bit? mask 256) "r1" "r2")))
  (values (if (bit? mask 128) (fresh-state) seeded) receipt current))
(def (check-admission mask expected)
  (unless (eq? (apply (.get predicates semantic-admit?)
                 (map (cut bit? mask <>) '(1 2 4 8 16 32 64 128 256 512 1024 2048 4096 8192)))
               (hash-ref expected "admitted"))
    (error "published admission predicate differs from Quint" mask))
  (let-values (((before receipt current) (admission-input mask)))
    (def before-value (abstract-state before))
    (def actual (receive policy-a before receipt current))
    (check-transition 'receive mask before actual expected receipt)
    (unless (equal? before-value (abstract-state before)) (error "input state mutated" mask))))
(def (check-occupied mask expected retired?)
  (def receipt-request (if (bit? mask 128) "r2" "r1"))
  (def current-request (if (bit? mask 256) receipt-request
                        (if (bit? mask 128) "r1" "r2")))
  (let-values (((r c) (receipt-and-current mask receipt-request current-request)))
    (def before (if retired? withdrawn seeded))
    (def before-value (abstract-state before))
    (check-transition 'occupied mask before (receive policy-a before r c) expected r)
    (unless (equal? before-value (abstract-state before)) (error "occupied state mutated" mask))))
(def (check-refresh mask expected)
  (unless (eq? (apply (.get predicates retain-current?)
                 (map (cut bit? mask <>) '(1 2 4 8 16 32 64 128)))
               (hash-ref expected "accepted"))
    (error "published retention predicate differs from Quint" mask))
  (let* ((before (if (bit? mask 1) seeded withdrawn))
         (policy (if (bit? mask 2) policy-a policy-b))
         (current (.cc default-current request: (if (bit? mask 4) "r1" "r2")
                   provider: (if (bit? mask 8) 'worktrunk 'git-worktree)
                   authorized?: (bit? mask 16) fence-current?: (bit? mask 32)
                   source: (if (bit? mask 64) base-source (.cc base-source git-head: "other"))
                   policy-revision: (if (bit? mask 128) "v1" "v2")))
         (actual (refresh policy before current)))
    (check-transition 'refresh mask before actual expected)
    (unless (and (eq? (.get before receipts) (.get actual receipts))
                 (eq? (.get before accepted-requests) (.get actual accepted-requests)))
      (error "refresh replaced history" mask))))
(def (check-source mask expected)
  (unless (eq? (apply (.get predicates source-current?)
                 (map (cut bit? mask <>) '(1 2 4 8 16)))
               (hash-ref expected "admitted"))
    (error "published source predicate differs from Quint" mask))
  (let* ((source (.cc base-source project: (if (bit? mask 1) "project" "other")
                   worktree: (if (bit? mask 2) "worktree" "other")
                   path: (if (bit? mask 4) "policy.org" "other.org")
                   text: (if (bit? mask 8) (.get base-source text) "other text")
                   git-head: (if (bit? mask 16) "head" "other")))
         (receipt (.cc baseline-receipt witness: mask working-copy: returned-binding
                    source: (if (bit? mask 32) source base-source)))
         (before (fresh-state))
         (actual (receive policy-a before receipt
                   (.cc default-current source: (if (bit? mask 32) base-source source)))))
    (check-transition 'source mask before actual expected receipt)))
(def (check-provider id expected)
  (let* ((selected-policy (if (= id 3) policy-c policy-a))
         (r (.cc baseline-receipt witness: id working-copy: returned-binding
              provider: (case id ((1) 'git-worktree) ((2) 'unknown) (else 'worktrunk))))
         (before (fresh-state)) (actual (receive selected-policy before r default-current)))
    (check-transition 'provider id before actual expected r)))
(def (make-history-checker)
  (let ((state seeded))
    (lambda (id expected)
      (def before state)
      (def r (and (memv id '(1 4 5 8))
               (.cc baseline-receipt witness: id request: (if (>= id 5) "r2" "r1")
                    provider: (if (>= id 5) 'git-worktree 'worktrunk)
                    working-copy: (if (= id 8) old-binding returned-binding))))
      (def current (if (>= id 5) (.cc default-current request: "r2" provider: 'git-worktree) default-current))
      (def actual
        (cond ((= id 0) seeded)
              (r (receive policy-a before r current))
              ((= id 2) (refresh policy-a before (.cc current authorized?: #f)))
              ((= id 6) (refresh policy-b before current))
              (else (refresh policy-a before current))))
      (check-transition 'history id before actual expected r)
      (def event (list-ref '(original-binding duplicate-changed-path revoke-authority restore-authority
                            late-spent-receipt fresh-request replace-policy-object restore-policy
                            late-duplicate-after-policy-restore) id))
      (displayln "SCENARIO-OK " event
        " before=" (if (.get before binding) (.get (.get before binding) path) "none")
        " admitted=" (.get actual admitted?) " current-use=" (.get actual accepted?)
        " after=" (if (.get actual binding) (.get (.get actual binding) path) "none"))
      (set! state actual))))
(def (check-selection mask expected)
  (def profile (modulo (quotient mask 4) 4))
  (def allowed (filter (lambda (p) (bit? mask (if (eq? p 'git-worktree) 1 2))) '(git-worktree worktrunk)))
  (def local (case profile ((0) "git-worktree") ((1) "worktrunk") (else "git-worktree worktrunk")))
  (def preferred (if (even? profile) "git-worktree" "worktrunk"))
  (def source (.cc base-source text:
    (string-append "* Work\n:PROPERTIES:\n:ID: work\n:GITOPS_ALLOWED: " local
                   "\n:GITOPS_PREFERRED: " preferred "\n:END:\n")))
  (def policy (bind-policy (.cc (.get scope working-copy-policy) allowed: allowed) source "work" "v1"))
  (def selected (select-provider policy (.o git-worktree: (bit? mask 16) worktrunk: (bit? mask 32))))
  (def wanted-allowed (decode-list (hash-ref (hash-ref expected "allowed") "#set")))
  (def actual-allowed (map provider-id (.get policy allowed)))
  (unless (and (= (length wanted-allowed) (length actual-allowed))
               (andmap (lambda (id) (memv id actual-allowed)) wanted-allowed)
               (= (provider-id selected) (decode-int (hash-ref expected "selected"))))
    (error "Scheme/Quint Policy mismatch" mask)))
(def (check-derived-policies expected)
  (unless (= (length expected) 3) (error "incomplete Policy projection"))
  (for-each (lambda (actual wanted)
    (def wanted-allowed (decode-list (hash-ref (hash-ref wanted "allowed") "#set")))
    (def actual-allowed (map provider-id (.get actual allowed)))
    (def selector (.get actual select-provider))
    (def selector-id (cond ((eq? selector (.get scope working-copy-policy select-provider)) 0)
                          ((eq? selector prefer-available-git) 1) (else (error "selector was replaced during binding"))))
    (unless (and (= (length actual-allowed) (length wanted-allowed))
                 (andmap (lambda (id) (memv id actual-allowed)) wanted-allowed)
                 (= (provider-id (.get actual preferred)) (decode-int (hash-ref wanted "preferred")))
                 (= selector-id (decode-int (hash-ref wanted "selector")))
                 (eq? (.get actual source) (if (= (decode-int (hash-ref wanted "source")) 0) base-source changed-source))
                 (equal? (.get actual anchor) "work")
                 (= 1 (decode-int (hash-ref wanted "anchor")))
                 (equal? (.get actual revision) (string-append "v" (number->string (decode-int (hash-ref wanted "revision"))))))
      (error "Scheme/Quint derived Policy differs" (decode-int (hash-ref wanted "revision")))))
    (list policy-a policy-d policy-e) expected))
(def (make-replacement-checker)
  (let ((state seeded))
    (lambda (id expected)
      (def before state)
      (def selected-policy (if (>= id 4) policy-e policy-d))
      (def version (if (>= id 4) "v3" "v2"))
      (def source-value (if (>= id 4) changed-source base-source))
      (def request-name (case id ((0 1) "r1") ((2) "r2") ((3 4) "r3") ((5) "r4") (else "r5")))
      (def current (.cc default-current request: request-name provider: 'git-worktree
                       source: source-value policy-revision: version))
      (def r (and (memv id '(2 3 5 6))
        (.cc baseline-receipt witness: id request: request-name provider: 'git-worktree
             working-copy: returned-binding
             source: (if (= id 6) changed-source base-source)
             policy-revision: (case id ((2) "v1") ((3 5) "v2") (else "v3")))))
      (def actual (cond ((= id 0) seeded)
                        (r (receive selected-policy before r current))
                        (else (refresh selected-policy before current))))
      (check-transition 'replacement id before actual expected r)
      (displayln "POLICY-OK " (list-ref '(original derive-and-replace old-revision-receipt
                      new-revision-receipt rebind-org old-org-receipt new-org-receipt) id)
        " admitted=" (.get actual admitted?) " current-use=" (.get actual accepted?))
      (set! state actual))))
(def (source-cut)
  (map (lambda (relative)
    (cons relative (hex-encode (sha256 (call-with-input-file (path-expand relative repo-root) read-all-as-u8vector)))))
    (append (map (lambda (name) (string-append "modules/gitops/" name))
                 '("types.ss" "objects.ss" "contracts.ss" "working-copy.ss" "config.ss" "interface.ss"))
            (map (lambda (name) (string-append model-directory name))
                 '("38-gitops-library.qnt" "39-gitops-refinement-witnesses.qnt"))
            '("init.ss" "t/yanxu/interface.ss" "t/yanxu/modules/gitops/refinement-test.ss"))))
(def (artifact-cut directory)
  (map (lambda (name) (cons name (hex-encode (sha256
    (call-with-input-file (path-expand name directory) read-all-as-u8vector)))))
    (filter (lambda (name) (or (string-suffix? ".itf.json" name) (equal? name "quint.log")))
            (directory-files directory))))
(def (read-cases path key)
  (def doc (call-with-input-file path (lambda (port) (read-json port key-as-symbol: #f object-as-hash: #t))))
  (unless (and (equal? (hash-ref (hash-ref doc "#meta") "status") "passed")
               (= (length (hash-ref doc "states")) 2)) (error "unqualified ITF witness" path))
  (def initial (car (hash-ref doc "states")))
  (check-derived-policies (hash-ref initial "policies"))
  (def contract (.get scope create-contract))
  (unless (and (equal? (hash-ref initial "identity") (symbol->string (.get contract identity)))
               (= (decode-int (hash-ref initial "revision")) (.get contract revision)))
    (error "Contract identity or revision differs from Quint" path))
  (def rows (hash-ref (cadr (hash-ref doc "states")) key))
  (values (if (equal? key "choices") (hash-ref rows "#set") rows)
          (hash-ref initial "origin")))
(def (check-comparison-controls expected)
  (let-values (((before receipt current) (admission-input 16383)))
    (def actual (receive policy-a before receipt current))
    (def mutants (list (.cc actual binding: old-binding) (.cc actual admitted?: #f)
                      (.cc actual accepted?: #f) (.cc actual receipts: '())
                      (.cc actual accepted-requests: '("r1" "r1"))
                      (.cc actual active-policy: policy-b) (.cc actual active-request: "r2")
                      (.cc actual active-provider: 'git-worktree)))
    (for-each (lambda (mutant) (when (same-transition? mutant expected) (error "comparison accepted a mutant"))) mutants)
    ;; These retain alpha's scalar values. The independent identity relation
    ;; must still reject reconstructed receipts and reconstructed bindings.
    (for-each (lambda (mutant)
      (unless (same-transition? mutant expected) (error "invalid lineage control"))
      (unless (with-catch (lambda (_) #t)
                (lambda () (check-transition 'lineage-control 16383 before mutant expected receipt) #f))
        (error "comparison accepted a reconstructed object")))
      (list (.cc actual receipts: (list (.cc receipt witness: 16383)))
            (.cc actual binding: (.cc returned-binding path: "/returned"))))
    (+ 2 (length mutants))))
(def (check-directory directory)
  (def before (source-cut))
  (def tool (getenv "QUINT_BIN" "quint"))
  (unless (equal? (run-process (list "timeout" "5s" tool "--version") coprocess: read-line) "0.33.0")
    (error "Expected Quint 0.33.0"))
  (def exit-status #f)
  (def output (run-process (list "timeout" "--foreground" "--signal=TERM" "--kill-after=3s" "30s"
    "env" "NODE_OPTIONS=--max-old-space-size=1024" tool "test"
    (path-expand (string-append model-directory "39-gitops-refinement-witnesses.qnt") repo-root) "--backend" "typescript"
    "--max-samples" "1" "--seed" "20261116" "--out-itf" (path-expand "trace_{test}_{seq}.itf.json" directory))
    directory: repo-root stderr-redirection: #t check-status: (lambda (status _) (set! exit-status status))))
  (call-with-output-file (path-expand "quint.log" directory) (cut display output <>))
  (unless (equal? exit-status 0) (error "Quint witness generation failed" exit-status output))
  (def witnesses (artifact-cut directory))
  (def total 0)
  (def controls 0)
  (for-each (lambda (family)
    (def name (car family)) (def count (cadr family)) (def consume (caddr family))
    (def files (filter (lambda (name-value) (and (string-prefix? (string-append "trace_" name "Test_") name-value)
                                               (string-suffix? ".itf.json" name-value))) (directory-files directory)))
    (unless (= (length files) 1) (error "Missing or duplicate Quint witness" name))
    (let-values (((cases origin) (read-cases (path-expand (car files) directory)
                                   (if (equal? name "selection") "choices" "cases"))))
      (check-transition 'seed -1 (fresh-state) seeded origin baseline-receipt)
      (unless (= (length cases) count) (error "incomplete partition" name (length cases)))
      (def seen (make-hash-table))
      (for-each (lambda (entry)
        (def mask (decode-int (hash-ref entry "id")))
        (unless (and (<= 0 mask) (< mask count) (not (hash-get seen mask))) (error "invalid witness identity" name mask))
        (hash-put! seen mask #t)
        (def expected (if (equal? name "selection") entry (hash-ref entry "expected")))
        (consume mask expected)
        (when (and (equal? name "admission") (= mask 16383))
          (set! controls (check-comparison-controls expected))))
        (if (member name '("history" "replacement"))
          (map (lambda (id) (find (lambda (entry) (= id (decode-int (hash-ref entry "id")))) cases)) (iota count))
          cases))
      (set! total (+ total count))))
    (list (list "admission" 16384 check-admission) (list "refresh" 256 check-refresh)
          (list "occupied" 16384 (lambda (mask expected) (check-occupied mask expected #f)))
          (list "retired" 16384 (lambda (mask expected) (check-occupied mask expected #t)))
          (list "source" 64 check-source) (list "provider" 4 check-provider)
          (list "history" 9 (make-history-checker)) (list "selection" 64 check-selection)
          (list "replacement" 7 (make-replacement-checker))))
  (unless (equal? before (source-cut)) (error "refinement source cut changed"))
  (unless (equal? witnesses (artifact-cut directory)) (error "refinement witness changed"))
  (call-with-output-file (path-expand "receipt.ss" directory)
    (lambda (port)
      (write `((schema . gitops.library-refinement.v1) (contract . agentic-ai-lab.gitops.create)
               (revision . 4) (quint-version . "0.33.0") (backend . typescript)
               (bounded-step-correspondence . #t) (source-refinement-proved . #f)
               (quint-catalogue-closure . #f)
               (cases . ,total) (comparison-controls . ,controls)
               (witnesses-sha256 . ,witnesses) (sources-sha256 . ,before)) port)
      (newline port)))
  (displayln "REFINEMENT-OK cases=" total " comparison-controls=" controls)
  total)
(def (check-gitops-refinement)
  (def selected (getenv "GITOPS_REFINEMENT_ARTIFACTS" #f))
  (if selected
    (begin (when (file-exists? selected) (error "refinement output must be new" selected))
           (create-directory selected) (check-directory selected))
    (call-with-temporary-directory "gitops-refinement-" check-directory)))

(def refinement-test
  (test-suite "GitOps revision 4 Scheme/Quint finite refinement"
    (test-case "R01 every Boolean admission/refresh partition and source cut commutes"
      (check-equal? (check-gitops-refinement) 49556))))
