# Product adapter roots; dependency traversal belongs to Core, not shell lists.
set shell := ["bash", "-euo", "pipefail", "-c"]
root := justfile_directory() + "/../../.."

build:
    cd "{{ root }}" && timeout --signal=TERM --kill-after=5s 240s gxi -:max-heap=2G,debug=q t/qualification/nix/build.ss

test path:
    cd "{{ root }}" && timeout --signal=TERM --kill-after=5s 240s gxi -:max-heap=2G,debug=q t/qualification/nix/run.ss "{{ path }}"

# Core TestingScript owns the per-file 2 GiB / 120-second gate, serially.
test-all:
    cd "{{ root }}" && timeout --signal=TERM --kill-after=5s 3600s gxi -:max-heap=2G,debug=q t/qualification/nix/run.ss

# Nix-specific approval preparation; Core owns the restarted publication worker.
approved-producer workspace:
    cd "{{ root }}" && env -u SDKROOT timeout --signal=TERM --kill-after=5s 120s "$GERBIL_PATH/bin/build-approved-producer" -:max-heap=2G,debug=q "{{ workspace }}"

# Compiled drivers retain independent processes and the same protocol arguments.
publication-worker workspace library identity mode record:
    cd "{{ root }}" && env -u SDKROOT timeout --signal=TERM --kill-after=5s 120s "$GERBIL_PATH/bin/build-publication-worker" -:max-heap=2G,debug=q "{{ workspace }}" "{{ library }}" "{{ identity }}" "{{ mode }}" "{{ record }}"

approved-worker workspace mode:
    cd "{{ root }}" && env -u SDKROOT timeout --signal=TERM --kill-after=5s 120s "$GERBIL_PATH/bin/build-publication-worker" -:max-heap=2G,debug=q "{{ workspace }}" "approved-{{ mode }}"

store-producer workspace:
    cd "{{ root }}/core" && env -u SDKROOT timeout --signal=TERM --kill-after=5s 120s "$GERBIL_PATH/bin/build-store-producer" -:max-heap=2G,debug=q "{{ workspace }}"

store-worker workspace library identity mode record selected candidate:
    cd "{{ root }}" && env -u SDKROOT timeout --signal=TERM --kill-after=5s 120s "$GERBIL_PATH/bin/build-publication-worker" -:max-heap=2G,debug=q "{{ workspace }}" "{{ library }}" "{{ identity }}" "{{ mode }}" "{{ record }}" "{{ selected }}" "{{ candidate }}"

# Read the actual Nix-selected head in an independent bounded process.
head-reader profile:
    cd "{{ root }}" && env -u SDKROOT timeout --signal=TERM --kill-after=5s 30s gxi -:max-heap=2G,debug=q t/qualification/build-publication/nix-head-reader.ss "{{ profile }}"
