;;; Historical deltas are native inference, not proof or execution authority.
(ascent-fragment
  (relation current_row ((query symbol?) (row symbol?)))
  (relation previous_row ((query symbol?) (row symbol?)))
  (relation current_input ((path symbol?) (hash symbol?)))
  (relation previous_input ((path symbol?) (hash symbol?)))
  (relation current_name ((path symbol?)))
  (relation previous_name ((path symbol?)))
  (relation added ((query symbol?) (row symbol?)))
  (relation removed ((query symbol?) (row symbol?)))
  (relation retained ((query symbol?) (row symbol?)))
  (relation changed_input ((path symbol?)))
  (relation added_input ((path symbol?)))
  (relation removed_input ((path symbol?)))
  ((added Q R) <-- (current_row Q R) (not (previous_row Q R)))
  ((removed Q R) <-- (previous_row Q R) (not (current_row Q R)))
  ((retained Q R) <-- (current_row Q R) (previous_row Q R))
  ((changed_input P) <-- (current_input P H) (previous_input P K) (not (previous_input P H)))
  ((added_input P) <-- (current_input P H) (not (previous_name P)))
  ((removed_input P) <-- (previous_input P H) (not (current_name P)))
  ((previous_name P) <-- (previous_input P H))
  ((current_name P) <-- (current_input P H)))
