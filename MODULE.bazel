module(
    name = "agentic_ai_lab",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "gerbil_bazel", version = "0.1.0")

# protobuf 33.4 pulls unused Apple and Swift rule sets into every C build;
# protobuf 34 removes that dependency edge.  Keep the graph on the first
# release without the irrelevant macOS Swift repository probe.
single_version_override(
    module_name = "protobuf",
    version = "34.0.bcr.1",
)

include("//:gerbil-bazel.MODULE.bazel")

GERBIL_LINUX_REVISION = "1cfb032c7a1612637da6205f5f8a15683eba3ba0"

GERBIL_LINUX_SHA256 = "143c691fee5af4f9f631fd339f69a66f562e42e0bfc1d4ee2cda5fa8d35c35ee"

GERBIL_LINUX_URLS = [
    "https://github.com/tao3k/gerbil-bazel/releases/download/gerbil-v0.19-1cfb032c7a1612637da6205f5f8a15683eba3ba0-linux-x86_64-portable-full-single-host-unlimited-multiple-vms-patch9599b09b82f8/gerbil-v0.19-1cfb032c7a1612637da6205f5f8a15683eba3ba0-linux-x86_64-portable-full-single-host-unlimited-multiple-vms-patch9599b09b82f8.tar.gz",
]

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.12")
python.toolchain(python_version = "3.12")

gerbil = use_extension("@gerbil_bazel//gerbil:extensions.bzl", "gerbil")
gerbil.auto(
    name = "local_gerbil",
    # Bound each native std/make executor; Bazel may schedule two projects.
    environment = {"GERBIL_BUILD_CORES": "2"},
    expected_version_prefixes = [
        "Gerbil 1cfb032",
    ],
    linux_prebuilt_arch = "x86_64",
    linux_prebuilt_manifest_path = "gerbil-toolchain-release.json",
    linux_prebuilt_release_revision = GERBIL_LINUX_REVISION,
    linux_prebuilt_sha256 = GERBIL_LINUX_SHA256,
    linux_prebuilt_strip_prefix = "gerbil-v0.19-linux-x86_64",
    linux_prebuilt_urls = GERBIL_LINUX_URLS,
    project_root_marker = "//:gerbil.pkg",
)
use_repo(
    gerbil,
)
use_repo(
    gerbil,
    "local_gerbil",
)

include("//:gerbil-dependencies.MODULE.bazel")

register_toolchains("@local_gerbil//:registered_toolchain")
