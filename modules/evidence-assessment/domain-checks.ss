;;; Exact checks over supplied observations. Observation collection and source
;;; authority remain the host's responsibility; this does not prove Python.
(export ascent-domain-check ascent-domain-contract)
(def (ascent-domain-contract kind)
  (cond ((equal? kind "graph-schedule") "Inner update traversal equals outer group traversal filtered by reachability; matrix mutation must not mix traversal schedules.")
        ((equal? kind "graph-update") "Read the required update epoch; after=before-removed and 0<=removed<=before.")
        ((equal? kind "series-precision") "For p=x^m*u and nth root n!=0, internal precision=P-m/n; keep a normalized term e exactly when e+m/n<P.")
        ((equal? kind "graph-row-normalization") "Normalize each mutual-weight row by that row's own maximum; the read divisor must belong to the same row.")
        ((equal? kind "symbolic-specialization") "A receipted zero symbolic difference witnesses that a specialization belongs to a returned family; retaining both is redundant. A nonzero or unknown difference is not a containment proof.")
        (else (error "unsupported domain contract"))))
(def (rational-pair value)
  (unless (and (list? value) (= (length value) 2)
               (andmap exact-integer? value) (> (cadr value) 0))
    (error "expected exact rational numerator and positive denominator"))
  (/ (car value) (cadr value)))
(def (wire-rational value) (list (numerator value) (denominator value)))
(def (bounded-rows rows width)
  (unless (and (list? rows) (<= (length rows) 256)
               (andmap (lambda (row) (and (list? row) (= (length row) width))) rows))
    (error "invalid domain observation shape")))
(def (ascent-domain-check kind rows)
  (cond
   ((equal? kind "graph-row-normalization")
    ;; [id, original row, observed normalized row, absolute tolerance].
    (bounded-rows rows 4)
    (map (lambda (row)
           (unless (and (string? (car row)) (list? (cadr row)) (pair? (cadr row))
                        (list? (caddr row)) (= (length (cadr row)) (length (caddr row))))
             (error "invalid normalization observation"))
           (let* ((original (map rational-pair (cadr row))) (actual (map rational-pair (caddr row)))
                  (maximum (apply max original)) (tolerance (rational-pair (cadddr row))))
             (unless (and (> maximum 0) (>= tolerance 0) (andmap (lambda (v) (>= v 0)) original))
               (error "normalization requires nonnegative weights and a positive row maximum"))
             (let (required (map (lambda (v) (/ v maximum)) original))
               (hash ("id" (car row)) ("requiredNormalizedRow" (map wire-rational required))
                     ("claims" (list (list "same-row-divisor"
                       (andmap (lambda (x y) (<= (abs (- x y)) tolerance)) actual required)))))))) rows))
   ((equal? kind "symbolic-specialization")
    ;; Symbolic simplification is a delegated, receipted observation, not Scheme algebra.
    (bounded-rows rows 3)
    (map (lambda (row)
           (unless (and (string? (car row)) (string? (cadr row)) (boolean? (caddr row)))
             (error "invalid symbolic specialization witness"))
           (let (zero (equal? (cadr row) "0"))
             (hash ("id" (car row)) ("witnessAvailable" zero)
                   ("claims" (list (list "specialization-witness" zero)
                                    (list "no-redundant-specialization" (not (and zero (caddr row))))))))) rows))
   ((equal? kind "graph-schedule")
    ;; Observation is [id, outer group traversal, reachable nodes, inner traversal].
    (bounded-rows rows 4)
    (map (lambda (row)
           (unless (and (string? (car row))
                        (andmap list? (cdr row))
                        (andmap (lambda (xs) (andmap (lambda (v) (or (string? v) (exact-integer? v))) xs)) (cdr row)))
             (error "invalid graph schedule observation"))
           (let* ((outer (cadr row)) (eligible (caddr row)) (observed (cadddr row))
                  (expected (filter (lambda (v) (member v eligible)) outer)))
             (hash ("id" (car row)) ("requiredOrder" expected)
                   ("claims" (list (list "update-traversal-coherence" (equal? expected observed))))))) rows))
   ((equal? kind "graph-update")
    ;; [id, expected read epoch, observed read epoch, before, removed, after].
    (bounded-rows rows 6)
    (map (lambda (row)
           (unless (and (string? (car row)) (andmap exact-integer? (cdr row))
                        (andmap (lambda (x) (>= x 0)) (cdr row)))
             (error "invalid graph update observation"))
           (let ((id (car row)) (expected (list-ref row 1)) (observed (list-ref row 2))
                 (before (list-ref row 3)) (removed (list-ref row 4)) (after (list-ref row 5)))
             (hash ("id" id)
                   ("claims" (list
                     (list "update-read-version" (= expected observed))
                     (list "path-count-conservation" (= after (- before removed)))
                     (list "path-count-nonnegative" (<= removed before))))))) rows))
   ((equal? kind "series-precision")
    ;; [id, leading exponent, nonzero root order, final precision,
    ;;  observed internal precision, internal term exponent, included?].
    (bounded-rows rows 7)
    (map (lambda (row)
           (unless (and (string? (car row)) (exact-integer? (list-ref row 2))
                        (not (= (list-ref row 2) 0)) (boolean? (list-ref row 6)))
             (error "invalid series precision observation"))
           (let* ((m (rational-pair (list-ref row 1))) (n (list-ref row 2))
                  (p (rational-pair (list-ref row 3)))
                  (inner (rational-pair (list-ref row 4)))
                  (term (rational-pair (list-ref row 5)))
                  (shift (/ m n)) (required (- p shift)) (keep (< (+ term shift) p)))
             (hash ("id" (car row))
                   ("requiredInternalPrecision" (wire-rational required))
                   ("restoredExponent" (wire-rational (+ term shift)))
                   ("shouldInclude" keep)
                   ("claims" (list (list "precision-budget" (= inner required))
                                    (list "precision-boundary" (eq? (list-ref row 6) keep))))))) rows))
   (else (error "unsupported domain checker"))))
