(import :std/test
        (only-in :tao3k/yuanxu/observability/testing-case yuanxu-test-case)
        (only-in :tao3k/yuanxu/module-system/interface yuanxu-load-modules)
        (only-in :tao3k/yuanxu/module-system/source/objects
                 make-yuanxu-module-generated-source yuanxu-module-source-ref-value)
        (rename-in (only-in :tao3k/agentic-ai-lab/modules/gitops/features/worktree/interface Feature)
                   (Feature GitOpsFeature))
        (rename-in (only-in :tao3k/agentic-ai-lab/modules/ai-agentic-context/features/worktree/interface Feature)
                   (Feature ContextFeature))
        (rename-in (only-in :tao3k/agentic-ai-lab/modules/gitops/features/work/interface Feature)
                   (Feature GitOpsWorkFeature))
        (rename-in (only-in :tao3k/agentic-ai-lab/modules/gitops/features/worktrunk/interface Feature)
                   (Feature GitOpsWorkTrunkFeature))
        (rename-in (only-in :tao3k/agentic-ai-lab/modules/ai-agentic-context/features/work/interface Feature)
                   (Feature ContextWorkFeature))
        (rename-in (only-in :tao3k/agentic-ai-lab/modules/ai-agentic-context/features/worktrunk/interface Feature)
                   (Feature ContextWorkTrunkFeature))
        (only-in :clan/poo/object .o .ref .slot? .cc object? object-supers)
        (only-in :clan/poo/type Type.)
        (only-in :std/list/list find)
        (only-in :tao3k/agentic-ai-lab/modules/gitops/working-copy GitOpsWorkingCopyPolicy)
        (only-in :tao3k/agentic-ai-lab/modules/ai-agentic-context/objects AiAgenticContextScope.)
        :tao3k/agentic-ai-lab/modules/ai-agentic-context/task-publication
        :tao3k/agentic-ai-lab/modules/ai-agentic-context/query-provider
        :tao3k/agentic-ai-lab/modules/ai-agentic-context/use-host
        (only-in :tao3k/agentic-ai-lab/modules/search-engine/interface
                 agentic-ai-lab-search-factor-observation)
        :tao3k/agentic-ai-lab/modules/temporal-causality/truth-maintenance/support/policy
        :tao3k/agentic-ai-lab/modules/temporal-causality/truth-maintenance/support/policy-host
        (only-in :tao3k/agentic-ai-lab/modules/temporal-causality/time/objects
                 agentic-ai-lab-temporal-instant))
(export task-publication-test)

(def (at coordinate)
  (agentic-ai-lab-temporal-instant
   (number->string coordinate) "clock" coordinate "host" 'observed))
(def policy (agentic-ai-lab-temporal-support-policy "org-policy" "1" (at 1) (at 10)))
(def contract (agentic-ai-lab-context-use-contract "actor" "investigate-owner" "task" '() '() #t))
(def anchor "owner-evidence")
(def source-text
  ":PROPERTIES:\n:ID: findings\n:CONTRACT_ID: context.evidence-source.v1\n:CONTRACT_REVISION: 1\n:END:\n* Evidence\n:PROPERTIES:\n:ID: owner-evidence\n:END:\n")

(defstruct scenario (host queries grants policies scope source grant))
(defstruct delivery (ticket query search))

(def (register-source! s identity revision (bytes source-text))
  (context-query-source! (scenario-queries s) (context-org-source identity revision bytes)))

(def (register-grant! s id (generation 1) (source (scenario-source s)))
  (agentic-ai-lab-context-use-host-refresh! (scenario-grants s)
    (agentic-ai-lab-context-use-grant id generation "manifest"
       (context-task-read-scope (scenario-scope s) source anchor)
       contract "org-policy" (.ref policy 'semantic-digest) '(display) #t)))

(def (select! s (route "router-1") (revision "search-1") (grant-id (scenario-grant s)))
  (let ((source-id (scenario-source s)) (anchor-id anchor))
    (context-task-select! (scenario-host s) (scenario-scope s)
      (and route (.o source: source-id anchor: anchor-id router-revision: route
                     search-contract-revision: revision query-revision: "query-1" grant: grant-id)))))

(def (setup (worktree-id "A") (queries (context-query-host)) (bytes source-text))
  (let* ((scope (.o (:: @ AiAgenticContextScope.) bundle: "lab" organization: "team" epoch: 1
                   project: "gambit" worktree: worktree-id source-cut: "cut-1" actor: "actor"
                   task: "investigate-owner" destination: "search"))
         (grants (agentic-ai-lab-context-use-host))
         (policies (agentic-ai-lab-temporal-support-policy-host))
         (source (string-append worktree-id "/findings.org"))
         (id (string-append worktree-id "-read"))
         (s (make-scenario (context-task-publication-host scope queries grants policies)
                           queries grants policies scope source id)))
    (agentic-ai-lab-temporal-support-policy-host-refresh! policies policy 1 (at 1))
    (register-source! s source 1 bytes)
    (register-grant! s id)
    (select! s)
    s))

(def (search-observation ticket query (cut (.ref ticket 'search-source-cut)))
  (agentic-ai-lab-search-factor-observation
   (string-append (.ref ticket 'search-generation) ":returned")
   (.ref ticket 'search-generation) ContextTaskOrgEvidenceStage
   (.ref query 'query-digest) 1 cut '() 'derived #t))

(def (evaluate s ticket)
  (let (query (context-task-query! (scenario-host s) ticket))
    (make-delivery ticket query (search-observation ticket query))))

(def (issue s)
  (evaluate s (context-task-start! (scenario-host s))))

(def (deliver s item (query (delivery-query item)) (search (delivery-search item)))
  (context-task-publish! (scenario-host s) (delivery-ticket item) query search))

(def (current s)
  (context-task-current (scenario-host s)))

(def (check-current s request generation)
  (let* ((published (current s)) (query (.ref published 'query))
         (lineage (context-query-lineage query)))
    (check (.ref published 'request) => request)
    (check (.ref lineage 'source) => (scenario-source s))
    (check (.ref lineage 'generation) => generation)
    (check (.ref lineage 'org-ids) => (list anchor))
    (check (.ref (.ref query 'result-set) 'result-count) => 1)
    (check (.slot? query 'source-cut) => #f)
    (check (.ref (.ref published 'search) 'payload-identity) => (.ref lineage 'semantic-digest))
    (check (.ref (.ref query 'query-receipt) 'admitted?) => #t)))

(def (revoke! s (grant-id (scenario-grant s)))
  (let* ((grants (scenario-grants s))
         (old (agentic-ai-lab-context-use-host-current grants grant-id)))
    (agentic-ai-lab-context-use-host-refresh! grants (agentic-ai-lab-context-use-grant-revoke old))))

(def (restore! s)
  (register-grant! s "new-read")
  (select! s "router-1" "search-1" "new-read"))

(def design-source "A/design.org")
(def design-grant "design-read")
(def original-text (string-append source-text "Original design evidence.\n"))

(def (org-demand source-id grant-id (origin-ref #f))
  (let (anchor-id anchor)
    (.o source: source-id anchor: anchor-id origin: origin-ref grant: grant-id query-revision: "query-1")))

(def (origin source-id version)
  (let (anchor-id anchor)
    (.o source: source-id anchor: anchor-id generation: version)))

(def (select-orgs! s entries)
  (context-task-select! (scenario-host s) (scenario-scope s)
    (.o router-revision: "router-1" search-contract-revision: "search-1" org-modules: entries)))

(def (select-pair! s (version 1) (source-id design-source) (grant-id design-grant))
  ;; The derived module is deliberately first. The pin does not govern presentation order.
  (select-orgs! s (list (org-demand (scenario-source s) (scenario-grant s) (origin source-id version))
                       (org-demand source-id grant-id))))

(def (setup-pair (source-id design-source))
  (let (s (setup))
    (register-source! s source-id 1 original-text)
    (register-grant! s design-grant 1 source-id)
    (select-pair! s 1 source-id)
    s))

(def (check-pair s request derived-version original-version)
  (let* ((published (current s))
         (queries (.ref published 'org-queries))
         (derived (car queries))
         (original (cadr queries))
         (derived-lineage (context-query-lineage derived))
         (original-lineage (context-query-lineage original))
         (pinned (.ref derived 'origin)))
    (check (.ref published 'request) => request)
    (check (length queries) => 2)
    (check (.ref published 'query) => #f)
    (check (.ref derived-lineage 'source) => (scenario-source s))
    (check (.ref original-lineage 'source) => design-source)
    (check (.ref derived-lineage 'generation) => derived-version)
    (check (.ref original-lineage 'generation) => original-version)
    (check (.ref derived-lineage 'org-ids) => (list anchor))
    (check (.ref original-lineage 'org-ids) => (list anchor))
    (check (.ref pinned 'source) => design-source)
    (check (.ref pinned 'anchor) => anchor)
    (check (.ref pinned 'generation) => original-version)
    (check (.ref pinned 'query-digest) => (.ref original-lineage 'semantic-digest))
    (check (.ref original 'origin) => #f)))

(def (derived-text generation)
  (string-append
   ":PROPERTIES:\n:ID: findings\n:CONTRACT_ID: context.evidence-source.v1\n:CONTRACT_REVISION: 1\n:END:\n"
   "* Evidence\n:PROPERTIES:\n:ID: owner-evidence\n:CONTEXT_ORIGIN_MODULE: design\n"
   ":CONTEXT_ORIGIN_SOURCE: A/design.org\n:CONTEXT_ORIGIN_ID: owner-evidence\n"
   ":CONTEXT_ORIGIN_GENERATION: " (number->string generation) "\n:END:\n"
   "#+begin_src text\n:CONTEXT_ORIGIN_SOURCE: B/design.org\n#+end_src\n"))

(def (setup-worktree (bytes (derived-text 1)))
  (let (s (setup "A" (context-query-host) bytes))
    (register-source! s design-source 1 original-text)
    (register-grant! s design-grant 1 design-source)
    s))

(def ScopeType (.cc Type. identity: 'test/context-worktree-scope .element?: object?))
(def WorktreePath '(worktrees gc-owner-fix))

(def WorktreeFeatures
  (let* ((ids '(gitops ai-agentic-context))
         (view
           (yuanxu-load-modules
             (.o generation: "context-worktree-features" module-ids: ids selected: ids denied-modules: '()
                 feature-roots: ids
                 intent: (.o mode: 'explicit
                             decisions: (map (lambda (id)
                                               (.o identity: id selection: (.o selection-flags: '(+worktree +work +worktrunk))))
                                             ids))
                 locate: make-yuanxu-module-generated-source current?: (lambda (_) #t)
                 read-publication:
                 (lambda (reference)
                   (let* ((id (yuanxu-module-source-ref-value reference))
                          (declarations
                            (if (eq? id 'gitops)
                              (.o worktree: GitOpsFeature work: GitOpsWorkFeature worktrunk: GitOpsWorkTrunkFeature)
                              (.o worktree: ContextFeature work: ContextWorkFeature worktrunk: ContextWorkTrunkFeature))))
                     (.o identity: id features: declarations
                         core: (.o scope-contract: ScopeType
                                   exports: (if (eq? id 'gitops)
                                              (.o component: id working-copy-policy: GitOpsWorkingCopyPolicy)
                                              (.o component: id))))))))))
    (.ref view 'modules)))

(def (worktree-loader s revision live-generation (design-path '(org design)) (roots '(findings))
                      (work-binding #f) (trunk-binding #f) (review-trunk-binding #f))
  (let* ((ids '(worktrees/gc-owner-fix org/findings org/design org/other org/unselected))
         (worktree-id (.ref (scenario-scope s) 'worktree))
         (project-id (.ref (scenario-scope s) 'project))
         (source-cut-id (.ref (scenario-scope s) 'source-cut))
         (forced '())
         (project
           (.o (:: @ (.ref (.ref WorktreeFeatures 'ai-agentic-context) 'worktree-context))
               org: (.o findings: '(org findings) design: design-path unselected: '(org unselected))
               tasks: (.o investigate-owner:
                          (.o org: roots work: work-binding worktrunk: trunk-binding
                              router-revision: "router-1" search-contract-revision: "search-1")
                          review: (.o worktrunk: review-trunk-binding)))))
    (def (org-module source-id grant-id)
      (.o worktree: worktree-id source: source-id anchor: "owner-evidence"
          grant: grant-id query-revision: "query-1"))
    (def (read-module source)
      (let (id (yuanxu-module-source-ref-value source))
        (.o identity: id features: (.o)
            core: (.o scope-contract: ScopeType
                      exports:
                      (begin
                        (set! forced (cons id forced))
                        (case id
                          ((worktrees/gc-owner-fix)
                           (.o (:: @ project) project: project-id worktree: worktree-id source-cut: source-cut-id))
                          ((org/findings) (org-module (scenario-source s) (scenario-grant s)))
                          ((org/design) (org-module design-source design-grant))
                          ((org/other) (org-module "A/other-design.org" "other-read"))
                          (else (error "Unselected Org Module was forced" id))))))))
    (let (loaded
           (yuanxu-load-modules
             (.o generation: revision module-ids: ids selected: ids denied-modules: '()
                 locate: make-yuanxu-module-generated-source
                 current?: (lambda (candidate) (equal? candidate (live-generation)))
                 read-publication: read-module)))
      (.o owner: loaded forced-scopes: (lambda () (reverse forced))))))

(def (bind-worktree! s selection-reader)
  (let* ((gitops (.ref WorktreeFeatures 'gitops))
         (context (.ref WorktreeFeatures 'ai-agentic-context))
         (dependency ((.ref gitops 'worktree-dependency) selection-reader WorktreePath)))
    ((.ref context 'bind-worktree!) (scenario-host s) (scenario-scope s) dependency)))

(def (select-worktree! s loader)
  (bind-worktree! s (lambda () (.ref loader 'owner))))

(def (feature-loader role version roots (on-read void))
  (let* ((context (.ref WorktreeFeatures 'ai-agentic-context))
         (prototype (.ref context (if (eq? role 'work) 'work-context 'worktrunk-context)))
         (scope (.cc (.o (:: @ prototype) project: "gambit" revision: version org: roots)
                     role (symbol->string role))))
    (yuanxu-load-modules
      (.o generation: version module-ids: '(selected unrelated) selected: '(selected unrelated) denied-modules: '()
          locate: make-yuanxu-module-generated-source current?: (lambda (_) #t)
          read-publication:
          (lambda (reference)
            (let (id (yuanxu-module-source-ref-value reference))
              (.o identity: id features: (.o)
                  core: (.o scope-contract: ScopeType
                            exports: (if (eq? id 'selected) (begin (on-read) scope)
                                         (error "Unselected GitOps leaf was forced" id))))))))))

(def (feature-dependency feature current)
  (let ((gitops (.ref WorktreeFeatures 'gitops))
        (slot (if (eq? feature 'work) 'work-dependency 'worktrunk-dependency)))
    ((.ref gitops slot) current '(selected))))

(def (published-versions publication)
  (map (lambda (row) (list (.ref row 'feature) (.ref row 'identity) (.ref row 'revision)))
       (.ref publication 'gitops-dependencies)))

(def (check-feature-dependency-refresh role (arrival 'before-start))
  (let* ((s (setup-worktree))
         (context (.ref WorktreeFeatures 'ai-agentic-context))
         (gitops (.ref WorktreeFeatures 'gitops))
         (start (.ref context 'start-task!))
         (work (feature-loader 'work "w1" '(design)))
         (trunk (feature-loader 'worktrunk "t1" '()))
         (loader (worktree-loader s "g1" (lambda () "g1") '(org design) '()
                                  (feature-dependency 'work (lambda () work))
                                  (feature-dependency 'worktrunk (lambda () trunk))))
         (original '((work "work" "w1") (worktrunk "worktrunk" "t1")))
         (replacement (if (eq? role 'work)
                        '((work "work" "w2") (worktrunk "worktrunk" "t1"))
                        '((work "work" "w1") (worktrunk "worktrunk" "t2")))))
    (check (eq? (car (object-supers (.ref context 'work-context))) (.ref gitops 'work-prototype)) => #t)
    (check (eq? (car (object-supers (.ref context 'worktrunk-context))) (.ref gitops 'worktrunk-prototype)) => #t)
    (check (select-worktree! s loader) => #t)
    (check (deliver s (evaluate s (start (scenario-host s)))) => 'published)
    (check (published-versions (current s)) => original)
    (check ((.ref loader 'forced-scopes)) => '(worktrees/gc-owner-fix org/design))
    (let (late (evaluate s (start (scenario-host s))))
      (check (start (scenario-host s)) => #f)
      (if (eq? role 'work)
        (set! work (feature-loader 'work "w2" '(design findings)))
        (set! trunk (feature-loader 'worktrunk "t2" '(findings))))
      (check (current s) => #f)
      (when (eq? arrival 'before-start) (check (deliver s late) => 'historical))
      (let (fresh (evaluate s (start (scenario-host s))))
        (check (.ref (delivery-ticket fresh) 'request) => 3)
        (case arrival
          ((before-start)
           (check (deliver s late) => 'unbound)
           (check (deliver s fresh) => 'published))
          ((while-pending)
           (check (deliver s late (delivery-query fresh) (delivery-search late)) => 'unbound)
           (check (deliver s late) => 'historical)
           (check (deliver s late) => 'unbound)
           (check (current s) => #f)
           (check (deliver s fresh) => 'published))
          ((after-publication)
           (check (deliver s fresh) => 'published)
           (check (deliver s late) => 'historical)
           (check (deliver s late) => 'unbound))))
      (let ((publication (current s)) (history (context-task-history (scenario-host s))))
        (check (published-versions publication) => replacement)
        (check (map (lambda (query) (.ref (context-query-lineage query) 'source))
                    (.ref publication 'org-queries))
               => (list design-source (scenario-source s)))
        (check (map published-versions history)
               => (case arrival
                    ((before-start) (list original original '() replacement))
                    ((while-pending) (list original '() original '() replacement))
                    ((after-publication) (list original replacement original '()))))
        (check ((.ref loader 'forced-scopes)) => '(worktrees/gc-owner-fix org/design org/findings))))))

(def task-publication-test
  (test-suite "Org Context Task publication and Quint correspondence"
    (yuanxu-test-case "independentOrgTest"
      (let* ((s (setup)) (ticket (context-task-start! (scenario-host s))))
        (register-source! s "A/independent.org" 1)
        (select! s)
        (let (item (evaluate s ticket))
          (check (eq? (context-task-query! (scenario-host s) ticket) (delivery-query item)) => #t)
          (check (deliver s item) => 'published)
          (check (context-task-query! (scenario-host s) ticket) => #f)
          (let* ((original
                   (context-query-observation (scenario-queries s)
                                               (.ref (delivery-query item) 'query-digest)))
                 (gql (.ref original 'query-descriptor))
                 (row (car (.ref (.ref original 'result-set) 'rows)))
                 (element-kind (find (lambda (cell) (eq? (.ref cell 'field) 'elementKind))
                                     (.ref row 'cells))))
            (check (.ref gql 'key) => 'propertyId)
            (check (.ref gql 'value) => anchor)
            (check (.ref element-kind 'value) => "OrgSection"))
          (register-source! s "A/another.org" 1)
          (string-set! (.ref ticket 'search-source-cut) 0 #\X)
          (let (returned (current s))
            (string-set! (.ref (.ref returned 'search) 'payload-identity) 0 #\X)
            (string-set! (.ref (context-query-lineage (.ref returned 'query)) 'source) 0 #\X))
          (check-current s 1 1))))
    (yuanxu-test-case "sourceEditTest"
      (let (s (setup))
        (check (deliver s (issue s)) => 'published)
        (let (late (issue s))
          (register-source! s (scenario-source s) 2 (string-append source-text "Edited evidence.\n"))
          (check (current s) => #f)
          (check (deliver s late) => 'historical)
          (check (current s) => #f)
          (check (map (lambda (row) (.ref row 'request)) (context-task-history (scenario-host s)))
                 => '(1 2))
          (check (deliver s (issue s)) => 'published)
          (check-current s 3 2))))
    (yuanxu-test-case "routerConflictTest"
      (let* ((s (setup)) (late (issue s)))
        (select! s #f)
        (check (deliver s late) => 'historical)
        (check (current s) => #f)
        (check (context-task-start! (scenario-host s)) => #f)
        (select! s "router-1")
        (check (deliver s late) => 'unbound)
        (check (deliver s (issue s)) => 'published)
        (check-current s 2 1)))
    (yuanxu-test-case "replacedContractTest"
      (let* ((s (setup)) (late (issue s)))
        (select! s "router-1" "search-2")
        (check (deliver s late) => 'historical)
        (check (current s) => #f)))
    (yuanxu-test-case "siblingReceiptTest"
      (let* ((s (setup)) (sibling (setup "B" (scenario-queries s))))
        (check (deliver s (issue s)) => 'published)
        (let ((pending (issue s)) (foreign (issue sibling)))
          (check (deliver s pending (delivery-query foreign) (delivery-search foreign)) => 'unbound)
          (check-current s 1 1)
          (check (deliver s pending) => 'published)
          (check-current s 2 1))))
    (yuanxu-test-case "revokedThenRestoredTest"
      (let (s (setup))
        (check (deliver s (issue s)) => 'published)
        (let (late (issue s))
          (revoke! s)
          (check (current s) => #f)
          (check (context-task-query! (scenario-host s) (delivery-ticket late)) => #f)
          (restore! s)
          (check (current s) => #f)
          (check (deliver s late) => 'historical)
          (let (fresh (issue s))
            ;; Same Query result digest can recur, but an earlier receipt
            ;; ticket cannot satisfy a new evaluation.
            (check (deliver s late) => 'unbound)
            (check (deliver s fresh (delivery-query late)) => 'unbound)
            (check (deliver s fresh) => 'published)
            (check-current s 3 1)))))
    (yuanxu-test-case "ignoreContractCounterexampleTest"
      (let (s (setup))
        (check (deliver s (issue s)) => 'published)
        (let (pending (issue s))
          (select! s "router-1" "search-2")
          (check (current s) => #f)
          (select! s "router-1" "search-1")
          (check (current s) => #f)
          (check (deliver s pending) => 'historical)
          (check (current s) => #f))))
    (yuanxu-test-case "ignoreWorktreeCounterexampleTest"
      (let* ((s (setup)) (sibling (setup "B" (scenario-queries s)))
             (pending (issue s)) (foreign (issue sibling))
             (wrong-cut (search-observation (delivery-ticket pending) (delivery-query pending)
                                            (.ref (delivery-ticket foreign) 'search-source-cut)))
             (wrong-result (search-observation (delivery-ticket pending) (delivery-query foreign))))
        (check (.ref (delivery-ticket pending) 'request) => (.ref (delivery-ticket foreign) 'request))
        (check (deliver s pending (delivery-query pending) (delivery-search foreign)) => 'unbound)
        (check (deliver s pending (delivery-query pending) wrong-cut) => 'unbound)
        (check (deliver s pending (delivery-query pending) wrong-result) => 'unbound)
        (check (current s) => #f)
        (check (deliver s pending) => 'published)
        (check-current s 1 1)))
    (yuanxu-test-case "ignoreGrantEpochCounterexampleTest"
      (let (s (setup))
        (check (deliver s (issue s)) => 'published)
        (let (late (issue s))
          ;; Even without a selection edit or a denied read between epochs,
          ;; the newer issuance cannot be used by an older request.
          (register-grant! s (scenario-grant s) 2)
          (check (current s) => #f)
          (check (deliver s late) => 'historical)
          (check (deliver s (issue s)) => 'published)
          (check-current s 3 1)
          ;; The clock can revoke the grant while observing it. Final use
          ;; must check the registration after the callback returns.
          (agentic-ai-lab-temporal-support-policy-host-enroll-clock! (scenario-policies s)
            (.o kind: 'temporal.monotonic-clock.v1
                .observe: (lambda (self id) (revoke! s) (at 2))))
          (check (current s) => #f))))
    (yuanxu-test-case "multiOrgCompletesTest"
      (let* ((s (setup-pair)) (item (issue s)))
        (check (deliver s item) => 'published)
        (register-source! s "A/unrelated.org" 1)
        (check-pair s 1 1 1)
        (check (.ref (.ref (current s) 'search) 'payload-identity)
               => (.ref (delivery-query item) 'query-digest))
        (check-exception (select-orgs! s
                           (list (org-demand (scenario-source s) (scenario-grant s)
                                             (origin "A/unrelated.org" 1))
                                 (org-demand design-source design-grant)))
                         true)
        (check-exception (select-orgs! s
                           (list (org-demand (scenario-source s) (scenario-grant s) (origin design-source 1))
                                 (org-demand design-source design-grant (origin (scenario-source s) 1))))
                         true)
        (check-pair s 1 1 1)))
    (yuanxu-test-case "multiOrgPartialReceiptTest"
      (let* ((s (setup-pair))
             (item (issue s))
             (member (car (cadr (context-query-history (scenario-queries s)))))
             (reference (.ref (context-query-lineage member) 'semantic-digest))
             (partial (.o query-digest: reference)))
        (check (deliver s item (delivery-query item) (search-observation (delivery-ticket item) partial))
               => 'unbound)
        (check (current s) => #f)
        (check (deliver s item) => 'published)
        (check-pair s 1 1 1)))
    (yuanxu-test-case "multiOrgOriginIdentityTest"
      (let* ((s (setup-pair)) (item (issue s))
             (other (setup-pair "A/other-design.org")) (other-item (issue other)))
        (check (deliver other other-item) => 'published)
        ;; Preserve this evaluation's generation and cut while substituting a
        ;; genuine batch for a different original with the same local Org ID.
        (check (deliver s item (delivery-query item)
                        (search-observation (delivery-ticket item) (delivery-query other-item)))
               => 'unbound)
        (check (current s) => #f)
        (check (deliver s item) => 'published)
        (check-pair s 1 1 1)))
    (yuanxu-test-case "multiOrgOriginEditTest"
      (let (s (setup-pair))
        (check (deliver s (issue s)) => 'published)
        (let (late (issue s))
          (register-source! s design-source 2 original-text)
          (check (current s) => #f)
          (check (deliver s late) => 'historical)
          (check (context-task-start! (scenario-host s)) => #f)
          (select-pair! s 2)
          (check (deliver s (issue s)) => 'published)
          (check-pair s 3 1 2)
          (let (history (context-task-history (scenario-host s)))
            (check (map (lambda (row) (.ref row 'status)) history) => '(published historical published))
            (check (map (lambda (row) (.ref (.ref (car (.ref row 'org-receipts)) 'origin) 'generation))
                        history)
                   => '(1 1 2))))))
    (yuanxu-test-case "multiOrgDerivedEditTest"
      (let (s (setup-pair))
        (check (deliver s (issue s)) => 'published)
        (let (late (issue s))
          (register-source! s (scenario-source s) 2 (string-append source-text "Edited findings.\n"))
          (check (current s) => #f)
          (check (deliver s late) => 'historical)
          (check (deliver s (issue s)) => 'published)
          (check-pair s 3 2 1))))
    (yuanxu-test-case "multiOrgGrantRevokedTest"
      (let (s (setup-pair))
        (check (deliver s (issue s)) => 'published)
        (let (late (issue s))
          (revoke! s design-grant)
          (check (current s) => #f)
          (check (deliver s late) => 'historical)
          (check (context-task-start! (scenario-host s)) => #f)
          (register-grant! s "design-restored" 1 design-source)
          (select-pair! s 1 design-source "design-restored")
          (check (current s) => #f)
          (check (deliver s (issue s)) => 'published)
          (check-pair s 3 1 1)
          (let (observations 0)
            (agentic-ai-lab-temporal-support-policy-host-enroll-clock! (scenario-policies s)
              (.o kind: 'temporal.monotonic-clock.v1
                  .observe: (lambda (self id)
                              (set! observations (+ observations 1))
                              (when (= observations 2) (revoke! s))
                              (at 2))))
            (check (current s) => #f)))))
    (yuanxu-test-case "multiOrgMissingAnchorTest"
      (let (s (setup-pair))
        (register-source! s design-source 2
          ":PROPERTIES:\n:ID: design\n:CONTRACT_ID: context.evidence-source.v1\n:CONTRACT_REVISION: 1\n:END:\n")
        (select-pair! s 2)
        (let ((host (scenario-host s)))
          (check (context-task-query! host (context-task-start! host)) => #f)
          (check (context-task-current host) => #f)
          (check (context-task-history host) => '())
          (check (length (cadr (context-query-history (scenario-queries s)))) => 2))))
    (yuanxu-test-case "worktreeOrgResolutionTest"
      (let* ((s (setup-worktree)) (loader (worktree-loader s "g1" (lambda () "g1"))))
        (let ((gitops (.ref WorktreeFeatures 'gitops))
              (context (.ref WorktreeFeatures 'ai-agentic-context)))
          (check (eq? (.ref context 'start-task!) context-task-start!) => #t)
          (check (eq? (car (object-supers (.ref context 'worktree-context)))
                      (.ref gitops 'worktree-prototype)) => #t))
        (check ((.ref loader 'forced-scopes)) => '())
        (check (select-worktree! s loader) => #t)
        (check ((.ref loader 'forced-scopes)) => '(worktrees/gc-owner-fix org/findings org/design))
        (let* ((item (issue s))
               (member (car (cadr (context-query-history (scenario-queries s)))))
               (reference (.ref (context-query-lineage member) 'semantic-digest))
               (partial (.o query-digest: reference)))
          (check (deliver s item (delivery-query item) (search-observation (delivery-ticket item) partial))
                 => 'unbound)
          (check (current s) => #f)
          (check (deliver s item) => 'published)
          (register-source! s "A/unrelated.org" 1)
          (check-pair s 1 1 1)
          (check (select-worktree! s loader) => #t)
          (check-pair s 1 1 1))))
    (yuanxu-test-case "worktreeTaskRootSelectionTest"
      (let* ((s (setup-worktree))
             (loader (worktree-loader s "g1" (lambda () "g1") '(org design) '(design))))
        (check (select-worktree! s loader) => #t)
        (check ((.ref loader 'forced-scopes)) => '(worktrees/gc-owner-fix org/design))
        (check (deliver s (issue s)) => 'published)
        (let (query (.ref (current s) 'query))
          (check (.ref (context-query-lineage query) 'source) => design-source)
          (check (.ref query 'origin) => #f))))
    (yuanxu-test-case "worktreeOriginalRepinTest"
      (let* ((s (setup-worktree)) (loader (worktree-loader s "g1" (lambda () "g1"))))
        (check (select-worktree! s loader) => #t)
        (check (deliver s (issue s)) => 'published)
        (let (late (issue s))
          (register-source! s design-source 2 original-text)
          (check (current s) => #f)
          (check (deliver s late) => 'historical)
          (check (select-worktree! s loader) => #f)
          (check (context-task-start! (scenario-host s)) => #f)
          (register-source! s (scenario-source s) 2 (derived-text 2))
          (check (deliver s (issue s)) => 'published)
          (check-pair s 3 2 2))))
    (yuanxu-test-case "worktreeModuleVersionTest"
      (let* ((s (setup-worktree)) (generation "g1")
             (loader (worktree-loader s generation (lambda () generation))))
        (check (bind-worktree! s (lambda () (.ref loader 'owner))) => #t)
        (check (deliver s (issue s)) => 'published)
        (let (late (issue s))
          (set! generation "g2")
          (check (current s) => #f)
          (check (deliver s late) => 'historical)
          (check (context-task-start! (scenario-host s)) => #f)
          (set! loader (worktree-loader s generation (lambda () generation)))
          (check (current s) => #f)
          (let (fresh (issue s))
            (check (deliver s late) => 'unbound)
            (check (deliver s fresh) => 'published))
          (check-pair s 3 1 1)
          (check (deliver s late) => 'unbound)
          (check-pair s 3 1 1))))
    (yuanxu-test-case "worktreeOriginDeclarationEditTest"
      (let* ((s (setup-worktree)) (loader (worktree-loader s "g1" (lambda () "g1"))))
        (check (select-worktree! s loader) => #t)
        (check (deliver s (issue s)) => 'published)
        (let (late (issue s))
          (register-source! s (scenario-source s) 2 source-text)
          (check (current s) => #f)
          (check (deliver s late) => 'historical)
          (check (deliver s (issue s)) => 'published)
          (let (query (.ref (current s) 'query))
            (check (.ref query 'origin) => #f)
            (check (.ref (context-query-lineage query) 'generation) => 2))
          (check ((.ref loader 'forced-scopes)) => '(worktrees/gc-owner-fix org/findings org/design)))))
    (yuanxu-test-case "worktreeFeatureTaskRootRefreshTest"
      (let* ((s (setup-worktree)) (generation "g1")
             (loader (worktree-loader s generation (lambda () generation)))
             (feature (.ref WorktreeFeatures 'ai-agentic-context))
             (start (.ref feature 'start-task!)))
        (check (bind-worktree! s (lambda () (.ref loader 'owner))) => #t)
        (check (deliver s (evaluate s (start (scenario-host s)))) => 'published)
        (check-pair s 1 1 1)
        (set! generation "g2")
        (set! loader (worktree-loader s generation (lambda () generation) '(org design) '(design)))
        (check ((.ref loader 'forced-scopes)) => '())
        (check (current s) => #f)
        (check ((.ref loader 'forced-scopes)) => '())
        (check (deliver s (evaluate s (start (scenario-host s)))) => 'published)
        (check ((.ref loader 'forced-scopes)) => '(worktrees/gc-owner-fix org/design))
        (let ((published (current s)))
          (check (.ref published 'request) => 2)
          (check (.ref (context-query-lineage (.ref published 'query)) 'source) => design-source))))
    (yuanxu-test-case "workDependencyRefreshTest" (check-feature-dependency-refresh 'work))
    (yuanxu-test-case "worktrunkDependencyRefreshTest" (check-feature-dependency-refresh 'worktrunk))
    (yuanxu-test-case "workLateReceiptDuringReplacementTest"
      (check-feature-dependency-refresh 'work 'while-pending))
    (yuanxu-test-case "worktrunkLateReceiptAfterReplacementTest"
      (check-feature-dependency-refresh 'worktrunk 'after-publication))
    (yuanxu-test-case "multipleSupersededReceiptsTest"
      (let* ((s (setup))
             (first (issue s)))
        (select! s "router-1" "search-2")
        (let (second (issue s))
          (select! s "router-1" "search-3")
          (let (fresh (issue s))
            (check (deliver s second) => 'historical)
            (check (deliver s fresh) => 'published)
            (check (deliver s first) => 'historical)
            (check (deliver s second) => 'unbound)
            (check-current s 3 1)
            (check (map (lambda (row) (.ref row 'request))
                        (context-task-history (scenario-host s)))
                   => '(2 3 1 #f))))))
    (yuanxu-test-case "supersededCancellationTest"
      (let* ((s (setup)) (host (scenario-host s)) (late (issue s)))
        (select! s "router-1" "search-2")
        (let (fresh (issue s))
          (check (context-task-cancel! host (delivery-ticket late)) => #t)
          (check (context-task-cancel! host (delivery-ticket late)) => #f)
          (check (deliver s late) => 'unbound)
          (check (deliver s fresh) => 'published)
          (check-current s 2 1))))
    (yuanxu-test-case "supersededUnevaluatedTest"
      (let* ((s (setup)) (host (scenario-host s)) (old (context-task-start! host)))
        (select! s "router-1" "search-2")
        (let (fresh (issue s))
          (check (context-task-query! host old) => #f)
          (check (context-task-cancel! host old) => #f)
          (check (deliver s fresh) => 'published)
          (check-current s 2 1))))
    (yuanxu-test-case "unselectedGitOpsDependencyTest"
      (let* ((s (setup-worktree))
             (reads 0)
             (on-trunk-read (lambda () (set! reads (+ reads 1))))
             (trunk (feature-loader 'worktrunk "t1" '(findings) on-trunk-read))
             (unselected (feature-dependency 'worktrunk (lambda () trunk)))
             (work (feature-loader 'work "w1" '(design)))
             (loader (worktree-loader s "g1" (lambda () "g1") '(org design) '()
                                      (feature-dependency 'work (lambda () work)) #f unselected)))
        (check (select-worktree! s loader) => #t)
        (check (deliver s (issue s)) => 'published)
        (set! trunk (feature-loader 'worktrunk "t2" '(findings) on-trunk-read))
        (check (published-versions (current s)) => '((work "work" "w1")))
        (check ((.ref loader 'forced-scopes)) => '(worktrees/gc-owner-fix org/design))
        (check reads => 0)))
    (yuanxu-test-case "worktreeOriginAliasSubstitutionTest"
      (let* ((s (setup-worktree))
             (loader (worktree-loader s "g1" (lambda () "g1") '(org other))))
        (register-source! s "A/other-design.org" 1 original-text)
        (register-grant! s "other-read" 1 "A/other-design.org")
        (check-exception (select-worktree! s loader) true)
        (check (context-task-start! (scenario-host s)) => #f)
        (check (current s) => #f)))))
