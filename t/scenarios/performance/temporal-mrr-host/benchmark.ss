((benchmarkKind . scenario-e2e)
 (max_total . 900ms)
 (target_total . 500ms)
 (regression_budget . 400ms)
 (expected_over_input_budget . 0us)
 (sampleCount . 20)
 (targetRationale . "Measure complete installed Rust/runtime MRR admission scenario including fresh process and thread-affine Scheme lifetime; not a kernel throughput claim.")
 (unit . "us")
 (sourcePath . "t/qualification/temporal-mrr-host/runtime-test.ss")
 (rule . GERBIL-SCHEME-AGENT-R031)
 (feature . temporal-mrr-host)
 (optimizationFocus . "runtime typed handoff and bounded Scheme datum ABI")
 (inputShape . "two MRR event/position rows plus identity, receipt and duplicate negative controls")
 (expectedOutcome . "MRR owner re-admission and POO classification pass in every process")
 (expectedRepair . "repair owner admission, transport or lifetime without weakening evidence checks")
 (baseline . "complete runtime scenario")
 (candidate . "typed MRR values and Scheme ABI v2")
 (measurementPhases candidate-evaluation assert-semantic-gate assert-time-gate)
 (tags temporal mrr runtime scheme performance))
