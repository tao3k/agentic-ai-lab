(import (only-in "./main.ss" selected-governance)
        (only-in "./init.ss" yuanxu-governance-consumer.init.exports)
        (only-in :clan/poo/object .get .all-slots .ref/cached .cc .o)
        (only-in :yuanxu/module-system/source/admission current-module-source-observer))
(export verify-governance-use)
(def (verify-governance-use)
  (def declarations '())
  (def factories '())
  (def (observe key _amount)
    (when (pair? key)
      (case (car key)
        ((publication-start) (set! declarations (cons (cadr key) declarations)))
        ((link-stage-start)
         (let (stage (cadr key))
           (when (and (pair? stage) (eq? (car stage) 'scope-factory))
             (set! factories (cons (cadr stage) factories))))))))
  (def modules
    (parameterize ((current-module-source-observer observe))
      (.get yuanxu-governance-consumer.init.exports modules)))
  (unless (equal? (parameterize ((current-module-source-observer observe)) (.all-slots modules))
                  '(governance))
    (error "unselected Lab module was exposed"))
  (unless (and (null? declarations) (null? factories) (not (.ref/cached modules 'governance)))
    (error "Governance was forced before the first business read"))
  (def started (real-time))
  (def scope (parameterize ((current-module-source-observer observe)) (selected-governance)))
  (displayln "LAB-GOVERNANCE-FIRST-GET seconds=" (- (real-time) started))
  (unless (and (parameterize ((current-module-source-observer observe)) (eq? scope (selected-governance)))
               (equal? factories '(governance))
               (= (length declarations) 1)
               (string-suffix? "/modules/governance/interface.ss" (car declarations))
               (eq? (.get scope library) 'agentic-ai-lab/modules/governance/interface))
    (error "Governance demand differed from the selected closure" declarations factories))
  (def profile
    (.cc (.get scope Profile)
         identity: "lab/downstream-release" revision: "1" owner: "downstream"))
  (def context (.o request: 'release))
  (def assessment ((.get scope evaluate) profile context))
  (unless (and (eq? (.get assessment kind) 'agentic-ai-lab.governance-assessment)
               (equal? (.get assessment profile-identity) "lab/downstream-release")
               (eq? (.get assessment context) context)
               (null? (.get assessment unresolved-threats))
               (.get assessment handoff-ready?)
               (eq? (.get assessment runtime-executed?) #f))
    (error "Governance release assessment was not an inert handoff" assessment))
  (displayln "LAB-GOVERNANCE-USE-OK declarations=1 scopes=1 assessment=release-ready"))

(def (main) (verify-governance-use))
