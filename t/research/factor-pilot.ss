;;; Finite pilot only. Native proof admission and an independent scheduling oracle.
(import :std/encoding/json :std/error
        :gerbil-ascent/candidate/checked-program
        :gerbil-ascent/candidate/program
        :gerbil-ascent/candidate/provenance
        :gerbil-ascent/candidate/finite-evidence)
(export main)
(def (list-index pred xs)
  (let loop ((xs xs) (i 0)) (cond ((null? xs) #f) ((pred (car xs)) i) (else (loop (cdr xs) (+ i 1))))))
(def snapshot #f)
(def edges [])
(def arm "A")
(def atomic (make-hash-table))
(def packet #f)
(def (wire x)
  (cond ((symbol? x) (symbol->string x)) ((pair? x) (map wire x))
        ((vector? x) (map wire (vector->list x))) (else x)))
(def (proposal u v)
  `(candidate (relation path 2)
     (rule (path ?x ?y) (edge ?x ?y))
     (rule (path ?x ?z) (path ?x ?y) (edge ?y ?z))
     (query path ,u ,v) (limits 64 1024 2048)))
(def (certificate receipt)
  (let (p (reasoning-receipt-proof receipt))
    (hash ("kind" (if (null? (reasoning-receipt-rows receipt)) "checked-finite-absence" "checked-positive-dag"))
          ("finiteClosure" (wire (finite-evidence-closure (reasoning-stratified-evidence-finite (reasoning-receipt-stratified receipt)))))
          ("sourceDigest" (reasoning-snapshot-digest snapshot))
          ("candidateDigest" (reasoning-receipt-candidate-digest receipt))
          ("query" (wire (positive-proof-query p)))
          ("roots" (positive-proof-roots p))
          ("nodes" (map (lambda (n)
                    (hash ("id" (proof-node-id n)) ("kind" (wire (proof-node-kind n)))
                          ("relation" (wire (proof-node-relation n)))
                          ("row" (wire (proof-node-row n))) ("ruleOrSourceIndex" (wire (proof-node-label n)))
                          ("inputs" (proof-node-inputs n)))) (positive-proof-nodes p))))))
(def (admit p)
  (let* ((r (reasoning-attempt snapshot p 100000 100000))
         (positive (candidate-verify-positive-proof snapshot (candidate-inspect snapshot p)
                    (reasoning-receipt-candidate-digest r) (reasoning-receipt-status r)
                    (reasoning-receipt-rows r) (reasoning-receipt-proof r) 8192))
         (finite (reasoning-verify-finite-receipt r snapshot p 100000)))
    (unless (and (or (null? (reasoning-receipt-rows r)) positive) (eq? finite 'valid)) (error "proof admission failed" positive finite))
    r))
(def (factor u v)
  (unless (and (exact-integer? u) (exact-integer? v) (<= 0 u 6) (<= 0 v 6)) (error "job outside source scope"))
  (let* ((key (list u v)) (prior (hash-ref atomic key #f))
         (began (current-jiffy)) (hit #f) (fresh #f) (cert #f) (all #f)
         (value
          (cond
           ((and (string=? arm "D") packet)
            (unless (reasoning-receipt-bound? packet snapshot (proposal '?x '?y)) (error "stale fragment"))
            (set! hit #t) (and (member key (reasoning-receipt-rows packet)) #t))
           ((and (member arm '("B" "C")) prior)
            (when (string=? arm "C")
              (unless (reasoning-receipt-bound? (cadr prior) snapshot (caddr prior)) (error "stale atomic factor")))
            (set! hit #t) (car prior))
           (else
            (set! fresh #t)
            (let* ((p (if (string=? arm "D") (proposal '?x '?y) (proposal u v)))
                   (r (if (string=? arm "B") (reasoning-attempt snapshot p #f) (admit p)))
                   (answer (and (member key (reasoning-receipt-rows r)) #t)))
              (unless (eq? (reasoning-receipt-status r) 'complete) (error "incomplete native answer"))
              (unless (string=? arm "B") (set! cert (certificate r)))
              (when (string=? arm "D") (set! packet r) (set! all (reasoning-receipt-rows r)))
              (unless (string=? arm "A") (hash-put! atomic key (list answer r p)))
              answer)))))
    (hash ("claim" (list u v)) ("precedes" value) ("reused" hit)
          ("freshNativeSolve" fresh) ("checked" (not (string=? arm "B")))
          ("seconds" (exact->inexact (/ (- (current-jiffy) began) (jiffies-per-second))))
          ("sourceDigest" (reasoning-snapshot-digest snapshot))
          ("admittedCertificate" cert) ("derivedFactors" all))))
;;; Oracle uses only direct source constraints and integer arithmetic, never ASCENT closure.
(def (valid-order? order n)
  (and (list? order) (= (length order) n)
       (andmap exact-integer? order)
       (andmap (lambda (x) (= 1 (length (filter (cut = x <>) order)))) (iota n))
       (andmap (lambda (e)
                 (or (>= (car e) n) (>= (cadr e) n)
                     (< (list-index (cut = <> (car e)) order)
                        (list-index (cut = <> (cadr e)) order)))) edges)))
(def (objective order durations weights)
  (let loop ((xs order) (clock 0) (cost 0))
    (if (null? xs) cost
      (let (next (+ clock (list-ref durations (car xs))))
        (loop (cdr xs) next (+ cost (* next (list-ref weights (car xs)))))))))
(def (oracle durations weights)
  (let ((best #f) (feasible 0) (n (length durations)))
    (let visit ((prefix []) (remaining (iota n)))
      (if (null? remaining)
        (when (valid-order? prefix n)
          (set! feasible (+ feasible 1))
          (let (c (objective prefix durations weights))
            (when (or (not best) (< c best)) (set! best c))))
        (for-each (lambda (x) (visit (append prefix (list x)) (filter (lambda (y) (not (= x y))) remaining))) remaining)))
    (hash ("optimum" best) ("feasibleOrders" feasible) ("enumeratedOrders" (factorial n)))))
(def (factorial n) (if (= n 0) 1 (* n (factorial (- n 1)))))
(def (dispatch r)
  (case (string->symbol (hash-ref r "op"))
    ((init)
     (set! arm (hash-ref r "arm")) (unless (member arm '("A" "B" "C" "D")) (error "unknown arm"))
     (set! edges (hash-ref r "edges"))
     (set! snapshot (reasoning-source-snapshot (hash-ref r "identity") 0 (list (list 'edge 2 edges))))
     (set! atomic (make-hash-table)) (set! packet #f)
     (hash ("sourceDigest" (reasoning-snapshot-digest snapshot))))
    ((factor) (factor (hash-ref r "u") (hash-ref r "v")))
    ((explore)
     (let* ((prefix (hash-ref r "prefix")) (n (hash-ref r "n"))
            (remaining (filter (lambda (x) (not (member x prefix))) (iota n)))
            (ok (and (list? prefix) (= (+ (length prefix) (length remaining)) n)
                     (andmap (lambda (x) (and (exact-integer? x) (<= 0 x) (< x n))) prefix)
                     (andmap (lambda (e)
                        (or (>= (car e) n) (>= (cadr e) n) (not (member (cadr e) prefix))
                            (and (member (car e) prefix)
                                 (< (list-index (cut = <> (car e)) prefix)
                                    (list-index (cut = <> (cadr e)) prefix))))) edges))))
       (hash ("validPrefix" ok) ("depth" (length prefix))
             ("nextJobs" (if ok (filter (lambda (x)
                       (andmap (lambda (e) (or (not (= (cadr e) x)) (>= (car e) n)
                                              (member (car e) prefix))) edges)) remaining) [])))))
    ((evaluate grade)
     (let* ((ds (hash-ref r "durations")) (ws (hash-ref r "weights")) (order (hash-ref r "order"))
            (valid (valid-order? order (length ds)))
            (cost (and valid (objective order ds ws))))
       (if (string=? (hash-ref r "op") "grade")
         (let (gold (oracle ds ws))
           (hash ("valid" valid) ("objective" cost) ("oracle" gold)
                 ("gap" (and valid (- cost (hash-ref gold "optimum"))))
                 ("optimal" (and valid (= cost (hash-ref gold "optimum"))))))
         (hash ("valid" valid) ("objective" cost)))))
    ((cards)
     (hash ("facts" (map (lambda (k) (hash ("claim" k) ("precedes" (car (hash-ref atomic k))))) (hash-keys atomic)))
           ("derivedFactors" (and packet (reasoning-receipt-rows packet)))
           ("sourceDigest" (reasoning-snapshot-digest snapshot))))
    ((fault)
     (let* ((p (proposal 0 4)) (r (admit p))
            (changed (reasoning-source-snapshot "changed" 1 (list (list 'edge 2 [])))))
       (hash ("staleRejected" (not (candidate-verify-positive-proof changed (candidate-inspect snapshot p)
                                    (reasoning-receipt-candidate-digest r) 'complete
                                    (reasoning-receipt-rows r) (reasoning-receipt-proof r) 8192)))
             ("boundedRejected" (not (candidate-verify-positive-proof snapshot (candidate-inspect snapshot p)
                                      (reasoning-receipt-candidate-digest r) 'complete
                                      (reasoning-receipt-rows r) (reasoning-receipt-proof r) 1))))))
    (else (error "unknown operation"))))
(def (main . args)
  (let loop ()
    (let (line (read-line))
      (unless (eof-object? line)
        (let (answer (try
                     (dispatch (parameterize ((current-json-read-options (JSONReadOptions object-as-hash: #t)))
                                 (call-with-input-string line read-json)))
                     (catch (e) (hash ("error" (exception->string e))))))
          (display (json->string answer)) (newline) (force-output))
        (loop)))))
