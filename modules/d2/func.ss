(import (only-in :clan/poo/object .o .ref)
        (only-in :std/list/list delete-duplicates/hash)
        (only-in :gerbil-ascent/program/api gerbil-ascent-evaluate-program)
        "types.ss" "ascent.ss" "ascent-review.ss" "ascent-explanation.ss" "ascent-authoring.ss" "ascent-scene.ss" "ascent-teaching.ss" "profiles/context-evolution.ss")
(export d2-infer d2-review d2-plan-explanation d2-author d2-scene d2-teaching d2-source d2-source-for-config
        ExperienceWindow. context-evolution-evaluate context-evolution-rows)
(def (d2-infer source-diagram)
  (unless (d2-diagram? source-diagram) (error "invalid POO D2 Diagram"))
  (let* ((ids (map (lambda (node) (.ref node 'identity)) (.ref source-diagram 'nodes)))
         (unique (let loop ((rest ids) (seen '()))
                   (cond ((null? rest) #t) ((memq (car rest) seen) #f)
                         (else (loop (cdr rest) (cons (car rest) seen)))))))
    (unless unique (error "duplicate D2 Node identity")))
  (let* ((inference (gerbil-ascent-evaluate-program (d2-graph-program source-diagram)))
         (rows (.ref inference 'rows-of)))
    (unless (null? (rows 'MissingNode)) (error "D2 relation has an undeclared endpoint" (rows 'MissingNode)))
    (.o diagram: source-diagram nodes: (rows 'VisualNode) relations: (rows 'VisualEdge)
        cycle-members: (rows 'CycleMember))))

;;; D2 is the output syntax. Only serialize admitted derived rows;
;;; this projection neither repeats graph traversal nor writes files.
(def (quoted value port) (write (if (symbol? value) (symbol->string value) value) port))
(def (row<? a b)
  (string<? (call-with-output-string "" (lambda (p) (write a p)))
            (call-with-output-string "" (lambda (p) (write b p)))))
(def (d2-source-for-config config-value)
  (let (direction (.ref config-value 'direction))
    (unless (memq direction '(right left up down)) (error "invalid D2 layout direction" direction))
    (lambda (view) (d2-source view direction))))
(def (d2-source view (direction 'right))
  (call-with-output-string ""
    (lambda (port)
      (display "# ASCENT Scheme projection; no layout coordinates.\ndirection: " port)
      (display direction port) (newline port)
      (display "classes: {\n" port)
      (for-each (lambda (kind)
        (quoted kind port) (display ": {}\n" port))
        (list-sort (lambda (a b) (string<? (symbol->string a) (symbol->string b)))
          (delete-duplicates/hash (map cadr (.ref view 'nodes)))))
      (display "}\n" port)
      (for-each (lambda (row)
        (quoted (car row) port) (display ": " port) (quoted (caddr row) port)
        (display " {class: " port) (quoted (cadr row) port) (display "}\n" port))
        (list-sort row<? (.ref view 'nodes)))
      (for-each (lambda (row)
        (quoted (car row) port) (display " -> " port) (quoted (cadr row) port)
        (display ": " port) (quoted (caddr row) port) (newline port))
        (list-sort row<? (.ref view 'relations))))))
