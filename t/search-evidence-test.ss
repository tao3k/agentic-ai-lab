(import :std/test (only-in :clan/poo/object .ref)
        :agentic-ai-lab/modules/search-engine/interface)
(export search-evidence-test)
(def (stage name input output)
  (agentic-ai-lab-search-stage name 'search '() input output agentic-ai-lab-search-acquisition-role))
(def a (stage 'a 'source 'candidates))
(def b (stage 'b 'source 'candidates))
(def branches (agentic-ai-lab-search-parallel 'branches (list a b)))
(def c (stage 'c (agentic-ai-lab-search-node-output-domain branches) 'results))
(def strategy (agentic-ai-lab-search-strategy 'search (agentic-ai-lab-search-merge 'join branches c) '()))
(def (initial)
  (agentic-ai-lab-search-engine-require-evidence
   (agentic-ai-lab-search-engine strategy "generation" "configuration" "cut")))
(def (reject? thunk) (with-catch (lambda (_) #t) (lambda () (thunk) #f)))
(def (event factor id position parents . cut)
  (agentic-ai-lab-search-factor-observation id "generation" factor "candidate" position
    (if (null? cut) "cut" (car cut)) parents 'derived #t))
(def (observe engine name observation)
  (let (issued (agentic-ai-lab-search-engine-issue engine name))
    (agentic-ai-lab-search-engine-observe (.ref issued 'engine) name (.ref issued 'request) observation)))
(def (parents-done)
  (observe (observe (initial) 'b (event b "B" 1 '())) 'a (event a "A" 2 '())))
(def search-evidence-test
  (test-suite "Search Engine Temporal evidence"
    (test-case "input snapshots are current and cannot mutate retained evidence"
      (let* ((issued (agentic-ai-lab-search-engine-issue (parents-done) 'c))
             (next (.ref issued 'engine)) (request (.ref issued 'request))
             (inputs (agentic-ai-lab-search-engine-inputs next 'c request)))
        (check (map (lambda (input) (.ref input 'identity)) inputs) => '("A" "B"))
        (string-set! (.ref (car inputs) 'identity) 0 #\Z)
        (string-set! (.ref (car inputs) 'payload-identity) 0 #\X)
        (string-set! (.ref (.ref (car inputs) 'observation) 'provenance-identity) 0 #\Y)
        (check (map (lambda (input) (.ref input 'identity))
                    (agentic-ai-lab-search-engine-inputs next 'c request)) => '("A" "B"))
        (check (.ref (.ref (agentic-ai-lab-search-engine-node next 'a) 'evidence) 'payload-identity)
               => "candidate")
        (check (agentic-ai-lab-search-engine-frontier
                 (agentic-ai-lab-search-engine-observe next 'c request (event c "C" 3 '("A" "B"))))
               => '())
        (check (reject? (lambda ()
          (agentic-ai-lab-search-engine-inputs
            (agentic-ai-lab-search-engine-revise next '(a) "cut2") 'c request))) => #t)))
    (test-case "roots have no fabricated inputs and identity-only sessions reject input reads"
      (let* ((issued (agentic-ai-lab-search-engine-issue (initial) 'a))
             (next (.ref issued 'engine)) (request (.ref issued 'request)))
        (check (agentic-ai-lab-search-engine-inputs next 'a request) => '())
        (check (reject? (lambda ()
          (agentic-ai-lab-search-engine-inputs
            (agentic-ai-lab-search-engine-cancel next 'a request) 'a request))) => #t))
      (let* ((issued (agentic-ai-lab-search-engine-issue
                      (agentic-ai-lab-search-engine strategy "generation" "configuration" "cut") 'a)))
        (check (reject? (lambda ()
          (agentic-ai-lab-search-engine-inputs (.ref issued 'engine) 'a (.ref issued 'request)))) => #t)))
    (test-case "observed fan-in follows causal evidence rather than arrival order"
      (let* ((done (parents-done)) (joined (observe done 'c (event c "C" 3 '("B" "A")))))
        (check (agentic-ai-lab-search-engine-frontier done) => '(c))
        (check (agentic-ai-lab-search-engine-frontier joined) => '())
        (check (.ref (.ref (agentic-ai-lab-search-engine-node joined 'c) 'evidence)
                     'causal-parent-identities) => '("B" "A"))))
    (test-case "declared edges cannot replace missing or foreign observed parents"
      (let* ((issued (agentic-ai-lab-search-engine-issue (parents-done) 'c))
             (next (.ref issued 'engine)) (request (.ref issued 'request)))
        (for-each (lambda (parents)
                    (check (reject? (lambda ()
                      (agentic-ai-lab-search-engine-observe next 'c request (event c "C" 3 parents)))) => #t))
                  '(("A") ("A" "foreign") ("A" "A")))))
    (test-case "wrong source stage and uncommitted evidence cannot settle an attempt"
      (let* ((issued (agentic-ai-lab-search-engine-issue (initial) 'a))
             (next (.ref issued 'engine)) (request (.ref issued 'request)))
        (for-each (lambda (observation)
          (check (reject? (lambda ()
            (agentic-ai-lab-search-engine-observe next 'a request observation))) => #t))
          (list (event a "A" 1 '() "old-cut") (event b "B" 1 '())
                (agentic-ai-lab-search-factor-observation "H" "generation" a "candidate" 1
                  "cut" '() 'hypothesized #f)))))
    (test-case "causal parents must strictly precede their observed child"
      (let* ((issued (agentic-ai-lab-search-engine-issue (parents-done) 'c))
             (next (.ref issued 'engine)) (request (.ref issued 'request)))
        (check (reject? (lambda ()
          (agentic-ai-lab-search-engine-observe next 'c request (event c "C" 2 '("A" "B"))))) => #t)))
    (test-case "revision clears dependent evidence and retains independent observations"
      (let* ((done (observe (parents-done) 'c (event c "C" 3 '("A" "B"))))
             (revised (agentic-ai-lab-search-engine-revise done '(a) "cut2"))
             (fresh (observe revised 'a (event a "A2" 4 '() "cut2")))
             (joined (observe fresh 'c (event c "C2" 5 '("A2" "B") "cut2"))))
        (check (.ref (agentic-ai-lab-search-engine-node revised 'a) 'evidence) => #f)
        (check (.ref (agentic-ai-lab-search-engine-node revised 'c) 'evidence) => #f)
        (check (eq? (agentic-ai-lab-search-engine-node done 'b)
                    (agentic-ai-lab-search-engine-node revised 'b)) => #t)
        (check (agentic-ai-lab-search-engine-frontier joined) => '())))
    (test-case "revision cannot reuse an admitted event identity"
      (let* ((done (observe (initial) 'a (event a "A" 1 '())))
             (revised (agentic-ai-lab-search-engine-revise done '(a) "cut2"))
             (issued (agentic-ai-lab-search-engine-issue revised 'a))
             (next (.ref issued 'engine)) (request (.ref issued 'request)))
        (check (reject? (lambda ()
          (agentic-ai-lab-search-engine-observe next 'a request (event a "A" 2 '() "cut2")))) => #t)
        (let (fresh (agentic-ai-lab-search-engine-observe next 'a request (event a "A2" 2 '() "cut2")))
          (check (.ref fresh 'event-identities) => '("A2" "A")))))
    (test-case "rejected observations do not reserve identities or settle work"
      (let* ((issued (agentic-ai-lab-search-engine-issue (initial) 'a))
             (next (.ref issued 'engine)) (request (.ref issued 'request)))
        (check (reject? (lambda ()
          (agentic-ai-lab-search-engine-observe next 'a request (event a "A" 1 '() "wrong")))) => #t)
        (check (.ref next 'event-identities) => '())
        (let* ((done (agentic-ai-lab-search-engine-observe next 'a request (event a "A" 1 '())))
               (revised (agentic-ai-lab-search-engine-revise done '(a) "cut"))
               (fresh (agentic-ai-lab-search-engine-issue revised 'a))
               (fresh-engine (.ref fresh 'engine)))
          (check (.ref revised 'event-identities) => '("A"))
          (check (.ref (agentic-ai-lab-search-engine-cancel fresh-engine 'a (.ref fresh 'request))
                       'event-identities) => '("A")))))
    (test-case "evidence contract rejects identity-only completion and snapshots events"
      (let* ((issued (agentic-ai-lab-search-engine-issue (initial) 'a))
             (next (.ref issued 'engine)) (request (.ref issued 'request))
             (identity (string-copy "A"))
             (observation (event a identity 1 '()))
             (done (agentic-ai-lab-search-engine-observe next 'a request observation)))
        (check (reject? (lambda () (agentic-ai-lab-search-engine-complete next 'a request))) => #t)
        (check (reject? (lambda () (agentic-ai-lab-search-engine-require-evidence next))) => #t)
        (string-set! identity 0 #\Z)
        (check (.ref (.ref (agentic-ai-lab-search-engine-node done 'a) 'evidence) 'identity) => "A")))))
