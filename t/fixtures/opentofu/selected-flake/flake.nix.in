{
  # Package setup reuses the repository's locked Git package-set input.
  inputs.nixpkgs = { url = "@PACKAGE_SET@"; flake = false; };
  outputs = { self, nixpkgs }:
    let pkgs = import nixpkgs { system = "aarch64-darwin"; };
    in {
      lib.providerArtifacts = import ./lib/selected-provider-artifacts-flake.nix {
        inherit pkgs;
        schemas = import ./providers.nix { inherit pkgs; };
      };
    };
}
