{
  "name": "@poo-flow/context-diagrams",
  "private": true,
  "type": "module",
  "scripts": {
    "render": "bun run render.ts",
    "context": "bun run render.ts --example context",
    "temporal": "bun run render.ts --example temporal",
    "evolution": "bun run render.ts --example evolution",
    "window": "bun run render.ts --example window-evolution",
    "reuse": "bun run reuse.ts",
    "ascent": "cd ../.. && just d2-export && cd dev/d2 && bun run render.ts --example ascent-early && bun run render.ts --example ascent-later",
    "session": "bun run render.ts --example session",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@deterministic-engineering/render": "git+https://github.com/hardenedlinux/deterministic-engineering.git#1fe20380441a0cd85055695c2adcc55ce699a369",
    "@openmbee/opensysml": "0.11.0",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.11"
  }
}
