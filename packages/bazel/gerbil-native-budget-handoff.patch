diff --git a/gerbil/native_environment.bzl b/gerbil/native_environment.bzl
new file mode 100644
index 0000000..60b1c28
--- /dev/null
+++ b/gerbil/native_environment.bzl
@@ -0,0 +1,40 @@
+"""Export pinned native identities while preserving invocation-owned budgets."""
+
+def _shell_quote(value):
+    return "'{}'".format(value.replace("'", "'\"'\"'"))
+
+def native_environment_exports(environment):
+    """Keep runtime leases across nested tools; pin compiler relocation last."""
+    lines = []
+    for key in sorted(environment.keys()):
+        value = _shell_quote(environment[key])
+        if key == "GERBIL_BUILD_CORES":
+            # A resource guard has already admitted its child concurrency.
+            # The repository snapshot supplies only the unset default.
+            lines.extend([
+                "if [[ ${GERBIL_BUILD_CORES+x} != x ]]; then",
+                "  export GERBIL_BUILD_CORES={}".format(value),
+                "fi",
+            ])
+        elif key == "GAMBOPT" and environment.get("GERBIL_HOME", ""):
+            home = environment["GERBIL_HOME"]
+            mappings = "~~={},~~bin={}/bin,~~lib={}/lib".format(home, home, home)
+            # Heap/debug options belong to this invocation. Native paths still
+            # win over foreign ambient mappings; repeated tools do not grow
+            # an already canonical trailing mapping group.
+            lines.extend([
+                "if [[ ${GAMBOPT+x} == x ]]; then",
+                "  gerbil_native_mappings={}".format(_shell_quote(mappings)),
+                '  case "$GAMBOPT" in',
+                '    "$gerbil_native_mappings"|*",$gerbil_native_mappings") ;;',
+                '    *) GAMBOPT="${GAMBOPT:+${GAMBOPT},}${gerbil_native_mappings}" ;;',
+                "  esac",
+                "  export GAMBOPT",
+                "  unset gerbil_native_mappings",
+                "else",
+                "  export GAMBOPT={}".format(value),
+                "fi",
+            ])
+        else:
+            lines.append("export {}={}".format(key, value))
+    return "\n".join(lines)
