module GitOps_none {
  import WorktreeGitOps(BUG = "none").* from "./37-worktree-gitops"
  run actualPathTest = initWith(0).then(composePolicy).then(project).then(admit).then(execute)
    .then(returnReceipt(false, 1, 11)).then(consume).expect(safety and s.accepted and s.boundPath == 11)
  run restrictTest = initWith(1).then(composePolicy).expect(s.provider == 1)
  run fallbackTest = initWith(2).then(composePolicy).expect(s.provider == 1)
  run unavailableTest = initWith(4).then(composePolicy).then(deny).expect(s.phase == 6 and not(s.executed))
  run dispatchRaceTest = initWith(0).then(composePolicy).then(project).then(admit)
    .then(changeSource).then(refuse).expect(safety and not(s.executed))
  run staleResultTest = initWith(0).then(composePolicy).then(project).then(admit).then(execute)
    .then(changePolicy).then(returnReceipt(false, 1, 11)).then(retainOnly)
    .expect(safety and s.receipt and not(s.accepted))
  run foreignResultTest = initWith(0).then(composePolicy).then(project).then(admit).then(execute)
    .then(returnReceipt(true, 1, 11)).then(retainOnly).expect(safety and not(s.accepted))
  run failureTest = initWith(0).then(composePolicy).then(project).then(admit).then(execute)
    .then(returnReceipt(false, 2, 10)).then(retainOnly).expect(safety and not(s.accepted))
  run ambiguousTest = initWith(0).then(composePolicy).then(project).then(admit).then(execute)
    .then(returnReceipt(false, 3, 10)).then(retainOnly).expect(safety and not(s.accepted))
  run revokeAfterUseTest = initWith(0).then(composePolicy).then(project).then(admit).then(execute)
    .then(returnReceipt(false, 1, 11)).then(consume).then(revoke)
    .expect(safety and s.acceptCount == 1 and s.receipt and not(s.accepted))
  run duplicateTest = initWith(0).then(composePolicy).then(project).then(admit).then(execute)
    .then(returnReceipt(false, 1, 11)).then(consume).then(duplicate).expect(safety and s.acceptCount == 1)
  run gitFallbackExecutionTest = initWith(2).then(composePolicy).then(project).then(admit).then(execute)
    .then(returnReceipt(false, 1, 10)).then(consume).expect(safety and s.accepted and s.provider == 1)
  run projectionRaceTest = initWith(0).then(composePolicy).then(changeSource).then(project)
    .then(refuse).expect(safety and not(s.executed))
  run staleSourceResultTest = initWith(0).then(composePolicy).then(project).then(admit).then(execute)
    .then(changeSource).then(returnReceipt(false, 1, 11)).then(retainOnly)
    .expect(safety and s.receipt and not(s.accepted))
  run beforeComposeRaceTest = initWith(0).then(changeSource).then(composePolicy).then(project)
    .then(refuse).expect(safety and s.capturedSource == 0 and not(s.executed))
  run providerMismatchTest = initWith(0).then(composePolicy).then(project).then(admit).then(execute)
    .then(returnOtherProvider).then(retainOnly).expect(safety and s.receipt and not(s.accepted))
}
