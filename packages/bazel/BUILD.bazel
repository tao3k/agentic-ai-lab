# These are the Parser APIs consumed by this product and its Orgize dependency,
# not a list of transitive implementation files or all upstream language cases.
gerbil_dependency_entry(
    name = "parser_dependency_build",
    source_build = "@gerbil_parser_sources//:build_script",
    entry_modules = [
        # Orgize's public event-tape binding consumes Parser artifact values.
        "artifact-support.ss",
        "compiler-build-support.ss",
        "event-fold-build-support.ss",
        "event-fold-program-support.ss",
        "graph-projection-support.ss",
        "graph-query-support.ss",
        "language-support.ss",
        "language-support/grammar.ss",
        "rust-runtime-event-support.ss",
        "rust-runtime-support.ss",
        "rust-syntax-support.ss",
        "text-support.ss",
        "src/build-support/compiler-profile.ss",
        "src/compiler/event-fold-runtime.ss",
        "src/compiler/event-fold-scheme-build.ss",
        "src/compiler/event-fold-scheme-modules.ss",
        "src/runtime/machine.ss",
        "src/compiler/rust-pure-aot.ss",
        "src/compiler/rust-syntax.ss",
        "src/language/descriptor.ss",
        "graph-syntax-support.ss",
        "src/declarations.ss",
        "src/runtime/artifact.ss",
    ],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "parser_dependency_entry_test",
    size = "small",
    timeout = "short",
    srcs = ["parser-dependency-entry-test.sh"],
    args = [
        "$(location @local_gerbil//:gxi)",
        "$(location :parser-dependency-entry-check.ss)",
        "$(location :parser_dependency_build)",
        "$(location @orgize_sources//:build_script)",
        "$(location @gerbil_parser_sources//:build_script)",
        "$(location //:gerbil.pkg)",
    ],
    data = [
        ":parser-dependency-entry-check.ss",
        ":parser_dependency_build",
        "@local_gerbil//:gxi",
        "@orgize_sources//:build_script",
        "@gerbil_parser_sources//:build_script",
        "//:gerbil.pkg",
        "@orgize_sources//:sources",
        "@gerbil_parser_sources//:sources",
        "//:gerbil_package_sources",
    ],
)

# The consumer needs Scheme APIs, not upstream standalone C ABI executables.
# API roots are direct imports; Core discovers their actual transitive closure.
gerbil_dependency_entry(
    name = "ascent_dependency_build",
    source_build = "@gerbil_ascent_sources//:build_script",
    compiler_options_module = "@gerbil_ascent_sources//:build-modules.ss",
    compiler_options_binding = "gerbil-ascent-compiler-options",
    entry_modules = [
        "candidate/checked-program.ss",
        "candidate/datum.ss",
        "candidate/finite-evidence.ss",
        "candidate/funs.ss",
        "candidate/program.ss",
        "candidate/provenance.ss",
        "candidate/types.ss",
        "interface/engine-api.ss",
        "program/interface.ss",
        "program/session.ss",
        "rules/declaration.ss",
        "rules/interface.ss",
        "temporal/lens.ss",
    ],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "ascent_dependency_entry_test",
    size = "small",
    timeout = "short",
    srcs = ["parser-dependency-entry-test.sh"],
    args = [
        "$(location @local_gerbil//:gxi)",
        "$(location :parser-dependency-entry-check.ss)",
        "$(location :ascent_dependency_build)",
        "-",
        "$(location @gerbil_ascent_sources//:build_script)",
        "$(location //:gerbil.pkg)",
        ":gerbil-ascent/",
    ],
    data = [
        ":parser-dependency-entry-check.ss",
        ":ascent_dependency_build",
        "@local_gerbil//:gxi",
        "@gerbil_ascent_sources//:sources",
        "@gerbil_ascent_sources//:build_script",
        "//:gerbil.pkg",
        "//:gerbil_package_sources",
    ],
)
