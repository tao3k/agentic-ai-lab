(import :std/test
        :agentic-ai-lab/modules/evidence-assessment/candidate/evidence-store
        (only-in :gerbil-ascent/candidate/checked-program reasoning-source-snapshot))
(export ascent-evidence-store-test)
(def (field name answer) (cadr (assq name answer)))
(def candidate
  '(candidate (relation path 2) (relation ready 1)
     (rule (path ?x ?y) (edge ?x ?y))
     (rule (path ?x ?z) (path ?x ?y) (edge ?y ?z))
     (rule (ready ?f) (need ?f ?u ?v ?x ?y) (path ?u ?v) (path ?x ?y))
     (query ready ?f) (limits 16 128 128)))
(def (source (generation 0) (edges '((0 1) (1 2) (3 4))))
  (reasoning-source-snapshot 'search generation
    (list (list 'edge 2 edges) (list 'need 5 '((0 0 2 3 4) (1 0 2 4 3))))))
(def ascent-evidence-store-test
  (test-suite "native evidence store and deterministic obligations"
    (test-case "Fact fragments close over shared support and reject stale generations"
      (let* ((store (reasoning-open-evidence-store)) (snapshot (source))
             (answer (reasoning-resolve-evidence store snapshot candidate)) (h (field 'handle answer))
             (a (reasoning-evidence-fragment store snapshot candidate h '(path 0 2)))
             (b (reasoning-evidence-fragment store snapshot candidate h '(ready 0)))
             (nodes (field 'nodes b)))
        (check-equal? (field 'status a) 'verified)
        (check-equal? (field 'status b) 'verified)
        (for-each (lambda (n)
                    (check-equal? (and (assoc (car n) nodes) #t) #t)
                    (for-each (lambda (id) (check-equal? (and (assoc id nodes) #t) #t))
                              (list-ref n 5))) (field 'nodes a))
        (for-each (lambda (n) (for-each (lambda (id)
                     (check-equal? (and (assoc id nodes) #t) #t)) (list-ref n 5))) nodes)
        (check-equal? (field 'status (reasoning-evidence-fragment store (source 1) candidate h '(ready 0))) 'unknown)
        (check-equal? (field 'status (reasoning-evidence-fragment store snapshot candidate h '(path 4 3))) 'finite-absent)
        (check-equal? (field 'proof-builds (reasoning-evidence-store-stats store)) 1)))
    (test-case "one proof build across distinct branch paths; no model hint needed"
      (let* ((store (reasoning-open-evidence-store)) (snapshot (source))
             (a (reasoning-resolve-evidence store snapshot candidate))
             (b (reasoning-resolve-evidence store snapshot candidate)))
        (check-equal? (field 'status a) 'verified)
        (check-equal? (field 'reused a) #f)
        (check-equal? (field 'reused b) #t)
        (check-equal? (field 'handle a) (field 'handle b))
        (check-equal? (field 'proof-builds (reasoning-evidence-store-stats store)) 1)
        (check-equal? (field 'hits (reasoning-evidence-store-stats store)) 1)
        (let* ((h (field 'handle a))
               (left (reasoning-evidence-partition store snapshot candidate h '((10 ((ready 0))) (11 ((ready 1))))))
               (right (reasoning-evidence-partition store snapshot candidate h '((20 ((path 0 2) (path 3 4))) (21 ((path 4 3)))))))
          (check-equal? (field 'allowed left) '(10))
          (check-equal? (field 'pruned left) '(11))
          (check-equal? (field 'allowed right) '(20))
          (check-equal? (field 'pruned right) '(21))
          (check-equal? (field 'proof-builds (reasoning-evidence-store-stats store)) 1))))
    (test-case "concurrent callers share one serialized admitted build"
      (let* ((store (reasoning-open-evidence-store)) (snapshot (source))
             (a (thread-start! (make-thread (lambda () (reasoning-resolve-evidence store snapshot candidate)))))
             (b (thread-start! (make-thread (lambda () (reasoning-resolve-evidence store snapshot candidate)))))
             (left (thread-join! a)) (right (thread-join! b)))
        (check-equal? (field 'status left) 'verified)
        (check-equal? (field 'status right) 'verified)
        (check-equal? (field 'handle left) (field 'handle right))
        (check-equal? (field 'proof-builds (reasoning-evidence-store-stats store)) 1)
        (check-equal? (field 'hits (reasoning-evidence-store-stats store)) 1)))
    (test-case "generation, content and query changes refuse old handles"
      (let* ((store (reasoning-open-evidence-store)) (snapshot (source))
             (a (reasoning-resolve-evidence store snapshot candidate)) (h (field 'handle a))
             (changed (source 0 '((0 1) (3 4))))
             (revision (source 1)))
        (check-equal? (field 'status (reasoning-evidence-claim store changed candidate h '(0))) 'unknown)
        (check-equal? (field 'status (reasoning-evidence-claim store revision candidate h '(0))) 'unknown)
        (let (changed-answer (reasoning-resolve-evidence store changed candidate))
          (check-equal? (field 'status changed-answer) 'verified)
          (check-equal? (field 'status (reasoning-evidence-claim store changed candidate (field 'handle changed-answer) '(0))) 'finite-absent))
        (let (restricted '(candidate (relation path 2) (rule (path ?x ?y) (edge ?x ?y))
                            (query path 0 1) (limits 16 128 128)))
          (check-equal? (field 'status (reasoning-evidence-claim store snapshot restricted h '(0 1))) 'unknown))))
    (test-case "bounded evidence remains unresolved and is not cached as false"
      (let* ((store (reasoning-open-evidence-store 4 1 1)) (snapshot (source))
             (answer (reasoning-resolve-evidence store snapshot candidate))
             (partition (reasoning-evidence-partition store snapshot candidate #f '((10 ((ready 0))) (11 ((ready 1)))))))
        (check-equal? (field 'status answer) 'unknown)
        (check-equal? (field 'entries (reasoning-evidence-store-stats store)) 0)
        (check-equal? (field 'pruned partition) [])
        (check-equal? (field 'unresolved partition) '(10 11))
        (check-equal? (field 'allowed partition) '(10 11))))
    (test-case "individual intermediate Facts and shared support nodes are reusable"
      (let* ((store (reasoning-open-evidence-store)) (snapshot (source))
             (answer (reasoning-resolve-evidence store snapshot candidate)) (h (field 'handle answer))
             (a (reasoning-evidence-fact store snapshot candidate h '(path 0 2)))
             (b (reasoning-evidence-fact store snapshot candidate h '(path 0 2)))
             (partition (reasoning-evidence-partition store snapshot candidate h
                          '((10 ((path 0 2) (missing 7))) (11 ((path 4 3) (missing 7)))))))
        (check-equal? (field 'status a) 'verified)
        (check-equal? (pair? (field 'support-nodes a)) #t)
        (check-equal? (field 'support-nodes a) (field 'support-nodes b))
        (check-equal? (field 'status (reasoning-evidence-fact store snapshot candidate h '(missing 7))) 'unknown)
        (check-equal? (field 'allowed partition) '(10))
        (check-equal? (field 'unresolved partition) '(10))
        (check-equal? (field 'pruned partition) '(11))
        (check-equal? (field 'proof-builds (reasoning-evidence-store-stats store)) 1)))
    (test-case "constant and repeated query variables cannot authorize out-of-query absence"
      (let* ((store (reasoning-open-evidence-store)) (snapshot (source))
             (ground '(candidate (relation path 2) (rule (path ?x ?y) (edge ?x ?y))
                         (query path 0 1) (limits 16 128 128)))
             (same '(candidate (relation path 2) (rule (path ?x ?y) (edge ?x ?y))
                       (query path ?x ?x) (limits 16 128 128)))
             (a (reasoning-resolve-evidence store snapshot ground))
             (b (reasoning-resolve-evidence store snapshot same)))
        (check-equal? (field 'status (reasoning-evidence-claim store snapshot ground (field 'handle a) '(0 1))) 'verified)
        (check-equal? (field 'status (reasoning-evidence-claim store snapshot ground (field 'handle a) '(1 2))) 'unknown)
        (check-equal? (field 'status (reasoning-evidence-claim store snapshot same (field 'handle b) '(0 1))) 'unknown)
        (check-equal? (field 'status (reasoning-evidence-claim store snapshot same (field 'handle b) '(0 0))) 'finite-absent)))
    (test-case "published rows and certificates do not mutate the stored proof"
      (let* ((store (reasoning-open-evidence-store)) (snapshot (source))
             (answer (reasoning-resolve-evidence store snapshot candidate)) (h (field 'handle answer))
             (proof (reasoning-evidence-certificate store snapshot candidate h)))
        (set-car! (car (field 'rows answer)) 999)
        (set-car! (car (field 'nodes proof)) 999)
        (check-equal? (field 'rows (reasoning-resolve-evidence store snapshot candidate)) '((0)))
        (check-equal? (field 'status (reasoning-evidence-claim store snapshot candidate h '(0))) 'verified)
        (check-equal? (= (caar (field 'nodes (reasoning-evidence-certificate store snapshot candidate h))) 999) #f)))
    (test-case "eviction and clearing refuse references without reusing handle IDs"
      (let* ((store (reasoning-open-evidence-store 1)) (snapshot (source))
             (a (reasoning-resolve-evidence store snapshot candidate)) (h (field 'handle a)))
        (reasoning-resolve-evidence store (source 1) candidate)
        (check-equal? (field 'status (reasoning-evidence-certificate store snapshot candidate h)) 'unknown)
        (check-equal? (field 'evictions (reasoning-evidence-store-stats store)) 1)
        (reasoning-evidence-store-clear! store)
        (check-equal? (field 'entries (reasoning-evidence-store-stats store)) 0)
        (let (b (reasoning-resolve-evidence store snapshot candidate))
          (check-equal? (> (field 'handle b) h) #t))))))
