      (slot-04 4) (slot-05 5) (slot-06 6) (slot-07 7)
      (slot-08 8) (slot-09 9) (slot-10 10) (slot-11 11)
      (slot-12 12) (slot-13 13) (slot-14 14) (slot-15 15)
      (slot-16 16) (slot-17 17) (slot-18 18) (slot-19 19)
      (slot-20 20) (slot-21 21) (slot-22 22) (slot-23 23)))

(def static-runtime-prototype-b
  (.o (slot-00 0) (slot-01 1) (slot-02 2) (slot-03 3)
      (slot-04 4) (slot-05 5) (slot-06 6) (slot-07 7)
      (slot-08 8) (slot-09 9) (slot-10 10) (slot-11 11)
      (slot-12 12) (slot-13 13) (slot-14 14) (slot-15 15)
      (slot-16 16) (slot-17 17) (slot-18 18) (slot-19 19)
      (slot-20 20) (slot-21 21) (slot-22 22) (slot-23 23)))
